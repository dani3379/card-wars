build/
.export_templates/

# Shelved art — moved out of the active project (see assets/_unused/_MOVED_MANIFEST.txt).
# Kept on disk as a local backup; the originals stay recoverable from git history.
assets/_unused/

.vscode/
.idea/
.DS_Store
Thumbs.db
.claude/

# --- Scratch / work-in-progress (not shipped) ---
staging/
_preview_*
*.tmp.*

# Frame iteration & debug leftovers
assets/frames/_backup_v3/
assets/frames/_debug_*
assets/frames/frame_comparison*
assets/frames/frame_cleaned_comparison*
assets/frames/*_cleaned*
assets/frames/*_thin*
assets/frames/frame_creature_common_v3*
assets/frames/frame_creature_common_v4*
assets/frames/frame_v4_cardsize*
assets/frames/frame_v5_*

# AI art / UI experiments
assets/ui/_ai_*

# Font test scratch
assets/fonts/test/

# --- Local dev study & screenshot workspaces (large scratch; kept on disk, not shipped) ---
# Video captures + extracted frames, card-redesign renders, and probe screenshots.
# These live under tools/ and are never loaded by the game.
tools/combat_study/
tools/card_redesign_v6/
tools/screenshot/
tools/screenshot_boot.*
tools/_crop_*
# Clarity-verification scratch (2026-06-21): combat/map/card render harnesses,
# their PNG outputs, and the zoomed crops used to eyeball the UI changes.
/_shot_*.png
# 2026-07-30: this used to be a blanket `tools/_shot_*`, which ignored the
# HARNESSES as well as their output. That contradicted CLAUDE.md, which tells
# contributors to run tools/_shot_battle_log.tscn, _shot_creature_fx.tscn,
# _shot_event_pass.tscn and friends to verify their work — instructions naming
# files nobody else could have. It also meant harness fixes silently evaporated:
# the settle timings were found to be capturing mid-animation (manufacturing
# phantom bugs in the Recruit audit) and the correction could not be committed.
# Track the sources; keep ignoring the pictures.
tools/_shot_*.png
tools/_shot_*.png.import
tools/_shot_*.log
# Output DIRECTORIES too (tools/_shot_ev/ alone is 244MB of captures) — the
# trailing slash is what keeps this from matching _shot_foo.gd.
tools/_shot_*/
tools/screenshot/
tools/_render_*
tools/_v_*
# Headless parse-check / probe run logs (regenerated on every run)
tools/*.log

# Godot editor temp / backup files
*.TMP
project.godot~*

# Large local render/preview scratch (like card_redesign_v6/ & screenshot/ above)
tools/detail_redesign/
tools/_textshot/
tools/_kwprev_*
tools/card_mockups/
tools/field_study/
tools/renders/
tools/screen_mockups/
tools/_card_dump.txt

# External-tool probe logs + scratch dumped at repo root (regenerated per run)
/_codex_*
/_verify_*.log
/scratch_combat_err.txt
# Stray self-contained-mode engine userdata dir
/Godot/
# Orphan import sidecars for already-ignored screenshot PNGs
_shot_*.png.import
# Debug zoom crops (scratch, same family as _shot_*)
/_zoom_*.png
_zoom_*.png.import

# --- Raw art source dumps (Midjourney downloads) ---
# The processed, cropped versions the game actually loads live under assets/.
# These are the untouched source outputs — kept on disk as a local archive (like
# assets/_unused/), never committed, so git history isn't bloated by ~160MB of
# working art.
pictures/
new_pictures/
