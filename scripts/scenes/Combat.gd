# ─────────────────────────────────────────────────────────────────────────
#  Keyword callouts (LEGIBILITY)
#  The core fix for "combat reads as samey / players ignore effects": when a
#  keyword actually FIRES (Thorns reflects, Armored blocks, Poison kills, a
#  creature Regenerates, a Last Stand saves it), pop a chip that is visually
#  DISTINCT from damage numbers — a dark pill with the keyword's own silhouette
#  icon and a colored keyline — so "THORNS reflected 1" never reads the same as
#  a bare "-1". Per-keyword colour + display label live in one table so every
#  call site stays a one-liner. Purely presentational; no game logic here.
# ─────────────────────────────────────────────────────────────────────────
const _CALLOUT_STYLE := {
	"thorns":     {"col": Color(0.62, 0.86, 0.46), "label": "THORNS"},
	"poison":     {"col": Color(0.58, 0.93, 0.34), "label": "POISON"},
	"armored":    {"col": Color(0.62, 0.80, 1.00), "label": "ARMORED"},
	"shield":     {"col": Color(0.66, 0.86, 1.00), "label": "SHIELD"},
	"last_stand": {"col": Color(1.00, 0.86, 0.30), "label": "LAST STAND"},
	"piercing":   {"col": Color(1.00, 0.58, 0.30), "label": "PIERCING"},
	"regenerate": {"col": Color(0.50, 0.92, 0.60), "label": "REGEN"},
	"wither":     {"col": Color(0.80, 0.58, 0.90), "label": "WITHER"},
	"swift":      {"col": Color(0.58, 0.90, 1.00), "label": "SWIFT"},
	"guardian":   {"col": Color(0.88, 0.80, 0.56), "label": "GUARDIAN"},
	"sacrifice":  {"col": Color(1.00, 0.36, 0.22), "label": "SACRIFICE"},
	"exhaust":    {"col": Color(0.76, 0.70, 0.62), "label": "EXHAUST"},
	# ROUND-SCOPED RIDERS (2026-07-28) — the moment-of-change half of the status
	# rail's standing marks. A rule landing on a body used to be invisible: War
	# Cry moved the WHOLE line into the Swift pre-phase and nothing on screen
	# moved, so the player learned about it by watching an unexplained combat
	# order. Colours match Card2D._active_effect_colors' rider family (ember for
	# an attacking rider, shield-blue for a protective one) so the flash and the
	# orb it leaves behind are recognisably the same thing.
	"granted_swift":  {"col": Color(1.00, 0.72, 0.36), "label": "SWIFT"},
	"charging":       {"col": Color(1.00, 0.72, 0.36), "label": "CHARGING"},
	"double_strike":  {"col": Color(1.00, 0.72, 0.36), "label": "STRIKE TWICE"},
	"challenging":    {"col": Color(1.00, 0.72, 0.36), "label": "CHALLENGE"},
	"redirecting":    {"col": Color(0.74, 0.88, 1.00), "label": "COVERING"},
	"warded":         {"col": Color(0.74, 0.88, 1.00), "label": "WARDED"},
	# A tick that DIDN'T happen still has to read (2026-07-28). A Doom body's
	# counter holds on the round it forms up, and a countdown that silently
	# refuses to move is indistinguishable from a bug — so the round it holds,
	# it says so. Ember, because it is the fuse's own colour.
	"fuse_unlit":     {"col": Color(1.00, 0.62, 0.28), "label": "FUSE UNLIT"},
	# THE FIGHT'S OWN RULE (2026-07-29). An encounter passive lending its line
	# Piercing or Thorns is a rider like any other — it just happens to be named
	# after a printed keyword. Ember, with the rest of the "this body does
	# something extra" family, so a LENT Thorns never reads as a printed one.
	"granted_piercing": {"col": Color(1.00, 0.72, 0.36), "label": "PIERCING"},
	"granted_thorns":   {"col": Color(1.00, 0.72, 0.36), "label": "THORNS"},
	# A body joining the enemy line. The only board change with no float of its
	# own — a creature simply exists that did not before — so it says so ON the
	# arrival rather than as a caption in the middle of the screen.
	"summoned":         {"col": Color(0.95, 0.62, 0.30), "label": "SUMMONED"},
}
## Devices borrowed by the rider callouts. A rider is a STATE, not a registered
## keyword, so it has no device of its own — and a callout with no icon is a bare
## word, visually a different species from every other keyword chip. Kept in step
## with the icon_id arguments in Card2D._active_effect_entries.
const _CALLOUT_ICON_ALIAS := {
	"granted_swift": "swift", "charging": "charge", "double_strike": "rampage",
	"challenging": "overrun", "redirecting": "guardian", "warded": "last_stand",
	"fuse_unlit": "doom",
	"granted_piercing": "piercing", "granted_thorns": "thorns",
	"summoned": "summon",
}
var _active_callouts: Array = []

## Convenience: spawn a keyword callout at `card`, looking up colour/label/icon
## from _CALLOUT_STYLE by keyword id. `suffix` appends a magnitude (" +1", " -2").
func spawn_keyword_callout_kw(card: Control, kw_id: String, suffix: String = "") -> void:
	if card == null or not is_instance_valid(card):
		return
	var style: Dictionary = _CALLOUT_STYLE.get(kw_id,
		{"col": Color(1, 1, 1), "label": kw_id.to_upper()})
	# Visual parity: the host re-broadcasts this callout so the client replays it on
	# the same creature (the client never runs the resolver, so it would otherwise see
	# only the HP delta, not WHY). eid<0 (an unsynced fresh token) can't be matched — skip.
	if _is_host() and int(card.entity_id) >= 0:
		var col: Color = style["col"]
		_net_fx_queue.append({
			"eid": int(card.entity_id), "label": String(style["label"]) + suffix,
			"col": [col.r, col.g, col.b],
		})
	var anchor: Vector2 = card.global_position + Vector2(
		card.size.x * card.scale.x * 0.5, card.size.y * card.scale.y * 0.06)
	log_status(card, String(style["label"]) + suffix)
	spawn_keyword_callout(anchor, String(style["label"]) + suffix,
		style["col"], GameTheme.get_keyword_icon(
			String(_CALLOUT_ICON_ALIAS.get(kw_id, kw_id))))


## Trigger callout for an on-ENTER (battlecry) or on-DEATH (deathrattle) ability.
## Ties the visible result (a card drawn, a creature summoned, the foe's face
## ticking down) back to its CAUSE — the creature that just entered or died.
## Cyan = enter, bone = death, so these read as one family, apart from the
## per-keyword reaction chips. No-ops on an empty label (unmapped effect type).
const _TRIGGER_ENTER_COL := Color(0.42, 0.86, 0.95)  # play-cyan (battlecry)
const _TRIGGER_DEATH_COL := Color(0.86, 0.78, 0.60)  # bone (deathrattle)
func spawn_trigger_callout(global_pos: Vector2, text: String, is_death: bool, eid: int = -1) -> void:
	if text == "":
		return
	var col: Color = _TRIGGER_DEATH_COL if is_death else _TRIGGER_ENTER_COL
	# Visual parity: re-broadcast battlecry/deathrattle labels to the client by eid (the
	# caller passes the firing creature's entity_id). On-enter labels anchor on a live
	# creature and replay; on-death labels usually have no anchor left (the creature's
	# gone from the next snapshot) and are dropped — the death burst already reads it.
	if _is_host() and eid >= 0:
		_net_fx_queue.append({"eid": eid, "label": text, "col": [col.r, col.g, col.b]})
	spawn_keyword_callout(global_pos, text, col, null)


## A styled "a keyword fired" chip — DISTINCT from the bare floating damage
## numbers so the player can read the mechanic, not just the math. Pops in,
## rises, holds long enough to read the word, then fades. Stacks above any
## sibling chips already live near the same anchor so they never overlap.
func spawn_keyword_callout(global_pos: Vector2, text: String, color: Color,
		icon_tex: Texture2D = null) -> void:
	var parent: Node = _hud_layer if _hud_layer != null else self
	_play_keyword_pulse_for(text, global_pos, color)
	_active_callouts = _active_callouts.filter(func(c): return is_instance_valid(c))
	var stack := 0
	for c in _active_callouts:
		if absf(c.position.x - global_pos.x) < 92.0 \
				and absf(c.position.y - global_pos.y) < 70.0:
			stack += 1
	var chip := PanelContainer.new()
	chip.mouse_filter = Control.MOUSE_FILTER_IGNORE
	chip.z_index = 210
	var sb := StyleBoxFlat.new()
	sb.bg_color = Color(0.07, 0.055, 0.05, 0.90)
	sb.border_color = Color(color.r, color.g, color.b, 0.95)
	sb.set_border_width_all(2)
	sb.set_corner_radius_all(7)
	sb.shadow_color = Color(0, 0, 0, 0.55)
	sb.shadow_size = 4
	sb.content_margin_top = 3
	sb.content_margin_bottom = 3
	sb.content_margin_left = 7
	sb.content_margin_right = 8
	chip.add_theme_stylebox_override("panel", sb)
	var row := HBoxContainer.new()
	row.add_theme_constant_override("separation", 4)
	row.mouse_filter = Control.MOUSE_FILTER_IGNORE
	chip.add_child(row)
	if icon_tex != null:
		var ic := TextureRect.new()
		ic.texture = icon_tex
		ic.custom_minimum_size = Vector2(18, 18)
		# The keyword device SVGs are 512² — without IGNORE_SIZE the TextureRect
		# adopts that as its minimum and the chip balloons. Pin it to 18px.
		ic.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
		ic.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
		ic.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		ic.modulate = Color(color.r, color.g, color.b, 1.0)
		ic.mouse_filter = Control.MOUSE_FILTER_IGNORE
		row.add_child(ic)
	var lbl := Label.new()
	lbl.text = text
	lbl.add_theme_font_size_override("font_size", 17)
	lbl.add_theme_color_override("font_color", Color(
		minf(color.r * 1.25, 1.0), minf(color.g * 1.25, 1.0),
		minf(color.b * 1.25, 1.0)))
	lbl.add_theme_color_override("font_outline_color", Color(0, 0, 0, 0.92))
	lbl.add_theme_constant_override("outline_size", 4)
	if GameTheme.font_title_black != null:
		lbl.add_theme_font_override("font", GameTheme.font_title_black)
	lbl.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	lbl.mouse_filter = Control.MOUSE_FILTER_IGNORE
	row.add_child(lbl)
	chip.position = global_pos + Vector2(-42, -16 - float(stack) * 30.0)
	chip.scale = Vector2(0.6, 0.6)
	chip.pivot_offset = Vector2(42, 14)
	parent.add_child(chip)
	_active_callouts.append(chip)
	# Center horizontally on the anchor once the container has sized to its text.
	_recenter_callout.call_deferred(chip, global_pos.x)
	# ON THE SHARED CLOCK (2026-07-27). These four durations were literal, so the
	# chip lived 1.06 s no matter the animation-speed setting — against a strike
	# that takes 0.19 s at 1.0x and 0.063 s at "Instant". That put five strikes'
	# worth of chips on screen at normal speed and SEVENTEEN at Instant, which is
	# the single largest contributor to the clash reading as visual soup. The
	# sibling spawn_floating_number was already scaled; this was the outlier.
	var tw := chip.create_tween()
	tw.set_parallel(true)
	tw.tween_property(chip, "scale", Vector2.ONE, Motion.time(0.16)) \
		.set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	tw.tween_property(chip, "position:y", chip.position.y - 30.0, Motion.time(0.95)) \
		.set_ease(Tween.EASE_OUT)
	tw.tween_property(chip, "modulate:a", 0.0, Motion.time(0.40)) \
		.set_ease(Tween.EASE_IN).set_delay(Motion.time(0.66))
	tw.chain().tween_callback(chip.queue_free)


func _recenter_callout(chip: Control, center_x: float) -> void:
	if is_instance_valid(chip):
		chip.position.x = center_x - chip.size.x * 0.5


func _play_keyword_pulse_for(text: String, global_pos: Vector2, color: Color) -> void:
	var key := text.to_upper()
	var strong := key.begins_with("BLOCKED") or key.begins_with("ARMORED") \
		or key.begins_with("SHIELD") or key.begins_with("PIERCING") \
		or key.begins_with("SACRIFICE") or key.begins_with("EXHAUST")
	if not strong or _hud_layer == null:
		return
	var ring := Line2D.new()
	ring.width = 3.0
	ring.antialiased = true
	ring.z_index = 208
	ring.default_color = Color(color.r, color.g, color.b, 0.74)
	var pts := PackedVector2Array()
	var r := 24.0
	for i in range(33):
		var a := TAU * float(i) / 32.0
		pts.append(Vector2(cos(a), sin(a)) * r)
	ring.points = pts
	ring.position = global_pos
	_hud_layer.add_child(ring)
	var tw := ring.create_tween().set_parallel(true)
	var end_scale := Vector2(1.35, 1.35)
	if UserSettings != null and UserSettings.reduce_motion:
		end_scale = Vector2(1.05, 1.05)
	tw.tween_property(ring, "scale", end_scale, 0.28).set_ease(Tween.EASE_OUT)
	tw.tween_property(ring, "modulate:a", 0.0, 0.30).set_ease(Tween.EASE_IN)
	tw.chain().tween_callback(ring.queue_free)


func spawn_floating_number(global_pos: Vector2, text: String, color: Color, big: bool = false) -> void:
	# Floating combat text (damage / heal / gold). Parented to the HUD layer so
	# it survives the source node's death and rides the screen-shake offset.
	# Rises while fading; pops in with a slight back-eased scale.
	var parent: Node = _hud_layer if _hud_layer != null else self
	# Colour-blind: remap the float colour centrally so heal greens read distinct
	# from damage reds under deuteranopia/protanopia (no-op when colorblind is off).
	color = GameTheme.cb_color(color)
	var lbl := Label.new()
	lbl.text = text
	lbl.add_theme_font_size_override("font_size", 38 if big else 26)
	lbl.add_theme_color_override("font_color", color)
	lbl.add_theme_color_override("font_outline_color", Color(0, 0, 0, 0.92))
	lbl.add_theme_constant_override("outline_size", 6)
	lbl.mouse_filter = Control.MOUSE_FILTER_IGNORE
	lbl.z_index = 200
	lbl.scale = Vector2(0.5, 0.5)
	# Center the label on the anchor: shift left/up by half its (font-driven)
	# size. Use a fixed nominal half-width since size isn't known pre-layout.
	lbl.position = global_pos + Vector2(-14, -8) + Vector2(randf_range(-10, 10), 0)
	lbl.pivot_offset = Vector2(14, 14)
	parent.add_child(lbl)
	var rise := -54.0 if not big else -72.0
	var tw := lbl.create_tween()
	tw.set_parallel(true)
	tw.tween_property(lbl, "scale", Vector2.ONE, UserSettings.anim_time(0.16)).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	tw.tween_property(lbl, "position:y", lbl.position.y + rise, UserSettings.anim_time(0.72)).set_ease(Tween.EASE_OUT)
	tw.tween_property(lbl, "modulate:a", 0.0, UserSettings.anim_time(0.72)).set_ease(Tween.EASE_IN).set_delay(UserSettings.anim_time(0.18))
	tw.chain().tween_callback(lbl.queue_free)


# ─────────────────────────────────────────────────────────────────────────
#  Magnitude-scaled combat hit feedback (JUICE)
#  Card2D.take_damage routes here so every creature hit shakes the screen in
#  proportion to the blow — a 1-dmg plink barely ripples, a 7-dmg haymaker
#  rocks the board. Centralized so both armor-respecting and armor-bypass hits
#  feel consistent. Purely additive: no game logic, just shake.
# ─────────────────────────────────────────────────────────────────────────

func creature_hit_feedback(amount: int) -> void:
	# Called by Card2D after a creature absorbs a hit. Light hits get a whisper of
	# shake; bigger hits ramp up so the player FEELS the weight without the screen
	# jackhammering on chip damage. Kept modest on purpose because the combat
	# cascade ALSO fires an explicit screen_shake on heavy/lethal blows
	# (_creature_attacks_creature etc.) — this layers under that, it doesn't
	# replace it. 1 dmg → ~1.6px, 3 dmg → ~3.5px, 6+ dmg → capped ~6.5px.
	#
	# 2026-07-30: that layering WAS the bug — see _deal_creature_strike_damage,
	# which is now the single owner of a creature strike's shake. This path keeps
	# every NON-strike source (spell chip, Thorns recoil, venom, Doom ticks, the
	# passive taxes), which is exactly the set the flag excludes.
	if Card2D.strike_damage_active:
		return
	if amount <= 0:
		return
	var mag: float = clampf(0.9 + float(amount) * 0.95, 1.6, 6.5)
	screen_shake(mag)


func _play_face_damage_flash(amount: int) -> void:
	# A layered crimson vignette pulse for player-face damage — louder than the
	# generic screen_flash so a hit to the hero never gets lost. Two stacked
	# ColorRects: a brief full-screen wash (alpha scales with damage) plus a
	# thick red edge frame that snaps in and fades, reading as "blood at the
	# edges of your vision." Both self-free; pure overlay, no game logic.
	var parent: Node = _hud_layer if _hud_layer != null else self
	# RESCALED 2026-07-29. Measured: ONE point of damage produced +120 board
	# redness at 76 ms and took 330 ms to clear, burying a death, its damage
	# numeral and a PIERCING chip on the clash's first beat. The old 0.20 floor
	# gave a 1-damage tickle ~48% of the loudest flash in the game. The wash is
	# PUNCTUATION for the damage number, not information in itself — so it must
	# never mask the number it punctuates. Lower floor, steeper slope so big hits
	# still read as big, and a decay short enough to fuse with the blow instead
	# of sitting across the next one.
	var wash_a: float = clampf(0.07 + float(amount) * 0.038, 0.09, 0.38)
	# Full-screen red wash.
	var wash := ColorRect.new()
	wash.set_anchors_preset(Control.PRESET_FULL_RECT)
	wash.color = Color(0.72, 0.06, 0.04, wash_a)
	wash.mouse_filter = Control.MOUSE_FILTER_IGNORE
	wash.z_index = 232
	parent.add_child(wash)
	var tw := wash.create_tween()
	tw.tween_property(wash, "color:a", 0.0, 0.19).set_ease(Tween.EASE_IN)
	tw.tween_callback(wash.queue_free)
	# Hard red edge frame that hits + recedes for the "took a real blow" punch.
	var frame := Panel.new()
	frame.set_anchors_preset(Control.PRESET_FULL_RECT)
	frame.mouse_filter = Control.MOUSE_FILTER_IGNORE
	frame.z_index = 233
	var sb := StyleBoxFlat.new()
	sb.bg_color = Color(0, 0, 0, 0)
	# RESCALED WITH THE WASH (2026-07-29). The wash above was toned down first and
	# the board STILL measured +129 redness peak with a ~400 ms decay — because this
	# frame, not the wash, was doing most of it and had been left alone. Its floors
	# were the problem: 0.45 alpha and 80 px meant a ONE-POINT tickle drew more than
	# half the maximum frame the game can produce, and the 0.40 s fade sat right in
	# the 100-500 ms band §1 condemns, so it lay across the NEXT beat and buried it.
	# Floors down, slope kept so a real haymaker still frames the screen in blood.
	sb.border_color = Color(0.85, 0.07, 0.05, clampf(0.16 + float(amount) * 0.045, 0.20, 0.72))
	sb.set_border_width_all(int(clampf(38.0 + float(amount) * 11.0, 46.0, 150.0)))
	sb.shadow_color = Color(0.9, 0.08, 0.05, 0.34)
	sb.shadow_size = 30
	frame.add_theme_stylebox_override("panel", sb)
	parent.add_child(frame)
	var ft := frame.create_tween()
	ft.tween_property(frame, "modulate:a", 0.0, 0.22).set_ease(Tween.EASE_IN)
	ft.tween_callback(frame.queue_free)


func _punch_label(lbl: Control, amount_scale: float) -> void:
	# Quick scale-pop on a HUD label (HP counter) so a value change reads as an
	# impact, not a silent tick. Restores to the label's resting scale — which is
	# why this can't just call Motion.punch: that verb settles to Vector2.ONE,
	# and these labels don't all rest there.
	#
	# It follows the house grammar in every other respect (2026-07-26 — it used
	# to invert it, overshooting on the way OUT and easing flat on the way home):
	# Motion.PUNCH out on QUAD-out, Motion.SETTLE home on BACK-out, keyed
	# kill-before-restart so a fast HP cascade re-punches cleanly instead of
	# stacking tweens, and decorative, so Reduce Motion sits it out.
	if lbl == null or not is_instance_valid(lbl):
		return
	if UserSettings != null and UserSettings.reduce_motion:
		return
	# The resting scale is remembered on the FIRST punch and reused forever
	# after. Reading lbl.scale here would sample a punch already in flight, so
	# each re-punch would settle to an inflated scale and the label would creep
	# bigger every time the HP counter moved twice in quick succession.
	var rest: Vector2 = lbl.get_meta("_punch_label_rest", lbl.scale)
	lbl.set_meta("_punch_label_rest", rest)
	lbl.pivot_offset = lbl.size * 0.5
	if lbl.has_meta("_punch_label_tw"):
		var old = lbl.get_meta("_punch_label_tw")
		if old is Tween and old.is_valid():
			old.kill()
	lbl.scale = rest
	var tw := lbl.create_tween()
	lbl.set_meta("_punch_label_tw", tw)
	tw.tween_property(lbl, "scale", rest * amount_scale, Motion.PUNCH) \
		.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	tw.tween_property(lbl, "scale", rest, Motion.SETTLE) \
		.set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)


# ─────────────────────────────────────────────────────────────────────────
#  Notable-death weight (JUICE)
#  A heavy creature dying, or several creatures dying in the same frame, earns
#  an extra punctuation of shake on top of the per-creature death burst. Frame-
#  coalesced so a board wipe produces a single emphasis rather than a stutter.
#  Runs synchronously (no await) so it never desyncs the attack cascade — the
#  attack functions already supply the awaited HITSTOP_BEAT after a kill.
# ─────────────────────────────────────────────────────────────────────────

func _note_death(card: Control, _was_enemy: bool) -> void:
	if is_instance_valid(card):
		_log_event("%s falls." % _log_card_ref(card),
			_log_data(card), _log_side(card))
	_deaths_this_frame += 1
	var bulk: int = 1
	if is_instance_valid(card):
		bulk = maxi(int(card.card_data.get("atk", 1)), int(card.card_data.get("hp", 1)))
	# Notable if it's the 2nd+ death this frame (a wipe) OR a chunky body (a
	# 6/6+ bruiser, an elite/boss centerpiece). Emphasis fires once per frame.
	var notable: bool = _deaths_this_frame >= 2 or bulk >= 6
	# Boss / elite encounters: any death of a sizable enemy reads as a milestone.
	if not notable and _was_enemy and bulk >= 4:
		var enc_type := String(RunState.current_node_type)
		if enc_type == "boss" or enc_type == "elite":
			notable = true
	if notable and not _death_hitstop_armed:
		_death_hitstop_armed = true
		# A stronger jolt than the per-hit shake, scaled up for a multi-kill.
		var mag: float = clampf(7.0 + float(_deaths_this_frame) * 2.5 + float(bulk) * 0.6, 8.0, 18.0)
		screen_shake(mag)
		_reset_death_frame_counter.call_deferred()


func _play_creature_death_vfx(card: Control, was_enemy: bool) -> void:
	if _hud_layer == null or DisplayServer.get_name() == "headless" \
			or card == null or not is_instance_valid(card):
		return
	var pos := _card_center(card)
	var bulk: int = maxi(int(card.card_data.get("atk", 1)),
		int(card.card_data.get("hp", 1)))
	var color := Color(0.86, 0.74, 0.56)
	if was_enemy and _encounter_faction != "":
		color = _faction_vfx_color(_encounter_faction).lerp(Color.WHITE, 0.14)
	elif not was_enemy:
		color = Color(1.0, 0.78, 0.34)
	if card.has_keyword("structure"):
		color = Color(0.64, 0.61, 0.54)

	var amount: int = int(clampf(16.0 + float(bulk) * 3.0, 18.0, 44.0))
	spawn_ash_burst(pos, Color(color.r, color.g, color.b, 0.88), amount)
	_spawn_vfx_ring(pos, Color(color.r, color.g, color.b, 0.72),
		clampf(36.0 + float(bulk) * 4.0, 42.0, 76.0),
		1.28, 0.42, 218, 3.0, 0.54, Vector2(1.0, 0.66))
	if bulk >= 6:
		_spawn_vfx_ring(pos, Color(1.0, 0.92, 0.68, 0.75),
			58.0, 1.42, 0.50, 219, 4.0, 0.50, Vector2(1.08, 0.70))
	if not was_enemy and not _is_net() and int(card.deck_uid) >= 0 \
			and RunState.get_kills(int(card.deck_uid)) >= RunState.veteran_epithet_kills():
		_spawn_vfx_streak(pos + Vector2(-54.0, 26.0), pos + Vector2(54.0, -26.0),
			Color(1.0, 0.86, 0.40, 0.78), 4.0, 220, 0.36, -12.0)

func _reset_death_frame_counter() -> void:
	# Deferred to end-of-frame so all deaths in one combat step share the same
	# emphasis, then the gate reopens for the next frame's deaths.
	_deaths_this_frame = 0
	_death_hitstop_armed = false


# ─────────────────────────────────────────────────────────────────────────
#  Low-HP dread (JUICE)
#  When the player drops to/below a danger threshold, a red screen-edge
#  vignette breathes around the frame and a soft heartbeat plays. The effect
#  removes itself the instant HP recovers above the line. Driven from
#  _update_hud so every damage / heal event re-evaluates it.
# ─────────────────────────────────────────────────────────────────────────

const LOW_HP_ABS_THRESHOLD: int = 6        # at/below this HP the dread kicks in
const LOW_HP_PCT_THRESHOLD: float = 0.25   # ...or at/below 25% of max, whichever is higher

func _low_hp_danger_line() -> int:
	# The HP value at/below which dread activates: the larger of the flat floor
	# and the 25%-of-max line, so a 25-max hero and a 40-max hero both feel it.
	return maxi(LOW_HP_ABS_THRESHOLD, int(ceil(float(player_max_hp) * LOW_HP_PCT_THRESHOLD)))

func _update_low_hp_dread() -> void:
	# Toggle the persistent dread overlay based on current HP vs the danger line.
	if _hud_layer == null:
		return
	var in_danger: bool = player_hp > 0 and player_hp <= _low_hp_danger_line()
	if in_danger and not _low_hp_active:
		_start_low_hp_dread()
	elif not in_danger and _low_hp_active:
		_stop_low_hp_dread()
	elif in_danger and _low_hp_active:
		# Pitch the heartbeat up a touch as HP approaches zero so the dread
		# intensifies on the final sliver of life.
		var t: float = clampf(float(player_hp) / float(maxi(1, _low_hp_danger_line())), 0.0, 1.0)
		_low_hp_vignette_peak = lerpf(0.50, 0.30, t)  # closer to 0 HP → deeper red

func _start_low_hp_dread() -> void:
	_low_hp_active = true
	_low_hp_vignette_peak = 0.42
	# Build the vignette once. Asset-free edge-darkening: a Panel whose StyleBox
	# has a thick red border + shadow hugging the screen edge, leaving the center
	# clear. Reads as "blood creeping in at the edges of vision." Pulses alpha on
	# a looping tween so it breathes.
	if not is_instance_valid(_low_hp_vignette):
		var pan := Panel.new()
		pan.name = "LowHpVignette"
		pan.set_anchors_preset(Control.PRESET_FULL_RECT)
		pan.mouse_filter = Control.MOUSE_FILTER_IGNORE
		pan.z_index = 230  # above board, below banners (245) and floating numbers
		var sb := StyleBoxFlat.new()
		sb.bg_color = Color(0, 0, 0, 0)            # transparent center
		sb.border_color = Color(0.62, 0.04, 0.03, 1.0)
		sb.set_border_width_all(120)               # thick red frame = edge vignette
		sb.shadow_color = Color(0.85, 0.05, 0.04, 0.55)
		sb.shadow_size = 60
		# Soft inner falloff so the red bleeds toward the center instead of a hard line.
		sb.anti_aliasing = true
		pan.add_theme_stylebox_override("panel", sb)
		pan.modulate = Color(1, 1, 1, 0.0)
		_hud_layer.add_child(pan)
		_low_hp_vignette = pan
	# Looping breathe tween: fade the whole vignette in/out so it pulses like a
	# pulse. Uses a method tween so the peak can drift with HP (set above).
	if _low_hp_tween != null and _low_hp_tween.is_valid():
		_low_hp_tween.kill()
	_low_hp_vignette.visible = true
	if UserSettings.reduce_motion:
		# Reduce Motion: hold the dread vignette steady instead of the breathing
		# heartbeat pulse. Still signals low HP (informational), no oscillation.
		_set_low_hp_vignette_alpha(0.75)
		return
	_low_hp_tween = create_tween().set_loops()
	_low_hp_tween.tween_method(_set_low_hp_vignette_alpha, 0.12, 1.0, 0.62) \
		.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	_low_hp_tween.tween_callback(_low_hp_heartbeat)
	_low_hp_tween.tween_method(_set_low_hp_vignette_alpha, 1.0, 0.12, 0.62) \
		.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	_low_hp_tween.tween_interval(0.10)

func _set_low_hp_vignette_alpha(t: float) -> void:
	# t in [0,1] → scaled by the current peak so the breathe deepens near death.
	if is_instance_valid(_low_hp_vignette):
		_low_hp_vignette.modulate.a = t * _low_hp_vignette_peak

func _low_hp_heartbeat() -> void:
	# Soft thud at the crest of each pulse. Reuses the existing "hit_hero" cue at
	# low volume, pitched well down so it reads as a muffled heartbeat, not a
	# strike. Rises slightly as HP falls (the vignette peak deepens on the same
	# slide), so the pulse tightens in character near death.
	if AudioBank != null and AudioBank.has_sfx("hit_hero"):
		var urgency: float = clampf(inverse_lerp(0.30, 0.50, _low_hp_vignette_peak), 0.0, 1.0)
		AudioBank.play_sfx("hit_hero", 0.02, -16.0, lerpf(0.52, 0.62, urgency))

func _stop_low_hp_dread() -> void:
	_low_hp_active = false
	if _low_hp_tween != null and _low_hp_tween.is_valid():
		_low_hp_tween.kill()
		_low_hp_tween = null
	if is_instance_valid(_low_hp_vignette):
		var v := _low_hp_vignette
		var tw := create_tween()
		tw.tween_property(v, "modulate:a", 0.0, 0.35)
		tw.tween_callback(func(): if is_instance_valid(v): v.visible = false)


# ─────────────────────────────────────────────────────────────────────────
#  Threat flagging (JUICE)
#  Enemy creatures that pose an immediate threat — they will smash the player's
#  face this round, or they swing for a heavy blow — get a pulsing crimson
#  outline so the danger is visible at a glance, not buried in the numbers.
#  Re-evaluated whenever the board changes (via _update_hud).
# ─────────────────────────────────────────────────────────────────────────

const THREAT_HEAVY_ATK: int = 5   # an attacker swinging this hard gets flagged even if blocked

func _clear_threat_flags() -> void:
	# Drop every enemy threat outline (e.g. when combat begins resolving).
	_clear_lane_forecast()
	for row in [ROW_FRONT, ROW_BACK]:
		var arr = _row_array(true, row)
		for lane in range(LANES_PER_ROW):
			var c = arr[lane]
			if c != null and is_instance_valid(c) and c.has_method("set_threat_flagged"):
				c.set_threat_flagged(false)

func _refresh_threat_flags() -> void:
	# Only meaningful during the player's turn — once combat resolves the board
	# is mid-flux. Skip outside PLAYER_TURN so flags don't flicker during the
	# attack cascade.
	if phase != Phase.PLAYER_TURN:
		return
	for row in [ROW_FRONT, ROW_BACK]:
		var arr = _row_array(true, row)
		for lane in range(LANES_PER_ROW):
			var c = arr[lane]
			if c == null or not is_instance_valid(c):
				continue
			if not c.has_method("set_threat_flagged"):
				continue
			var threat: bool = _enemy_is_threatening(c, lane, row)
			# Pass the swing magnitude so the flag shows "this enemy hits for N" —
			# the number reads at a glance without hovering the telegraph.
			if threat:
				c.set_threat_flagged(true, c.effective_atk())
			else:
				c.set_threat_flagged(false)
			# Keep the default-attack chevron in sync with the badge: it hides
			# beneath a threat flag and reappears the moment the flag clears.
			_update_attack_marker(c, String(c.state.current_intent))

func _enemy_is_threatening(c: Control, lane: int, row: int) -> bool:
	# A creature is "threatening" if it can attack and either (a) its column is
	# open so it will hit the player's face this round, or (b) it swings for a
	# heavy blow regardless of target. Structures / stunned / frozen never flag.
	if c.has_keyword("structure"):
		return false
	if not c.can_attack():
		return false
	var intent: String = String(c.state.current_intent)
	# Non-attacking intents (GUARD/HEAL/RETREAT/SUMMON) aren't an incoming hit.
	if intent != "ATK" and intent != "CHARGE" and intent != "ENRAGE":
		return false
	var atk: int = c.effective_atk()
	if atk <= 0:
		return false
	# Heavy hitter — always worth flagging.
	if atk >= THREAT_HEAVY_ATK:
		return true
	# Face threat: both player slots in this column are empty, so the blow lands
	# on the hero. Front and back rows attack independently every turn (see
	# _resolve_column_attack) — a back-row enemy reaches face on an open column
	# regardless of its own front partner, so both rows flag here.
	if _player_field[lane] == null and _player_back[lane] == null:
		return true
	return false


func _clear_lane_forecast() -> void:
	for n in _lane_forecast_nodes:
		if is_instance_valid(n):
			n.queue_free()
	_lane_forecast_nodes.clear()
	_lane_forecast_anchors.clear()


func _request_lane_forecast_refresh() -> void:
	# An action can call _update_hud several times before the frame is drawn.
	# Rebuilding immediately leaves every queue_free'd forecast alive until the
	# frame boundary and stacks several replacement node sets on the input frame.
	# Re-arm the hover read too: keyboard actions and remote snapshots can change
	# the result without moving the mouse.
	_telegraph_last_mouse = Vector2(-1.0e9, -1.0e9)
	if _lane_forecast_refresh_queued:
		return
	_lane_forecast_refresh_queued = true
	_flush_lane_forecast_refresh.call_deferred()


func _flush_lane_forecast_refresh() -> void:
	_lane_forecast_refresh_queued = false
	if not is_inside_tree():
		return
	var signature := _lane_forecast_state_signature()
	if signature == _lane_forecast_signature:
		return
	_lane_forecast_signature = signature
	_refresh_lane_forecast()


func _lane_forecast_state_signature() -> String:
	# Everything the strike predictor can visibly depend on. Hashing at most 16
	# small card dictionaries on a HUD event is far cheaper than recreating up
	# to dozens of Line2D/Label/Polygon nodes when nothing relevant changed.
	var parts := PackedStringArray([
		str(int(phase)), str(Card2D.board_interactive),
		str(_targeting_spell != null), str(_targeting_potion_idx),
		str(UserSettings == null or UserSettings.combat_telegraph),
		str(round_number), str(_net_active_index), str(_encounter_passive),
		str(_virulence_active), str(_doubled_hour), str(_cards_played_this_turn),
		str(_phantom_veil_used),
	])
	for is_enemy in [true, false]:
		for row in [ROW_FRONT, ROW_BACK]:
			var arr = _row_array(is_enemy, row)
			for lane in range(LANES_PER_ROW):
				var card = arr[lane]
				if card == null or not is_instance_valid(card):
					parts.append("-")
					continue
				parts.append("%d:%d:%d:%d:%s:%s:%s:%s:%s:%s:%s:%s:%s:%s:%s:%s" % [
					card.get_instance_id(), card.card_data.hash(),
					card.effective_atk(), card.current_hp,
					str(card.can_attack()), str(card.last_stand_used),
					str(card.state.has_shield),
					String(card.state.current_intent),
					str(card.state.stunned), str(card.state.is_frozen),
					str(card.state.marked),
					str(card.state.enrage_vulnerable),
					str(card.state.redirecting),
					str(card.state.charges_this_turn),
					str(card.state.battle_order_second_strike),
					str(_is_swift_attacker(card)),
				])
	return "|".join(parts)


func _refresh_lane_forecast() -> void:
	# Always-on strike read for the planning phase, BOTH LINES. Reuses the same
	# predictor as the hover arrow, so the quiet board-wide chips and the loud
	# hover read can never disagree.
	#
	# THE PLAYER'S OWN LINE WAS MISSING until 2026-07-28. This loop read only
	# `_row_array(true, ...)` — the enemy — so the player could see what would be
	# done TO them but not what their own line would do, except by hovering one
	# card at a time. That is half a forecast: "should I trade here" is a question
	# about both columns at once. Into the Breach's whole thesis is that you plan
	# against a fully drawn future; the predictor already handled friendly
	# attackers (the hover twin used it), it simply was never asked.
	#
	# Chip count is the thing to watch — this can double the overlay on a full
	# board. It is quiet_text chips, not animating actors, so it does not spend the
	# ~4-concurrent-motion budget; but if it reads as clutter in play, narrowing it
	# to decisive lanes (kills / deaths only) is the intended next dial, NOT
	# reverting to enemy-only.
	_clear_lane_forecast()
	if _hud_layer == null:
		return
	if phase != Phase.PLAYER_TURN or not Card2D.board_interactive:
		return
	if _targeting_spell != null or _targeting_potion_idx >= 0:
		return
	if UserSettings != null and not UserSettings.combat_telegraph:
		return
	# Enemy first so their chips are built before ours — on a crowded lane the
	# later chip stacks clear of the earlier one, and the incoming threat is the
	# read the player orients on.
	var reads: Array = []
	for side_is_enemy in [true, false]:
		for row in [ROW_FRONT, ROW_BACK]:
			var arr = _row_array(side_is_enemy, row)
			for lane in range(LANES_PER_ROW):
				var attacker = arr[lane]
				if attacker == null or not is_instance_valid(attacker):
					continue
				if not _forecast_attacker_can_strike(attacker):
					continue
				var read := _predict_lane_strike(attacker)
				if read.is_empty():
					continue
				reads.append({"attacker": attacker, "read": read})

	# AGGREGATE PER TARGET. Two bodies striking one victim used to produce two
	# labels each reporting only ITS OWN damage — so a 4 HP body facing 2 and 3
	# read "TAKES 3 - 1 HP" when the true incoming was 5 and it died. Stacking the
	# labels made that honest but verbose; summing makes it both honest and short,
	# which is what the player is actually asking ("can this body survive the
	# round", not "what does each attacker do").
	var totals := _forecast_group_by_target(reads)
	for entry in reads:
		var r: Dictionary = entry["read"]
		# Suppress the per-attacker label only where an aggregate will replace it.
		var tgt = r.get("target")
		var suppress := tgt != null and is_instance_valid(tgt) \
			and totals.has(tgt.get_instance_id())
		_add_lane_forecast(entry["attacker"], r, suppress)
	for tid in totals:
		_add_lane_forecast_total(totals[tid])


func _forecast_attacker_can_strike(attacker: Control) -> bool:
	if attacker == null or not is_instance_valid(attacker):
		return false
	if attacker.has_keyword("structure") or not attacker.can_attack() \
			or attacker.state.stunned or attacker.state.is_frozen:
		return false
	# Alternating skirmish: only the active player's line strikes. In sealed mode
	# active_index is -1 and both committed lines resolve together.
	if _is_net() and _net_active_index >= 0:
		var mine: int = _net_my_index()
		var owner: int = 1 - mine if attacker.is_opponent else mine
		if owner != _net_active_index:
			return false
	# Solo intents execute immediately before combat. HEAL / SUMMON / ABILITY
	# explicitly spend this creature's attack; GUARD / RALLY / RETREAT do not.
	if not _is_net() and attacker.is_opponent and phase == Phase.PLAYER_TURN:
		var intent: String = String(attacker.state.current_intent)
		if intent in ["HEAL", "SUMMON", "ABILITY"]:
			return false
	return true


## Group multi-attacker reads by their victim, but ONLY where summing the damage
## is provably correct. Returns {instance_id: {target, damage, hp_after, lethal}}.
##
## Each `_predict_lane_strike` is computed independently against the victim's
## projected HP, so it knows nothing about the other blows landing on the same
## body. Plain damage composes cleanly and can simply be added. Shields, Last
## Stand, rescues and death-followups do NOT: they are order-dependent (a shield
## eats whichever blow lands first), and summing across them would replace one
## honest-but-partial number with a confidently wrong one. In those cases this
## returns nothing for the target and the per-attacker labels stack instead —
## verbose, but every number on screen stays true.
func _forecast_group_by_target(reads: Array) -> Dictionary:
	var groups: Dictionary = {}
	for entry in reads:
		var r: Dictionary = entry["read"]
		if bool(r.get("face", false)):
			continue
		var tgt = r.get("target")
		if tgt == null or not is_instance_valid(tgt):
			continue
		# Anything order-dependent disqualifies this victim from aggregation.
		if bool(r.get("shield_break", false)) or bool(r.get("last_stand", false)) \
				or String(r.get("rescue", "")) != "" \
				or String(r.get("death_followup", "")) != "":
			groups[tgt.get_instance_id()] = null
			continue
		var tid: int = tgt.get_instance_id()
		if groups.has(tid) and groups[tid] == null:
			continue
		if not groups.has(tid):
			groups[tid] = {"target": tgt, "damage": 0, "count": 0,
				"point": r.get("point", _card_center(tgt))}
		groups[tid]["damage"] = int(groups[tid]["damage"]) + int(r.get("damage", 0))
		groups[tid]["count"] = int(groups[tid]["count"]) + 1
	# Keep only victims taking 2+ clean blows — a single read already prints
	# correctly through the normal path and needs no aggregate.
	var out: Dictionary = {}
	for tid in groups:
		var g = groups[tid]
		if g == null or int(g["count"]) < 2:
			continue
		var hp0: int = _forecast_projected_hp(g["target"])
		g["hp_after"] = hp0 - int(g["damage"])
		g["lethal"] = int(g["hp_after"]) <= 0
		out[tid] = g
	return out


## The one chip that speaks for every blow landing on a body this round.
func _add_lane_forecast_total(g: Dictionary) -> void:
	var dmg: int = int(g["damage"])
	var txt := "SLAIN - TAKES %d" % dmg if bool(g["lethal"]) \
		else "TAKES %d - %d HP" % [dmg, maxi(int(g["hp_after"]), 0)]
	_add_lane_forecast_label(g["point"], {
		"quiet_text": txt, "text": txt,
		"color": Color(1.0, 0.42, 0.30) if bool(g["lethal"]) \
			else Color(1.0, 0.82, 0.42),
	})


func _add_lane_forecast(attacker: Control, read: Dictionary,
		suppress_label: bool = false) -> void:
	var dst: Vector2 = read["point"]
	var danger: Color = Color(1.0, 0.36, 0.20, 0.62) if bool(read.get("face", false)) \
		else Color(1.0, 0.72, 0.34, 0.48)
	if bool(read.get("face", false)):
		_add_lane_forecast_face_marker(dst, read, danger)
		if not suppress_label:
			_add_lane_forecast_label(dst, read)
		return

	var src := _card_center(attacker)
	_add_lane_forecast_target_ring(dst, read, danger)
	var line := Line2D.new()
	line.width = 3.0
	line.antialiased = true
	line.joint_mode = Line2D.LINE_JOINT_ROUND
	line.begin_cap_mode = Line2D.LINE_CAP_ROUND
	line.end_cap_mode = Line2D.LINE_CAP_ROUND
	line.z_index = 176
	line.default_color = danger
	var mid := (src + dst) * 0.5 + Vector2(0, -22)
	var pts := PackedVector2Array()
	for i in range(13):
		pts.append(_bezier_quad(src, mid, dst, float(i) / 12.0))
	line.points = pts
	_hud_layer.add_child(line)
	_lane_forecast_nodes.append(line)

	var head := Polygon2D.new()
	head.polygon = PackedVector2Array([
		Vector2(0, 0), Vector2(-12, -5), Vector2(-12, 5)
	])
	head.color = danger
	head.z_index = 177
	head.position = dst
	if pts.size() >= 2:
		var tangent: Vector2 = pts[pts.size() - 1] - pts[pts.size() - 2]
		if tangent.length_squared() > 0.01:
			head.rotation = tangent.angle()
	_hud_layer.add_child(head)
	_lane_forecast_nodes.append(head)

	# The arrow and ring always draw — they say WHO is striking, which the
	# aggregate cannot. Only the number is suppressed, because a per-attacker
	# number beside a total is two answers to one question.
	if not suppress_label:
		_add_lane_forecast_label(dst, read)


func _add_lane_forecast_label(dst: Vector2, read: Dictionary) -> void:
	var label := Label.new()
	label.text = _forecast_chip_text(read)
	label.add_theme_font_size_override("font_size", 19)
	if GameTheme.font_title != null:
		label.add_theme_font_override("font", GameTheme.font_title)
	label.add_theme_color_override("font_color", read.get("color", Color(1, 0.7, 0.3)))
	label.add_theme_color_override("font_outline_color", Color(0, 0, 0, 0.95))
	label.add_theme_constant_override("outline_size", 5)
	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	label.z_index = 178
	_hud_layer.add_child(label)
	_lane_forecast_nodes.append(label)
	label.reset_size()
	var s: Vector2 = label.size
	# STACK, DON'T BURY (2026-07-29). This loop runs per ATTACKER but anchors per
	# TARGET, so two bodies striking the same victim produced two labels at
	# identical positions — and the survivor showed only ITS OWN attacker's damage.
	# Measured on a real board: 9 labels created, 7 visually distinct, and one of
	# the hidden pair mattered — a 4 HP Outrider read "TAKES 3 - 1 HP" while true
	# incoming was 5. It died that clash. A forecast that under-reports incoming
	# damage is worse than no forecast: it is the "I'd have played differently"
	# failure, manufactured by the UI.
	#
	# Quantised so near-identical anchors collide deliberately; each further read on
	# the same body steps up by its own height.
	var key := Vector2i(int(dst.x / 24.0), int(dst.y / 24.0))
	var stacked: int = int(_lane_forecast_anchors.get(key, 0))
	_lane_forecast_anchors[key] = stacked + 1
	label.position = Vector2(dst.x - s.x * 0.5,
		dst.y - s.y - 10.0 - float(stacked) * (s.y + 3.0))


func _add_lane_forecast_face_marker(dst: Vector2, read: Dictionary, danger: Color) -> void:
	# Face damage is a lane breakthrough, not a line drawn to the HP widget.
	# Mark the empty column locally so the board says where the blow comes from.
	_add_lane_forecast_target_ring(dst, read, danger)
	var dir := -1.0 if bool(read.get("target_is_enemy", false)) else 1.0
	for i in range(2):
		var chevron := Line2D.new()
		chevron.width = 3.6 - float(i) * 0.8
		chevron.antialiased = true
		chevron.joint_mode = Line2D.LINE_JOINT_ROUND
		chevron.begin_cap_mode = Line2D.LINE_CAP_ROUND
		chevron.end_cap_mode = Line2D.LINE_CAP_ROUND
		chevron.z_index = 177
		chevron.default_color = Color(danger.r, danger.g, danger.b, 0.64 - float(i) * 0.20)
		var step := float(i) * 17.0 * -dir
		chevron.points = PackedVector2Array([
			Vector2(-26, -dir * 12 + step),
			Vector2(0, dir * 16 + step),
			Vector2(26, -dir * 12 + step),
		])
		chevron.position = dst
		_hud_layer.add_child(chevron)
		_lane_forecast_nodes.append(chevron)


func _add_lane_forecast_target_ring(dst: Vector2, read: Dictionary, danger: Color) -> void:
	# A quiet target reticle at the impact point makes the always-on lane forecast
	# readable even when the curved arrow crosses a busy row of cards.
	if _hud_layer == null:
		return
	var radius: float = 34.0 if bool(read.get("face", false)) else 50.0
	var ring := Line2D.new()
	ring.width = 2.5
	ring.antialiased = true
	ring.z_index = 175
	ring.default_color = Color(danger.r, danger.g, danger.b, minf(danger.a + 0.12, 0.72))
	var pts := PackedVector2Array()
	for i in range(41):
		var a := TAU * float(i) / 40.0
		pts.append(Vector2(cos(a), sin(a)) * radius)
	ring.points = pts
	ring.position = dst
	_hud_layer.add_child(ring)
	_lane_forecast_nodes.append(ring)

	var cross := Line2D.new()
	cross.width = 2.0
	cross.antialiased = true
	cross.z_index = 176
	cross.default_color = Color(danger.r, danger.g, danger.b, 0.42)
	cross.points = PackedVector2Array([
		Vector2(-radius * 0.54, 0), Vector2(radius * 0.54, 0),
		Vector2(0, 0),
		Vector2(0, -radius * 0.54), Vector2(0, radius * 0.54),
	])
	cross.position = dst
	_hud_layer.add_child(cross)
	_lane_forecast_nodes.append(cross)


func _forecast_chip_text(read: Dictionary) -> String:
	var text := String(read.get("quiet_text", read.get("text", "")))
	if bool(read.get("face", false)):
		return text
	if text.begins_with("-"):
		text = "TAKES %s" % text.substr(1)
	if int(read.get("target_row", ROW_FRONT)) == ROW_BACK:
		return "BACK %s" % text
	return text


func _refresh_hand_affordability() -> void:
	# Tell every card in the hand whether the current mana pool can pay its cost.
	# Card2D handles the visual change (dim when not affordable).
	#
	# Uses _effective_cost so the dim/glow state respects active mutators
	# (Taxed bumps spell cost), Ember Crown (free first spell), and Ironclad
	# Veteran discounts. Previously read raw card_data.cost — a 1-cost spell
	# under Taxed +1 would falsely look affordable at 1 mana and then fail at
	# play time with "Not enough Command!".
	# On the opponent's turn (skirmish) the hand is locked — Card2D.hand_interactive
	# is false — so grey EVERY card rather than showing affordable-looking cards you
	# can't actually play right now. hand_interactive stays true in solo and on your
	# own turn, where per-card Command decides affordability as before.
	var hand_locked: bool = not Card2D.hand_interactive
	for card in _hand:
		if card == null or not is_instance_valid(card):
			continue
		if not card.has_method("set_affordable"):
			continue
		var eff: int = _effective_cost(card)
		card.set_affordable((not hand_locked) and player_mana >= eff)
		# Also push the effective cost into the cost orb so the orb's number
		# matches what playing the card will actually charge.
		if card.has_method("set_display_cost"):
			card.set_display_cost(eff)


func _build_targeting_arrow() -> void:
	# Hearthstone-style glowing curve from the cast source to the cursor. Lives
	# on the HUD layer so it draws above everything; hidden until targeting begins.
	_targeting_arrow = Line2D.new()
	_targeting_arrow.width = 7.0
	_targeting_arrow.default_color = Color(1.0, 0.78, 0.30, 0.95)
	_targeting_arrow.antialiased = true
	_targeting_arrow.joint_mode = Line2D.LINE_JOINT_ROUND
	_targeting_arrow.begin_cap_mode = Line2D.LINE_CAP_ROUND
	_targeting_arrow.end_cap_mode = Line2D.LINE_CAP_ROUND
	_targeting_arrow.z_index = 240
	_targeting_arrow.visible = false
	# Width taper: thick at the cursor, slim at the source, like a chargeable beam.
	var curve := Curve.new()
	curve.add_point(Vector2(0.0, 0.4))
	curve.add_point(Vector2(1.0, 1.0))
	_targeting_arrow.width_curve = curve
	# Soft gradient: warm gold body fading to orange tip for the "spell about to
	# strike" read.
	var grad := Gradient.new()
	grad.set_color(0, Color(1.0, 0.85, 0.35, 0.55))
	grad.set_color(1, Color(1.0, 0.45, 0.15, 1.0))
	_targeting_arrow.gradient = grad
	_hud_layer.add_child(_targeting_arrow)
	# Arrowhead — triangular Polygon2D rotated to face the cursor.
	_targeting_arrow_head = Polygon2D.new()
	_targeting_arrow_head.polygon = PackedVector2Array([
		Vector2(0, 0), Vector2(-22, -10), Vector2(-22, 10)
	])
	_targeting_arrow_head.color = Color(1.0, 0.40, 0.12, 1.0)
	_targeting_arrow_head.z_index = 241
	_targeting_arrow_head.visible = false
	_hud_layer.add_child(_targeting_arrow_head)
	# Prediction label — appears above the hovered target during spell targeting.
	# Shows "-N" or "LETHAL!" so the player can read the outcome before clicking.
	_prediction_label = Label.new()
	_prediction_label.add_theme_font_size_override("font_size", 36)
	_prediction_label.add_theme_color_override("font_color", Color(1.0, 0.35, 0.20))
	_prediction_label.add_theme_color_override("font_outline_color", Color(0, 0, 0, 0.95))
	_prediction_label.add_theme_constant_override("outline_size", 7)
	_prediction_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_prediction_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_prediction_label.z_index = 242
	_prediction_label.visible = false
	_hud_layer.add_child(_prediction_label)


func _show_targeting_arrow() -> void:
	if _targeting_arrow == null:
		return
	_targeting_arrow.visible = true
	_targeting_arrow_head.visible = true
	set_process(true)


func _hide_targeting_arrow() -> void:
	if _targeting_arrow == null:
		return
	_targeting_arrow.visible = false
	_targeting_arrow_head.visible = false
	if _prediction_label != null:
		_prediction_label.visible = false
	# Re-arm the cursor-static gate so the next cast rebuilds the arc at least once.
	_targeting_last_mouse = Vector2(-1.0e9, -1.0e9)
	_refresh_combat_process()


func _process(_delta: float) -> void:
	# Trail decay runs ahead of the targeting early-return so a released card's
	# ribbon still burns out while a spell is being aimed. Aim threads too —
	# a sniper's standing order stays anchored to bobbing cards throughout.
	_update_drag_trail()
	_update_aim_threads()
	if _targeting_spell != null and _targeting_arrow != null and _targeting_arrow.visible:
		# Skip the whole rebuild (bezier arc + arrowhead + damage-prediction scan)
		# when the cursor is static — the board is frozen on player input, so last
		# frame's arrow/chip still reads correctly.
		var mp := get_viewport().get_mouse_position()
		if not (is_equal_approx(mp.x, _targeting_last_mouse.x) \
				and is_equal_approx(mp.y, _targeting_last_mouse.y)):
			_targeting_last_mouse = mp
			_update_targeting_arrow()
			_update_damage_prediction()
			# Spell targeting owns the screen while active — hide the hover telegraph
			# so the two arrows never fight over the cursor.
			_hide_combat_telegraph()
		return
	_update_combat_telegraph()
	if not _combat_process_needed():
		set_process(false)


func _combat_process_needed() -> bool:
	if not _drag_trail_pts.is_empty():
		return true   # a drag ribbon is still burning down
	if not _sniper_marks.is_empty() or not _aim_thread_nodes.is_empty():
		return true   # a standing aim order needs its thread tracked/retired
	if _targeting_spell != null and _targeting_arrow != null and _targeting_arrow.visible:
		return true
	if _telegraph_arrow == null:
		return false
	if UserSettings != null and not UserSettings.combat_telegraph:
		return false
	var my_turn: bool = phase == Phase.PLAYER_TURN and Card2D.board_interactive
	var opp_turn: bool = _is_net() and not _net_match_over \
			and _net_active_index != NetMatch.local_player_index \
			and phase != Phase.RESOLVING
	return my_turn or opp_turn


func _refresh_combat_process() -> void:
	set_process(_combat_process_needed())


func _update_targeting_arrow() -> void:
	# Cubic-bezier curve from a "spell hand" anchor (bottom-center of the screen)
	# up to the cursor. Curving rather than straight reads like a thrown spell
	# rather than a laser pointer.
	var vp := get_viewport_rect().size
	var origin := Vector2(vp.x * 0.5, vp.y - 60.0)
	var target := get_viewport().get_mouse_position()
	var dir := target - origin
	# Control points bow the curve toward the source so it arcs upward — feels
	# more like a casting gesture than a laser.
	var ctrl1 := origin + Vector2(dir.x * 0.15, -180.0)
	var ctrl2 := target + Vector2(0.0, 80.0)
	var points := PackedVector2Array()
	var steps := 28
	for i in range(steps + 1):
		var t: float = float(i) / float(steps)
		var pt := _bezier_cubic(origin, ctrl1, ctrl2, target, t)
		points.append(pt)
	_targeting_arrow.points = points
	# Position + rotate the arrowhead at the tip, facing the curve's tangent.
	_targeting_arrow_head.position = target
	if points.size() >= 2:
		var tangent: Vector2 = points[points.size() - 1] - points[points.size() - 2]
		if tangent.length_squared() > 0.01:
			_targeting_arrow_head.rotation = tangent.angle()


func _bezier_cubic(p0: Vector2, p1: Vector2, p2: Vector2, p3: Vector2, t: float) -> Vector2:
	var u := 1.0 - t
	return (u * u * u) * p0 + (3.0 * u * u * t) * p1 + (3.0 * u * t * t) * p2 + (t * t * t) * p3


func _bezier_quad(p0: Vector2, p1: Vector2, p2: Vector2, t: float) -> Vector2:
	var u := 1.0 - t
	return (u * u) * p0 + (2.0 * u * t) * p1 + (t * t) * p2


func _card_center(card: Control) -> Vector2:
	# Screen-space centre of a battlefield card. Cards live in the board layer but
	# their global_position maps 1:1 onto the HUD CanvasLayer (which only carries a
	# shake offset), so this is also the correct point for HUD-parented VFX.
	return card.global_position + card.size * card.scale * 0.5


func _play_face_strike_vfx(card: Control, lane_idx: int, is_enemy: bool, power: int) -> void:
	if card == null or not is_instance_valid(card) or power <= 0:
		return
	var target_is_enemy := not is_enemy
	var target_pos := _face_lane_point(target_is_enemy, lane_idx)
	var interposer := _find_interposer(target_is_enemy)
	if interposer != null and is_instance_valid(interposer):
		target_pos = _card_center(interposer)
	var from_pos := _card_center(card)
	_play_attack_tracer(from_pos, target_pos, is_enemy,
		float(power), power >= HEAVY_HIT_DAMAGE)
	_spawn_impact_burst(target_pos, target_pos - from_pos, float(power), false)
	if _hud_layer != null and DisplayServer.get_name() != "headless":
		var col := Color(1.0, 0.42, 0.28, 0.72) if is_enemy else Color(1.0, 0.82, 0.34, 0.72)
		_spawn_vfx_ring(target_pos, col, 28.0 + float(power) * 1.6,
			1.32, 0.28, 229, 2.5, 0.52, Vector2(1.28, 0.54))


func _play_attack_tracer(from_pos: Vector2, to_pos: Vector2, attacker_is_enemy: bool,
		power: float = 2.0, heavy: bool = false, ranged: bool = false,
		col_override: Color = Color(0, 0, 0, 0)) -> void:
	# Gold = player strike, ember-red = enemy. Heavy blows get a white-hot core;
	# ranged shots draw tighter, colder lines so snipers don't read like melee.
	# `col_override` (alpha > 0) paints the line in a caller's colour instead of
	# the side default — spell delivery uses it to fly each bolt in its own
	# family's colour (S4 of docs/SPELL_FX_PLAN_20260717.md). Additive: every
	# historical call site omits it and is unchanged.
	if _hud_layer == null or DisplayServer.get_name() == "headless":
		return
	var dir := to_pos - from_pos
	if dir.length_squared() <= 1.0:
		return
	var base_col := Color(1.0, 0.42, 0.28, 0.95) if attacker_is_enemy else Color(1.0, 0.82, 0.34, 0.95)
	if ranged:
		base_col = Color(1.0, 0.58, 0.34, 0.95) if attacker_is_enemy else Color(0.76, 0.92, 1.0, 0.95)
	if col_override.a > 0.0:
		base_col = col_override
	var hot_col := Color(1.0, 0.96, 0.76, 0.94)
	var glow_col := Color(base_col.r, base_col.g, base_col.b, 0.28)
	var slash_width := clampf(5.0 + (power - 2.0) * 0.48, 4.5, 9.0)
	var mid := (from_pos + to_pos) * 0.5
	var bow := clampf(dir.length() * (0.045 if ranged else 0.085), 10.0, 38.0)
	if attacker_is_enemy:
		bow *= -1.0
	var ctrl := mid + dir.orthogonal().normalized() * bow
	var pts := PackedVector2Array()
	var steps := 18
	for i in range(steps + 1):
		pts.append(_bezier_quad(from_pos, ctrl, to_pos, float(i) / float(steps)))
	if UserSettings.reduce_motion:
		_spawn_vfx_streak(from_pos, to_pos, base_col, slash_width * 0.75, 230, 0.16)
		return
	var glow := Line2D.new()
	glow.width = slash_width * 2.15
	glow.antialiased = true
	glow.joint_mode = Line2D.LINE_JOINT_ROUND
	glow.begin_cap_mode = Line2D.LINE_CAP_ROUND
	glow.end_cap_mode = Line2D.LINE_CAP_ROUND
	glow.z_index = 229
	glow.default_color = glow_col
	glow.points = pts
	_hud_layer.add_child(glow)
	var glow_tw := glow.create_tween()
	glow_tw.tween_property(glow, "width", maxf(1.0, slash_width * 0.85),
		UserSettings.anim_time(0.18)).set_ease(Tween.EASE_IN)
	glow_tw.parallel().tween_property(glow, "modulate:a", 0.0,
		UserSettings.anim_time(0.20)).set_ease(Tween.EASE_IN)
	glow_tw.tween_callback(glow.queue_free)
	var line := Line2D.new()
	line.width = slash_width
	line.antialiased = true
	line.joint_mode = Line2D.LINE_JOINT_ROUND
	line.begin_cap_mode = Line2D.LINE_CAP_ROUND
	line.end_cap_mode = Line2D.LINE_CAP_ROUND
	line.z_index = 230
	line.default_color = base_col
	var curve := Curve.new()
	curve.add_point(Vector2(0.0, 0.3))
	curve.add_point(Vector2(1.0, 1.0))
	line.width_curve = curve
	line.points = pts
	_hud_layer.add_child(line)
	var tw := line.create_tween()
	tw.tween_interval(UserSettings.anim_time(0.035))
	tw.tween_property(line, "modulate:a", 0.0,
		UserSettings.anim_time(0.17)).set_ease(Tween.EASE_IN)
	tw.tween_callback(line.queue_free)
	if heavy or power >= HEAVY_HIT_DAMAGE:
		var core := Line2D.new()
		core.width = maxf(1.6, slash_width * 0.34)
		core.antialiased = true
		core.joint_mode = Line2D.LINE_JOINT_ROUND
		core.begin_cap_mode = Line2D.LINE_CAP_ROUND
		core.end_cap_mode = Line2D.LINE_CAP_ROUND
		core.z_index = 231
		core.default_color = hot_col
		core.points = pts
		_hud_layer.add_child(core)
		var core_tw := core.create_tween()
		core_tw.tween_property(core, "modulate:a", 0.0,
			UserSettings.anim_time(0.12)).set_ease(Tween.EASE_IN)
		core_tw.tween_callback(core.queue_free)
		_spawn_vfx_ring(to_pos, Color(base_col.r, base_col.g, base_col.b, 0.50),
			22.0 + power * 2.0, 1.26, 0.22, 228, 2.0, 0.50, Vector2(1.24, 0.54))
	if ranged:
		var n := dir.normalized()
		var side := n.orthogonal() * 9.0
		_spawn_vfx_streak(to_pos - n * 38.0 + side, to_pos,
			Color(hot_col.r, hot_col.g, hot_col.b, 0.70), 2.0, 232, 0.13, 0.0)
		_spawn_vfx_streak(to_pos - n * 38.0 - side, to_pos,
			Color(base_col.r, base_col.g, base_col.b, 0.66), 2.0, 232, 0.13, 0.0)


## THE RUBRIC — the strike-through that replaced `_play_pierce_lance` (a 2-point
## Line2D of constant width). See scripts/ui/painters/RubricStroke.gd for the
## material and for why the mark starts at the VICTIM rather than the attacker.
##
## Parented to the BOARD, not the HUD: this is a mark on the record, and nothing
## that matters in this game floats above the table. Board parentage also earns
## the lockstep shake contract for free.
##
## `receiver` may be null (the client replay has no spill target in its log, and
## piercing's terminus is the hero plate rather than a body) — it is used only to
## work out which stretch of the stroke crosses bare table.
func _play_rubric_stroke(victim: Control, end_global: Vector2, receiver: Control,
		is_pierce: bool) -> void:
	if victim == null or not is_instance_valid(victim):
		return
	var parent: Node = _board_container
	if parent == null or not is_instance_valid(parent):
		parent = self
	var stroke := RubricStroke.new()
	stroke.z_index = 232
	parent.add_child(stroke)
	var start_global: Vector2 = _card_center(victim)
	var a_local := start_global
	var b_local := end_global
	if parent is CanvasItem:
		var inv: Transform2D = (parent as CanvasItem).get_global_transform().affine_inverse()
		a_local = inv * start_global
		b_local = inv * end_global
	stroke.configure(a_local, b_local,
		hash("%d_%d_%d" % [int(victim.entity_id), round_number, 1 if is_pierce else 0]),
		is_pierce)
	# Work out which stretch of the stroke crosses BARE TABLE by sampling, rather
	# than from layout constants — a Guardian redirect can make the mark diagonal,
	# and sampling is orientation-agnostic. The core refuses to dry there; see
	# THE GUTTER RULE in the painter.
	var spans: Array = []
	var vr := Rect2(victim.global_position, victim.size * victim.scale)
	var has_r: bool = receiver != null and is_instance_valid(receiver)
	var rr := Rect2(receiver.global_position, receiver.size * receiver.scale) if has_r else Rect2()
	var in_gap := false
	var gap_from := 0.0
	for i in 41:
		var t := float(i) / 40.0
		var p := start_global.lerp(end_global, t)
		var outside: bool = not vr.has_point(p) and not (has_r and rr.has_point(p))
		if outside and not in_gap:
			in_gap = true
			gap_from = t
		elif not outside and in_gap:
			in_gap = false
			spans.append(Vector2(gap_from, t))
	if in_gap:
		spans.append(Vector2(gap_from, 1.0))
	stroke.gutter_spans = spans
	# INFORMATIONAL: the mark always plays. Reduce Motion skips the nib's TRAVEL
	# and renders the stroke complete and already dried, holding the identical
	# window — the fact still lands, the movement doesn't.
	var reduce: bool = UserSettings != null and UserSettings.reduce_motion
	if reduce:
		stroke.progress = 1.0
		stroke.dry = 1.0
	else:
		var tw := stroke.create_tween()
		# The head clears the victim's silhouette around 55 ms and only then
		# reaches the body behind. That is what sequences the two halves of the
		# event — TRAVEL, not a scheduled wait, so nothing ever sits in the
		# 100-500 ms band where a gap reads as a dropped frame.
		tw.tween_property(stroke, "progress", 1.0, Motion.time(0.07))
		tw.tween_property(stroke, "dry", 1.0, Motion.time(0.16))
	# THE HOLD, then the fade. The struck-out line stays on the record while the
	# corpse burns away underneath it — that costs nothing, it is ordering.
	var life := stroke.create_tween()
	life.tween_interval(Motion.time(0.44))
	life.tween_property(stroke, "modulate:a", 0.0, Motion.time(0.42)).set_ease(Tween.EASE_IN)
	life.tween_callback(stroke.queue_free)


func spawn_ash_burst(global_pos: Vector2, color: Color, amount: int = 26) -> void:
	# One-shot rising ember/ash burst, parented to the HUD layer so it survives the
	# source card being freed. Used by the sacrifice ritual and piercing exit spark.
	var parent: Node = _hud_layer if _hud_layer != null else self
	Motion.burst(parent, global_pos, "ash", {"color": color, "amount": amount})


func _lunge_strength(atk: int) -> float:
	# Maps a blow's size to the attacker's lunge drive (Card2D.play_attack_lunge):
	# 2 ATK or less = the historical 26px, HEAVY_HIT_DAMAGE ≈ 1.6×, capped 1.7×.
	return clampf(1.0 + (float(atk) - 2.0) * 0.2, 1.0, 1.7)


func _spawn_impact_burst(global_pos: Vector2, strike_dir: Vector2, power: float,
		lethal: bool) -> void:
	# Contact-point punctuation for a creature strike: a short spark spray at the
	# defender's struck edge, back along the line of the blow. The lunge and
	# tracer say "a strike travelled"; this says "it landed HERE". Heavier blows
	# spray harder; kills flash white-hot. Sparks fall (gravity down) where the
	# ash burst's embers rise — different material, so kills still read distinct.
	var parent: Node = _hud_layer if _hud_layer != null else self
	Motion.burst(parent, global_pos, "impact", {
		"amount": int(clampf(8.0 + power * 3.0, 8.0, 24.0)) + (10 if lethal else 0),
		"direction": -strike_dir.normalized() if strike_dir.length() > 0.01 else Vector2(0, -1),
		"velocity_max": 240.0 + power * 30.0,
		"color": Color(1.0, 0.98, 0.88) if lethal else Color(1.0, 0.86, 0.52),
	})


func _update_damage_prediction() -> void:
	# While targeting, peek at the card the cursor is over and show "-N" or
	# "LETHAL!" above it so the player can read the outcome before clicking.
	if _prediction_label == null or _targeting_data.is_empty():
		return
	var mouse_pos := get_viewport().get_mouse_position()
	var hovered_card: Control = _find_hovered_target_card(mouse_pos)
	if hovered_card == null:
		_prediction_label.visible = false
		return
	var spell := _targeting_data.get("spell", {}) as Dictionary
	var spell_type: String = spell.get("type", "")
	var custom_id: String = spell.get("id", "")
	var raw_value: int = int(spell.get("value", 0))
	# Upgraded damage spells carry a flat dmg_bonus their resolvers add — include it
	# or an upgraded Slash reads "-3" (and never "LETHAL!") while it actually hits 5.
	var plus_dmg: int = int(_targeting_data.get("dmg_bonus", 0))
	var text := ""
	var color := Color(1.0, 0.85, 0.30)
	if spell_type == "damage" or (spell_type == "custom" and custom_id in ["penance", "hex", "pillage", "fuel_the_pyre", "holy_smite", "shove", "slash", "quick_shot", "last_rites", "slow_match", "banish", "petard", "sappers_charge", "ballista_bolt"]):
		var dmg: int = _predicted_damage_against(hovered_card, spell_type, custom_id, raw_value, plus_dmg)
		if dmg <= 0:
			_prediction_label.visible = false
			return
		if dmg >= hovered_card.current_hp:
			text = "LETHAL!"
			color = Color(1.0, 0.30, 0.20)
		else:
			text = "-%d" % dmg
			color = Color(1.0, 0.40, 0.20)
	elif spell_type == "heal":
		var miss: int = int(hovered_card.card_data.get("hp", hovered_card.current_hp)) - int(hovered_card.current_hp)
		var heal: int = mini(raw_value, miss)
		text = "+%d HP" % heal
		color = Color(0.50, 1.0, 0.55)
	elif spell_type == "buff_atk":
		text = "+%d ATK" % raw_value
		color = Color(1.0, 0.85, 0.30)
	elif spell_type == "buff_hp":
		text = "+%d HP" % raw_value
		color = Color(0.55, 0.85, 1.0)
	else:
		_prediction_label.visible = false
		return
	_prediction_label.text = text
	_prediction_label.add_theme_color_override("font_color", color)
	_prediction_label.visible = true
	# Anchor above the target card's center.
	var rect := hovered_card.get_global_rect()
	# Wait until the label has measured its text so we can center it.
	_prediction_label.size = Vector2.ZERO
	_prediction_label.reset_size()
	var lbl_size: Vector2 = _prediction_label.size
	_prediction_label.position = Vector2(
		rect.get_center().x - lbl_size.x * 0.5,
		rect.position.y - lbl_size.y - 8)


func _find_hovered_target_card(pos: Vector2) -> Control:
	# Returns the first card under the cursor that matches the active spell's
	# targeting rules, or null if the cursor isn't over a valid target.
	var targeting: String = _targeting_data.get("targeting", "none")
	if targeting == "friendly_then_enemy":
		return _clicked_target_from(pos, _all_player_creatures()) \
			if _targeting_first_target == null \
			else _clicked_target_from(pos, _all_enemy_creatures())
	if targeting == "two_enemies":
		var enemy := _clicked_target_from(pos, _all_enemy_creatures())
		return null if enemy == _targeting_first_target else enemy
	if targeting == "friendly_lane" and _targeting_first_target == null:
		return _clicked_target_from(pos, _all_player_creatures())
	if targeting in ["enemy_creature", "any_creature", "any"]:
		var enemy := _clicked_target_from(pos, _all_enemy_creatures())
		if enemy != null:
			return enemy
	if targeting in ["friendly_creature", "any_creature", "any"]:
		return _clicked_target_from(pos, _all_player_creatures())
	return null


func _predicted_damage_against(card: Control, spell_type: String, custom_id: String, raw_value: int, plus_dmg: int = 0) -> int:
	# Mirror the relic / armored math from _resolve_spell so the prediction
	# matches the actual outcome. plus_dmg is the card's "+" upgrade dmg_bonus (the
	# same value each resolver below adds). Armored absorbs 1 per hit (clamped to 0).
	var spell_dmg_bonus := 0
	var spell: Dictionary = _targeting_data.get("spell", {})
	var spell_key: String = String(_targeting_data.get("id",
		spell.get("id", _targeting_data.get("name", ""))))
	if _has_relic("worn_spellbook") \
			and int(_spell_names_cast_this_fight.get(spell_key, 0)) > 0:
		spell_dmg_bonus += int(RelicDB.get_relic("worn_spellbook").get("value", 2))
	if _has_relic("powder_horn") and _powder_charges > 0:
		spell_dmg_bonus += _powder_charges \
			* int(RelicDB.get_relic("powder_horn").get("value", 2))
	if _has_relic("glowing_hand") and _is_relic_damage_spell(_targeting_data):
		spell_dmg_bonus += mini(
			int(RelicDB.get_relic("glowing_hand").get("value", 5)),
			_glowing_hand_spells_cast)
	var dmg := raw_value
	if spell_type == "damage":
		dmg += spell_dmg_bonus
	if custom_id == "penance":
		var pen_curse := false
		for hc in _hand:
			if is_instance_valid(hc) and CardDB.is_curse(hc.card_id):
				pen_curse = true
				break
		dmg = (6 if pen_curse else 2) + spell_dmg_bonus + plus_dmg
	elif custom_id == "hex":
		var has_keywords: bool = not card.card_data.get("keywords", []).is_empty() or card.state.has_shield
		dmg = (4 if has_keywords else 1) + spell_dmg_bonus + plus_dmg
	elif custom_id == "pillage":
		dmg = 2 + spell_dmg_bonus + plus_dmg
	elif custom_id == "shove":
		# Flank-push physics: predict the crash. Direction mirrors _flank_push
		# (lanes 0-1 left, 2-3 right); a blocked or edge-bound shove deals 2.
		var push_dir: int = -1 if card.current_lane <= 1 else 1
		var push_dest: int = card.current_lane + push_dir
		var push_blocked: bool = push_dest < 0 or push_dest >= LANES_PER_ROW \
			or _row_array(true, card.current_row)[push_dest] != null
		dmg = (plus_dmg + spell_dmg_bonus if plus_dmg > 0 else 0) \
			+ (2 if push_blocked else 0)
		# Upgraded shove on a blocked target is TWO hits — Armored absorbs from
		# each, and the shared adjust below only covers one of them.
		if plus_dmg > 0 and push_blocked \
				and card.has_method("has_keyword") and card.has_keyword("armored"):
			dmg -= 1
	elif custom_id == "slash":
		var can_blast_move: bool = card.current_row == ROW_FRONT \
			and _row_array(true, ROW_BACK)[card.current_lane] == null
		dmg = 2 + spell_dmg_bonus + plus_dmg + (0 if can_blast_move else 2)
	elif custom_id == "quick_shot":
		dmg = 1 + spell_dmg_bonus + plus_dmg
	elif custom_id == "slow_match":
		# Base 2 + the banked fuse — the hover must show the TRUE hit
		# (card-honesty rule; the fuse charge is otherwise invisible).
		dmg = 2 + int(_targeting_data.get("fuse", 0)) + spell_dmg_bonus + plus_dmg
	elif custom_id == "petard":
		dmg = 5 + spell_dmg_bonus + plus_dmg
	elif custom_id == "sappers_charge":
		# The bomb's payload rides the THROWN neighbours (crash 4, "+" 6) — the
		# body it lands on only takes the 1-damage scorch shown here.
		dmg = 1 + spell_dmg_bonus
	elif custom_id == "ballista_bolt":
		dmg = 5 + spell_dmg_bonus + plus_dmg
	elif custom_id == "fuel_the_pyre":
		dmg = 999  # Kills target outright (sets up "LETHAL!" automatically)
	elif custom_id == "last_rites":
		# Morbid: 3 base, 6 once a friendly has fallen this fight.
		dmg = (6 if _friendly_deaths_this_fight > 0 else 3) + spell_dmg_bonus + plus_dmg
	elif custom_id == "holy_smite":
		# Equal to the target's missing HP — full creature takes nothing.
		dmg = maxi(3, int(card.card_data.get("hp", card.current_hp)) - int(card.current_hp)) \
			+ spell_dmg_bonus + plus_dmg
	elif custom_id == "banish":
		var limit: int = 4 + plus_dmg
		dmg = card.current_hp if card.current_hp <= limit else limit
	var banish_exiles: bool = custom_id == "banish" and card.current_hp <= 4 + plus_dmg
	if custom_id != "hex" and not banish_exiles and card.has_method("has_keyword") and card.has_keyword("armored"):
		# Match Card2D.take_damage: Armored floors damage at 1, never fully negates,
		# so the lethal/non-lethal read can't disagree with the actual hit.
		dmg = maxi(1, dmg - 1)
	return dmg


# ─────────────────────────────────────────────────────────────────────────────
#  COMBAT TELEGRAPH — hover a battlefield creature to read its NEXT attack.
#  Normal columns, Swift, Sniper, Hydra/Charge, face interception and the live
#  damage/status stack each have a forecast branch. This is deliberately not a
#  claim about the final board after the entire ordered clash and death cascade.
# ─────────────────────────────────────────────────────────────────────────────

func _build_combat_telegraph() -> void:
	# A slimmer cousin of the spell targeting arrow — quieter ink so it reads as
	# a "preview" rather than an active cast. Parented to the HUD layer; cards
	# live in the board layer but map 1:1 onto it (see _card_center).
	_telegraph_arrow = Line2D.new()
	_telegraph_arrow.width = 4.0
	_telegraph_arrow.antialiased = true
	_telegraph_arrow.joint_mode = Line2D.LINE_JOINT_ROUND
	_telegraph_arrow.begin_cap_mode = Line2D.LINE_CAP_ROUND
	_telegraph_arrow.end_cap_mode = Line2D.LINE_CAP_ROUND
	_telegraph_arrow.z_index = 235
	_telegraph_arrow.visible = false
	var grad := Gradient.new()
	grad.set_color(0, Color(0.95, 0.80, 0.42, 0.30))
	grad.set_color(1, Color(0.96, 0.50, 0.22, 0.92))
	_telegraph_arrow.gradient = grad
	_hud_layer.add_child(_telegraph_arrow)
	_telegraph_head = Polygon2D.new()
	_telegraph_head.polygon = PackedVector2Array([
		Vector2(0, 0), Vector2(-16, -7), Vector2(-16, 7)
	])
	_telegraph_head.color = Color(0.96, 0.46, 0.18, 0.95)
	_telegraph_head.z_index = 236
	_telegraph_head.visible = false
	_hud_layer.add_child(_telegraph_head)
	_telegraph_chip = Label.new()
	_telegraph_chip.add_theme_font_size_override("font_size", 26)
	if GameTheme.font_title != null:
		_telegraph_chip.add_theme_font_override("font", GameTheme.font_title)
	_telegraph_chip.add_theme_color_override("font_outline_color", Color(0, 0, 0, 0.95))
	_telegraph_chip.add_theme_constant_override("outline_size", 6)
	_telegraph_chip.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_telegraph_chip.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_telegraph_chip.z_index = 237
	_telegraph_chip.visible = false
	_hud_layer.add_child(_telegraph_chip)
	# Stat-provenance caption — quieter than the outcome chip (it's reference
	# ink, not a verdict), parchment ivory so it reads apart from the gold/red
	# stat tints it explains. Signs carry the direction, not colour.
	_telegraph_stat_line = Label.new()
	_telegraph_stat_line.add_theme_font_size_override("font_size", 18)
	if GameTheme.font_title != null:
		_telegraph_stat_line.add_theme_font_override("font", GameTheme.font_title)
	_telegraph_stat_line.add_theme_color_override("font_color", Color(0.95, 0.90, 0.78))
	_telegraph_stat_line.add_theme_color_override("font_outline_color", Color(0, 0, 0, 0.95))
	_telegraph_stat_line.add_theme_constant_override("outline_size", 5)
	_telegraph_stat_line.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_telegraph_stat_line.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_telegraph_stat_line.z_index = 237
	_telegraph_stat_line.visible = false
	_hud_layer.add_child(_telegraph_stat_line)
	_refresh_combat_process()


func _hide_combat_telegraph() -> void:
	_telegraph_hovered = null
	if _telegraph_arrow != null:
		_telegraph_arrow.visible = false
	if _telegraph_head != null:
		_telegraph_head.visible = false
	if _telegraph_chip != null:
		_telegraph_chip.visible = false
	if _telegraph_stat_line != null:
		_telegraph_stat_line.visible = false


func _update_combat_telegraph() -> void:
	# Shows during the player's own turn (solo or net) AND — in a net match — during
	# the OPPONENT's turn, so the player can read the incoming strike before it lands
	# the same way they preview their own. Respects the setting; skip while dragging a
	# card (the drop preview owns the cursor).
	if _telegraph_arrow == null:
		return
	if (UserSettings != null and not UserSettings.combat_telegraph) \
			or Card2D._any_card_dragging:
		_telegraph_last_mouse = Vector2(-1.0e9, -1.0e9)
		_hide_combat_telegraph()
		return
	# My own active turn — the historical gate (solo play and my own net turn both
	# satisfy board_interactive + PLAYER_TURN).
	var my_turn: bool = phase == Phase.PLAYER_TURN and Card2D.board_interactive
	# The opponent's net turn: my board is locked, but the forward read stays useful
	# while they develop. Drop it once the clash actually resolves (the host flips to
	# RESOLVING; the client never does, so its coarse v1 animation keeps a live read).
	var opp_turn: bool = _is_net() and not _net_match_over \
			and _net_active_index != NetMatch.local_player_index \
			and phase != Phase.RESOLVING
	if not (my_turn or opp_turn):
		_telegraph_last_mouse = Vector2(-1.0e9, -1.0e9)
		_hide_combat_telegraph()
		return
	var mouse_pos := get_viewport().get_mouse_position()
	# Skip the entire recompute (hover-scan + strike prediction + curve rebuild) if
	# the cursor hasn't moved since we last resolved — last frame's arrow/chip/hidden
	# state is still correct. The opponent's net turn mutates the board without my
	# cursor, so it always recomputes (the reset above re-arms us on every turn flip).
	if not opp_turn \
			and is_equal_approx(mouse_pos.x, _telegraph_last_mouse.x) \
			and is_equal_approx(mouse_pos.y, _telegraph_last_mouse.y):
		return
	_telegraph_last_mouse = mouse_pos
	var hovered := _find_hovered_battlefield_creature(mouse_pos)
	if hovered == null:
		_hide_combat_telegraph()
		return
	_telegraph_hovered = hovered
	# Stat provenance rides the same hover, independent of whether a strike
	# resolves — a frozen veteran's breakdown is still worth reading.
	_update_stat_provenance(hovered)
	# Resolve who this creature would strike, and the outcome of that strike.
	var read := _predict_lane_strike(hovered)
	if read.is_empty():
		# Nothing to hit this turn (can't attack, or no target + no open column).
		# Hide only the strike read — the provenance caption stays with the hover.
		_telegraph_arrow.visible = false
		_telegraph_head.visible = false
		_telegraph_chip.visible = false
		return
	var timing_caveat := _forecast_hover_timing_caveat(hovered)
	if timing_caveat != "":
		# The card-level calculation remains useful, but do not present it as a
		# guaranteed final result when an earlier/random beat can retarget it.
		read["text"] = String(read.get("text", "")) + "\n" + timing_caveat
	var dst: Vector2 = read["point"]
	if bool(read.get("summary", false)):
		# Multi-target attacks have no honest single arrow. Seat the aggregate
		# above the source instead of pointing at one false target.
		_telegraph_arrow.visible = false
		_telegraph_head.visible = false
		_telegraph_chip.text = read["text"]
		_telegraph_chip.add_theme_color_override("font_color", read["color"])
		_telegraph_chip.visible = true
		_telegraph_chip.size = Vector2.ZERO
		_telegraph_chip.reset_size()
		var summary_size: Vector2 = _telegraph_chip.size
		var summary_src := _card_center(hovered)
		var summary_vp := get_viewport().get_visible_rect().size
		_telegraph_chip.position = Vector2(
			clampf(summary_src.x - summary_size.x * 0.5,
				8.0, maxf(8.0, summary_vp.x - summary_size.x - 8.0)),
			maxf(8.0, hovered.global_position.y - summary_size.y - 18.0))
		return
	if bool(read.get("face", false)):
		# Face reads use the lane-local breakthrough marker from the quiet forecast.
		# The loud hover layer only adds the outcome chip; no arrow to the HUD.
		_telegraph_arrow.visible = false
		_telegraph_head.visible = false
		_telegraph_chip.text = read["text"]
		_telegraph_chip.add_theme_color_override("font_color", read["color"])
		_telegraph_chip.visible = true
		_telegraph_chip.size = Vector2.ZERO
		_telegraph_chip.reset_size()
		var face_lbl_size: Vector2 = _telegraph_chip.size
		_telegraph_chip.position = Vector2(
			dst.x - face_lbl_size.x * 0.5, dst.y - face_lbl_size.y - 28)
		return

	var src := _card_center(hovered)
	# Slim curved arrow source→target so it reads as a thrown blow, not a ruler.
	var mid := (src + dst) * 0.5 + Vector2(0, -36)
	var points := PackedVector2Array()
	var steps := 20
	for i in range(steps + 1):
		var t: float = float(i) / float(steps)
		points.append(_bezier_quad(src, mid, dst, t))
	_telegraph_arrow.points = points
	_telegraph_arrow.visible = true
	_telegraph_head.position = dst
	if points.size() >= 2:
		var tangent: Vector2 = points[points.size() - 1] - points[points.size() - 2]
		if tangent.length_squared() > 0.01:
			_telegraph_head.rotation = tangent.angle()
	_telegraph_head.visible = true
	# Outcome chip, anchored above the target point.
	_telegraph_chip.text = read["text"]
	_telegraph_chip.add_theme_color_override("font_color", read["color"])
	_telegraph_chip.visible = true
	_telegraph_chip.size = Vector2.ZERO
	_telegraph_chip.reset_size()
	var lbl_size: Vector2 = _telegraph_chip.size
	_telegraph_chip.position = Vector2(dst.x - lbl_size.x * 0.5, dst.y - lbl_size.y - 22)


func _update_stat_provenance(hovered: Control) -> void:
	# Show WHERE a token's live stats came from whenever they differ from the
	# printed (as-drawn, run-mods folded) card — the gold/red tint says "changed",
	# this says "from what, and for how long". Skipped in net: the client's
	# snapshot pre-folds every buff into one atk number, so the decomposition
	# below would be fiction there (the tint/caret still mark changed stats).
	if _telegraph_stat_line == null:
		return
	if _is_net():
		_telegraph_stat_line.visible = false
		return
	var txt := _stat_provenance_text(hovered)
	if txt == "":
		_telegraph_stat_line.visible = false
		return
	_telegraph_stat_line.text = txt
	_telegraph_stat_line.visible = true
	_telegraph_stat_line.size = Vector2.ZERO
	_telegraph_stat_line.reset_size()
	var sz: Vector2 = _telegraph_stat_line.size
	# Under the token (the outcome chip owns the space above the target); flip
	# above when the token sits at the screen's bottom edge. Clamped on-screen.
	var bottom: float = hovered.global_position.y + hovered.size.y * hovered.scale.y
	var pos := Vector2(_card_center(hovered).x - sz.x * 0.5, bottom + 6.0)
	var vp: Vector2 = get_viewport().get_visible_rect().size
	if pos.y + sz.y > vp.y - 8.0:
		pos.y = hovered.global_position.y - sz.y - 6.0
	pos.x = clampf(pos.x, 8.0, vp.x - sz.x - 8.0)
	_telegraph_stat_line.position = pos


func _stat_provenance_text(c: Control) -> String:
	# One line per stat that differs from the printed card, empty when nothing
	# does. ATK decomposes into the buckets Card2D actually tracks:
	#   current_atk − printed  → "this fight" (rally/ramps/debuffs — permanent)
	#   persistent_atk_buff    → timed ("for N rounds"); ≥99 rounds is the
	#                            "rest of this fight" idiom → fight bucket;
	#                            1 round left reads as "this round"
	#   adj_atk_buff           → "Adj. Buff" (live while the neighbour stands)
	#   temp_atk_buff          → "this round"
	# Durations follow COPY_STYLE §5; signs carry direction per §2.
	var printed_atk: int = int(c.card_data.get("atk", c.current_atk))
	var lines: PackedStringArray = []
	var shown_atk: int = c.effective_atk()
	if shown_atk != printed_atk:
		var fight: int = int(c.current_atk) - printed_atk
		var round_d: int = int(c.temp_atk_buff)
		var timed := ""
		var pers: int = int(c.persistent_atk_buff)
		if pers != 0:
			if int(c.persistent_atk_buff_rounds) >= 99:
				fight += pers
			elif int(c.persistent_atk_buff_rounds) <= 1:
				round_d += pers
			else:
				timed = "%+d for %d rounds" % [pers, int(c.persistent_atk_buff_rounds)]
		var comps: PackedStringArray = []
		if fight != 0:
			comps.append("%+d this fight" % fight)
		if int(c.adj_atk_buff) != 0:
			comps.append("%+d Adj. Buff" % int(c.adj_atk_buff))
		# Relic ATK is named rather than folded. Before 2026-07-28 these six terms
		# were added outside Card2D entirely, so they appeared in NO bucket and the
		# decomposition silently failed to sum to the number above it.
		if int(c.relic_atk_buff) != 0:
			comps.append("%+d relics" % int(c.relic_atk_buff))
		if timed != "":
			comps.append(timed)
		if round_d != 0:
			comps.append("%+d this round" % round_d)
		var line := "ATK %d — printed %d" % [shown_atk, printed_atk]
		if not comps.is_empty():
			line += " · " + " · ".join(comps)
		lines.append(line)
	# HP against the LIVE max (card_data.hp — in-fight +HP buffs raise it), the
	# number heal decisions need. "of" not "/" so it can't misread as a fraction
	# of something else at caption size.
	var max_hp: int = int(c.card_data.get("hp", c.current_hp))
	if int(c.current_hp) != max_hp:
		lines.append("HP %d of %d" % [int(c.current_hp), max_hp])
	return "\n".join(lines)


func _find_hovered_battlefield_creature(pos: Vector2) -> Control:
	# Any living creature on either side under the cursor. Both sides are valid
	# so the player can also read what the enemy line will do to them.
	for c in _all_creatures_both_sides():
		if c == null or not is_instance_valid(c):
			continue
		if c.current_hp <= 0:
			continue
		if _is_click_on_card(pos, c):
			return c
	return null


func _forecast_hover_timing_caveat(attacker: Control) -> String:
	if attacker == null or not is_instance_valid(attacker):
		return ""
	# Random/moving enemy intents resolve before combat. Their exact post-intent
	# board cannot honestly be represented by a pre-commit static arrow.
	if not _is_net() and phase == Phase.PLAYER_TURN:
		for source in _all_enemy_creatures():
			var intent: String = String(source.state.current_intent)
			if intent == "SUMMON":
				return "SUMMON RESOLVES FIRST - TARGET MAY CHANGE"
			if intent == "ABILITY":
				var ability_type: String = String(source.card_data.get("ability", {}).get("type", ""))
				if ability_type not in ["warcry", "steal_command", "curse", "heal_all"]:
					return "ABILITY RESOLVES FIRST - OUTCOME MAY CHANGE"
	# A back-row attacker follows its own front line. If that earlier body can
	# alter the same target, show the ordering caveat instead of overpromising.
	if int(attacker.current_row) == ROW_BACK:
		var front_ally = _row_array(bool(attacker.is_opponent), ROW_FRONT)[int(attacker.current_lane)]
		if front_ally != null and is_instance_valid(front_ally) \
				and _forecast_attacker_can_strike(front_ally) \
				and (_is_swift_attacker(front_ally) \
					or not _is_sniper(front_ally, bool(front_ally.is_opponent), ROW_FRONT)):
			return "FRONT LINE STRIKES FIRST - TARGET MAY CHANGE"
	# Swift removes casualties before the main clash. A non-Swift body opposite
	# an eligible Swift attacker may never reach the forecasted hit.
	if not _is_swift_attacker(attacker):
		var opp_is_enemy: bool = not bool(attacker.is_opponent)
		for row in [ROW_FRONT, ROW_BACK]:
			var swift_foe = _row_array(opp_is_enemy, row)[int(attacker.current_lane)]
			if swift_foe != null and is_instance_valid(swift_foe) \
					and _is_swift_attacker(swift_foe) \
					and _forecast_attacker_can_strike(swift_foe):
				return "SWIFT STRIKES FIRST - OUTCOME MAY CHANGE"
	return ""


func _predict_lane_strike(attacker: Control) -> Dictionary:
	# Forecast the hovered creature's NEXT attack action. Other Swift strikes,
	# deaths and random ABILITY intents can still alter later clash beats; this
	# function does not pretend a static hover is a full combat simulator.
	if not _forecast_attacker_can_strike(attacker):
		return {}
	var is_enemy: bool = bool(attacker.is_opponent)
	var lane: int = int(attacker.current_lane)
	if lane < 0 or lane >= LANES_PER_ROW:
		return {}
	var atk: int = _forecast_attack_power(attacker, lane, is_enemy)
	# Swift owns the next action and uses its same-column routine. A Swift
	# Sniper/Hydra is spent there before the later special phase can see it.
	if not _is_swift_attacker(attacker):
		if _is_sniper(attacker, is_enemy, int(attacker.current_row)):
			return _forecast_sniper_strike(attacker, atk, lane, is_enemy)
		if attacker.card_data.get("passive", "") == "attacks_all_lanes" \
				or bool(attacker.state.charges_this_turn):
			return _forecast_sweep_strike(attacker, atk, lane, is_enemy)
		if attacker.card_data.get("passive", "") == "siege":
			var siege_opp: bool = not is_enemy
			var siege_front = _row_array(siege_opp, ROW_FRONT)[lane]
			var siege_back = _row_array(siege_opp, ROW_BACK)[lane]
			if siege_front != null or siege_back != null:
				var blocker: Control = siege_front if siege_front != null else siege_back
				return {
					"point": _card_center(blocker), "text": "BLOCKED - NO STRIKE",
					"quiet_text": "BLOCKED", "color": Color(0.72, 0.76, 0.82),
					"face": false, "damage": 0, "target_row": blocker.current_row,
				}
			return _forecast_append_repeats(
				_forecast_face_strike(attacker, atk, lane, is_enemy, true),
				attacker, is_enemy)
	return _forecast_column_strike(attacker, atk, lane, is_enemy,
		"swift" if _is_swift_attacker(attacker) else "standard")


func _forecast_attack_power(attacker: Control, lane: int, is_enemy: bool) -> int:
	var atk: int = _effective_attack(attacker, lane, is_enemy)
	# Announced solo intents have not mutated the board during planning yet.
	if not _is_net() and is_enemy and phase == Phase.PLAYER_TURN:
		var intent: String = String(attacker.state.current_intent)
		if intent == "CHARGE":
			atk += 1
		elif intent == "ENRAGE":
			atk += 2
		for ally in _adjacent_in_row(true, int(attacker.current_row), lane):
			if String(ally.state.current_intent) == "RALLY":
				atk += 1
		# ABILITY: warcry spends the source's attack but buffs the rest first.
		for source in _all_enemy_creatures():
			if String(source.state.current_intent) != "ABILITY":
				continue
			var ability: Dictionary = source.card_data.get("ability", {})
			if String(ability.get("type", "")) == "warcry":
				atk += int(ability.get("value", 1))
	return maxi(0, atk)


func _forecast_column_strike(attacker: Control, atk: int, lane: int,
		is_enemy: bool, kind: String) -> Dictionary:
	var opp_is_enemy := not is_enemy
	var opp_front = _row_array(opp_is_enemy, ROW_FRONT)[lane]
	var opp_back = _row_array(opp_is_enemy, ROW_BACK)[lane]
	var target: Control = null
	if opp_front != null and is_instance_valid(opp_front) and opp_front.current_hp > 0:
		target = _redirect_target(opp_front, opp_is_enemy, lane, ROW_FRONT, attacker)
	elif opp_back != null and is_instance_valid(opp_back) and opp_back.current_hp > 0 \
			and not opp_back.has_keyword("structure"):
		target = _redirect_target(opp_back, opp_is_enemy, lane, ROW_BACK, attacker)
	if target == null or not is_instance_valid(target):
		# THE RUSH RULE HAS TO BE FORECAST TOO. Without this the lane read for a
		# Swift body in its arrival round promised real face damage ("FOE HP -4 -
		# 26 LEFT") that _creature_hits_face then refused — the UI stating a number
		# the rules will not honour, which is the textbook "is this broken?".
		# Worded in the grey refusal voice this layer already owns (see
		# _predict_lane_strike's Siege Golem read, which was its only user).
		if not _can_reach_face(attacker):
			return {
				"point": _card_center(attacker), "text": "HELD - NO FACE THIS ROUND",
				"quiet_text": "HELD", "color": Color(0.72, 0.76, 0.82),
				"face": false, "damage": 0,
			}
		var face_read := _forecast_face_strike(attacker, atk, lane, is_enemy, true)
		# Cleave still splashes around the empty struck seat after a face hit.
		if kind == "standard" and attacker.card_data.get("passive", "") == "cleave":
			var face_cleave := _forecast_cleave_summary(null, opp_is_enemy, lane)
			if face_cleave != "":
				face_read["text"] += "\n" + face_cleave
		return _forecast_append_repeats(face_read, attacker, is_enemy)
	var read := _forecast_creature_impact(attacker, target, atk, lane, is_enemy, kind)
	# Cleave is a rider on the normal column resolver; the Swift routine does not
	# fire it on the pre-phase hit.
	if kind == "standard" and attacker.card_data.get("passive", "") == "cleave":
		var cleave_summary := _forecast_cleave_summary(target, opp_is_enemy, lane)
		if cleave_summary != "":
			read["text"] += "\n" + cleave_summary
	return _forecast_append_repeats(read, attacker, is_enemy)


func _forecast_sniper_strike(attacker: Control, atk: int, lane: int,
		is_enemy: bool) -> Dictionary:
	# Take Aim: an OWN sniper under a standing order forecasts its quarry. A
	# foe's order is never read here — their aim is hidden information, the
	# same rule as their hand (net: the host holds client marks it must not show).
	var target: Control = null
	var aimed := false
	if not is_enemy:
		target = _sniper_mark_target(attacker)
		aimed = target != null
	if target == null:
		target = _forecast_sniper_pick_lowest(not is_enemy)
	if target == null:
		var face_read := _forecast_face_strike(attacker, atk, lane, is_enemy, false)
		if _doubled_hour[1 if is_enemy else 0]:
			face_read["text"] += "\nSECOND VOLLEY LATER"
		return face_read
	var read := _forecast_creature_impact(attacker, target, atk, lane, is_enemy, "sniper")
	if aimed:
		read["text"] = "AIMED\n" + String(read.get("text", ""))
	var target_lethal: bool = bool(read.get("lethal", false))
	var rescue_text: String = String(read.get("rescue", ""))
	var attacker_survives: bool = bool(read.get("attacker_survives", true))
	if target_lethal and rescue_text.is_empty() and attacker_survives:
		read["text"] += "\nCHAINS ON KILL"
		read["quiet_text"] = String(read.get("quiet_text", read["text"])) + " - CHAIN"
	if _doubled_hour[1 if is_enemy else 0] and attacker_survives:
		read["text"] += "\nSECOND VOLLEY LATER"
	elif bool(attacker.state.battle_order_second_strike) \
			and attacker_survives:
		read["text"] += "\nSECOND VOLLEY — RAIN OF BLOWS"
	return read


func _forecast_append_repeats(read: Dictionary, attacker: Control,
		is_enemy: bool) -> Dictionary:
	if not bool(read.get("attacker_survives", true)):
		return read
	if attacker.card_data.get("passive", "") == "attacks_twice":
		read["text"] += "\nFLANK BLOW LATER"
	if _doubled_hour[1 if is_enemy else 0]:
		read["text"] += "\nSTRIKES AGAIN LATER"
	elif bool(attacker.state.battle_order_second_strike) \
			and attacker.card_data.get("passive", "") != "attacks_twice":
		read["text"] += "\nSTRIKES AGAIN — RAIN OF BLOWS"
	return read


func _forecast_sniper_pick_lowest(target_is_enemy: bool) -> Control:
	# Intent HEAL / heal-all resolve before the ranged phase, so target selection
	# must compare the HP the Sniper will actually see rather than today's number.
	var best: Control = null
	var best_hp := 1 << 30
	for row in [ROW_FRONT, ROW_BACK]:
		for lane in range(LANES_PER_ROW):
			var card = _row_array(target_is_enemy, row)[lane]
			if card == null or not is_instance_valid(card) or card.current_hp <= 0 \
					or card.has_keyword("structure"):
				continue
			var projected_hp := _forecast_projected_hp(card)
			if best == null or projected_hp < best_hp:
				best = card
				best_hp = projected_hp
	return best


func _forecast_sweep_strike(attacker: Control, atk: int, lane: int,
		is_enemy: bool) -> Dictionary:
	var targets: Array = _all_player_creatures() if is_enemy else _all_enemy_creatures()
	var live: Array = []
	for target in targets:
		if target != null and is_instance_valid(target) and target.current_hp > 0:
			live.append(target)
	if live.is_empty():
		return _forecast_append_repeats(
			_forecast_face_strike(attacker, atk, lane, is_enemy, false),
			attacker, is_enemy)
	var died := 0
	var saved := 0
	var veiled := 0
	var shields := 0
	var hurt := 0
	var total_damage := 0
	for target in live:
		var impact := _forecast_creature_impact(attacker, target, atk, lane, is_enemy, "sweep")
		total_damage += int(impact.get("damage", 0))
		if bool(impact.get("shield_break", false)):
			shields += 1
		elif String(impact.get("rescue", "")).begins_with("PHANTOM VEIL"):
			veiled += 1
		elif String(impact.get("rescue", "")) != "" or bool(impact.get("last_stand", false)):
			saved += 1
		elif bool(impact.get("lethal", false)):
			died += 1
		elif int(impact.get("damage", 0)) > 0:
			hurt += 1
	var clauses := PackedStringArray()
	if died > 0: clauses.append("%d DIE" % died)
	if saved > 0: clauses.append("%d SURVIVE" % saved)
	if veiled > 0: clauses.append("%d MAY BE VEILED" % veiled)
	if shields > 0: clauses.append("%d SHIELD" % shields)
	if hurt > 0: clauses.append("%d HURT" % hurt)
	var is_hydra: bool = attacker.card_data.get("passive", "") == "attacks_all_lanes"
	var text := "HITS ALL %d" % live.size()
	if not clauses.is_empty():
		text += " - " + " - ".join(clauses)
	# Recoil is sequential, so model Shield / Armored / Last Stand per hit.
	var source_state := _forecast_card_state(attacker)
	var recoil_total := 0
	for target in live:
		if int(source_state["hp"]) <= 0:
			break
		var recoil: int = _forecast_attack_power(target, int(target.current_lane), bool(target.is_opponent)) \
			if is_hydra else 1
		if recoil <= 0:
			continue
		var before: int = int(source_state["hp"])
		_forecast_apply_damage_state(attacker, source_state, recoil, false)
		recoil_total += maxi(0, before - maxi(int(source_state["hp"]), 0))
	var source_survives := true
	if bool(source_state.get("last_stand", false)):
		text += "\nTAKES %d BACK - LAST STAND" % recoil_total
	elif int(source_state["hp"]) <= 0:
		var source_rescue := _forecast_creature_rescue(attacker)
		if source_rescue != "":
			text += "\nTAKES %d BACK - ATTACKER %s" % [recoil_total, source_rescue]
			source_survives = source_rescue == "REBORN" \
				or source_rescue.begins_with("PHANTOM VEIL")
		else:
			var source_followup := _forecast_death_followup(attacker)
			text += "\nTAKES %d BACK - ATTACKER %s" % [recoil_total,
				source_followup if source_followup != "" else "DIES"]
			source_survives = false
	elif recoil_total > 0:
		text += "\nTAKES %d BACK - %d HP" % [recoil_total, int(source_state["hp"])]
	elif bool(source_state.get("shield_break", false)):
		text += "\nRECOIL BREAKS SHIELD"
	var read := {
		"point": _card_center(attacker), "text": text,
		"quiet_text": "HITS ALL %d" % live.size(),
		"color": Color(1.0, 0.55, 0.28), "face": false, "summary": true,
		"damage": total_damage, "target_count": live.size(), "targets": live,
		"attacker_survives": source_survives,
	}
	return _forecast_append_repeats(read, attacker, is_enemy)


func _forecast_face_strike(attacker: Control, atk: int, lane: int,
		is_enemy: bool, use_column_rules: bool) -> Dictionary:
	var target_is_enemy := not is_enemy
	var dmg := atk
	if use_column_rules:
		if is_enemy and _encounter_passive == "harpy_swift_face" \
				and attacker.has_keyword("swift"):
			dmg += 1
		dmg = maxi(0, dmg - _get_wall_reduction(lane, target_is_enemy))
	var interposer := _find_interposer(target_is_enemy)
	if interposer != null and is_instance_valid(interposer):
		var caught := _forecast_creature_impact(attacker, interposer, dmg, lane,
			is_enemy, "interpose")
		caught["text"] = "INTERPOSES - " + String(caught["text"])
		caught["quiet_text"] = "INTERPOSES"
		return caught
	if not is_enemy and _has_relic("pyre_stoker") and _cards_played_this_turn >= 3 \
			and dmg > 0:
		dmg += int(RelicDB.get_relic("pyre_stoker").get("value", 1))
	var hp_before: int = enemy_hp if target_is_enemy else player_hp
	var hp_after: int = hp_before - dmg
	var text := ""
	var color := Color(1.0, 0.40, 0.20) if target_is_enemy else Color(1.0, 0.55, 0.30)
	if dmg <= 0:
		text = "NO FACE DAMAGE"
		color = Color(0.86, 0.83, 0.74)
	elif hp_after <= 0 and not target_is_enemy and _has_relic("phoenix_heart") \
			and not RunState.phoenix_heart_consumed:
		text = "PHOENIX HEART - 1 HP"
		color = Color(1.0, 0.85, 0.30)
	elif hp_after <= 0:
		text = "LETHAL" if target_is_enemy else "DEFEAT"
		color = Color(1.0, 0.32, 0.22)
	else:
		text = "%s -%d - %d LEFT" % ["FOE HP" if target_is_enemy else "YOUR HP", dmg, hp_after]
	return {
		"point": _face_lane_point(target_is_enemy, lane), "text": text,
		"quiet_text": "HP -%d" % dmg, "color": color, "face": true,
		"damage": dmg, "hp_after": 1 if text.begins_with("PHOENIX") else hp_after,
		"lane": lane, "target_is_enemy": target_is_enemy,
	}


func _forecast_creature_impact(attacker: Control, target: Control, base_atk: int,
		lane: int, attacker_is_enemy: bool, kind: String) -> Dictionary:
	var atk := base_atk
	# Swift applies vulnerability but its live branch does not apply Royal Guard
	# protection or Archlich's floor. Standard and Sniper apply all three.
	if kind in ["standard", "swift", "sniper", "sweep"]:
		if bool(target.state.marked):
			atk += 2
		if bool(target.state.enrage_vulnerable) \
				or (not _is_net() and target.is_opponent and phase == Phase.PLAYER_TURN \
					and String(target.state.current_intent) == "ENRAGE"):
			atk += 1
	if kind in ["standard", "swift", "sniper", "sweep"]:
		atk = maxi(0, atk)
		if atk > 0 and _has_adjacent_royal_guard(target):
			atk = maxi(1, atk - 1)
		if _encounter_passive == "archlich_immortal" and not attacker_is_enemy \
				and _forecast_projected_hp(target) - atk < 1:
			atk = maxi(0, _forecast_projected_hp(target) - 1)
	var state := _forecast_card_state(target)
	_forecast_apply_damage_state(target, state, atk, false)
	var poisonous: bool = kind in ["standard", "swift", "sniper", "sweep"] \
		and (attacker.has_keyword("poison") \
			or _virulence_active[1 if attacker_is_enemy else 0])
	var poison_lands := false
	if poisonous and int(state["hp"]) > 0:
		poison_lands = int(state.get("damage", 0)) > 0
	if poison_lands:
		state["hp"] = 0
		state["lethal"] = true
		state["poison"] = true
		state["last_stand"] = false
	var rescue := _forecast_creature_rescue(target) if bool(state.get("lethal", false)) else ""
	var death_followup := _forecast_death_followup(target) \
		if bool(state.get("lethal", false)) and rescue == "" else ""
	var text := _forecast_impact_text(state, rescue)
	if death_followup == "RETURNS TO HAND":
		text = death_followup
	elif death_followup != "":
		text += "\n" + death_followup
	var hit_gain := 0
	if kind in ["standard", "sniper"] and int(state["hp"]) > 0 and atk > 0:
		if target.card_data.get("passive", "") == "royal_guard":
			hit_gain = 2 if bool(target.card_data.get("is_upgraded", false)) else 1
		elif target.card_data.get("passive", "") == "rage_on_hit":
			hit_gain = 3 if bool(target.card_data.get("is_upgraded", false)) else 2
		if hit_gain > 0:
			text += "\nGAINS +%d ATK" % hit_gain
	var counter_gain := hit_gain
	if bool(state.get("shield_break", false)) \
			and target.card_data.get("passive", "") == "shield_rage":
		var shield_gain: int = 3 if bool(target.card_data.get("is_upgraded", false)) else 2
		text += "\nGAINS +%d ATK" % shield_gain
		counter_gain += shield_gain
	if bool(state.get("last_stand", false)) \
			and target.card_data.get("passive", "") == "paladin_rally":
		var rally_gain: int = 3 if bool(target.card_data.get("is_upgraded", false)) else 2
		text += "\nRALLIES +%d ATK - HEALS 3" % rally_gain
		counter_gain += rally_gain
	var return_outcome := {"text": "", "survives": true}
	if kind in ["standard", "swift", "sniper"]:
		var pavise := 0
		if kind == "sniper" and attacker_is_enemy and target.current_row == ROW_BACK \
				and _has_relic("hexagonal_shield"):
			pavise = int(RelicDB.get_relic("hexagonal_shield").get("value", 3))
		var reflected := int(state.get("damage", 0)) \
			if target.card_data.get("passive", "") == "reflect_strike" else 0
		return_outcome = _forecast_return_outcome(target, attacker,
			attacker_is_enemy, kind, counter_gain, pavise, reflected)
		var source_line: String = String(return_outcome.get("text", ""))
		if source_line != "":
			text += "\n" + source_line
	# OVERKILL / PIERCING — the excess a lethal blow carries onward. This used to
	# print ONLY for Piercing, so the universal overkill rule (the whole 2026-07-28
	# blocker economy — a body now REDUCES damage by its HP instead of negating a
	# whole attack) was invisible at the exact moment the player is choosing a
	# blocker. It is computed either way at `state["overkill"]`; it was simply being
	# discarded. Wording matches the resolution-time callout in
	# _apply_piercing_overflow verbatim, so the forecast teaches the same word the
	# board will shout.
	var spill_line := ""
	if kind in ["standard", "swift", "sniper"] \
			and bool(state.get("lethal", false)) and int(state.get("overkill", 0)) > 0 \
			and (kind != "sniper" or rescue == ""):
		var spill: int = int(state["overkill"])
		if _forecast_has_piercing(attacker, attacker_is_enemy):
			spill_line = "PIERCES %d" % spill
		elif _forecast_overkill_lands_behind(target):
			spill_line = "OVERKILL %d" % spill
		if spill_line != "":
			text += "\n" + spill_line
	var quiet_text := _forecast_impact_text(state, rescue)
	if death_followup == "RETURNS TO HAND":
		quiet_text = death_followup
	elif death_followup != "":
		quiet_text += " - " + death_followup
	# The spill has to reach the ALWAYS-ON chip too, not just the hover. `text` got
	# the OVERKILL/PIERCES line above, but `quiet_text` is rebuilt from scratch here
	# and `_forecast_chip_text` reads `quiet_text` FIRST — so the board forecast was
	# still silent about overkill while the hover explained it. That is exactly half
	# a fix: the pre-commit read a player actually glances at is the quiet one.
	if spill_line != "":
		quiet_text += " - " + spill_line
	return {
		"point": _card_center(target), "text": text,
		"quiet_text": quiet_text,
		"color": Color(1.0, 0.85, 0.30) if death_followup != "" \
			else _forecast_impact_color(state, rescue), "face": false,
		"damage": int(state.get("damage", 0)), "hp_after": int(state["hp"]),
		"target_row": int(target.current_row), "target": target,
		"lethal": bool(state.get("lethal", false)), "rescue": rescue,
		"last_stand": bool(state.get("last_stand", false)),
		"shield_break": bool(state.get("shield_break", false)),
		"overkill": int(state.get("overkill", 0)),
		"death_followup": death_followup,
		"attacker_survives": bool(return_outcome.get("survives", true)),
	}


func _forecast_card_state(card: Control) -> Dictionary:
	return {
		"hp": _forecast_projected_hp(card), "shield": bool(card.state.has_shield),
		"last_stand_used": bool(card.last_stand_used), "damage": 0,
		"shield_break": false, "last_stand": false, "lethal": false,
		"overkill": 0, "poison": false,
	}


func _forecast_projected_hp(card: Control) -> int:
	var hp: int = int(card.current_hp)
	if _is_net() or phase != Phase.PLAYER_TURN or not card.is_opponent:
		return hp
	var max_hp: int = int(card.card_data.get("hp", hp))
	if String(card.state.current_intent) == "HEAL":
		hp = mini(hp + 3, max_hp)
	# ABILITY: heal_all also lands before combat and can change Sniper ordering.
	for source in _all_enemy_creatures():
		if String(source.state.current_intent) != "ABILITY":
			continue
		var ability: Dictionary = source.card_data.get("ability", {})
		if String(ability.get("type", "")) == "heal_all":
			hp = mini(hp + int(ability.get("value", 2)), max_hp)
	# A draining ability heals its own source after biting the opposing column.
	if String(card.state.current_intent) == "ABILITY" \
			and String(card.card_data.get("ability", {}).get("type", "")) == "drain":
		hp = mini(hp + 2, max_hp)
	return hp


func _forecast_apply_damage_state(card: Control, state: Dictionary, amount: int,
		bypass_armor: bool) -> void:
	state["damage"] = 0
	state["shield_break"] = false
	state["last_stand"] = false
	state["lethal"] = false
	state["overkill"] = 0
	if bool(state.get("shield", false)):
		state["shield"] = false
		state["shield_break"] = true
		return
	var applied := amount
	if not bypass_armor and _forecast_card_has_keyword(card, "armored"):
		applied = maxi(1, applied - 1)
	applied += int(card.card_data.get("extra_damage", 0))
	var hp_before: int = int(state["hp"])
	var raw_after := hp_before - applied
	state["overkill"] = maxi(0, -raw_after)
	state["hp"] = raw_after
	state["damage"] = maxi(0, hp_before - maxi(raw_after, 0))
	if int(state["hp"]) <= 0 and _forecast_card_has_keyword(card, "last_stand") \
			and not bool(state.get("last_stand_used", false)):
		state["hp"] = 1
		state["last_stand_used"] = true
		state["last_stand"] = true
		state["overkill"] = 0
		state["damage"] = maxi(0, hp_before - 1)
	else:
		state["lethal"] = int(state["hp"]) <= 0


## COUNTERORDERS (2026-07-30) — the predicate the whole package reads: is this
## enemy WEARING AN ORDER right now?
##
## WHY THIS EXACT DEFINITION. Enemy intents are expensive, legible infrastructure
## the player already reads every round, and until now nothing in the player's hand
## could act on them — the telegraph was information with no counterplay, which is
## the one thing Into the Breach's telegraphs are famous for NOT being. The
## counterable state is deliberately "wears a visible order badge" rather than any
## deeper reading of what the enemy will do: _update_intent_display renders a badge
## for exactly the non-ATK intents, so the condition is on screen BY CONSTRUCTION
## and can never be a hidden bonus the player has to memorise a table to predict.
##
## Plain ATK is not an order. CHARGE is — it is the biggest wind-up in the game and
## hitting the charger before it lands is the counterplay the badge is asking for.
func _wears_an_order(card: Control) -> bool:
	if card == null or not is_instance_valid(card) or not card.is_opponent:
		return false
	if _is_fortification(card):
		return false
	var intent := String(card.state.current_intent)
	return intent != "" and intent != "ATK"


func _forecast_card_has_keyword(card: Control, keyword: String) -> bool:
	if card.has_keyword(keyword):
		return true
	# GUARD grants temporary Armored before this enemy still takes its strike.
	return keyword == "armored" and not _is_net() and card.is_opponent \
		and phase == Phase.PLAYER_TURN \
		and String(card.state.current_intent) == "GUARD"


func _forecast_creature_rescue(target: Control) -> String:
	# Live pre-death order: Phantom Veil first, then the Revenant's own Reborn.
	if not target.is_opponent and _has_relic("phantom_veil") \
			and not _phantom_veil_used:
		# Another earlier death in resolver order may spend it first; never state
		# this conditional rescue as certain from a single-card hover.
		return "PHANTOM VEIL MAY SAVE"
	var on_death: Dictionary = target.card_data.get("on_death", {})
	if String(on_death.get("type", "")) == "reborn" \
			and not bool(target.state.reborn_used):
		return "REBORN"
	return ""


func _forecast_death_followup(target: Control) -> String:
	# These effects happen after the original body really dies; they must enrich
	# the text without suppressing Sniper chains or Piercing's lethal trigger.
	var on_death: Dictionary = target.card_data.get("on_death", {})
	if String(on_death.get("type", "")) == "betray_opposing":
		return "BETRAYAL"
	if String(on_death.get("type", "")) == "return_to_hand_once" \
			and (_is_net() or not target.is_opponent) \
			and not target.is_token and int(target.deck_uid) >= 0 \
			and not _griffin_returned_uids.has(int(target.deck_uid)):
		return "RETURNS TO HAND"
	if not _is_net() and not target.is_opponent and not target.is_token \
			and _has_relic("death_card") and _hand.size() < MAX_HAND_SIZE:
		return "RETURNS TO HAND"
	var side: int = 1 if target.is_opponent else 0
	if not target.is_token and _relic_active_for_side(target.is_opponent, "gravewardens_pact"):
		var cap: int = int(RelicDB.get_relic("gravewardens_pact").get("value", 3))
		if _gravewardens_rebirths[side] < cap:
			return "REBORN AS A 1/1 IMP"
	return ""


func _forecast_impact_text(state: Dictionary, rescue: String) -> String:
	if bool(state.get("poison", false)) and bool(state.get("lethal", false)):
		return (rescue if rescue != "" else "DIES") + " - POISON"
	if bool(state.get("lethal", false)):
		return rescue if rescue != "" else "DIES"
	if bool(state.get("last_stand", false)):
		return "LAST STAND - 1 HP"
	if bool(state.get("shield_break", false)):
		return "SHIELD BREAKS"
	var damage: int = int(state.get("damage", 0))
	if damage <= 0:
		return "NO DAMAGE"
	return "TAKES %d - %d HP" % [damage, int(state["hp"])]


func _forecast_impact_color(state: Dictionary, rescue: String) -> Color:
	if bool(state.get("lethal", false)) and rescue == "":
		return Color(1.0, 0.32, 0.22)
	if rescue != "" or bool(state.get("last_stand", false)):
		return Color(1.0, 0.85, 0.30)
	if bool(state.get("shield_break", false)) or int(state.get("damage", 0)) <= 0:
		return Color(0.86, 0.83, 0.74)
	return Color(1.0, 0.55, 0.28)


func _forecast_return_outcome(defender: Control, attacker: Control,
		attacker_is_enemy: bool, kind: String, counter_bonus: int = 0,
		extra_bypass: int = 0, reflected_damage: int = 0) -> Dictionary:
	if defender.current_hp <= 0:
		return {"text": "", "survives": true}
	var defender_is_friendly: bool = attacker_is_enemy
	var has_thorns: bool = defender.has_keyword("thorns") \
		or (not attacker_is_enemy and _has_encounter_passive_keyword(defender, "thorns")) \
		or bool(defender.state.shield_wall_thorns) \
		or bool(defender.state.square_thorns) \
		or (defender_is_friendly and _has_relic("bridge_watcher") \
			and defender.current_lane in [1, 2]) \
		or (defender_is_friendly and _has_relic("corner_stone") \
			and defender.current_lane in [0, LANES_PER_ROW - 1])
	# Mirror of the live rule at _creature_attacks_creature (see the will_counter
	# there): a defender answers either because the net clash pass is one-directional
	# (_net_mutual_retaliation, predicted here by the net-turn proxy) OR because it is
	# MUSTERING — the solo arm. The mustering arm was missing, so a body played this
	# turn forecast as free food when it in fact trades: the rule that makes the
	# muster delay fair was the one the forecast refused to show.
	# Mirror of the live rule at _creature_attacks_creature (see the will_counter
	# there): a defender answers either because the net clash pass is one-directional
	# (_net_mutual_retaliation, predicted here by the net-turn proxy) OR because it is
	# MUSTERING — the solo arm. The mustering arm was missing, so a body played this
	# turn forecast as free food when it in fact trades: the rule that makes the
	# muster delay fair was the one the forecast refused to show.
	var will_counter: bool = kind == "standard" \
		and ((_is_net() and _net_active_index >= 0) or _defender_is_mustering(defender)) \
		and _defender_will_counter(defender)
	if not has_thorns and not will_counter and extra_bypass <= 0 \
			and reflected_damage <= 0:
		return {"text": "", "survives": true}
	var source_state := _forecast_card_state(attacker)
	var before: int = int(source_state["hp"])
	if has_thorns:
		var thorns := 1
		if defender_is_friendly \
				and ((_has_relic("bridge_watcher") and defender.current_lane in [1, 2]) \
					or (_has_relic("corner_stone") and defender.current_lane in [0, LANES_PER_ROW - 1])):
			thorns = 2
		_forecast_apply_damage_state(attacker, source_state, thorns, true)
		var thorn_lost: int = maxi(0, before - maxi(int(source_state["hp"]), 0))
		if bool(defender.card_data.get("venom_thorns", false)) and thorn_lost > 0 \
				and int(source_state["hp"]) > 0:
			source_state["hp"] = 0
			source_state["lethal"] = true
	# Iron Rampart reflects the HP the strike actually removed, even when that
	# strike kills it. Reflection is armor-bypass recoil, matching the live hook.
	if reflected_damage > 0 and int(source_state["hp"]) > 0:
		_forecast_apply_damage_state(attacker, source_state, reflected_damage, true)
	if will_counter and int(source_state["hp"]) > 0:
		var defender_is_enemy: bool = not attacker_is_enemy
		var retal := _forecast_attack_power(defender,
			int(defender.current_lane), defender_is_enemy) + counter_bonus
		if retal > 0:
			_forecast_apply_damage_state(attacker, source_state, retal, false)
			var counter_poison: bool = defender.has_keyword("poison") \
				or _virulence_active[1 if defender_is_enemy else 0]
			if counter_poison and int(source_state["hp"]) > 0:
				source_state["hp"] = 0
				source_state["lethal"] = true
	# Hexagonal Shield's Pavise bolt lands after an enemy Sniper's back-row shot.
	if extra_bypass > 0 and int(source_state["hp"]) > 0:
		_forecast_apply_damage_state(attacker, source_state, extra_bypass, true)
	var lost: int = maxi(0, before - maxi(int(source_state["hp"]), 0))
	if bool(source_state.get("lethal", false)):
		var rescue := _forecast_creature_rescue(attacker)
		var followup := _forecast_death_followup(attacker) if rescue == "" else ""
		var outcome := rescue if rescue != "" else followup
		if outcome == "":
			outcome = "DIES ON RETURN"
		var remains_on_board: bool = rescue == "REBORN" or rescue.begins_with("PHANTOM VEIL")
		return {
			"text": "ATTACKER %s" % outcome,
			"survives": remains_on_board,
		}
	if bool(source_state.get("last_stand", false)):
		return {"text": "ATTACKER: LAST STAND", "survives": true}
	if bool(source_state.get("shield_break", false)):
		return {"text": "ATTACKER SHIELD BREAKS", "survives": true}
	return {
		"text": "ATTACKER TAKES %d - %d HP" % [lost, int(source_state["hp"])],
		"survives": true,
	}


## Would a plain (non-Piercing) overkill spill actually hit something?
##
## Overkill STOPS at the body behind the victim — it never reads on to the face.
## So the forecast may only promise it when that body exists and is alive, or the
## chip would advertise damage that goes nowhere. Mirrors the spill lookup in
## _apply_piercing_overflow: the victim's OWN column (a Guardian / redirecting
## Royal Guard can pull the hit a lane over), front row only.
func _forecast_overkill_lands_behind(victim: Control) -> bool:
	if victim == null or not is_instance_valid(victim):
		return false
	var vpos := _find_creature_position(victim)
	if vpos.is_empty() or int(vpos["row"]) != ROW_FRONT:
		return false
	var back_card = _row_array(bool(vpos["is_enemy"]), ROW_BACK)[int(vpos["lane"])]
	return back_card != null and is_instance_valid(back_card) \
		and _forecast_projected_hp(back_card) > 0


func _forecast_has_piercing(attacker: Control, attacker_is_enemy: bool) -> bool:
	return attacker.has_keyword("piercing") \
		or (attacker_is_enemy and _has_encounter_passive_keyword(attacker, "piercing")) \
		or bool(attacker.state.inspire_piercing) \
		or (not attacker_is_enemy and _has_relic("piercing_crown"))


func _forecast_cleave_summary(main_target: Control, target_is_enemy: bool,
		lane: int) -> String:
	var row: int = ROW_FRONT
	var pos := _find_creature_position(main_target) \
		if main_target != null and is_instance_valid(main_target) else {}
	if not pos.is_empty():
		row = int(pos["row"])
	elif _row_array(target_is_enemy, ROW_FRONT)[lane] == null \
			and _row_array(target_is_enemy, ROW_BACK)[lane] != null:
		row = ROW_BACK
	var hit := 0
	var died := 0
	var shields := 0
	for target in _adjacent_creatures(target_is_enemy, row, lane):
		if target == null or not is_instance_valid(target) or target.current_hp <= 0:
			continue
		var state := _forecast_card_state(target)
		_forecast_apply_damage_state(target, state, 1, false)
		hit += 1
		if bool(state.get("shield_break", false)):
			shields += 1
		elif bool(state.get("lethal", false)):
			died += 1
	if hit <= 0:
		return ""
	var text := "CLEAVE HITS %d" % hit
	if died > 0:
		text += " - %d DIE" % died
	if shields > 0:
		text += " - %d SHIELD" % shields
	return text


func _telegraph_damage_to(target: Control, atk: int) -> int:
	# Compatibility helper for probes and older callers. Structured hover text is
	# built from _forecast_apply_damage_state so Shield/Last Stand stay in parity.
	if target == null or not is_instance_valid(target):
		return 0
	var state := _forecast_card_state(target)
	_forecast_apply_damage_state(target, state, atk, false)
	return int(state.get("damage", 0))


func _face_lane_point(target_is_enemy: bool, lane: int) -> Vector2:
	# Face damage still comes through a lane. Keep the read on the board edge
	# instead of firing a line into the HUD's HP medallion.
	var slots := _slot_array(target_is_enemy, ROW_FRONT)
	if lane >= 0 and lane < slots.size():
		var slot: Control = slots[lane]
		if slot != null and is_instance_valid(slot) and slot.is_inside_tree():
			var rect := slot.get_global_rect()
			var dir := -1.0 if target_is_enemy else 1.0
			return rect.get_center() + Vector2(0, dir * maxf(42.0, rect.size.y * 0.36))
	return _hero_face_point(target_is_enemy)


func _hero_face_point(target_is_enemy: bool) -> Vector2:
	# Legacy fallback for direct hero-facing effects. Face-strike forecasts use
	# _face_lane_point instead so they stay on the board.
	var lbl: Control = _enemy_hp_label if target_is_enemy else _player_hp_label
	if lbl != null and is_instance_valid(lbl) and lbl.is_inside_tree():
		return lbl.get_global_rect().get_center()
	var vp := get_viewport_rect().size
	return Vector2(vp.x * 0.5, 40.0 if target_is_enemy else vp.y - 220.0)


func _pulse_mana_label(amount: int, is_gain: bool = false) -> void:
	# Brief flash + scale punch on the Command counter so a change reads as a
	# deliberate cost paid — or a gift received — not just a number that quietly
	# ticked.
	#
	# GAINS WERE SILENT until 2026-07-28. This funnel was only ever called on a
	# SPEND, so every source of extra Command (a battlecry, a potion, Raider's Oath,
	# the Warm Knucklebone) simply made the wax seal show a different numeral on the
	# next frame. Command is the resource the entire turn is planned around; a
	# player who does not notice they gained one plans a smaller turn than they
	# could have. `is_gain` keeps the default behaviour for the five existing spend
	# call sites untouched.
	if _mana_label == null or amount <= 0:
		return
	# The floating number is the INFORMATIONAL half — it states the amount, so it
	# survives Reduce Motion. The flash and the punch below are decorative.
	var pos := _mana_label.get_global_rect().get_center() + Vector2(0, -10)
	if is_gain:
		spawn_floating_number(pos, "+%d" % amount, Color(0.98, 0.84, 0.42), false)
	else:
		spawn_floating_number(pos, "-%d" % amount, Color(0.55, 0.80, 1.0), false)
	if UserSettings != null and UserSettings.reduce_motion:
		return
	var rest_color: Color = _mana_label.get_theme_color("font_color")
	# Remembered on the first punch: reading .scale mid-flight (a two-spell turn
	# lands two of these inside one beat) would settle to an inflated scale and
	# the counter would creep. Same reason _punch_label keys its rest.
	var rest_scale: Vector2 = _mana_label.get_meta(
		"_pulse_mana_rest", _mana_label.scale)
	_mana_label.set_meta("_pulse_mana_rest", rest_scale)
	_mana_label.pivot_offset = _mana_label.size * 0.5
	if _mana_label.has_meta("_pulse_mana_tw"):
		var old = _mana_label.get_meta("_pulse_mana_tw")
		if old is Tween and old.is_valid():
			old.kill()
	_mana_label.scale = rest_scale
	var tw := _mana_label.create_tween()
	_mana_label.set_meta("_pulse_mana_tw", tw)
	tw.set_parallel(true)
	# House grammar: QUAD-out out, BACK-out home (this used to be inverted).
	tw.tween_property(_mana_label, "scale", rest_scale * 1.25, Motion.PUNCH) \
		.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	tw.tween_method(func(c: Color):
			_mana_label.add_theme_color_override("font_color", c),
		Color(0.55, 0.80, 1.0), rest_color, 0.32)
	tw.chain().tween_property(_mana_label, "scale", rest_scale, Motion.SETTLE) \
		.set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)


# Tier-2 family map. Each spell card id is routed to one of six visual families
# (FIRE / SHOCK / BLIGHT / BLESSING / EARTH / MIND), each with its own particle
# preset + accent (screen flash, lightning Line2D, target pulse, screen shake).
# Spells not listed here fall back to the legacy color-by-type burst so adding a
# new spell never breaks visually — it just lands without family flavor until
# someone tags it.
## EVERY spell in CARD_POOL must appear here — `tools/_probe_spell_fx_audit.gd`
## FAILS on an untagged spell or on a tag whose id no longer exists, and it runs
## in the regression set. That gate is the point: this map silently drifted to
## 42% untagged + 6 dead ids (S1 of docs/SPELL_FX_PLAN_20260717.md) precisely
## because nothing checked it. An untagged spell doesn't error — it just quietly
## casts a generic colour puff forever.
