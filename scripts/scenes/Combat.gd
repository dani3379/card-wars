func _debug_auto_win() -> void:
	# Debug hotkey (F1): instant-win the current combat. Routes through the
	# normal victory path so gold rewards, relic hooks, and scene transition
	# all fire exactly as if the player had killed the last enemy.
	enemy_hp = 0
	_info_label.text = "[debug] auto-win"
	_check_game_over()


func _dim_war_furniture() -> void:
	# ★13 (screenshot-caught 2026-07-17, in _shot_killing_blow's stamp frame):
	# the verdict used to stamp down over STALE PROMISES — the INCOMING chip
	# and the NEXT-ROUND wave chip kept forecasting a round that will never
	# come, enemy intent chevrons kept telegraphing swings, and the CLASH
	# button stayed lit under the ceremony. Sweep the live-fight furniture the
	# moment the fight ends so the climax plays on a settled stage.
	# SOLO-ONLY: the net rematch flow reuses this scene in place, and a chip
	# faded to alpha 0 here would come back invisible in game 2.
	# The forecast information is dead by definition at GAME_OVER, so Reduce
	# Motion snapping these hidden (fade_exit's contract) is correct.
	for chip in [_incoming_dmg_chip, _wave_chip, _reserves_chip]:
		if chip != null and is_instance_valid(chip) and chip.visible:
			Motion.fade_exit(chip)
	if _end_turn_btn != null and is_instance_valid(_end_turn_btn):
		_end_turn_btn.disabled = true
		Motion.fade_exit(_end_turn_btn)
	for c in _all_enemy_creatures():
		if c == null or not is_instance_valid(c):
			continue
		if c.has_method("set_threat_flagged"):
			c.set_threat_flagged(false)
		for meta in ["intent_label", "atk_marker"]:
			if c.has_meta(meta) and is_instance_valid(c.get_meta(meta)):
				(c.get_meta(meta) as CanvasItem).visible = false
	# The per-slot "HP -N" danger sigils are the same class of dead forecast.
	_clear_lane_forecast()


func _play_killing_blow_moment(won: bool) -> void:
	# ★8 (docs/ANIMATION_COOL_PITCH_20260717.md §5b) — the blow that ends the
	# FIGHT gets what no chip hit gets: the music drops out on the impact, the
	# table takes its heaviest blow, and the colour drains from the world for a
	# beat before the verdict ceremony takes the stage. The strike sites hold
	# the killer at full extension through the same beat (hold_lunge_apex).
	#
	# The drain rides the EXISTING cinematic grade (u_sat on _grade_mat, which
	# tones the whole frame). Under Reduce Motion the grade layer is never
	# built, so the moment self-reduces to the duck + shake — correct: the
	# drain is decorative emphasis, the verdict banner carries the information.
	if AudioBank != null:
		# Immediate dip at the blow itself. The victory sting's own duck
		# (+0.45s) supersedes cleanly — duck_music removes the prior offset
		# before applying a new one, by contract.
		AudioBank.duck_music(-9.0, 0.5 if won else 1.2)
	screen_shake(10.0)
	# The lethal push-in (★6's leftover, finished with ★8's moment): the whole
	# board leans in 1.5% on the blow — a camera move in all but name. Won: it
	# eases back out as the colour floods with the stamp. Solo defeat: it stays
	# leaned in through the fade, the table looming. Net ALWAYS eases back —
	# a Bo3 rematch reuses this scene in place (the ★13 lesson) and game 2
	# must not open on a zoomed board.
	if _board_container != null and is_instance_valid(_board_container) \
			and DisplayServer.get_name() != "headless" \
			and not (UserSettings != null and UserSettings.reduce_motion):
		_board_container.pivot_offset = _board_container.size * 0.5
		var ptw := create_tween()
		ptw.tween_property(_board_container, "scale", Vector2(1.015, 1.015), 0.22) \
			.set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
		if won or _is_net():
			ptw.tween_interval(0.28)
			ptw.tween_property(_board_container, "scale", Vector2.ONE, 0.55) \
				.set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_IN_OUT)
	if _grade_mat == null or DisplayServer.get_name() == "headless":
		return
	var base_sat: float = float(_grade_mat.get_shader_parameter("u_sat"))
	var base_bright: float = float(_grade_mat.get_shader_parameter("u_bright"))
	var drained: float = 0.22 if won else 0.30
	var dim: float = base_bright * 0.94
	var tw := create_tween()
	tw.tween_method(func(v: float):
		if _grade_mat != null:
			_grade_mat.set_shader_parameter("u_sat", lerpf(base_sat, drained, v))
			_grade_mat.set_shader_parameter("u_bright", lerpf(base_bright, dim, v)),
		0.0, 1.0, 0.24).set_ease(Tween.EASE_OUT)
	if won:
		# Hold the drained beat, then flood the colour back in step with the
		# VICTORY stamp landing (the banner schedules at +0.45 and strikes at
		# ~+0.63) — the world regains its colour AS the verdict hits the page.
		tw.tween_interval(0.26)
		tw.tween_method(func(v: float):
			if _grade_mat != null:
				_grade_mat.set_shader_parameter("u_sat", lerpf(drained, base_sat, v))
				_grade_mat.set_shader_parameter("u_bright", lerpf(dim, base_bright, v)),
			0.0, 1.0, 0.55).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_IN_OUT)
	else:
		# Defeat: the world STAYS drained into the scene fade — recover only
		# enough saturation for the DEFEAT ink to read blood-red, not grey
		# (the grade layer sits over the HUD, so it tones the verdict too).
		tw.tween_interval(0.30)
		tw.tween_method(func(v: float):
			if _grade_mat != null:
				_grade_mat.set_shader_parameter("u_sat", lerpf(drained, 0.55, v)),
			0.0, 1.0, 0.50).set_ease(Tween.EASE_OUT)


func _check_game_over() -> void:
	# Idempotent: once we've entered GAME_OVER, ignore further calls so the
	# DEFEAT/VICTORY scene-change timer is never scheduled twice. Needed because
	# damage_enemy_hero / damage_player_hero now call us on every face hit, and
	# the same hit can produce multiple zero-HP events in a single combat phase.
	if phase == Phase.GAME_OVER:
		return
	# Skirmish has no RunState run to write back to, no reward/map flow, and the
	# match-over verdict is host-authoritative. Route to the net resolver instead
	# of the campaign victory/defeat path (which would advance the map & rewards).
	if _is_net():
		if _is_host():
			_net_host_check_match_over()
		return
	if (player_hp <= 0 or enemy_hp <= 0) and _clash_lane_focus != null \
			and is_instance_valid(_clash_lane_focus):
		_clash_lane_focus.clear_focus()
	if player_hp <= 0:
		phase = Phase.GAME_OVER
		PlayLog.log_event("combat_end", {"encounter": _encounter_id,
			"result": "defeat", "round": round_number,
			"player_hp": 0, "enemy_hp": enemy_hp})
		_stop_low_hp_dread()  # JUICE: kill the heartbeat/vignette before the defeat sting
		_play_killing_blow_moment(false)  # ★8: the world stops for the blow that ended it
		_dim_war_furniture()  # ★13: no stale next-round forecasts under the verdict
		_dbgp("[PACING] FIGHT END | %s | DEFEAT  | ended R%d | P_HP:%d E_HP:%d | intents_shown:%s" % [_encounter_name, round_number, player_hp, enemy_hp, str(_pacing_any_intent_shown)])
		_phase_label.text = "DEFEAT"
		_phase_label.add_theme_color_override("font_color", Color(0.95, 0.25, 0.25))
		RunState.hero_hp = 0
		# Record what killed the player for the GameOver recap. Encounter name
		# is the most useful unit of "killed by" — players remember "I died
		# to the Pyre Cult," not "I died to Burning Martyr's on-death."
		RunState.cause_of_death = _encounter_name if _encounter_name != "" else "an unknown foe"
		_presence_say(_pick_bark("slay"), Color(0.95, 0.85, 0.5))   # the foe's parting line
		_show_battle_verdict(false)
		if AudioBank != null:
			AudioBank.duck_music(-8.0, 1.3)
			AudioBank.play_sfx("defeat")
		get_tree().create_timer(1.5).timeout.connect(func():
			RunState.end_run(false)
			GameTheme.fade_out_then_change_scene(self, GAMEOVER_SCENE, 0.5)
		)
	elif enemy_hp <= 0:
		phase = Phase.GAME_OVER
		# A NAMED ACTION pays its trophy on ANY victory, not only on the beat
		# the objective ticks over: breaking the foe outright is carrying the
		# ground by the shortest route available, and the brief never promised
		# otherwise. Idempotent — the objective path may already have paid.
		_sp_award()
		PlayLog.log_event("combat_end", {"encounter": _encounter_id,
			"result": "victory", "round": round_number,
			"player_hp": player_hp, "enemy_hp": 0})
		_stop_low_hp_dread()  # JUICE: clear dread overlay on victory
		_play_killing_blow_moment(true)  # ★8: the world stops for the blow that ended it
		_dim_war_furniture()  # ★13: no stale next-round forecasts under the verdict
		_dbgp("[PACING] FIGHT END | %s | VICTORY | ended R%d | P_HP:%d E_HP:%d | intents_shown:%s" % [_encounter_name, round_number, player_hp, enemy_hp, str(_pacing_any_intent_shown)])
		# The banner + victory sting are DEFERRED ~0.45s (scheduled below, once
		# the gold line is known) so the killing blow's death burst and shake get
		# a held beat — they used to swap in the very frame the last creature died.
		var victory_banner := "VICTORY!"
		var node_type = RunState.current_node_type
		RunState.hero_hp = max(player_hp, 1)
		# Run-stat bookkeeping for the GameOver recap.
		RunState.fights_won += 1
		# Surviving Pay-Wagons return their principal plus half. Destroyed wagons
		# are absent from the field and therefore stay plundered.
		var wagon_payout: int = _settle_pay_wagons()
		# Successor Wars: every garrison/stronghold that falls counts toward
		# opening the rival lord's keep (RunState.is_lord_gate_open).
		var gate_was_open: bool = RunState.is_lord_gate_open()
		var conquest_line := ""
		if node_type in ["combat", "elite"]:
			RunState.holds_broken_in_act += 1
			RunState.holds_broken_run += 1
			if node_type == "elite":
				RunState.generals_broken_run += 1
			conquest_line = _victory_conquest_line(gate_was_open)
		if _mutator_id != "" and not RunState.mutators_survived.has(_mutator_id):
			RunState.mutators_survived.append(_mutator_id)
		# Vulture's Feast
		# The post-fight settlement pays out over the ~1-2 s the victory banner
		# holds before the scene change, so the rail is still on screen — but
		# every line below moved gold or HP with nothing naming the source.
		if _has_relic("vultures_feast"):
			var heal = mini(_friendly_deaths_this_fight, 5)
			RunState.heal_hero(heal)
			if heal > 0:
				_relic_fired("vultures_feast")
		# Lich's Bargain: lose 1 HP per friendly death this fight, capped at 3.
		if _has_relic("lichs_bargain"):
			var cost: int = mini(_friendly_deaths_this_fight, 3)
			if cost > 0:
				RunState.damage_hero(cost)
				_relic_fired("lichs_bargain")
		# Coin Purse
		if _has_relic("coin_purse"):
			RunState.gain_gold(10)
			_relic_fired("coin_purse")
		# Sellsword's Retainer — the surviving hireling collects his 10 gold.
		if _has_relic("sellswords_retainer"):
			for sw in _all_player_creatures():
				if is_instance_valid(sw) and sw.is_token \
						and String(sw.card_data.get("name", "")) == "Sellsword":
					RunState.gold = maxi(0, RunState.gold - 10)
					_show_info("The Sellsword collects his fee — 10 gold.")
					_relic_fired("sellswords_retainer")
					break
		# Thief's Gloves grades the raid instead of asking for a brittle perfect.
		if _has_relic("thiefs_gloves") and _face_damage_taken_this_fight <= 5:
			RunState.gain_gold(int(RelicDB.get_relic("thiefs_gloves").get("value", 15)))
			_relic_fired("thiefs_gloves")
			if _face_damage_taken_this_fight == 0:
				RunState.next_combat_mana_bonus += 1
				_show_info("Thief's Gloves — a clean job: +15 gold, +1 Command next fight.")
			else:
				_show_info("Thief's Gloves — the haul survives: +15 gold.")
		# Gold reward — fights pay ground, not cards (Successor Wars Phase 4):
		# the card drip moved to recruit stops, so the gold base is bumped to
		# keep the shop a real deck-growth lever.
		var gold_won: int = 0
		match node_type:
			"combat": gold_won = RunState.roll_gold_reward(40)
			"elite": gold_won = RunState.roll_gold_reward(60)
			"boss": gold_won = RunState.roll_gold_reward(55)
		if gold_won > 0:
			RunState.gain_gold(gold_won)
		if gold_won + wagon_payout > 0:
			victory_banner = "VICTORY!  +%d gold" % (gold_won + wagon_payout)
		# Spoils potion — StS-style drop with a pity ladder: 40% base, +10% per
		# dry fight, reset on a drop. Rolled only when a slot is free (no dead
		# rewards; can_add_potion also respects the Temperance Vow) and never
		# on the boss — the act transition pays its own way.
		if node_type in ["combat", "elite"] and RunState.can_add_potion():
			if _combat_ops.chance_percent(40 + RunState.potion_drop_misses * 10):
				var drop_pid: String = PotionDB.roll_random_potion()
				RunState.add_potion(drop_pid)
				RunState.potion_drop_misses = 0
				_show_info("Spoils: %s" % PotionDB.get_potion(drop_pid).get("name", drop_pid))
			else:
				RunState.potion_drop_misses += 1
		# Mutator bonus pays out here now (Reward no longer fronts normal
		# fights). Clear the id so a save/reload can't double-pay. Gated on
		# current_mutator_id so the Daily March omen (which fills EVERY fight
		# via _init_mutator_state's fallback) doesn't pay its bonus per fight —
		# only true node mutators front gold.
		if _mutator_id != "" and RunState.current_mutator_id != "" \
				and MutatorDB.exists(_mutator_id):
			var mut_bonus: int = int(MutatorDB.get_mutator(_mutator_id).get("gold_bonus", 0))
			if mut_bonus > 0:
				RunState.gain_gold(mut_bonus)
				_show_info("★ Mutator bonus: +%d gold" % mut_bonus)
			RunState.current_mutator_id = ""
		# Cursed Key: the curse lands on victory (used to ride the Reward roll).
		if RunState.has_downside("curse_on_reward"):
			RunState.add_card(CardDB.random_curse_id())

		# The held beat: banner text + sting land together after the final death
		# has breathed. Well inside the earliest scene fade (elite, 1.0s).
		get_tree().create_timer(0.45).timeout.connect(func():
			_show_battle_verdict(true, gold_won)
			if is_instance_valid(_phase_label):
				_phase_label.text = victory_banner
				_phase_label.add_theme_color_override("font_color", Color(1.0, 0.82, 0.34))
			if conquest_line != "":
				_show_info(conquest_line)
			if AudioBank != null:
				# Dip the combat track under the sting so the fanfare reads
				# over the music instead of fighting it.
				AudioBank.duck_music(-7.0, 1.1)
				AudioBank.play_sfx("victory")
		)

		if node_type == "boss":
			# Post-boss heal: 75% of missing HP
			var missing = RunState.hero_max_hp - RunState.hero_hp
			RunState.heal_hero(int(missing * 0.75))
			get_tree().create_timer(2.0).timeout.connect(func():
				if RunState.is_final_boss():
					RunState.end_run(true)
					GameTheme.fade_out_then_change_scene(self, GAMEOVER_SCENE, 0.5)
				else:
					# Don't advance_act here — that would clear current_node_type,
					# so Reward would render as a normal fight (no boss relic
					# offer). Reward handles the act advance after the player
					# finishes picking, on its way back to the map.
					GameTheme.fade_out_then_change_scene(self, REWARD_SCENE, 0.35)
			)
		elif node_type == "elite":
			# Elites still detour through Reward for their relic pick.
			get_tree().create_timer(1.0).timeout.connect(func():
				GameTheme.fade_out_then_change_scene(self, REWARD_SCENE, 0.35)
			)
		else:
			# Normal holds pay out inline and march straight back to the map —
			# no card pick, no interstitial screen. Pace is the point.
			get_tree().create_timer(1.2).timeout.connect(func():
				GameTheme.fade_out_then_change_scene(self, MAP_SCENE, 0.35)
			)


# =====================================================================
#  INTENT SYSTEM
# =====================================================================

func _assign_intents() -> void:
	## Assigns an intent to each enemy creature on the field based on their
	## intent cycle. 4x4: scans both rows. Default ATK still gets a visible
	## damage badge so the player can always read what's coming.
	for card in _all_enemy_creatures():
		var intents = card.card_data.get("intents", [])
		if _is_fortification(card):
			card.state.current_intent = ""
			_update_intent_display(card, "")
			continue
		if intents.is_empty():
			card.state.current_intent = "ATK"
			_update_intent_display(card, "ATK")
			continue
		# Get current cycle position (stored on card, incremented each round)
		var cycle_pos = card.state.intent_cycle_pos
		var intent = intents[cycle_pos % intents.size()]
		# Anti-repetition: no same non-ATK intent more than 2 rounds in a row
		var consecutive = card.state.intent_consecutive
		var last_intent = card.state.last_intent
		if intent != "ATK" and intent == last_intent:
			consecutive += 1
			if consecutive >= 2:
				intent = "ATK"
				consecutive = 0
		else:
			consecutive = 0
		card.state.current_intent = intent
		card.state.last_intent = intent
		card.state.intent_consecutive = consecutive
		card.state.intent_cycle_pos = cycle_pos + 1
		# Update visual display
		_update_intent_display(card, intent)


func _update_intent_display(card: Control, intent: String) -> void:
	## Renders an intent badge above enemies for non-default intents (CHARGE,
	## GUARD, RALLY, …). The default ATK case gets its own compact red down-chevron
	## via _update_attack_marker — so a plain attacker (by far the most common
	## case, and the one that used to telegraph NOTHING) now reads as "this will
	## swing," without re-printing the ATK-orb numeral that overlapped the art.
	_update_attack_marker(card, intent)
	var lbl: Label = null
	if card.has_meta("intent_label") and is_instance_valid(card.get_meta("intent_label")):
		lbl = card.get_meta("intent_label")
	if intent == "ATK" or intent == "":
		if lbl != null:
			lbl.visible = false
		return
	var label_text: String = intent
	if lbl == null:
		lbl = Label.new()
		# Intent text is the enemy's telegraph — it has to read from across the
		# board. The old 11px bare label vanished against the art on a 1080p
		# capture; a dark pill + bold 22px caps gives it a nameplate's presence
			# so this CHARGE / GUARD / RALLY telegraph reads from across the board.
			# (size set on the lbl just below)
		if GameTheme.font_display:
			lbl.add_theme_font_override("font", GameTheme.font_display)
		lbl.add_theme_font_size_override("font_size", 22)
		lbl.add_theme_color_override("font_outline_color", Color(0, 0, 0, 0.95))
		lbl.add_theme_constant_override("outline_size", 4)
		var pill := StyleBoxFlat.new()
		pill.bg_color = Color(0.05, 0.04, 0.035, 0.82)
		pill.border_color = Color(0, 0, 0, 0.65)
		for k in ["border_width_top", "border_width_bottom",
				"border_width_left", "border_width_right"]:
			pill.set(k, 1)
		for k in ["corner_radius_top_left", "corner_radius_top_right",
				"corner_radius_bottom_left", "corner_radius_bottom_right"]:
			pill.set(k, 9)
		pill.content_margin_left = 8
		pill.content_margin_right = 8
		pill.content_margin_top = 1
		pill.content_margin_bottom = 1
		lbl.add_theme_stylebox_override("normal", pill)
		lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		lbl.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		lbl.anchor_left = 0.0
		lbl.anchor_right = 1.0
		lbl.anchor_top = 0.0
		lbl.anchor_bottom = 0.0
		lbl.offset_left = 22
		lbl.offset_right = -22
		lbl.offset_top = -26
		lbl.offset_bottom = -2
		lbl.z_index = 5
		lbl.mouse_filter = Control.MOUSE_FILTER_IGNORE
		card.add_child(lbl)
		card.set_meta("intent_label", lbl)
	var color := Color(0.95, 0.40, 0.30)  # default ATK red
	match intent:
		"CHARGE": color = Color(1.0, 0.45, 0.20)
		"GUARD": color = Color(0.50, 0.78, 1.0)
		"RALLY": color = Color(1.0, 0.88, 0.30)
		"HEAL": color = GameTheme.HEALTH_GREEN
		"ENRAGE": color = Color(1.0, 0.40, 0.10)
		"RETREAT": color = Color(0.75, 0.75, 0.75)
		"SUMMON": color = Color(0.80, 0.55, 1.0)
		"ABILITY": color = Color(1.0, 0.85, 0.10)
	lbl.add_theme_color_override("font_color", color)
	lbl.text = label_text
	lbl.visible = true
	_pacing_any_intent_shown = true


func _update_attack_marker(card: Control, intent: String) -> void:
	## The default-attack telegraph: a small red down-chevron on every enemy that
	## will simply swing this turn — the case named-intent pills skip. Kept in its
	## own marker node so it never duplicates the ATK orb or the intent pill.
	var show_fang := (intent == "ATK" or intent == "")
	# Only flag a creature that can actually strike (skip stunned / 0-ATK / etc.).
	if show_fang and card.has_method("can_attack") and not card.can_attack():
		show_fang = false
	# The louder "⚔ N" threat badge already telegraphs this swing (with its number),
	# so a face-threat enemy carries ONE signal, not two stacked at its top edge.
	# The chevron is the quiet fallback for attackers the threat flag skips (a
	# blocked lane / a light hitter). _refresh_threat_flags re-syncs us on toggle.
	if show_fang and bool(card.get("_threat_flagged")):
		show_fang = false
	var m: Control = null
	if card.has_meta("atk_marker") and is_instance_valid(card.get_meta("atk_marker")):
		m = card.get_meta("atk_marker")
	if not show_fang:
		if m != null:
			m.visible = false
		return
	if m == null:
		m = _make_attack_fang()
		card.add_child(m)
		card.set_meta("atk_marker", m)
	m.visible = true


func _make_attack_fang() -> Control:
	## A down-pointing red chevron pinned to the enemy card's top edge. Drawn with
	## Polygon2D so it is font-independent (the UI font carries no ⚔/▼ glyph), and
	## small so eight of them never crowd the board.
	var holder := Control.new()
	holder.anchor_left = 0.5
	holder.anchor_right = 0.5
	holder.anchor_top = 0.0
	holder.anchor_bottom = 0.0
	holder.offset_left = -12
	holder.offset_right = 12
	holder.offset_top = -15
	holder.offset_bottom = 7
	holder.z_index = 6
	holder.mouse_filter = Control.MOUSE_FILTER_IGNORE
	# Dark backing chevron (slightly larger, drawn first → reads as an outline).
	var back := Polygon2D.new()
	back.polygon = PackedVector2Array([Vector2(-11, 0), Vector2(11, 0), Vector2(0, 15)])
	back.color = Color(0, 0, 0, 0.85)
	back.position = Vector2(12, 1)
	holder.add_child(back)
	# Crimson fill chevron.
	var tri := Polygon2D.new()
	tri.polygon = PackedVector2Array([Vector2(-8.5, 0), Vector2(8.5, 0), Vector2(0, 11.5)])
	tri.color = Color(0.93, 0.30, 0.26, 0.97)
	tri.position = Vector2(12, 1)
	holder.add_child(tri)
	return holder


func _resolve_intents() -> void:
	## Resolves all non-ATK intents for enemy creatures BEFORE combat.
	## 4x4: iterates both rows. Lane index drives same-row adjacency for RALLY/SUMMON.
	for row in [ROW_FRONT, ROW_BACK]:
		var arr = _row_array(true, row)
		for lane_idx in range(LANES_PER_ROW):
			var card = arr[lane_idx]
			if card == null:
				continue
			var intent = card.state.current_intent
			match intent:
				"ATK":
					pass
				"CHARGE":
					# The refresh is not cosmetic: without it the seal can print the
					# pre-intent number while the body swings at the buffed one, and
					# the rail only catches up on a 0.25 s poll — slower than the
					# 0.19 s strike cadence, so the stale value is what the player
					# actually reads. Every other arm below already refreshes.
					card.temp_atk_buff += 1
					card.update_stat_display()
				"GUARD":
					if "armored" not in card.card_data.keywords:
						card.card_data.keywords.append("armored")
						card.state.temp_armored = true
						card.update_stat_display()
				"RALLY":
					# Same-row adjacency buff.
					for adj_card in _adjacent_in_row(true, row, lane_idx):
						adj_card.temp_atk_buff += 1
						adj_card.update_stat_display()
				"HEAL":
					card.current_hp = mini(card.current_hp + 3, card.card_data.hp)
					card.has_attacked_this_turn = true
					card.update_stat_display()
				"ENRAGE":
					card.current_atk += 2
					card.state.enrage_vulnerable = true
					card.update_stat_display()
				"RETREAT":
					card.state.will_retreat = true
				"SUMMON":
					# Adjacent empty in the same row.
					var adj_empty: Array[int] = []
					for adj in [lane_idx - 1, lane_idx + 1]:
						if adj >= 0 and adj < LANES_PER_ROW and arr[adj] == null:
							adj_empty.append(adj)
					if adj_empty.size() > 0:
						var target_lane = int(_combat_ops.pick(adj_empty))
						if not _reinforcement.is_empty():
							var data = _reinforcement.duplicate(true)
							data.id = _combat_ops.next_id("summon")
							_place_enemy_card(data, target_lane, row)
					card.has_attacked_this_turn = true
				"ABILITY":
					_resolve_enemy_ability(card, lane_idx)
					card.has_attacked_this_turn = true


func _resolve_enemy_ability(card: Control, lane_idx: int) -> void:
	## Resolves the creature-specific ability telegraphed by ABILITY intent.
	## 4x4: opposing-column lookups front-preferred; "all enemy" iterates both rows.
	var ability = card.card_data.get("ability", {})
	var ability_type = ability.get("type", "")
	match ability_type:
		"warcry":
			for c in _all_enemy_creatures():
				c.current_atk += ability.get("value", 1)
				c.update_stat_display()
		"steal_atk":
			var opp = _get_creature_in_column(false, lane_idx)
			if opp != null and opp.current_atk > 0:
				var steal = ability.get("value", 1)
				opp.current_atk = maxi(0, opp.current_atk - steal)
				card.current_atk += steal
				opp.update_stat_display()
				card.update_stat_display()
		"steal_command":
			var value: int = int(ability.get("value", 1))
			if value > 0:
				_bonus_mana_next_turn -= value
				_show_info("%s steals %d Command next round." \
					% [card.card_data.get("name", "Cutpurse"), value])
				_log_event("%s steals [color=#f2e6c8]%d Command[/color] next round." \
					% [_log_card_ref(card), value], _log_data(card), _log_side(card))
		"curse":
			_player_discard_pile.append(CardDB.random_curse_id())
		"devour":
			# Same-row adjacency.
			var pos = _find_creature_position(card)
			if pos.is_empty():
				return
			var row = pos.row
			var arr = _row_array(true, row)
			var adj: Array[int] = []
			if lane_idx > 0 and arr[lane_idx - 1] != null:
				adj.append(lane_idx - 1)
			if lane_idx < LANES_PER_ROW - 1 and arr[lane_idx + 1] != null:
				adj.append(lane_idx + 1)
			if adj.size() > 0:
				var target_lane = int(_combat_ops.pick(adj))
				var victim = arr[target_lane]
				if victim != null:
					card.current_atk += victim.effective_atk()
					card.current_hp += victim.current_hp
					card.card_data.hp += victim.current_hp
					victim.take_damage(999)
					arr[target_lane] = null
					card.update_stat_display()
		"terrify":
			var opp = _get_creature_in_column(false, lane_idx)
			if opp != null:
				var opp_pos = _find_creature_position(opp)
				if not opp_pos.is_empty():
					var opp_row = opp_pos.row
					var opp_arr = _row_array(false, opp_row)
					var empty_lanes: Array[int] = []
					for i in range(LANES_PER_ROW):
						if i != lane_idx and opp_arr[i] == null:
							empty_lanes.append(i)
					if empty_lanes.size() > 0:
						var new_lane = int(_combat_ops.pick(empty_lanes))
						opp_arr[lane_idx] = null
						_place_card_in_slot(opp, new_lane, opp_row)
						_restore_slot_label(_slot_array(false, opp_row)[lane_idx], lane_idx)
		"hex":
			var opp = _get_creature_in_column(false, lane_idx)
			if opp != null:
				opp.card_data.keywords.clear()
				opp.card_data.erase("sniper")
				opp.update_stat_display()
		"mark":
			var opp = _get_creature_in_column(false, lane_idx)
			if opp != null:
				opp.state.marked = true
		"resurrect":
			if not _last_dead_enemy_data.is_empty():
				var slot = _find_empty_enemy_slot()
				if not slot.is_empty():
					var data = _last_dead_enemy_data.duplicate(true)
					data.atk = 1
					data.hp = 1
					data.id = _combat_ops.next_id("resurrected")
					_place_enemy_card(data, slot.lane, slot.row)
		"heal_all":
			var value = ability.get("value", 2)
			for c in _all_enemy_creatures():
				c.current_hp = mini(c.current_hp + value, c.card_data.hp)
				c.update_stat_display()
		"drain":
			var opp = _get_creature_in_column(false, lane_idx)
			if opp != null:
				opp.take_damage(2)
			card.current_hp = mini(card.current_hp + 2, card.card_data.hp)
			card.update_stat_display()


# =====================================================================
#  BOSS PHASE SYSTEM
# =====================================================================

func _check_boss_phase_transition() -> void:
	## Check if enemy HP has dropped below a phase threshold.
	## If so, transition to the next phase.
	if _siege_active and not _siege_breached:
		return
	if _boss_phases.is_empty():
		return
	# Find current phase based on HP thresholds
	var new_phase := 0
	for i in range(_boss_phases.size()):
		if enemy_hp <= _boss_phases[i].threshold:
			new_phase = i + 1
	if new_phase > _boss_current_phase and new_phase < _boss_phases.size():
		_boss_current_phase = new_phase
		var phase_data = _boss_phases[new_phase]
		# Climactic banner overlay — the boss phase IS the moment of the run.
		# Banner pulls the existing `transition_msg` as the headline and the
		# new phase's `passive_desc` as the subtitle so the player both feels
		# the beat and reads the new rules in the same overlay.
		var phase_title: String = String(phase_data.get("transition_msg", "PHASE %d" % (new_phase + 1)))
		var phase_subtitle: String = String(phase_data.get("passive_desc", ""))
		# The banner is transient; the plaque is permanent. Both are fed the SAME
		# string so the two can never state different law — the plaque used to
		# keep phase 1's wording for the rest of the fight.
		_set_standing_rule(String(phase_data.passive_id), phase_subtitle)
		# Color ramps as phases escalate: phase 2 amber, phase 3+ crimson.
		var phase_color: Color = Color(1.0, 0.55, 0.30) if new_phase == 1 else Color(1.0, 0.30, 0.25)
		_show_combat_banner(phase_title, phase_subtitle, phase_color)
		screen_shake(15.0)
		screen_flash(Color(phase_color.r, phase_color.g, phase_color.b, 0.30), 0.35)
		presence_phase(phase_color)   # the antagonist leans in; the world tightens
		if AudioBank != null:
			AudioBank.play_sfx("spell_cast", 0.0, 2.0)
		# Also keep the info-label hint for accessibility (some players miss
		# the banner if it overlaps the boss intent reveal).
		if phase_data.has("transition_msg"):
			_show_info(phase_data.transition_msg)
		if phase_data.has("transition_effect"):
			_execute_phase_transition(phase_data.transition_effect)
		for c in _all_enemy_creatures():
			c.state.intent_cycle_pos = 0


func _execute_phase_transition(effect: Dictionary) -> void:
	## Executes a boss phase transition effect.
	match effect.get("type", ""):
		"summon":
			var slot = _find_empty_enemy_slot()
			if not slot.is_empty():
				var data = {
					"id": _combat_ops.next_id("phase_summon"),
					"name": effect.get("name", "Minion"),
					"type": "creature", "cost": 0,
					"atk": effect.get("atk", 2), "hp": effect.get("hp", 3),
					"rarity": "enemy",
					"keywords": effect.get("kw", []).duplicate(),
					"desc": "",
				}
				_place_enemy_card(data, slot.lane, slot.row)
		"summon_multiple":
			var count = effect.get("count", 2)
			for _i in range(count):
				var slot2 = _find_empty_enemy_slot()
				if slot2.is_empty():
					break
				var data = {
					"id": _combat_ops.next_id("phase_summon"),
					"name": effect.get("name", "Minion"),
					"type": "creature", "cost": 0,
					"atk": effect.get("atk", 2), "hp": effect.get("hp", 3),
					"rarity": "enemy",
					"keywords": effect.get("kw", []).duplicate(), "desc": "",
				}
				_place_enemy_card(data, slot2.lane, slot2.row)
		"heal_all_enemies":
			var value = effect.get("value", 2)
			for c in _all_enemy_creatures():
				c.current_hp = mini(c.current_hp + value, c.card_data.hp)
				c.update_stat_display()
		"buff_all_enemies_atk":
			var value = effect.get("value", 1)
			for c in _all_enemy_creatures():
				c.current_atk += value
				c.update_stat_display()
		"debuff_all_player_atk":
			var value = effect.get("value", 1)
			for c in _all_player_creatures():
				c.current_atk = maxi(0, c.current_atk - value)
				c.update_stat_display()


# =====================================================================
#  REACTIVE PASSIVES
# =====================================================================

func _dispatch_reactive(trigger: String, source_card: Control, _lane_idx: int) -> void:
	# Mark the plaque when the fight's OWN rule is what just acted. Skirmish
	# pulses the foe's arsenal chip for exactly this reason (_pulse_relic_chip):
	# a rule that fires invisibly reads as the game cheating. Gated on this
	# encounter really carrying a reactive entry for THIS trigger, so the plaque
	# only ever moves when something actually happened.
	var react: Dictionary = EncounterDB.get_reactive_passive(_encounter_id)
	if not react.is_empty() and String(react.get("trigger", "")) == trigger:
		_pulse_passive_plaque()
	EncounterEffects.dispatch_reactive(self, trigger, source_card, _lane_idx)


func _pulse_passive_plaque() -> void:
	## The standing-rule plaque is the ONLY place a fight's special rule lives,
	## and it never moved — so a reactive passive firing was invisible unless the
	## player already knew to expect it. This is the solo twin of the skirmish
	## arsenal-chip pulse, and it goes through one funnel for the same reason
	## _relic_fired does: new trigger sites report here rather than animating the
	## plaque themselves.
	##
	## Debounced, because several triggers can land inside one beat (a clash that
	## kills three bodies fires ON_CREATURE_DEATH three times) and three stacked
	## punches read as a glitch rather than an event.
	##
	## INFORMATIONAL, SO IT MUST SURVIVE REDUCE MOTION (2026-07-28). `Motion.punch`
	## returns early under Reduce Motion, and this punch is the ONLY evidence a
	## reactive passive fired at all — so a Reduce Motion player got literally
	## nothing when the fight's special rule triggered. That is the house rule
	## backwards: informational cues always play, they just hold steady instead of
	## pulsing. Under Reduce Motion we light the plaque and hold it lit, then let it
	## cool, which is a state change rather than a motion.
	if _passive_banner == null or not is_instance_valid(_passive_banner):
		return
	if _passive_pulse_guard:
		return
	_passive_pulse_guard = true
	get_tree().create_timer(0.35).timeout.connect(
		func(): _passive_pulse_guard = false)
	if UserSettings != null and UserSettings.reduce_motion:
		_hold_passive_plaque_lit()
		return
	Motion.punch(_passive_banner, 1.10)


## Reduce Motion's stand-in for the plaque punch: raise the plaque to a hot tint,
## hold it there long enough to be noticed, then ease back to its rest colour. No
## scale, no shake — only the colour moves, and it moves slowly.
func _hold_passive_plaque_lit() -> void:
	if _passive_banner == null or not is_instance_valid(_passive_banner):
		return
	var lbl := _passive_banner
	if not (lbl is Label or lbl is RichTextLabel):
		return
	var key := "font_color" if lbl is Label else "default_color"
	var rest: Color = lbl.get_theme_color(key)
	lbl.add_theme_color_override(key, Color(1.0, 0.86, 0.46))
	var tw := lbl.create_tween()
	tw.tween_interval(0.55)
	tw.tween_method(func(c: Color):
			if is_instance_valid(lbl):
				lbl.add_theme_color_override(key, c),
		Color(1.0, 0.86, 0.46), rest, 0.40)


# =====================================================================
#  ESCALATION MECHANICS
# =====================================================================

func _check_escalation() -> void:
	## Checks if escalation timer has triggered and applies buffs.
	var enc = EncounterDB.get_encounter(_encounter_id) if _encounter_id != "" else {}
	var enc_type = enc.get("type", "combat")

	match enc_type:
		"combat":
			# Drip reinforcements harden as the fight wears on. The round-N
			# double-place itself lives in _post_combat_sequence; this is the
			# later "they're sending tougher bodies now" tier.
			if round_number >= _esc_round(ESCALATION_REINFORCE_BUFF_ROUND):
				_reinforcement["atk"] = _reinforcement.get("atk", 1) + 1
				_reinforcement["hp"] = _reinforcement.get("hp", 1) + 1
		"elite":
			if round_number >= _esc_round(ESCALATION_ELITE_BUFF_ROUND):
				# NAME THE CAUSE (2026-07-28). This gives EVERY enemy body a
				# permanent +1 ATK, and its only evidence was the incidental float
				# that `update_stat_display` throws — four or five "+1 ATK" rising
				# at once with nothing saying why. Four simultaneous unexplained
				# buffs is the exact shape players read as the game cheating. The
				# floats stay (they carry the per-body number); this adds the
				# sentence that makes them a decision the General made.
				var esc_n := 0
				for c in _all_enemy_creatures():
					c.current_atk += 1
					c.update_stat_display()
					esc_n += 1
				if esc_n > 0:
					_show_info("The General presses the attack - his line gains +1 attack.")
		"boss":
			if _siege_active and not _siege_breached:
				return
			# Boss escalation handled by phase transitions
			# Auto-transition if stalled 10+ rounds in Phase 1
			if round_number >= _esc_round(ESCALATION_BOSS_STALL_ROUND) and _boss_current_phase == 0 and not _boss_phases.is_empty():
				_boss_current_phase = 1
				var phase_data = _boss_phases[1] if _boss_phases.size() > 1 else _boss_phases[0]
				# Through the funnel like the HP-threshold turn. This path shows
				# NO banner (only the info line), so the plaque is the ONLY place
				# the player can read what the boss just became.
				_set_standing_rule(String(phase_data.passive_id),
					String(phase_data.get("passive_desc", "")))
				if phase_data.has("transition_msg"):
					_show_info(phase_data.transition_msg)
				# Mirror the normal HP-threshold transition: a stall-forced phase
				# change must still run the phase's board effect, or the player who
				# stalls in gets a half-applied (weaker) boss.
				if phase_data.has("transition_effect"):
					_execute_phase_transition(phase_data.transition_effect)


# =====================================================================
#  POST-COMBAT CLEANUP (temp effects from intents and floops)
# =====================================================================

func _post_combat_cleanup() -> void:
	## Cleans up temporary effects from intents and floops at end of round.
	## 4x4: iterate both rows on both sides.
	# The enemy-relocation ledger is cleared HERE, not in _start_round (2026-07-28).
	# RETREAT — the only AI-driven enemy move in solo — is executed by the loop
	# below, so a clear at the top of the next round wiped the record before the
	# player's turn ever saw it. Cleared here, the reading becomes "moved since
	# your last chance to act", which is the only one that makes the clause real.
	_enemy_changed_columns_this_round.clear()
	for is_enemy in [false, true]:
		for row in [ROW_FRONT, ROW_BACK]:
			var field = _row_array(is_enemy, row)
			for lane_idx in range(LANES_PER_ROW):
				var card = field[lane_idx]
				if card == null:
					continue
				if card.state.temp_armored:
					card.card_data.keywords.erase("armored")
				if card.state.temp_thorns:
					card.card_data.keywords.erase("thorns")
				if card.state.temp_poison:
					card.card_data.keywords.erase("poison")
				if card.state.temp_piercing:
					card.card_data.keywords.erase("piercing")
				# tick_end_of_round() clears EVERY per-round flag on the instance
				# (stun, freeze, the temp grants, the Charge!/Rain riders, marked,
				# enrage, retreat). The long tail of remove_meta calls that used to
				# sit around it predates the CreatureInstance migration and was all
				# dead - nothing calls set_meta for any of those keys.
				#
				# will_retreat MUST be read BEFORE the tick or the intent is
				# unreachable: the old code tested it AFTER, by which point the tick
				# had already zeroed it, so _execute_retreat never ran once.
				var retreating: bool = card.state.will_retreat
				card.state.tick_end_of_round()
				if retreating:
					_execute_retreat(card, lane_idx, row, is_enemy)


func _execute_retreat(card: Control, lane_idx: int, row: int, is_enemy: bool) -> void:
	## Moves a creature to a random different lane in the same row (RETREAT intent).
	var field = _row_array(is_enemy, row)
	var empty_lanes: Array[int] = []
	for i in range(LANES_PER_ROW):
		if i != lane_idx and field[i] == null:
			empty_lanes.append(i)
	if empty_lanes.size() > 0:
		var new_lane = int(_combat_ops.pick(empty_lanes))
		_relocate_creature(card, is_enemy, row, new_lane)


# =====================================================================
#  ENCOUNTER SCRIPTS — scripted moments per round (Slay-the-Spire style).
# =====================================================================

func _run_encounter_script(round_num: int) -> void:
	## Iterates the encounter script and fires any entries matching this
	## round. Used by regular fights to inject narrative beats (reinforcements,
	## global buffs, environmental damage) that the player can plan around.
	if _encounter_script.is_empty():
		return
	for entry in _encounter_script:
		if int(entry.get("round", -1)) != round_num:
			continue
		_show_event_banner(entry.get("msg", ""))
		_apply_script_event(entry)


func _apply_script_event(entry: Dictionary) -> void:
	## Resolves a single scripted-event entry. Keep this dispatcher focused —
	## events should be small, telegraphed, and individually understandable.
	match entry.get("event", ""):
		"summon":
			# Drop a thematic creature into the first available enemy slot.
			var card_data: Dictionary = {
				"id": _combat_ops.next_id("scripted"),
				"name": entry.get("name", "Reinforcement"),
				"type": "creature", "cost": 0,
				"atk": int(entry.get("atk", 2)),
				"hp": int(entry.get("hp", 2)),
				"rarity": "enemy",
				"keywords": entry.get("kw", []).duplicate() if entry.has("kw") else [],
				"desc": "",
			}
			# Try front row first, then back; abort if board is full.
			for row in [ROW_FRONT, ROW_BACK]:
				var arr = _row_array(true, row)
				for lane in range(LANES_PER_ROW):
					if arr[lane] == null:
						_place_enemy_card(card_data, lane, row)
						return
		"buff_all_atk":
			var v: int = int(entry.get("value", 1))
			for c in _all_enemy_creatures():
				c.current_atk += v
				c.update_stat_display()
		"buff_all_hp":
			var v: int = int(entry.get("value", 1))
			for c in _all_enemy_creatures():
				c.card_data.hp += v
				c.current_hp += v
				c.update_stat_display()
		"grant_keyword_all":
			var kw: String = entry.get("keyword", "")
			if kw == "":
				return
			for c in _all_enemy_creatures():
				var keys = c.card_data.get("keywords", [])
				if kw not in keys:
					keys.append(kw)
					c.card_data["keywords"] = keys
		"face_damage":
			damage_player_hero(int(entry.get("value", 1)))
		"heal_all":
			var v: int = int(entry.get("value", 1))
			for c in _all_enemy_creatures():
				c.current_hp = mini(c.current_hp + v, c.card_data.hp)
				c.update_stat_display()


func _show_event_banner(msg: String) -> void:
	## Brief banner in the center of the screen announcing a scripted event.
	## Auto-dismisses; non-blocking so the round flow can continue.
	if msg == "":
		return
	var banner := Label.new()
	banner.text = msg
	banner.add_theme_font_override("font", GameTheme.font_display)
	banner.add_theme_font_size_override("font_size", 38)
	banner.add_theme_color_override("font_color", Color(1.0, 0.85, 0.30))
	banner.add_theme_color_override("font_outline_color", Color(0, 0, 0, 0.95))
	banner.add_theme_constant_override("outline_size", 6)
	banner.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	banner.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	banner.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	banner.mouse_filter = Control.MOUSE_FILTER_IGNORE
	banner.z_index = 100
	add_child(banner)
	var tween = create_tween()
	tween.tween_property(banner, "modulate:a", 1.0, 0.25).from(0.0)
	tween.tween_interval(1.6)
	tween.tween_property(banner, "modulate:a", 0.0, 0.4)
	tween.tween_callback(banner.queue_free)


# =====================================================================
#  ENCOUNTER PASSIVES
# =====================================================================

func _dispatch_passive_start_of_round() -> void:
	_passive_speaking = true
	EncounterEffects.dispatch_passive_start_of_round(self)
	_passive_speaking = false
	# THE BELLRINGER boss (Act 2). Its doom_bell passive lives here rather than
	# in EncounterEffects so the whole signature — the toll cadence, the host
	# buff, the deploy — sits in one readable place alongside the combat helpers
	# (_find_empty_enemy_slot / _place_enemy_card / _show_combat_banner) it
	# reuses. Runs AFTER KeywordEffects.dispatch_start_of_round (which ticks the
	# existing Doomspawn countdowns), so a freshly-tolled bomb starts its clock
	# clean this round instead of losing a tick the instant it lands.
	if _encounter_passive == "doom_bell":
		_doom_bell_start_of_round()


func _dispatch_passive_end_of_round() -> void:
	_passive_speaking = true
	EncounterEffects.dispatch_passive_end_of_round(self)
	_passive_speaking = false


# ── THE BELLRINGER — doom_bell signature ─────────────────────────────────────
# A telegraphed doomsday clock built on the `doom` keyword. Every other round
# the bell TOLLS and deploys a "Cinder" bomb-creature (Doom 2) into an empty
# enemy lane; its on-board countdown ticks 2 → 1 → DETONATE (face damage via the
# canonical KeywordEffects doom path). The player must triage and kill it in
# time. The "ignoring it is costly" lever: while ANY Doomspawn is still ticking,
# every other enemy creature swings +1 ATK this round (the toll empowers the
# host). Round 6 cracks the bell — a DOUBLE peal drops two bombs at once.
func _doom_bell_start_of_round() -> void:
	# Setup round is combat-free; the first toll lands going into round 2.
	if round_number < 2:
		return
	# Host buff: if a bomb is currently ticking on the board, the Bellringer's
	# standing creatures hit harder this round. temp_atk_buff (cleared each
	# round) keeps it a per-round pressure beat, not permanent snowball.
	var has_live_bomb := false
	for c in _all_enemy_creatures():
		if c.has_keyword("doom"):
			has_live_bomb = true
			break
	if has_live_bomb:
		for c in _all_enemy_creatures():
			if not c.has_keyword("doom"):
				c.temp_atk_buff += 1
				c.update_stat_display()
	# Toll cadence: every other round (2, 4, 6, …). Round 6 is the cracked
	# double peal. Skip the toll if the board is full — no empty lane to drop
	# a bomb into — so it never silently no-ops mid-swarm.
	if round_number % 2 != 0:
		return
	var peals: int = 2 if round_number >= 6 else 1
	var tolled := false
	for _i in range(peals):
		var slot := _find_empty_enemy_slot()
		if slot.is_empty():
			break
		var bomb := {
			"id": _combat_ops.next_id("doom_bell"),
			"name": "Cinder",  # reuses the torchbearer art alias (a walking fuse)
			"type": "creature", "cost": 0,
			"atk": 2, "hp": 3, "rarity": "enemy",
			"keywords": ["doom"], "doom": 2, "doom_damage": 6,
			"desc": "",
		}
		_place_enemy_card(bomb, slot.lane, slot.row)
		tolled = true
	if tolled:
		var subtitle := "Two fuses are lit." if peals >= 2 else "A fuse is lit — kill it before it blows."
		_show_combat_banner("☼ THE BELL TOLLS ☼", subtitle, Color(1.0, 0.42, 0.16))
		screen_shake(8.0)
		if AudioBank != null:
			AudioBank.play_sfx("hit_hero")


# =====================================================================
#  MUTATORS — per-fight modifiers attached to map nodes
# =====================================================================

func _init_mutator_state() -> void:
	# Reads RunState.current_mutator_id and caches the per-hook effect dicts
	# into typed combat fields. Hooks below read those fields directly so
	# combat code stays branch-light at the call site.
	# Online skirmish (v1) runs mutator-free — clear and bail so a leftover
	# campaign mutator can't arm enemy buffs in a net fight.
	if _is_net():
		_mutator_id = ""
		_mutator_data = {}
		return
	_mutator_id = RunState.current_mutator_id
	# Daily March: today's omen fills every fight that didn't roll its own
	# node mutator, so the whole run carries the day's weather. Node mutators
	# (and their gold bonus) still win when present.
	if _mutator_id == "" and RunState.is_daily_run \
			and MutatorDB.exists(RunState.daily_mutator_id):
		_mutator_id = RunState.daily_mutator_id
	if _mutator_id == "" or not MutatorDB.exists(_mutator_id):
		_mutator_id = ""
		_mutator_data = {}
		return
	_mutator_data = MutatorDB.get_mutator(_mutator_id)
	# on_enemy_enter: grant keyword OR stat buff to every enemy placed.
	var e_enter: Dictionary = _mutator_data.get("on_enemy_enter", {})
	match String(e_enter.get("kind", "")):
		"grant_keyword":
			_mutator_enemy_keyword = String(e_enter.get("value", ""))
		"buff_atk":
			_mutator_enemy_atk_buff = int(e_enter.get("value", 0))
		"buff_hp":
			_mutator_enemy_hp_buff = int(e_enter.get("value", 0))
		"grant_doom":
			# "Doomed" — front-row enemies enter as ticking bombs (handled in
			# _mutator_apply_to_enemy so back-row queue creatures stay clean).
			_mutator_enemy_doom = int(e_enter.get("value", 0))
		"buff_hp_regen":
			# "Overgrown" — +N HP AND Regenerate on every enemy.
			_mutator_enemy_regen_hp = int(e_enter.get("value", 0))
	# on_player_creature_enter: grant keyword OR weaken HP on player plays.
	var p_enter: Dictionary = _mutator_data.get("on_player_creature_enter", {})
	match String(p_enter.get("kind", "")):
		"grant_player_keyword":
			_mutator_player_keyword = String(p_enter.get("value", ""))
		"weaken_player_creature_hp":
			_mutator_weaken_player_hp = int(p_enter.get("value", 0))
	# on_round_start: most commonly per-round chip damage on the front row.
	var r_start: Dictionary = _mutator_data.get("on_round_start", {})
	if String(r_start.get("kind", "")) == "damage_player_front":
		_mutator_burn_per_round = int(r_start.get("value", 0))
	# on_combat_start: one-shot adjustments to combat globals.
	var c_start: Dictionary = _mutator_data.get("on_combat_start", {})
	match String(c_start.get("kind", "")):
		"spell_cost_increase":
			_mutator_spell_cost_increase = int(c_start.get("value", 0))
		"hand_draw_reduce":
			_mutator_hand_draw_reduce = int(c_start.get("value", 0))
		"hand_draw_increase":
			_mutator_hand_draw_increase = int(c_start.get("value", 0))
		"max_mana_increase":
			_mutator_max_mana_increase = int(c_start.get("value", 0))
		"enemy_double_on_death":
			_mutator_double_enemy_on_death = true
		"damage_player_now":
			# "Scarred" — apply a one-shot HP haircut RIGHT NOW so the fight
			# opens with the player visibly battered. Floor at 1 so it can
			# never instantly kill on entry. Propagates to RunState so the
			# damage persists past combat (the price of taking the fight).
			_mutator_scarred_dmg = int(c_start.get("value", 0))
			if _mutator_scarred_dmg > 0:
				var new_hp: int = maxi(1, player_hp - _mutator_scarred_dmg)
				var actual: int = player_hp - new_hp
				player_hp = new_hp
				RunState.hero_hp = maxi(1, RunState.hero_hp - actual)


func _mutator_apply_to_enemy(card: Control) -> void:
	# Called from _place_enemy_card for every enemy creature placed (initial
	# lineup, reinforcement, encounter scripts). No-ops when no mutator.
	if _mutator_id == "":
		return
	if _mutator_enemy_keyword != "" and not card.has_keyword(_mutator_enemy_keyword):
		card.card_data.keywords.append(_mutator_enemy_keyword)
	if _mutator_enemy_atk_buff != 0:
		card.current_atk = maxi(0, card.current_atk + _mutator_enemy_atk_buff)
	if _mutator_enemy_hp_buff != 0:
		card.current_hp += _mutator_enemy_hp_buff
		card.card_data.hp = int(card.card_data.get("hp", 1)) + _mutator_enemy_hp_buff
	# "Overgrown": +N HP and Regenerate on every enemy. Stacks on top of the
	# card's own keywords; the start-of-round Regenerate tick heals it back up.
	if _mutator_enemy_regen_hp > 0:
		card.current_hp += _mutator_enemy_regen_hp
		card.card_data.hp = int(card.card_data.get("hp", 1)) + _mutator_enemy_regen_hp
		if not card.has_keyword("regenerate"):
			card.card_data.keywords.append("regenerate")
	# "Doomed": only FRONT-row enemies become ticking bombs. Seed the doom keyword
	# + counter + a fixed detonation value so it reads the same as a real Doom
	# creature; the canonical dispatch_start_of_round tick + _detonate_doom path
	# handles the countdown and explosion. Skip if it's already a Doom creature.
	if _mutator_enemy_doom > 0 and card.current_row == ROW_FRONT and not card.has_keyword("doom"):
		card.card_data.keywords.append("doom")
		card.card_data["doom"] = _mutator_enemy_doom
		if not card.card_data.has("doom_damage"):
			card.card_data["doom_damage"] = maxi(1, card.current_atk)
		if card.has_method("_ensure_doom_init"):
			card._ensure_doom_init()
		if card.has_method("update_doom_display"):
			card.update_doom_display()


func _mutator_apply_to_player_creature(card: Control) -> void:
	# Called from _play_creature after the card has landed in its slot.
	if _mutator_id == "":
		return
	if _mutator_player_keyword != "" and not card.has_keyword(_mutator_player_keyword):
		card.card_data.keywords.append(_mutator_player_keyword)
	if _mutator_weaken_player_hp > 0:
		var new_hp: int = maxi(1, card.current_hp - _mutator_weaken_player_hp)
		card.current_hp = new_hp


func _mutator_round_start_tick() -> void:
	# Called from _start_round AFTER the standard round-start tasks. Currently
	# only "burning" uses this; future round-start mutators slot in here.
	if _mutator_id == "" or _mutator_burn_per_round <= 0:
		return
	for lane in range(LANES_PER_ROW):
		var card = _player_field[lane]
		if card != null and is_instance_valid(card) and card.current_hp > 0:
			card.take_damage_bypass_armor(_mutator_burn_per_round)


func has_mutator() -> bool:
	return _mutator_id != ""


func mutator_doubles_enemy_on_death() -> bool:
	# Exposed for KeywordEffects.dispatch_on_death so the "Frenzied" mutator
	# can amplify enemy on-death effects without needing a sentinel passive.
	return _mutator_double_enemy_on_death


# =====================================================================
#  SET-PIECE HOLDS — the named actions of the war
# =====================================================================
##
## An authored scenario fought on the ordinary combat engine: an opening board
## someone placed on purpose, ONE twisted rule, and an objective that is not
## "kill the face," carrying a deadline. See scripts/data/SetPieceDB.gd for the
## schema, the five objective kinds, and the design rationale.
##
## THE CONTRACT WITH THE REST OF COMBAT:
##  · A set-piece is a `combat` node wearing a `setpiece_id`. Node type, music,
##    gold, conquest tally and scene routing are all untouched.
##  · Failure is NOT death. When the clock runs out the army WITHDRAWS — the
##    toll is paid in HP, no trophy is granted, and the march continues. Dying
##    the ordinary way (HP 0) still ends the run, through the ordinary path.
##  · Every entry point below no-ops in skirmish and on ordinary holds, so the
##    hot paths cost one `_sp_id == ""` string compare.
##
## Verify: tools/_probe_setpiece.gd (headless).

func is_set_piece() -> bool:
	return _sp_id != ""


## Called from _setup_fight_state INSTEAD of the encounter branch. A set-piece
## supplies its own face HP, deck and reinforcement, so nothing is read from
## EncounterDB — but the bodies themselves are built THROUGH make_card_data, so
## they inherit the exact enemy card schema (and its authored-flag whitelist).
func _sp_setup_fight_state() -> void:
	_sp_data = SetPieceDB.get_set_piece(_sp_id)
	if _sp_data.is_empty():
		_sp_id = ""
		return
	_sp_objective = _sp_data.get("objective", {})
	_sp_deadline = int(_sp_objective.get("rounds", 0))
	_sp_closed_lanes.clear()
	for lane in SetPieceDB.closed_lanes(_sp_id):
		var l: int = int(lane)
		if l >= 0 and l < LANES_PER_ROW:
			_sp_closed_lanes.append(l)
	_encounter_id = ""
	_encounter_faction = ""
	_wave_schedule_active = false
	_encounter_name = String(_sp_data.get("name", "A Named Action"))
	_encounter_passive = ""
	# The GROUND is the fight's standing rule, stated in the despatch the player
	# must read and dismiss before round 1. It does NOT ride the encounter rule
	# plaque: `_encounter_passive` is blanked just above, and that plaque is
	# keyed on the ID — so despite what this comment claimed until 2026-07-27,
	# the ground text has never appeared there. The objective and its clock hold
	# that slot instead (see _sp_build_plaque), which is the running readout a
	# named action actually promises. Posting the ground permanently as well is a
	# deliberate design call, not a bug fix — it would want its own layout pass.
	_encounter_passive_desc = String(_sp_data.get("ground", {}).get("text", ""))
	_encounter_preamble = ""
	_encounter_script = []
	_reactive_passive = {}
	_boss_phases = []
	_enemy_deck = SetPieceDB.build_deck(_sp_id)
	# NOT shuffled. An authored scenario means the order the reinforcements
	# arrive in is part of the problem — a shuffle would make the same named
	# ground play differently every time, which is the one thing a set-piece
	# is not for.
	_reinforcement = SetPieceDB.get_reinforcement(_sp_id)
	enemy_max_hp = _scale_enemy_hp(int(_sp_data.get("hp", 20)), "combat")
	enemy_hp = enemy_max_hp


## Called from _place_starting_board INSTEAD of the random count/formation roll.
## Places BOTH sides' authored openings; a set-piece is the only path in the
## game that seats a player creature before round 1 other than a gift.
func _sp_place_opening() -> void:
	for entry in SetPieceDB.build_opening(_sp_id, "enemy"):
		_place_enemy_card(entry.data, int(entry.lane), int(entry.row), false)
	# Identify the marked body AFTER the whole opening is seated, by its
	# card_data flag rather than by the slot it was asked for: _place_enemy_card
	# is allowed to redirect an arrival, and reading back the requested slot
	# could silently lose the mark — which would make the objective unwinnable.
	for e in _all_enemy_creatures():
		if is_instance_valid(e) and bool(e.card_data.get("sp_mark", false)):
			_sp_marked = e
			e.set_meta("sp_mark", true)
			break
	for entry in SetPieceDB.build_opening(_sp_id, "player"):
		var data: Dictionary = entry.data
		var lane: int = int(entry.lane)
		var row: int = int(entry.row)
		if _row_array(false, row)[lane] != null:
			continue
		# Seated by hand rather than through summon_token: the authored body
		# must land at EXACTLY the printed statline, and summon_token layers
		# Conscription / Sharpened Pitchforks / Standard Bearer riders onto
		# every token it makes. A scenario whose warded cart quietly gains +1/+1
		# from a relic is a scenario that no longer means what the brief said.
		var card = CARD_SCENE.instantiate()
		card.card_id = String(data.get("id", "sp_body"))
		card.is_opponent = false
		card.is_on_battlefield = true
		card.is_token = true      # not from the deck: never files into a pile
		card.compact_mode = true
		card.card_data = data
		card.current_atk = int(data.get("atk", 0))
		card.current_hp = int(data.get("hp", 1))
		card.current_lane = lane
		card.current_row = row
		_row_array(false, row)[lane] = card
		_slot_set_card(_slot_array(false, row)[lane], card)
		card.destroyed.connect(_on_card_destroyed.bind(card))
		card.will_die.connect(_on_card_will_die.bind(card))
		_play_landing_pop(card)
		if bool(data.get("sp_ward", false)):
			_sp_ward = card
			card.set_meta("sp_ward", true)
	_refresh_adjacency_buffs()


## True when a lane is closed ground for this fight — no body of either side
## may hold it. The ONE twisted rule that needs a gate rather than a hook, so
## it is checked at exactly three places: the player's drop (_play_creature),
## every enemy arrival (_place_enemy_card, the same choke point Salted Ground
## already uses), and the enemy's empty-slot search.
func _sp_lane_closed(lane: int) -> bool:
	return not _sp_closed_lanes.is_empty() and _sp_closed_lanes.has(lane)


## Record a death for objective purposes. Called from the death path for BOTH
## sides, before the body is freed.
func _sp_note_death(card: Control) -> void:
	if _sp_id == "" or card == null:
		return
	if card == _sp_marked or card.has_meta("sp_mark"):
		_sp_mark_broken = true
		_sp_marked = null
		return
	if card == _sp_ward or card.has_meta("sp_ward"):
		_sp_ward_lost = true
		_sp_ward = null
		return
	# THE EAGLE RULE — while the marked bearer still stands, every OTHER enemy
	# that falls is queued to stand back up at the end of the round. Queued at
	# death (the card is about to be freed) rather than rebuilt at round end,
	# so what returns is exactly what fell.
	if bool(_sp_data.get("rules", {}).get("revive_while_mark", false)) \
			and not _sp_mark_broken and card.is_opponent and not card.is_token:
		var body: Dictionary = card.card_data.duplicate(true)
		body.erase("on_enter")   # standing back up is not arriving
		_sp_revive_queue.append(body)


## THE EAGLE RULE, resolved. Runs at round end, before the objective is
## evaluated — the bodies are back up when the clock is read, which is what
## makes the rule frightening rather than academic.
func _sp_end_of_round_revive() -> void:
	if _sp_id == "" or _sp_revive_queue.is_empty():
		return
	if _sp_mark_broken:
		# The standard is down. Everything queued this round stays down too —
		# that is the whole promise the objective makes.
		_sp_revive_queue.clear()
		return
	var risen: int = 0
	for body in _sp_revive_queue:
		var slot: Dictionary = _find_empty_enemy_slot()
		if slot.is_empty():
			break
		_place_enemy_card(body, int(slot.lane), int(slot.row), true)
		risen += 1
	_sp_revive_queue.clear()
	if risen > 0:
		_show_combat_banner("THE EAGLE IS STILL UP",
			"%d of the dead get back in line" % risen, Color(0.72, 0.62, 0.86))
		_log_event("The standard holds. %d of the fallen stand back up." % risen,
			{}, 1)
		if AudioBank != null:
			AudioBank.play_sfx("creature_death", 0.0, 0.0, 0.7)


## ─────────────────────────────────────────────────────────────────────────
##  THE DESPATCH — the scenario brief, shown once before the first round
## ─────────────────────────────────────────────────────────────────────────
##
## An ordinary hold gets a banner that FLASHES its name; a named action gets a
## page you READ. That difference is the whole point — a set-piece asks the
## player to plan against a stated problem, and a 0.8s banner cannot carry a
## problem statement. So this is dismissed by the player, not by a timer.
##
## Everything the brief prints is a promise the fight then keeps: the ground,
## the order, the trophy, and the toll. Nothing is withheld for a surprise —
## surprises belong to the foe's hand ([[enemy-is-real-opponent]]), never to
## the rules of the ground you agreed to fight on.
func _sp_show_despatch() -> void:
	if _sp_id == "" or _hud_layer == null or not is_instance_valid(_hud_layer):
		return
	# Headless (probes / autorun) never blocks on a read-and-dismiss page.
	if DisplayServer.get_name() == "headless":
		return
	var vp: Vector2 = get_viewport_rect().size
	var reduce: bool = UserSettings != null and UserSettings.reduce_motion

	var scrim := ColorRect.new()
	scrim.set_anchors_preset(Control.PRESET_FULL_RECT)
	scrim.color = Color(0.02, 0.015, 0.01, 0.0)
	scrim.mouse_filter = Control.MOUSE_FILTER_STOP   # the board is not live yet
	scrim.z_index = 244
	_hud_layer.add_child(scrim)

	# The despatch itself — a parchment sheet, chamfered and tacked, the same
	# document furniture every other panel in the game is cut from.
	var sheet := PanelContainer.new()
	sheet.z_index = 246
	sheet.add_theme_stylebox_override("panel", GameTheme.make_panel_style(
		Color(0.13, 0.105, 0.074, 0.985), GameTheme.GILT_BRIGHT, 2, 9, true, true))
	sheet.custom_minimum_size = Vector2(minf(vp.x * 0.62, 880.0), 0)
	sheet.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	sheet.set_anchors_preset(Control.PRESET_CENTER)

	var holder := CenterContainer.new()
	holder.set_anchors_preset(Control.PRESET_FULL_RECT)
	holder.mouse_filter = Control.MOUSE_FILTER_IGNORE
	holder.z_index = 246
	_hud_layer.add_child(holder)
	holder.add_child(sheet)

	var pad := MarginContainer.new()
	for side in ["left", "right"]:
		pad.add_theme_constant_override("margin_%s" % side, 40)
	pad.add_theme_constant_override("margin_top", 26)
	pad.add_theme_constant_override("margin_bottom", 24)
	sheet.add_child(pad)

	var col := VBoxContainer.new()
	col.add_theme_constant_override("separation", 12)
	pad.add_child(col)

	# ── Eyebrow: what KIND of page this is, before the name of it ──
	var eyebrow := _make_text_label("A NAMED ACTION", 15, Color(0.78, 0.64, 0.38))
	eyebrow.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	col.add_child(eyebrow)

	var title := _make_text_label(String(_sp_data.get("name", "")), 44, IVORY)
	if GameTheme.font_display != null:
		title.add_theme_font_override("font", GameTheme.font_display)
	title.add_theme_color_override("font_outline_color", Color(0.35, 0.14, 0.04, 0.95))
	title.add_theme_constant_override("outline_size", 7)
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	col.add_child(title)

	col.add_child(_sp_rule_line(GameTheme.GILT_BRIGHT, 0.75))

	# ── The situation. Body font, generous measure, no theatre. ──
	var brief := _make_text_label(String(_sp_data.get("brief", "")), 19,
		Color(0.93, 0.87, 0.74))
	if GameTheme.font_card_body != null:
		brief.add_theme_font_override("font", GameTheme.font_card_body)
	brief.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	brief.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	col.add_child(brief)

	# ── THE GROUND — oxblood, because the twisted rule is the foe's law, the
	#    same colour it will wear on the standing plaque all fight. ──
	var ground: Dictionary = _sp_data.get("ground", {})
	if String(ground.get("text", "")) != "":
		col.add_child(_sp_brief_block(
			"THE GROUND · %s" % String(ground.get("name", "")).to_upper(),
			String(ground.get("text", "")),
			Color(0.62, 0.26, 0.17, 0.95), Color(1.0, 0.74, 0.52)))

	# ── THE ORDER — gilt, because it is yours. ──
	col.add_child(_sp_brief_block(
		"THE ORDER",
		String(_sp_objective.get("label", "")),
		GameTheme.GILT_BRIGHT, Color(1.0, 0.93, 0.74)))

	# ── The stakes, stated before the player can possibly commit to them. ──
	var trophy_id := String(_sp_data.get("trophy", {}).get("relic", ""))
	var stake_bits: Array[String] = []
	if trophy_id != "":
		stake_bits.append("Carry the field: %s" \
			% String(RelicDB.get_relic(trophy_id).get("name", trophy_id)))
	var purse: int = int(_sp_data.get("gold", 0))
	if purse > 0:
		stake_bits.append("%d gold" % purse)
	var toll: int = int(_sp_data.get("toll", 0))
	if toll > 0:
		stake_bits.append("Fail the order and the army withdraws — %d HP" % toll)
	if not stake_bits.is_empty():
		col.add_child(_sp_rule_line(Color(0.55, 0.46, 0.30), 0.55))
		var stakes := _make_text_label("  ·  ".join(stake_bits), 16,
			Color(0.84, 0.77, 0.60))
		stakes.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		stakes.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		col.add_child(stakes)

	var take := GameTheme.make_themed_button("START THE FIGHT",
		Color(0.28, 0.17, 0.09), Vector2(260, 50), 22)
	take.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	col.add_child(take)
	GameTheme.hover_lift(take)

	# ── Entrance. Decorative: gated, and the end state is what matters. ──
	if reduce:
		scrim.color.a = 0.72
	else:
		sheet.pivot_offset = sheet.size * 0.5
		sheet.scale = Vector2(0.94, 0.94)
		sheet.modulate.a = 0.0
		var tw := create_tween()
		tw.set_parallel(true)
		tw.tween_property(scrim, "color:a", 0.72, 0.30)
		tw.tween_property(sheet, "modulate:a", 1.0, 0.26)
		tw.tween_property(sheet, "scale", Vector2.ONE, Motion.SETTLE) \
			.set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	if AudioBank != null:
		AudioBank.play_sfx("boss_intro", 0.0, 1.0,
			1.0 if AudioBank.has_own_sfx("boss_intro") else 0.86)
		AudioBank.duck_music(-5.0, 1.2)

	await take.pressed
	if AudioBank != null:
		AudioBank.play_sfx("button_click")
	if reduce:
		scrim.queue_free()
		holder.queue_free()
		return
	var out := create_tween()
	out.set_parallel(true)
	out.tween_property(scrim, "color:a", 0.0, 0.26)
	out.tween_property(sheet, "modulate:a", 0.0, 0.24)
	await out.finished
	scrim.queue_free()
	holder.queue_free()


## A titled block on the despatch — a rimmed inner panel carrying one heading
## and one line of consequence. Used for THE GROUND and THE ORDER, which are
## the two things the player has to hold in their head while they plan.
func _sp_brief_block(heading: String, body: String, rim: Color,
		ink: Color) -> Control:
	var frame := PanelContainer.new()
	var bg := GameTheme.make_panel_style(Color(0.08, 0.062, 0.044, 0.92), rim, 2, 4, false)
	bg.content_margin_left = 16
	bg.content_margin_right = 16
	bg.content_margin_top = 9
	bg.content_margin_bottom = 10
	frame.add_theme_stylebox_override("panel", bg)
	var col := VBoxContainer.new()
	col.add_theme_constant_override("separation", 3)
	frame.add_child(col)
	var head := _make_text_label(heading, 14, rim.lerp(Color.WHITE, 0.45))
	head.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	col.add_child(head)
	var line := _make_text_label(body, 19, ink)
	if GameTheme.font_card_body_bold != null:
		line.add_theme_font_override("font", GameTheme.font_card_body_bold)
	line.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	line.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	col.add_child(line)
	return frame


## A hairline metal rule across the despatch — the document's own punctuation.
func _sp_rule_line(col: Color, alpha: float) -> Control:
	var rule := ColorRect.new()
	rule.color = Color(col.r, col.g, col.b, alpha)
	rule.custom_minimum_size = Vector2(0, 2)
	rule.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	rule.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return rule


## ─────────────────────────────────────────────────────────────────────────
##  THE STANDING ORDER — the objective's plaque and its live readout
## ─────────────────────────────────────────────────────────────────────────

## Build the standing-order plaque into the HUD's top stack. No-ops on an
## ordinary hold. Deliberately a SECOND plaque rather than more text on the
## rule plaque: the order changes as you play and the rule never does, so they
## are different instruments and must not share one box.
func _sp_build_plaque(stack: Control) -> void:
	if _sp_id == "" or stack == null or not is_instance_valid(stack):
		return
	var frame := PanelContainer.new()
	# IGNORE, like the rule plaque beside it — this strip hangs near the enemy
	# back-row slot tops and must never eat a hover meant for a card under it.
	frame.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var bg := GameTheme.make_panel_style(
		Color(0.09, 0.075, 0.052, 0.94), GameTheme.GILT_BRIGHT, 2, 4, true)
	bg.content_margin_left = 14
	bg.content_margin_right = 14
	bg.content_margin_top = 5
	bg.content_margin_bottom = 6
	frame.add_theme_stylebox_override("panel", bg)
	frame.size_flags_horizontal = Control.SIZE_SHRINK_CENTER

	var col := VBoxContainer.new()
	col.add_theme_constant_override("separation", 1)
	col.mouse_filter = Control.MOUSE_FILTER_IGNORE
	frame.add_child(col)

	# Gilt-rimmed and gilt-lettered: the order is YOURS. The rule plaque below
	# is oxblood because it is the foe's law — the two plaques must never be
	# mistaken for each other at a glance.
	var head := _make_text_label("STANDING ORDER", 13, GameTheme.GILT_BRIGHT)
	head.add_theme_color_override("font_outline_color", Color(0, 0, 0, 0.9))
	head.add_theme_constant_override("outline_size", 3)
	head.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	col.add_child(head)

	_sp_plaque_order = _make_text_label(
		String(_sp_objective.get("label", "")), 18, Color(0.98, 0.94, 0.82))
	if GameTheme.font_card_body_bold != null:
		_sp_plaque_order.add_theme_font_override("font", GameTheme.font_card_body_bold)
	_sp_plaque_order.add_theme_color_override("font_outline_color", Color(0, 0, 0, 0.9))
	_sp_plaque_order.add_theme_constant_override("outline_size", 3)
	_sp_plaque_order.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_sp_plaque_order.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	_sp_plaque_order.custom_minimum_size = Vector2(560, 0)
	col.add_child(_sp_plaque_order)

	_sp_plaque_clock = _make_text_label("", 15, Color(0.86, 0.80, 0.62))
	_sp_plaque_clock.add_theme_color_override("font_outline_color", Color(0, 0, 0, 0.9))
	_sp_plaque_clock.add_theme_constant_override("outline_size", 3)
	_sp_plaque_clock.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	col.add_child(_sp_plaque_clock)

	stack.add_child(frame)
	_sp_plaque = frame
	_sp_refresh_plaque()


## The live readout. Called from _update_hud (so it tracks every board change,
## not just round flips) and once more at round end before the verdict.
##
## Informational by the Reduce Motion contract — it carries game state, so it
## always renders. When the clock goes short it CHANGES COLOUR AND WORDS, never
## pulses: a persistent overlay holds steady under Reduce Motion, and "LAST
## ROUND" in ember text is a stronger read than a throb anyway.
func _sp_refresh_plaque() -> void:
	if _sp_id == "" or _sp_plaque_clock == null or not is_instance_valid(_sp_plaque_clock):
		return
	_sp_plaque_clock.text = _sp_progress_text()
	var left: int = _sp_rounds_left()
	var col: Color = Color(0.86, 0.80, 0.62)
	if _sp_deadline > 0 and left <= 1:
		col = Color(1.0, 0.46, 0.30)      # last round — ember
	elif _sp_deadline > 0 and left <= 2:
		col = Color(1.0, 0.72, 0.34)      # the clock is short — amber
	_sp_plaque_clock.add_theme_color_override("font_color", col)


## Rounds remaining on the clock, counting the one being played. 99 when the
## objective has no deadline (clear_board), so callers can treat it as "lots".
func _sp_rounds_left() -> int:
	if _sp_deadline <= 0:
		return 99
	# Clamp to round 1: the plaque is BUILT by _build_hud, which runs before
	# _start_round, so round_number is still 0 while the despatch is on screen.
	# Un-clamped that printed "6 ROUNDS LEFT" on a five-round order at exactly
	# the moment the player is reading the brief — shot-caught.
	return maxi(0, _sp_deadline - maxi(round_number, 1) + 1)


## One line of live state for the clock row. Every objective kind answers two
## questions here — "how am I doing" and "how long have I got" — because those
## are the only two the player is actually asking.
func _sp_progress_text() -> String:
	var kind := String(_sp_objective.get("kind", ""))
	var left: int = _sp_rounds_left()
	var clock: String = ""
	if _sp_deadline > 0:
		if left <= 0:
			clock = "THE TIME IS UP"
		elif left == 1:
			clock = "LAST ROUND"
		else:
			clock = "%d ROUNDS LEFT" % left
	match kind:
		"hold_rounds":
			return clock
		"slay_marked":
			if _sp_mark_broken:
				return "THE ORDER IS KEPT"
			return "STILL STANDING · %s" % clock
		"protect":
			if _sp_ward_lost:
				return "LOST"
			var ward_hp: String = ""
			if _sp_ward != null and is_instance_valid(_sp_ward):
				ward_hp = "%d HP · " % maxi(0, int(_sp_ward.current_hp))
			return "%s%s" % [ward_hp, clock]
		"break_face":
			var need: int = int(_sp_objective.get("value", 1))
			return "%d OF %d DEALT · %s" % [
				mini(_sp_face_damage_done, need), need, clock]
		"clear_board":
			var standing: int = _all_enemy_creatures().size()
			if _sp_deadline <= 0:
				return "%d STILL STANDING" % standing
			return "%d STILL STANDING · %s" % [standing, clock]
	return clock


## Evaluate the objective at the end of a round. Returns "won", "lost", or
## "open". Pure read of live state — safe to call more than once.
func _sp_evaluate_objective() -> String:
	if _sp_id == "" or _sp_objective.is_empty():
		return "open"
	var kind := String(_sp_objective.get("kind", ""))
	match kind:
		"hold_rounds":
			# Simply being here at the end of round N is the win. Dying is the
			# only failure, and it takes the ordinary defeat path.
			return "won" if round_number >= _sp_deadline else "open"
		"slay_marked":
			if _sp_mark_broken:
				return "won"
			return "lost" if round_number >= _sp_deadline else "open"
		"protect":
			if _sp_ward_lost:
				return "lost"
			return "won" if round_number >= _sp_deadline else "open"
		"break_face":
			if _sp_face_damage_done >= int(_sp_objective.get("value", 1)):
				return "won"
			return "lost" if round_number >= _sp_deadline else "open"
		"clear_board":
			if _all_enemy_creatures().is_empty():
				return "won"
			return "lost" if _sp_deadline > 0 and round_number >= _sp_deadline else "open"
	return "open"


## Round-end hook. Called from _post_combat_sequence, AFTER the revive rule and
## the end-of-round passives, BEFORE _check_game_over — so a set-piece decided
## on the same beat as a death resolves as the scenario says, not by HP.
func _sp_round_end_check() -> void:
	if _sp_id == "" or _sp_resolved or phase == Phase.GAME_OVER:
		return
	# A dead commander carries nothing. The ordinary defeat path owns this beat
	# — without the guard, an objective ticking over on the same round the
	# clash killed the player would stamp "THE FIELD IS CARRIED" over a defeat
	# and pay a trophy into a run that has already ended.
	if player_hp <= 0:
		return
	_sp_refresh_plaque()
	match _sp_evaluate_objective():
		"won":
			_sp_carry_the_field()
		"lost":
			_sp_withdraw()


## THE FIELD IS CARRIED. The objective is met: pay the trophy and the purse on
## the field, then hand off to the ordinary victory path by emptying the foe's
## face — that keeps ONE victory implementation (gold roll, potion pity, relic
## hooks, conquest tally, scene routing) instead of a parallel one that would
## drift.
func _sp_carry_the_field() -> void:
	if _sp_resolved:
		return
	_sp_award()
	# Hand the verdict to the ordinary victory path.
	enemy_hp = 0
	_check_game_over()


## Pay a carried named action: banner, trophy, purse. Split out from
## _sp_carry_the_field because there are TWO ways to carry the ground — meet
## the order, or simply break the foe outright before the clock runs down —
## and both must pay. _check_game_over's victory branch calls this directly so
## the second path can never quietly skip the prize.
func _sp_award() -> void:
	if _sp_id == "" or _sp_resolved:
		return
	_sp_resolved = true
	var already: bool = RunState.setpieces_carried.has(_sp_id)
	if not already:
		RunState.setpieces_carried.append(_sp_id)
	_show_combat_banner("THE FIELD IS CARRIED",
		String(_sp_objective.get("short", "THE ORDER IS KEPT")),
		Color(1.0, 0.82, 0.34))
	_log_event("The order is kept: %s" % String(_sp_objective.get("label", "")),
		{}, 0)
	# The trophy is granted ON THE FIELD, not on a reward screen — a named
	# action pays where it was won. Guarded on `already` so a save resumed
	# inside a set-piece can never re-pay it.
	var trophy := String(_sp_data.get("trophy", {}).get("relic", ""))
	if trophy != "" and not already and not RunState.has_relic(trophy):
		RunState.add_relic(trophy)
		_rebuild_relic_cache()
		var tname := String(RelicDB.get_relic(trophy).get("name", trophy))
		_show_info("★ %s — taken from the field." % tname)
	var purse: int = int(_sp_data.get("gold", 0))
	if purse > 0 and not already:
		RunState.gain_gold(purse)
	if AudioBank != null:
		AudioBank.play_sfx("victory")
	var won_line := String(_sp_data.get("won", ""))
	if won_line != "":
		_show_info(won_line)


## THE ARMY WITHDRAWS. The clock ran out. This is NOT a defeat: the toll is
## paid in HP, the trophy is forfeit, and the march continues. Stated on the
## map tooltip before the player ever commits, so it is a price accepted, not
## a trap sprung.
func _sp_withdraw() -> void:
	if _sp_resolved:
		return
	_sp_resolved = true
	phase = Phase.GAME_OVER
	var toll: int = maxi(0, int(_sp_data.get("toll", 0)))
	# Never lethal. A withdrawal that killed the player would be exactly the
	# run-ending puzzle whiff this whole resolution exists to avoid.
	toll = mini(toll, maxi(0, player_hp - 1))
	if toll > 0:
		player_hp -= toll
		RunState.hero_hp = maxi(1, RunState.hero_hp - toll)
	PlayLog.log_event("combat_end", {"encounter": _sp_id,
		"result": "withdraw", "round": round_number,
		"player_hp": player_hp, "enemy_hp": enemy_hp})
	_stop_low_hp_dread()
	_dim_war_furniture()
	if is_instance_valid(_phase_label):
		_phase_label.text = "WITHDRAWN"
		_phase_label.add_theme_color_override("font_color", Color(0.82, 0.68, 0.42))
	_show_combat_banner("THE ARMY WITHDRAWS",
		"%s — the toll is %d HP" % [String(_sp_objective.get("short", "")), toll],
		Color(0.72, 0.44, 0.24))
	_log_event("The order fails. The army breaks off and pays %d HP." % toll,
		{}, 1)
	var lost_line := String(_sp_data.get("lost", ""))
	if lost_line != "":
		_show_info(lost_line)
	if AudioBank != null:
		AudioBank.duck_music(-6.0, 1.1)
		AudioBank.play_sfx("defeat")
	# Back to the chart. The hold is struck (it was fought) but pays no purse,
	# no potion roll and no conquest tally — the ground was not taken.
	RunState.hero_hp = maxi(1, RunState.hero_hp)
	get_tree().create_timer(2.2).timeout.connect(func():
		GameTheme.fade_out_then_change_scene(self, MAP_SCENE, 0.5)
	)


# =====================================================================
#  STRUCTURES — Pyres, Mausoleums, Altars, etc.
# =====================================================================
##
## Structures are unattackable board objects placed in enemy back-row lanes
## at fight setup. They carry a `charge` counter visible above the card and
## drive the encounter's signature ritual mechanic (ignition, summon, etc.).
##

# =====================================================================
#  CAPITAL SIEGE - attackable fortifications over a normal boss fight
# =====================================================================

func _is_fortification(card) -> bool:
	return card != null and is_instance_valid(card) \
		and bool(card.card_data.get("fortification", false))


func _spawn_siege_fortifications() -> void:
	if not _siege_active:
		return
	_siege_gates.clear()
	for entry in EncounterDB.build_siege_fortifications(
			_encounter_id, RunState.get_act()):
		var lane := int(entry.get("lane", 0))
		var row := int(entry.get("row", ROW_FRONT))
		if lane < 0 or lane >= LANES_PER_ROW \
				or _row_array(true, row)[lane] != null:
			continue
		_place_enemy_card(entry.get("data", {}), lane, row)
		var gate = _row_array(true, row)[lane]
		if _is_fortification(gate):
			_siege_gates.append(gate)
	_siege_refresh_plaque()


func _living_siege_gates() -> Array[Control]:
	var living: Array[Control] = []
	for gate in _siege_gates:
		if _is_fortification(gate) and gate.current_hp > 0:
			living.append(gate)
	return living


func _siege_gate_for_lane(source_lane: int) -> Control:
	var living := _living_siege_gates()
	if living.is_empty():
		return null
	if source_lane >= 0:
		var wanted := "left" if source_lane <= 1 else "right"
		for gate in living:
			if String(gate.card_data.get("siege_side", "")) == wanted:
				return gate
	# Effects without a lane hit the weakest section first. Stable left-to-right
	# ties make previews and replays deterministic.
	var best: Control = living[0]
	for gate in living:
		if gate.current_hp < best.current_hp \
				or (gate.current_hp == best.current_hp \
				and gate.current_lane < best.current_lane):
			best = gate
	return best


## Route damage aimed at the protected face into one or both gate sections.
## Returns actual fortification HP removed plus any raw overflow that may reach
## the boss after the final section falls.
func _siege_redirect_face_damage(amount: int, source_lane: int = -1) -> Dictionary:
	var remaining := maxi(0, amount)
	var gate_damage := 0
	var preferred_lane := source_lane
	while remaining > 0:
		var gate := _siege_gate_for_lane(preferred_lane)
		if gate == null:
			break
		var hp_before := int(gate.current_hp)
		var armor_cost := 1 if gate.has_keyword("armored") \
				and not Card2D.spell_pierce_active else 0
		gate.take_damage(remaining)
		var hp_after := maxi(0, int(gate.current_hp)) \
			if is_instance_valid(gate) else 0
		gate_damage += maxi(0, hp_before - hp_after)
		# Armored consumes one point before HP. Spending raw force, rather than
		# subtracting HP removed, prevents a blocked point becoming overflow.
		var force_spent := mini(remaining, hp_before + armor_cost)
		remaining = maxi(0, remaining - force_spent)
		preferred_lane = -1
		if hp_after > 0:
			remaining = 0
			break
	_siege_check_breach()
	_siege_refresh_plaque()
	return {"gate_damage": gate_damage, "overflow": remaining}


func _deal_siege_removal_damage(card: Control) -> bool:
	if not _is_fortification(card) or card.current_hp <= 0:
		return false
	card.take_damage_bypass_armor(3)
	_siege_check_breach()
	_siege_refresh_plaque()
	return true


func _siege_check_breach() -> void:
	if not _siege_active or _siege_breached \
			or not _living_siege_gates().is_empty():
		return
	_siege_breached = true
	# The lord's own formation wakes with the gate. Until now the restored rule
	# had nowhere to live — the ID guard meant no standing plaque was ever built
	# for a siege, so the player fought a formation nobody had posted. The plaque
	# is built hidden while the gate stands, and this is the beat it appears.
	_set_standing_rule(_siege_saved_passive, _siege_saved_passive_desc)
	_siege_refresh_plaque()
	var breach_log := String(_siege_data.get(
		"breach_log", "The last fortification falls. The rival can be reached."))
	var breach_title := String(_siege_data.get(
		"breach_title", "THE WAY IS OPEN"))
	var after_breach := String(_siege_data.get(
		"after_breach", "Defeat the rival."))
	_log_event(breach_log)
	_show_combat_banner(breach_title, after_breach,
		Color(1.0, 0.66, 0.28))
	var breach_effect: Dictionary = _siege_data.get("breach_effect", {})
	if not breach_effect.is_empty():
		_execute_phase_transition(breach_effect)
	screen_shake(15.0)
	screen_flash(Color(1.0, 0.48, 0.20, 0.24), 0.32)
	if AudioBank != null:
		AudioBank.play_sfx("creature_death", 0.0, 1.0, 0.78)


func _siege_note_gate_destroyed(card: Control) -> void:
	if not _is_fortification(card):
		return
	var side := String(card.card_data.get("siege_side", "")).capitalize()
	var noun := String(_siege_data.get("break_noun", "fortification"))
	var label := noun.capitalize() if side == "" \
		else ("%s %s" % [side, noun]).capitalize()
	_log_event("%s breaks." % label)
	_siege_check_breach()
	if not _siege_breached:
		var remaining := _living_siege_gates().size()
		var remaining_text := "1 remains" if remaining == 1 \
			else "%d remain" % remaining
		_show_info("%s breaks - %s." % [label, remaining_text])
	_siege_refresh_plaque()


func _siege_build_plaque(stack: Control) -> void:
	if not _siege_active or stack == null or not is_instance_valid(stack):
		return
	var frame := PanelContainer.new()
	frame.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var bg := GameTheme.make_panel_style(
		Color(0.09, 0.075, 0.052, 0.94), GameTheme.GILT_BRIGHT, 2, 4, true)
	bg.content_margin_left = 14
	bg.content_margin_right = 14
	bg.content_margin_top = 5
	bg.content_margin_bottom = 6
	frame.add_theme_stylebox_override("panel", bg)
	frame.size_flags_horizontal = Control.SIZE_SHRINK_CENTER

	var col := VBoxContainer.new()
	col.add_theme_constant_override("separation", 1)
	col.mouse_filter = Control.MOUSE_FILTER_IGNORE
	frame.add_child(col)

	var head := _make_text_label("STANDING ORDER", 15, GameTheme.GILT_BRIGHT)
	head.add_theme_color_override("font_outline_color", Color(0, 0, 0, 0.9))
	head.add_theme_constant_override("outline_size", 3)
	head.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	col.add_child(head)

	_siege_plaque_order = _make_text_label("", 18, Color(0.98, 0.94, 0.82))
	if GameTheme.font_card_body_bold != null:
		_siege_plaque_order.add_theme_font_override(
			"font", GameTheme.font_card_body_bold)
	_siege_plaque_order.add_theme_color_override(
		"font_outline_color", Color(0, 0, 0, 0.9))
	_siege_plaque_order.add_theme_constant_override("outline_size", 3)
	_siege_plaque_order.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_siege_plaque_order.custom_minimum_size = Vector2(560, 0)
	col.add_child(_siege_plaque_order)

	_siege_plaque_state = _make_text_label("", 15, Color(0.86, 0.80, 0.62))
	_siege_plaque_state.add_theme_color_override(
		"font_outline_color", Color(0, 0, 0, 0.9))
	_siege_plaque_state.add_theme_constant_override("outline_size", 3)
	_siege_plaque_state.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_siege_plaque_state.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	_siege_plaque_state.custom_minimum_size = Vector2(560, 0)
	col.add_child(_siege_plaque_state)

	stack.add_child(frame)
	_siege_plaque = frame
	_siege_refresh_plaque()


func _siege_refresh_plaque() -> void:
	if not _siege_active or _siege_plaque_order == null \
			or not is_instance_valid(_siege_plaque_order):
		return
	if _siege_breached:
		_siege_plaque_order.text = String(_siege_data.get(
			"breach_title", "THE WAY IS OPEN"))
		_siege_plaque_state.text = String(_siege_data.get(
			"after_breach", "Defeat the rival."))
		_siege_plaque_state.add_theme_color_override(
			"font_color", Color(1.0, 0.67, 0.32))
	else:
		var total := int(_siege_data.get("fortifications", []).size())
		var broken := maxi(0, total - _living_siege_gates().size())
		_siege_plaque_order.text = String(_siege_data.get(
			"order", "BREAK THE FORTIFICATIONS"))
		var progress_label := String(_siege_data.get(
			"progress_label", "FORTIFICATIONS BROKEN"))
		_siege_plaque_state.text = "%s  %d / %d" % [
			progress_label, broken, total]
		_siege_plaque_state.add_theme_color_override(
			"font_color", Color(0.86, 0.80, 0.62))

## Encounter data declares them in the optional `structures` field:
##   "structures": [
##     {"name": "Pyre", "atk": 0, "hp": 99, "kw": ["structure"],
##      "charge_max": 3, "lane": 0},
##   ]
##
## The "structure" keyword wires:
##   • Card2D.can_attack() → false (structures never swing)
##   • Combat attack resolution → bypasses structure back-row slots
##   • Spell targeting → strips structures from valid lists
## The charge counter is displayed via the existing intent badge so it sits
## above the card like other enemy intents and stays readable at the
## battlefield's compact scale.

func _spawn_encounter_structures(enc: Dictionary) -> void:
	var structures: Array = enc.get("structures", [])
	if structures.is_empty():
		return
	for s in structures:
		var lane: int = int(s.get("lane", 0))
		if lane < 0 or lane >= LANES_PER_ROW:
			continue
		if _enemy_back[lane] != null:
			continue
		# Build a real card_data dict so the rest of combat (display, dispatch,
		# death) treats this exactly like a normal creature. The structure
		# keyword + charge fields are what differentiate it.
		var data: Dictionary = EncounterDB.make_card_data(s)
		data["charge_current"] = int(s.get("charge_current", 0))
		data["charge_max"] = int(s.get("charge_max", 3))
		_place_enemy_card(data, lane, ROW_BACK)
		# Refresh the intent badge so the charge counter shows up immediately
		# instead of waiting for the first intent-assignment pass.
		var card = _enemy_back[lane]
		if card != null and is_instance_valid(card):
			_refresh_structure_charge_label(card)


## Passive ids that actually drive a charge structure. If the encounter's live
## passive is not one of these, no structure on the board can ever advance or
## fire, so any CHARGE badge still showing is a lie.
const STRUCTURE_DRIVING_PASSIVES: Array[String] = [
	"pyre_ritual", "crypt_rite", "altar_sacrifice", "siege_ritual", "cauldron_brew",
]


## Silence any structure the current passive can no longer operate (2026-07-28).
##
## The bug this exists for: the Iron Warden's phase 2 swaps the encounter passive
## to `iron_warden_siege`, at which point BOTH `siege_ritual` arms — the death
## feed and the fire check — stop matching. The Trebuchet then sat on the board
## for the rest of every fight still displaying a live "CHARGE n/3" badge that
## could never advance and could never go off. Every Iron Warden fight ever
## played ended with a prop pretending to be a threat.
func _quiet_orphaned_structures() -> void:
	if _encounter_passive in STRUCTURE_DRIVING_PASSIVES:
		return
	for s in _all_structures():
		if s == null or not is_instance_valid(s):
			continue
		if int(s.card_data.get("charge_max", 0)) <= 0:
			continue
		s.card_data["charge_max"] = 0
		s.card_data["charge_current"] = 0
		s.state.ready_to_ignite = false
		_refresh_structure_charge_label(s)


func _refresh_structure_charge_label(card: Control) -> void:
	# Repurposes the intent badge above the card to show "CHARGE n/max".
	# Goes through _update_intent_display so colors/positioning match other
	# intents without duplicating the label-build code.
	if card == null or not is_instance_valid(card):
		return
	if not card.has_keyword("structure"):
		return
	var cur: int = int(card.card_data.get("charge_current", 0))
	var max_c: int = int(card.card_data.get("charge_max", 3))
	# charge_max 0 means the engine has been orphaned or spent — clear the badge
	# rather than posting "CHARGE 0/0" (see _quiet_orphaned_structures).
	if max_c <= 0:
		_update_intent_display(card, "")
		return
	_update_intent_display(card, "CHARGE %d/%d" % [cur, max_c])


func _add_structure_charge(card: Control, amount: int) -> void:
	# Increments the charge on a structure and refreshes its badge. Triggers
	# the encounter's signature climax (ignition) when the counter crosses
	# the threshold; the climax itself is dispatched at start of round so
	# the player sees the build-up land in a single beat rather than mid-attack.
	if card == null or not is_instance_valid(card):
		return
	if not card.has_keyword("structure"):
		return
	var cur: int = int(card.card_data.get("charge_current", 0)) + amount
	var max_c: int = int(card.card_data.get("charge_max", 3))
	card.card_data["charge_current"] = cur
	_refresh_structure_charge_label(card)
	# Visual feedback for the feed — small floating chip so the player sees
	# the structure react instantly.
	if amount > 0:
		var anchor = card.global_position + card.size * card.scale * 0.5
		spawn_floating_number(anchor, "+%d CHARGE" % amount, Color(1.0, 0.62, 0.20), false)
	# When the threshold is crossed, mark the structure as ready to fire;
	# the actual fire happens at start of next round (telegraphed ignition).
	if cur >= max_c:
		card.state.ready_to_ignite = true


func _all_structures() -> Array:
	# Walks both rows for both sides and returns every live structure card.
	# Currently only enemy back row holds structures, but the iteration covers
	# everything so a future "player builds an altar" doesn't need a rewrite.
	var out: Array = []
	for row in [ROW_FRONT, ROW_BACK]:
		for arr in [_row_array(true, row), _row_array(false, row)]:
			for c in arr:
				if c != null and is_instance_valid(c) and c.has_keyword("structure"):
					out.append(c)
	return out


func _fire_pyre_ignition(pyre: Control) -> void:
	# THE climax. Big banner, screen pulse, AoE damage to every creature NOT
	# in a lane adjacent to a Pyre. Resets the Pyre's charge so the ritual
	# can re-build (though most fights end before this matters).
	if pyre == null or not is_instance_valid(pyre):
		return
	var pyre_lane: int = pyre.current_lane
	# Banner — reuses _show_encounter_intro's overlay style for the climax.
	_show_combat_banner("★ IGNITION ★", "The bonfire roars.", Color(1.0, 0.45, 0.18))
	# Particle burst at the Pyre.
	var burst_pos: Vector2 = pyre.global_position + pyre.size * pyre.scale * 0.5
	spawn_spell_burst(burst_pos, Color(1.0, 0.50, 0.15, 0.95))
	screen_shake(15.0)
	screen_flash(Color(1.0, 0.45, 0.18, 0.35), 0.3)
	if AudioBank != null:
		AudioBank.play_sfx("spell_cast", 0.0, 2.0)
	# Find which lanes are "adjacent to a Pyre" — pyre's own lane plus the
	# columns immediately to either side. Creatures in any of these lanes
	# survive the ignition.
	var safe_lanes: Array[int] = []
	for s in _all_structures():
		var sl: int = s.current_lane
		safe_lanes.append(sl)
		if sl > 0:
			safe_lanes.append(sl - 1)
		if sl < LANES_PER_ROW - 1:
			safe_lanes.append(sl + 1)
	# Damage every creature not in a safe lane. Use take_damage_bypass_armor
	# so Armored doesn't reduce the ritual (the fire is supernatural). Hits
	# both sides — even enemies that clustered away from the Pyre burn.
	for c in _all_creatures_both_sides():
		if c == null or not is_instance_valid(c):
			continue
		if c.has_keyword("structure"):
			continue
		if c.current_lane in safe_lanes:
			continue
		c.take_damage_bypass_armor(4)
	# Player face damage on top of board damage.
	damage_player_hero(3)
	# Reset the Pyre so the ritual can build again.
	pyre.card_data["charge_current"] = 0
	pyre.state.ready_to_ignite = false
	_refresh_structure_charge_label(pyre)


func _fire_trebuchet_strike(trebuchet: Control) -> void:
	# Iron Warden climax. Bigger boom than the Pyre — this is artillery,
	# not ambient fire. Hits EVERY player creature (no adjacency mercy)
	# for 3 and chunks 4 face damage. Resets the Trebuchet so phase 1
	# can fire it again if the player stalls (rare in practice — phase 2
	# usually arrives first).
	if trebuchet == null or not is_instance_valid(trebuchet):
		return
	_show_combat_banner("★ TREBUCHET FIRES ★",
		"Stones rain from the keep.", Color(0.75, 0.65, 0.45))
	var burst_pos: Vector2 = trebuchet.global_position + trebuchet.size * trebuchet.scale * 0.5
	spawn_spell_burst(burst_pos, Color(0.95, 0.85, 0.55, 0.95))
	screen_shake(18.0)
	screen_flash(Color(0.95, 0.85, 0.55, 0.30), 0.32)
	if AudioBank != null:
		AudioBank.play_sfx("spell_cast", 0.0, 2.0)
	# THE STONES FALL ON THE LINE, NOT ON YOU (2026-07-28). This used to hit every
	# player creature for 3 AND chunk 4 off the face, with no way to stop either:
	# the Trebuchet is a 0/99 structure — unattackable, un-spell-targetable, and it
	# doesn't even block a lane — so the charge counter it displays was a pure fake
	# affordance. A siege engine shelling the field is the fantasy; taxing the
	# player's own body for standing there is just a clock. The AoE alone is the
	# threat, and it IS answerable — spread out, keep bodies cheap, race the charge.
	var struck := 0
	for c in _all_player_creatures():
		if c != null and is_instance_valid(c) and c.current_hp > 0:
			c.take_damage_bypass_armor(3)
			struck += 1
	# An empty field still costs something, or clearing your own board would be a
	# free dodge. The stones land on the ground you were holding.
	if struck == 0:
		damage_player_hero(3, false)
	trebuchet.card_data["charge_current"] = 0
	trebuchet.state.ready_to_ignite = false
	_refresh_structure_charge_label(trebuchet)


func _cauldron_brew_tick() -> void:
	# Crone's Cauldron — every round, +1 charge AND one curse into discard
	# (combining the original crone_drip behavior into the structure beat
	# so there's one legible threat instead of two parallel ones). At
	# Charge 5 the Cauldron OVERFLOWS: 3 face damage, a Wraith summon in
	# a random empty lane, and 2 extra curses dumped into discard.
	var cauldron: Control = null
	for s in _all_structures():
		if String(s.card_data.get("name", "")) == "Cauldron":
			cauldron = s
			break
	if cauldron == null:
		return
	# Skip round 1 — give the player a beat to read the board first.
	if round_number <= 1:
		return
	# The drip happens every round regardless of climax — that's the boss's
	# baseline pressure. The structure climax adds the dramatic moment on top.
	_player_discard_pile.append(CardDB.random_curse_id())
	_add_structure_charge(cauldron, 1)
	if cauldron.state.ready_to_ignite:
		_show_combat_banner("★ THE CAULDRON OVERFLOWS ★",
			"Hex-smoke fills the room.", Color(0.55, 0.18, 0.75))
		var burst_pos: Vector2 = cauldron.global_position + cauldron.size * cauldron.scale * 0.5
		spawn_spell_burst(burst_pos, Color(0.78, 0.30, 0.95, 0.95))
		screen_shake(14.0)
		screen_flash(Color(0.55, 0.18, 0.75, 0.32), 0.32)
		# Summon a Wraith in any empty front lane.
		var wraith_lane: int = -1
		for l in range(LANES_PER_ROW):
			if _enemy_field[l] == null:
				wraith_lane = l
				break
		if wraith_lane >= 0:
			var wraith: Dictionary = EncounterDB.make_card_data({
				"name": "Wraith", "atk": 3, "hp": 3, "kw": ["swift"],
			})
			_place_enemy_card(wraith, wraith_lane, ROW_FRONT)
		# Two more curses on top of the regular drip + face damage.
		_player_discard_pile.append(CardDB.random_curse_id())
		_player_discard_pile.append(CardDB.random_curse_id())
		damage_player_hero(3)
		cauldron.card_data["charge_current"] = 0
		cauldron.state.ready_to_ignite = false
		_refresh_structure_charge_label(cauldron)


func _rise_from_mausoleum(mausoleum: Control) -> void:
	# Haunted Crypt climax. The Mausoleum cracks open and the Lich rises in
	# its lane — same column, but the structure is replaced by a real
	# combatant. The Lich is the fight's true threat; killing it (or holding
	# it off) is the win condition for this run-through of the encounter.
	if mausoleum == null or not is_instance_valid(mausoleum):
		return
	var lane: int = mausoleum.current_lane
	_show_combat_banner("★ THE LICH RISES ★",
		"The mausoleum cracks open.", Color(0.55, 0.95, 0.65))
	var burst_pos: Vector2 = mausoleum.global_position + mausoleum.size * mausoleum.scale * 0.5
	spawn_spell_burst(burst_pos, Color(0.55, 0.95, 0.65, 0.95))
	screen_shake(12.0)
	screen_flash(Color(0.40, 0.85, 0.55, 0.28), 0.3)
	if AudioBank != null:
		AudioBank.play_sfx("spell_cast", 0.0, 2.0)
	# Remove the structure cleanly. Card2D._die() handles the visual exit
	# (fade + ash burst); the field array is cleared on the destroyed signal.
	_enemy_back[lane] = null
	mausoleum.queue_free()
	# Spawn the Lich in the same lane. 6/6 piercing means the player can't
	# just stall; they need to kill it before it dismantles their board.
	var lich_data: Dictionary = EncounterDB.make_card_data({
		"name": "The Lich", "atk": 6, "hp": 6,
		"kw": ["piercing"],
		"on_death": {"type": "damage_face", "value": 4},
	})
	_place_enemy_card(lich_data, lane, ROW_BACK)


func _cultist_altar_tick() -> void:
	# Altar start-of-round (Cultist Enclave's "Altar", the Owed's "Furnace
	# Altar"): the lowest-HP creature offers itself, adding +1 charge. At
	# charge 3 the altar climaxes: summon a champion AND deal 3 face damage.
	# Against the Owed the champion is "Paid in Full" — ledger language. The
	# sacrificed creature dies and triggers its on-death normally (e.g.
	# Bleeding Heart still bombs).
	var altar: Control = null
	for s in _all_structures():
		if String(s.card_data.get("name", "")) in ["Altar", "Furnace Altar"]:
			altar = s
			break
	if altar == null:
		return
	# Pick the lowest-HP non-structure cultist. Skip the very first round so
	# the player gets a beat to read the board before the ritual starts.
	if round_number <= 1:
		return
	var victim: Control = null
	var lowest_hp: int = 99
	for c in _all_enemy_creatures():
		if c == null or not is_instance_valid(c):
			continue
		if c.has_keyword("structure"):
			continue
		if c.current_hp > 0 and c.current_hp < lowest_hp:
			lowest_hp = c.current_hp
			victim = c
	if victim != null:
		# Visual: the cultist marches to the Altar before dying.
		spawn_floating_number(
			victim.global_position + victim.size * victim.scale * 0.5,
			"SACRIFICED", Color(0.95, 0.40, 0.30), false)
		victim.take_damage_bypass_armor(99)  # the ritual kills outright
		_add_structure_charge(altar, 1)
	# If the Altar crossed threshold, fire the climax.
	if altar.state.ready_to_ignite:
		var is_owed: bool = _encounter_faction == "owed"
		if is_owed:
			_show_combat_banner("★ PAID IN FULL ★",
				"The ledger balances.", Color(0.85, 0.30, 0.95))
		else:
			_show_combat_banner("★ CHAMPION SUMMONED ★",
				"The Altar drinks deep.", Color(0.85, 0.30, 0.95))
		var burst_pos: Vector2 = altar.global_position + altar.size * altar.scale * 0.5
		spawn_spell_burst(burst_pos, Color(0.85, 0.30, 0.95, 0.95))
		screen_shake(12.0)
		screen_flash(Color(0.55, 0.18, 0.75, 0.30), 0.3)
		# Summon the champion in an empty front lane.
		var champion: Dictionary = EncounterDB.make_card_data({
			"name": "Paid in Full" if is_owed else "Cultist Champion",
			"atk": 5, "hp": 6,
			"kw": ["piercing"],
			"on_enter": {"type": "damage_face", "value": 2},
		})
		var spawn_lane: int = -1
		for l in range(LANES_PER_ROW):
			if _enemy_field[l] == null:
				spawn_lane = l
				break
		if spawn_lane >= 0:
			_place_enemy_card(champion, spawn_lane, ROW_FRONT)
		else:
			# All front lanes occupied — fire face damage as a consolation
			# climax instead of swallowing the summon silently.
			damage_player_hero(5)
		damage_player_hero(3)
		altar.card_data["charge_current"] = 0
		altar.state.ready_to_ignite = false
		_refresh_structure_charge_label(altar)


func _show_combat_banner(title: String, subtitle: String, color: Color) -> void:
	# Mid-fight banner overlay for climactic moments (Ignition, Lich Rises,
	# Altar Awakens). Smaller and shorter than the encounter intro banner.
	if _hud_layer == null:
		return
	var holder := VBoxContainer.new()
	holder.add_theme_constant_override("separation", 6)
	holder.set_anchors_preset(Control.PRESET_FULL_RECT)
	holder.alignment = BoxContainer.ALIGNMENT_CENTER
	holder.mouse_filter = Control.MOUSE_FILTER_IGNORE
	holder.z_index = 240
	holder.modulate.a = 0.0
	_hud_layer.add_child(holder)

	var title_lbl := Label.new()
	title_lbl.text = title
	title_lbl.add_theme_font_size_override("font_size", 64)
	title_lbl.add_theme_color_override("font_color", color)
	title_lbl.add_theme_color_override("font_outline_color", Color(0, 0, 0, 0.95))
	title_lbl.add_theme_constant_override("outline_size", 8)
	title_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	title_lbl.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	holder.add_child(title_lbl)

	if subtitle != "":
		var sub_lbl := Label.new()
		sub_lbl.text = subtitle
		sub_lbl.add_theme_font_size_override("font_size", 20)
		sub_lbl.add_theme_color_override("font_color", Color(1.0, 0.88, 0.65))
		sub_lbl.add_theme_color_override("font_outline_color", Color(0, 0, 0, 0.92))
		sub_lbl.add_theme_constant_override("outline_size", 5)
		sub_lbl.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		sub_lbl.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		holder.add_child(sub_lbl)

	var tw := holder.create_tween()
	tw.tween_property(holder, "modulate:a", 1.0, 0.18)
	tw.tween_interval(0.7)
	tw.tween_property(holder, "modulate:a", 0.0, 0.35)
	tw.tween_callback(holder.queue_free)


## True when a card carries rules a compact battlefield token cannot print.
## Keywords and stats ARE legible on a token (keywords ink-stamp as devices in
## the bottom margin, ATK/HP as wax seals), so a vanilla body needs no
## announcement — revealing it would only spend a second of the player's time
## restating what the token already says. Everything tested below is invisible
## until the player thinks to hover, which IS the "I can't tell what the enemy
## is doing" complaint.
static func _card_has_hidden_rules(cd: Dictionary) -> bool:
	for key in ["on_enter", "on_death", "on_play", "floop", "adj_buff", "type_buff"]:
		var sub = cd.get(key, {})
		if sub is Dictionary and not (sub as Dictionary).is_empty():
			return true
	if String(cd.get("passive", "")) != "":
		return true
	if int(cd.get("wither", 0)) != 0 or int(cd.get("extra_damage", 0)) != 0:
		return true
	# A creature with a real intent CYCLE does something other than swing, and
	# the badge only names the CURRENT intent — the cycle itself is hidden.
	var intents = cd.get("intents", [])
	if intents is Array:
		for it in intents:
			if String(it) != "ATK":
				return true
	return false


## Announce an enemy body as it musters, the way skirmish announces an opponent's
## card: the real, readable face held for a beat. Solo used to seat enemies
## silently as compact tokens, so an arriving creature's rules text never crossed
## the screen at all. Filtered to rules-bearing cards (see _card_has_hidden_rules)
## so a plain 3/2 doesn't buy a reveal it has nothing to say in.
##
## Informational under the Reduce Motion contract — it carries state the player
## cannot otherwise read — so it is NOT gated off, only stripped of flourish by
## _reveal_cast_card itself.
## Set once the player asks the opening line to hurry up — the rest of the
## muster then seats without its card reveals. Per-fight; nothing reads it after
## the opening, so it is deliberately not saved.
var _muster_rushed := false


func _announce_enemy_muster(card_data: Dictionary) -> void:
	if _is_net():
		return   # skirmish already reveals the foe's plays on its own paths
	if DisplayServer.get_name() == "headless":
		return
	if _muster_rushed:
		return
	if not _card_has_hidden_rules(card_data):
		return
	_reveal_cast_card(card_data, "ENEMY REINFORCEMENT", Color(1.0, 0.56, 0.34))
	# _reveal_cast_card fires its own fade-in/hold/fade-out tween and returns
	# without awaiting it, so serialize the beat HERE: every reveal shares one
	# screen centre, and a multi-body wave would otherwise print two faces on
	# top of each other. Slightly under the 1.23s total so the next reveal's
	# fade-in laps the previous fade-out instead of leaving a dead gap.
	#
	# RUSHABLE: this is the fight's longest repeated beat (once per hidden-rules
	# body, and the opening muster deals up to four). A player who already knows
	# the kit can hold the button through the whole line.
	if await _rushable_pause(0.95):
		_muster_rushed = true


## Show a spell card the player did NOT play by hand — Chaos Imp's random cast,
## an Echo / Inkpot copy, or (in skirmish) the OPPONENT's spell — as a real,
## READABLE card face, held center-screen for a beat. Before this, an auto-cast
## or a foe's spell only flashed its EFFECT, so "what did they even play?" was a
## mystery. The card's own effect resolves elsewhere; this is pure feedback, so
## the overlay is click-through (mouse-ignore) and never blocks the turn.
func _reveal_cast_card(card_data: Dictionary, caption: String,
		accent: Color = Color(0.96, 0.84, 0.40)) -> void:
	if _hud_layer == null or card_data.is_empty():
		return
	# Warm the shared bake cache so the live card below renders via the cheap
	# baked-frame path (random / opponent spells aren't in the run-deck pre-bake).
	# bake() is idempotent and awaits ~2 frames; on a miss the card falls back to a
	# full live render, so the face reads correctly either way.
	if CardTextureCache != null and not CardTextureCache.has(card_data):
		await CardTextureCache.bake(card_data)
	if _hud_layer == null or not is_instance_valid(_hud_layer):
		return   # combat torn down during the await
	var vp := get_viewport_rect().size
	var center := Vector2(vp.x * 0.5, vp.y * 0.45)

	var holder := Control.new()
	holder.set_anchors_preset(Control.PRESET_FULL_RECT)
	holder.mouse_filter = Control.MOUSE_FILTER_IGNORE
	holder.z_index = 250
	holder.modulate.a = 0.0
	_hud_layer.add_child(holder)

	# Soft radial pool of shadow so the card pops off the busy board (plain
	# alpha, no additive — it only darkens the backdrop, like the title scrim).
	var scrim_grad := Gradient.new()
	scrim_grad.offsets = PackedFloat32Array([0.0, 1.0])
	scrim_grad.colors = PackedColorArray([
		Color(0.02, 0.01, 0.01, 0.66), Color(0.02, 0.01, 0.01, 0.0)])
	var scrim_tex := GradientTexture2D.new()
	scrim_tex.gradient = scrim_grad
	scrim_tex.fill = GradientTexture2D.FILL_RADIAL
	scrim_tex.fill_from = Vector2(0.5, 0.5)
	scrim_tex.fill_to = Vector2(1.0, 0.9)
	scrim_tex.width = 256
	scrim_tex.height = 256
	var scrim := TextureRect.new()
	scrim.texture = scrim_tex
	scrim.stretch_mode = TextureRect.STRETCH_SCALE
	scrim.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var sw := 780.0
	var sh := 560.0
	scrim.position = center - Vector2(sw, sh) * 0.5
	scrim.size = Vector2(sw, sh)
	holder.add_child(scrim)

	# Caption above the card — who cast it / why it's appearing.
	var cap := _make_text_label(caption, 24, accent)
	cap.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	cap.add_theme_color_override("font_outline_color", Color(0, 0, 0, 0.95))
	cap.add_theme_constant_override("outline_size", 6)
	cap.size = Vector2(540, 36)
	cap.position = center + Vector2(-270, -212)
	holder.add_child(cap)

	# The card face — a full, LIVE Card2D, NOT a bare baked TextureRect. The shared
	# CardTextureCache bake intentionally strips the NAME and RULES TEXT (the hand
	# redraws them with the live font renderer so they stay razor-sharp at any zoom),
	# so painting the raw baked texture shows a frame + art with a BLANK banner and an
	# EMPTY rules box. That was the "spell text doesn't appear on the card" bug on the
	# skirmish OPPONENT-cast reveal (and on Chaos Imp / Echo casts in solo). A real
	# Card2D in the same baked-overlay mode the hand uses paints the frame/art from the
	# bake AND draws name + rules + stats live on top.
	var pic: Control = CARD_SCENE.instantiate()
	pic.card_id = String(card_data.get("id", ""))
	pic.card_data = card_data.duplicate(true)
	pic.live_baked_mode = true   # baked frame+art + live text — identical to a hand card
	pic.static_display = true    # freeze per-frame animation in this transient overlay
	holder.add_child(pic)
	# Card2D._ready resets mouse_filter to STOP; force IGNORE *after* add_child so the
	# reveal never grabs hover/clicks (its mouse_entered isn't gated on static_display).
	pic.mouse_filter = Control.MOUSE_FILTER_IGNORE
	# Card2D is natively 225×300. Centre it on `center` (scale about its own centre via
	# pivot_offset) and blow it up slightly to the lifted-hand reveal size.
	var reveal_scale := 1.10
	pic.pivot_offset = Vector2(112.5, 150.0)
	pic.position = center - Vector2(112.5, 150.0)
	# Pop the card in with a small back-eased scale as the holder fades up.
	pic.scale = Vector2(reveal_scale * 0.80, reveal_scale * 0.80)
	var ptw: Tween = pic.create_tween()
	ptw.set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	ptw.tween_property(pic, "scale", Vector2(reveal_scale, reveal_scale), 0.26)

	var tw: Tween = holder.create_tween()
	tw.tween_property(holder, "modulate:a", 1.0, 0.18)
	tw.tween_interval(1.15)
	tw.tween_property(holder, "modulate:a", 0.0, 0.40)
	tw.tween_callback(holder.queue_free)


func _dispatch_encounter_on_enemy_death(lane_idx: int, dead_card: Control = null, row: int = -1) -> void:
	_passive_speaking = true
	EncounterEffects.dispatch_encounter_on_enemy_death(self, lane_idx, dead_card, row)
	_passive_speaking = false
	# "All his HP is in the Body — kill it and you win." A creature flagged
	# `holds_the_fight` IS the enemy's life total, so its death ends the fight
	# outright. Data-driven (not passive-id keyed) so any future encounter can
	# hang a fight on one body. Deliberately separate from `effect_immune`:
	# untouchable and load-bearing are two different promises.
	if dead_card != null and is_instance_valid(dead_card) \
			and bool(dead_card.card_data.get("holds_the_fight", false)) \
			and phase != Phase.GAME_OVER and enemy_hp > 0:
		_log_event("The Body falls. The war over it ends.",
			_log_data(dead_card), _log_side(dead_card))
		_kings_body_lethal = true
		damage_enemy_hero(enemy_hp, true)
		_kings_body_lethal = false


func _dispatch_encounter_on_player_death(_lane_idx: int) -> void:
	EncounterEffects.dispatch_encounter_on_player_death(self, _lane_idx)


func _dispatch_encounter_on_enter(_data: Dictionary, _lane_idx: int) -> void:
	EncounterEffects.dispatch_encounter_on_enter(self, _data, _lane_idx)


func _has_encounter_passive_keyword(card: Control, keyword: String) -> bool:
	return EncounterEffects.has_encounter_passive_keyword(self, card, keyword)


## The keywords a fight's own rule can LEND its line. The rule itself still lives
## in EncounterEffects.has_encounter_passive_keyword — every strike path asks it at
## the moment of the blow, so nothing below can change what a creature does — and
## this list only has to name what the SIGNAL must be able to show.
##
## `armored` is deliberately absent. Its arm in the lookup is a tautology (true
## only for a card that already prints Armored) and no strike path consults the
## lookup for it: the passives that really armor a line write the keyword onto the
## card themselves (sentinel_stone in _place_enemy_card, formation_drill's
## lockstep, iron_warden_siege), which is why those already show a device.
const ENCOUNTER_GRANT_KEYWORDS := ["piercing", "thorns"]


## Mirror the encounter's keyword grants onto the bodies that actually carry them,
## so a lent Piercing/Thorns FLASHES when it lands and STANDS on the status rail
## while it holds — the ROUND-SCOPED RIDERS contract. Before this, the Nexus's
## Thorns round, the herd's charge and a Mercenary crossing 4 ATK each changed the
## fight by lookup at strike time and moved not one pixel: the player watched a
## creature suddenly pierce or bite back with nothing on screen having changed.
##
## THE MIRROR RIDES ITS OWN card_data KEY, NEVER `card_data.keywords`, and that is
## the whole design. `keywords` is a shared, WRITEABLE channel that half the game
## reaches into: Defection loots a keyword off a corpse (_defection_steal_target),
## the Doppelganger copies a dead body's list, a deserter carries its entire dict
## across to your banner (_desert_enemy_to_player), and the silence/strip effects
## erase from it. A field rule parked there would be laundered onto the player's
## board permanently by any of the first three, and a strip would delete the ORB
## while the lookup went on returning true — a card claiming it does not pierce
## while it does is worse than the silence this fixes. `encounter_grants` has
## exactly one reader: Card2D's status rail.
##
## Cleared-then-derived on every sweep (the drummer/ward model), so a grant that
## stops being true — the charge breaking at round 3, a Mercenary dropping under 4
## ATK when its banner dies, a boss phase turning over — comes back OFF on its own.
func _refresh_encounter_keyword_grants() -> void:
	for card in _all_enemy_creatures():
		if card == null or not is_instance_valid(card):
			continue
		# No key at all = this body has never been swept, i.e. it just arrived. It
		# takes the standing orb but NOT the flash: the flash is for a rule that
		# LANDS on a body already standing there. A reinforcement that walks into a
		# rule already in force announces itself by arriving (and wears a SUMMONED
		# chip of its own) — a second chip in the same beat is doubled signal, and
		# on the opening deal it would be four of them over the intro.
		var arriving: bool = not card.card_data.has("encounter_grants")
		var had: Array = card.card_data.get("encounter_grants", [])
		var now: Array = []
		for kw in ENCOUNTER_GRANT_KEYWORDS:
			if _has_encounter_passive_keyword(card, kw):
				now.append(kw)
		if not arriving and now == had:
			continue
		card.card_data["encounter_grants"] = now
		if card.has_method("update_stat_display"):
			card.update_stat_display()
		if arriving:
			continue
		# THE MOMENT. Only the ON edge speaks, and only once per body per round:
		# this sweep re-runs at every board mutation and merc_piercing's answer is
		# derived from LIVE ATK, so an unlatched callout would fire again every time
		# a neighbour arrived or died and moved that body across the 4-ATK line. The
		# latch rides card_data rather than a Combat-level dictionary so it cannot
		# outlive the body it belongs to.
		if int(card.card_data.get("encounter_grants_said", -1)) == round_number:
			continue
		for kw in now:
			if had.has(kw):
				continue
			card.card_data["encounter_grants_said"] = round_number
			spawn_keyword_callout_kw(card, "granted_%s" % kw)


func _buff_random_enemy_atk(amount: int) -> void:
	var target = _random_enemy_creature()
	if target != null:
		target.current_atk += amount
		target.update_stat_display()


func _random_enemy_creature() -> Control:
	var enemies = _all_enemy_creatures()
	if enemies.is_empty():
		return null
	return _combat_ops.pick(enemies)


func _highest_atk_player_creature() -> Control:
	var best: Control = null
	var best_atk := -1
	for c in _all_player_creatures():
		var atk = c.effective_atk()
		if atk > best_atk:
			best_atk = atk
			best = c
	return best


func _highest_atk_enemy_creature() -> Control:
	var best: Control = null
	var best_atk := -1
	for c in _all_enemy_creatures():
		var atk = c.effective_atk()
		if atk > best_atk:
			best_atk = atk
			best = c
	return best


# The player creature currently flagged as the start-of-round passive's victim,
# so we can clear the old flag before moving it elsewhere.
var _passive_threat_marked: Control = null
var _passive_threat_amount: int = 0
var _martyr_chosen: Control = null

func _refresh_passive_threat_glow() -> void:
	# Glow the player creature the boss's start-of-round passive will snipe, using
	# the SAME picker the passive itself calls (_highest_atk_player_creature), so
	# the warning can never disagree with what actually happens. Presentation only
	# — nothing here mutates the board.
	var target: Control = null
	var amount: int = 0
	if _encounter_passive == "hollow_king_snipe" or _encounter_passive == "hollow_king_phase2":
		target = _highest_atk_player_creature()
		amount = 3
	elif _encounter_passive == "executioner_face":
		target = _highest_atk_enemy_creature()
		if target != null:
			amount = target.effective_atk()
	if target == _passive_threat_marked and amount == _passive_threat_amount:
		return
	if _passive_threat_marked != null and is_instance_valid(_passive_threat_marked):
		_passive_threat_marked.set_danger_marked(false)
	_passive_threat_marked = target
	_passive_threat_amount = amount
	if target != null and is_instance_valid(target):
		target.set_danger_marked(true, amount)


func _mark_martyr_chosen() -> void:
	var best: Control = null
	var best_hp: int = 999999
	var best_atk: int = 999999
	for c in _all_enemy_creatures():
		if c == null or not is_instance_valid(c) or c.current_hp <= 0:
			continue
		if not c.card_data.has("on_death"):
			continue
		if c.has_keyword("structure"):
			continue
		var hp: int = int(c.current_hp)
		var atk: int = c.effective_atk()
		if best == null or hp < best_hp or (hp == best_hp and atk < best_atk):
			best = c
			best_hp = hp
			best_atk = atk
	if best == _martyr_chosen:
		return
	if _martyr_chosen != null and is_instance_valid(_martyr_chosen):
		_martyr_chosen.state.martyr_chosen = false
		if _martyr_chosen.has_method("set_danger_marked"):
			_martyr_chosen.set_danger_marked(false)
	_martyr_chosen = best
	if best != null and is_instance_valid(best):
		best.state.martyr_chosen = true
		if best.has_method("set_danger_marked"):
			best.set_danger_marked(true, 0)
		_show_info("%s is Chosen for the martyr-pact." % best.card_data.get("name", "A cultist"))
		_log_event("%s is Chosen: its on-death will fire twice." \
			% _log_card_ref(best), _log_data(best), _log_side(best))


func _double_martyr_on_death(dead_card: Control, lane_idx: int, row: int = -1) -> void:
	if dead_card == null or not is_instance_valid(dead_card):
		return
	if not bool(dead_card.state.martyr_chosen):
		return
	var data: Dictionary = dead_card.card_data
	if data.has("on_death"):
		_log_event("%s's martyr-pact repeats." % _log_card_ref(dead_card),
			_log_data(dead_card), _log_side(dead_card))
		KeywordEffects._run_on_death(data.on_death, lane_idx, true, self, row)
	if dead_card == _martyr_chosen:
		_martyr_chosen = null


func _find_empty_enemy_slot(allow_salted: bool = false) -> Dictionary:
	# 4x4: fill front-row first, then back-row. Returns {row, lane} or {}.
	for row in [ROW_FRONT, ROW_BACK]:
		var arr = _row_array(true, row)
		var empties: Array[int] = []
		for i in range(LANES_PER_ROW):
			# Closed ground is NOT waivable by allow_salted: salt is a spell
			# that some scripted arrivals are allowed to ignore, closed ground
			# is the fight's printed rule and binds every path.
			if _sp_lane_closed(i):
				continue
			if arr[i] == null and (allow_salted or not _lane_is_salted(i)):
				empties.append(i)
		if not empties.is_empty():
			return {"row": row, "lane": int(_combat_ops.pick(empties))}
	return {}


func _pick_empty_for_summon(is_enemy: bool, preferred_row: int) -> Dictionary:
	# Prefer the requested row; fall through to the other row.
	var other = ROW_BACK if preferred_row == ROW_FRONT else ROW_FRONT
	for row in [preferred_row, other]:
		var arr = _row_array(is_enemy, row)
		var empties: Array[int] = []
		for i in range(LANES_PER_ROW):
			if arr[i] == null and not _sp_lane_closed(i):
				empties.append(i)
		if not empties.is_empty():
			return {"row": row, "lane": int(_combat_ops.pick(empties))}
	return {}


func _summon_one_soldier(atk: int, hp: int) -> void:
	# Summon one player token into the first empty lane (front preferred). Board
	# presence in place of card draw (Provision / War Chant) under persistent hand.
	var slot := _pick_empty_for_summon(false, ROW_FRONT)
	if not slot.is_empty():
		summon_token(atk, hp, slot.lane, false, slot.row)


## The two scripted-arrival helpers RETURN THE BODY THEY PLACED, or null when the
## board had no seat for it. They used to return void, so every announcement in
## EncounterEffects had to sample _all_enemy_creatures().size() before and after
## just to learn whether the summon landed — fragile arithmetic that could only
## ever produce a screen caption, never a beat on the arrival itself.
##
## Read back out of the board array rather than trusting the request: the slot
## comes from _find_empty_enemy_slot, which already refuses salted and closed
## ground, so neither summon_token nor _place_enemy_card can reroute it — but a
## body CAN arrive and die inside _place_enemy_card (Poisoned Rations, a Wolf-Pit),
## and the array is the only thing that knows. Callers must handle null.
func _summon_enemy_token(atk: int, hp: int) -> Card2D:
	var slot = _find_empty_enemy_slot()
	if slot.is_empty():
		return null
	summon_token(atk, hp, slot.lane, true, slot.row)
	return _row_array(true, int(slot.row))[int(slot.lane)] as Card2D


func _summon_enemy_token_with_keyword(atk: int, hp: int, keyword: String) -> Card2D:
	var slot = _find_empty_enemy_slot()
	if slot.is_empty():
		return null
	var data = {
		"id": "token_%s" % keyword, "name": "Ghost" if keyword == "swift" else "Token",
		"type": "creature", "cost": 0, "atk": atk, "hp": hp,
		"rarity": "token", "keywords": [keyword], "desc": "",
		# Flagged like summon_token's product so death-triggered passives can
		# refuse to raise their own spawn (crypt_ghost). Without this the body
		# is indistinguishable from an authored enemy creature.
		"is_token": true,
	}
	_place_enemy_card(data, slot.lane, slot.row)
	return _row_array(true, int(slot.row))[int(slot.lane)] as Card2D


# =====================================================================
#  BOARD LAYOUT
# =====================================================================

func _build_board() -> void:
	# Layout strategy (anchor-based, no competing VBox shares):
	#
	#   ┌──────────── top HUD (Combat._build_hud) — anchored to top ──────────┐
	#   │                                                                     │
	#   │ enemy_portrait  ┌─ board container (fills middle) ──┐                │
	#   │   (left edge)   │  enemy back row                   │                │
	#   │                 │  enemy front row                  │                │
	#   │                 │  ─── midline ─────────────────────│                │
	#   │ player_portrait │  player front row                 │                │
	#   │   (left edge)   │  player back row                  │                │
	#   │                 в””в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”  [End Turn]    │
	#   ├────── HUD strip (HP, mana, deck/discard) anchored above hand ───────┤
	#   └────── hand container (anchored to bottom edge, fixed height) в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”
	_board_container = Control.new()
	_board_container.set_anchors_preset(Control.PRESET_FULL_RECT)
	add_child(_board_container)

	_board_bg = ColorRect.new()
	_board_bg.color = Color(0, 0, 0, 0.0)
	_board_bg.set_anchors_preset(Control.PRESET_FULL_RECT)
	_board_bg.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_board_container.add_child(_board_bg)

	# ── Hand container: bottom-anchored, fixed height. Always visible. ──
	# Plain Control (not HBoxContainer) — cards are positioned manually by
	# _layout_hand() to produce a slight Hearthstone-style fan: centred,
	# subtle outward rotation, parabolic Y-drop at the edges. Spans from
	# past the left info column out to the right margin (leaving room for
	# the End Turn button stack); fixed 280 px tall so the highest point
	# of a hovered card (which scales 1.15x past the top edge) doesn't get
	# clipped by the board zone above.
	_hand_container = Control.new()
	_hand_container.anchor_left = 0.0
	_hand_container.anchor_right = 1.0
	# Pull hand inward so it doesn't sit on top of the player banner + mana
	# orb (left edge ends ~x=344) or the end-turn / pile column (right). The
	# centered hand fans cleanly in the gap between the bottom-corner UI.
	# Symmetric about screen centre (x=800) so the fan aligns with the board's
	# central lane / clash line instead of drifting right. Left (360) clears the
	# mana orb (ends x=354); right (1240) clears the end-turn stack (starts 1420).
	_hand_container.offset_left = 360
	_hand_container.offset_right = -360
	_hand_container.anchor_top = 1.0
	_hand_container.anchor_bottom = 1.0
	# Hand sits on top of the board's bottom edge (board_zone goes down to
	# offset_bottom = -150; the player back row ends at y=737). REST_SCALE/PEEK
	# in _layout_hand seat resting cards just below y=737 so they don't cover
	# back-row creature stats; hovered cards lift up over the board's
	# bottom ~130px — cards fan ON TOP of the field, the way Hearthstone /
	# Cross Blitz layer them, instead of in a separate stripe below.
	_hand_container.offset_top = -210
	_hand_container.offset_bottom = -10
	_hand_container.mouse_filter = Control.MOUSE_FILTER_IGNORE
	# Re-layout on resize so window resize / scaling reflows the fan.
	_hand_container.resized.connect(_layout_hand)
	# Any time a card leaves the hand (played, discarded, exiled, exhausted)
	# the remaining cards need to re-fan. _hand.erase() is called BEFORE
	# remove_child() everywhere, so by the time this signal fires _hand is
	# already trimmed; defer one frame so the removed node is fully out of
	# the tree before we run.
	_hand_container.child_exiting_tree.connect(
		func(_n): call_deferred("_layout_hand"))
	# Hand lives in its OWN CanvasLayer at layer=20 — above the HUD (layer=12)
	# so cards draw over the board frame edge, encounter scroll, relic strip,
	# and all other UI. The card drag system uses screen-space global_position
	# which works identically inside a CanvasLayer as outside.
	_hand_layer = CanvasLayer.new()
	_hand_layer.layer = 20
	add_child(_hand_layer)
	_hand_layer.add_child(_hand_container)

	# ── Board zone: uses most of the screen between left/right columns and
	# the title strip on top. Left clears the gear+pile column (ends x=234);
	# right clears the enemy banner (starts at x=width-234). Top clears the
	# centered encounter title strip (ends y=90) plus a small margin.
	# Bottom extends ~30px behind the hand strip so hovered/raised cards
	# visibly layer over the field edge.
	var board_zone := Control.new()
	board_zone.anchor_left = 0.0
	board_zone.anchor_right = 1.0
	board_zone.anchor_top = 0.0
	board_zone.anchor_bottom = 1.0
	board_zone.offset_left = 272
	board_zone.offset_right = -272
	board_zone.offset_top = 70
	board_zone.offset_bottom = -150
	board_zone.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_board_container.add_child(board_zone)

	# ── Field ground (prototype styles) ─────────────────────────────────────
	# The board's "what is the field" treatment — four complete, shippable
	# grounds. _build_field_ground paints the substrate + dressing and sets the
	# _fld_* palette the lane tracks / numerals / clash seam read below, so the
	# whole board reads as one material per style.
	_field_style = field_style_override if field_style_override >= 0 else _default_field_style()
	_build_field_ground(board_zone)

	# S5 aftermath GROUND layer — salt stipple + the condemned column's wash,
	# painted on the table UNDER the creatures. Child of the board, so it shakes
	# in lockstep (★6's contract). Its twin marks layer is added after the clash
	# line. Deferred first paint: the slot rects it reads don't exist until the
	# lane rows below are built and laid out.
	_lane_aftermath = LaneAftermath.new()
	_lane_aftermath.draw_marks = false
	_lane_aftermath.set_anchors_preset(Control.PRESET_FULL_RECT)
	board_zone.add_child(_lane_aftermath)
	call_deferred("_refresh_lane_aftermath")

	# ── Lane duel-columns ────────────────────────────────────────────────────
	# This is a lane-combat game: the unit of play is the vertical column — your
	# creature faces the enemy's directly across the clash line, with each side's
	# back row queued behind. So the board is built as 4 vertical lane tracks, NOT
	# stacked rows. Each track holds, top→bottom: enemy back, enemy front,
	# <clash gap>, player front, player back. The persistent track panel is the
	# column the player reads even when sockets are empty; ownership (warm enemy /
	# cool player) lives on the sockets, the lane itself stays neutral.
	const LANE_GUTTER := 16
	const CLASH_GAP := 30
	var lanes_row := HBoxContainer.new()
	lanes_row.set_anchors_preset(Control.PRESET_FULL_RECT)
	lanes_row.add_theme_constant_override("separation", LANE_GUTTER)
	lanes_row.alignment = BoxContainer.ALIGNMENT_CENTER
	lanes_row.mouse_filter = Control.MOUSE_FILTER_IGNORE
	board_zone.add_child(lanes_row)

	for i in range(LANES_PER_ROW):
		var track := PanelContainer.new()
		track.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		track.size_flags_vertical = Control.SIZE_FILL
		track.mouse_filter = Control.MOUSE_FILTER_IGNORE
		var track_style := StyleBoxFlat.new()
		# Lane fill + keylines come from the active field style's palette (set in
		# _build_field_ground) so the four columns read as distinct lanes against
		# whatever ground is underneath. The side borders carry the column read;
		# top/bottom stay hairline.
		track_style.bg_color = _fld_track_bg
		track_style.border_color = _fld_track_border
		track_style.border_width_left = 2
		track_style.border_width_right = 2
		track_style.border_width_top = 1
		track_style.border_width_bottom = 1
		for k in ["corner_radius_top_left", "corner_radius_top_right",
				"corner_radius_bottom_left", "corner_radius_bottom_right"]:
			track_style.set(k, _fld_track_corner)
		track.add_theme_stylebox_override("panel", track_style)
		lanes_row.add_child(track)

		var col := VBoxContainer.new()
		col.alignment = BoxContainer.ALIGNMENT_CENTER
		col.add_theme_constant_override("separation", 6)
		col.mouse_filter = Control.MOUSE_FILTER_IGNORE
		track.add_child(col)

		var e_back := _make_lane_slot(true, i, ROW_BACK)
		col.add_child(e_back)
		_enemy_back_slots.append(e_back)
		var e_front := _make_lane_slot(true, i, ROW_FRONT)
		col.add_child(e_front)
		_enemy_slots.append(e_front)

		# Clash gap — the empty band the front rows fight across. The full-width
		# clash seam (built below) lands here.
		var gap := Control.new()
		gap.custom_minimum_size = Vector2(0, CLASH_GAP)
		gap.mouse_filter = Control.MOUSE_FILTER_IGNORE
		col.add_child(gap)

		# Lane numeral — a small engraved survey mark (i–iv) on the seam, giving
		# the player a vocabulary for lanes (pushes, sniper shots, log entries
		# all operate on lanes). Dark outline so it stays legible over the gilt
		# clash beam that crosses this gap.
		var numeral := Label.new()
		numeral.text = ["i", "ii", "iii", "iv"][i]
		numeral.set_anchors_preset(Control.PRESET_FULL_RECT)
		numeral.offset_right = -12
		numeral.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
		numeral.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		numeral.add_theme_font_override("font", GameTheme.font_display)
		numeral.add_theme_font_size_override("font_size", 15)
		numeral.add_theme_color_override("font_color", _fld_numeral)
		numeral.add_theme_color_override("font_outline_color",
			Color(0.06, 0.03, 0.01, 0.85))
		numeral.add_theme_constant_override("outline_size", 4)
		numeral.mouse_filter = Control.MOUSE_FILTER_IGNORE
		# The clash beam is added to board_zone AFTER the lane tracks and paints
		# over anything below it in the z stack (same trap the aftermath marks
		# hit — see the comment at the marks layer). Lift the numeral above it.
		numeral.z_index = 2
		gap.add_child(numeral)

		var p_front := _make_lane_slot(false, i, ROW_FRONT)
		col.add_child(p_front)
		_player_slots.append(p_front)
		var p_back := _make_lane_slot(false, i, ROW_BACK)
		col.add_child(p_back)
		_player_back_slots.append(p_back)

	# ── Clash line ───────────────────────────────────────────────────────────
	# The front line where combat resolves, drawn full-width across the centre
	# (lands in each column's CLASH_GAP). A charred furrow under a crisp lit
	# gilt seam — the front has burned itself into the table. It only crosses
	# the empty gap between the front rows, so it never overlaps a card.
	var furrow := Panel.new()
	furrow.anchor_left = 0.0
	furrow.anchor_right = 1.0
	furrow.anchor_top = 0.5
	furrow.anchor_bottom = 0.5
	furrow.offset_top = -7
	furrow.offset_bottom = 7
	furrow.offset_left = 10
	furrow.offset_right = -10
	furrow.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var fur_st := StyleBoxFlat.new()
	fur_st.bg_color = _fld_furrow
	fur_st.set_corner_radius_all(5)
	furrow.add_theme_stylebox_override("panel", fur_st)
	board_zone.add_child(furrow)
	_midline = Panel.new()
	_midline.anchor_left = 0.0
	_midline.anchor_right = 1.0
	_midline.anchor_top = 0.5
	_midline.anchor_bottom = 0.5
	_midline.offset_top = -2
	_midline.offset_bottom = 2
	_midline.offset_left = -8
	_midline.offset_right = 8
	_midline.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var beam_style := StyleBoxFlat.new()
	beam_style.bg_color = _fld_beam
	beam_style.shadow_color = _fld_beam_glow
	beam_style.shadow_size = 4 if _fld_seam_ink else 10
	for k in ["corner_radius_top_left", "corner_radius_top_right",
			"corner_radius_bottom_left", "corner_radius_bottom_right"]:
		beam_style.set(k, 2)
	_midline.add_theme_stylebox_override("panel", beam_style)
	board_zone.add_child(_midline)
	# Seam smolder — the front line has burned itself into the table, so it
	# still smokes: a low ambient ember drift rising off the furrow. Looping
	# ambient emitter (bespoke by policy, not a Motion.burst), gated exactly
	# like AmbientEmbers: "Particles: Off" and Reduce Motion both silence it.
	# The ink-line seam (Battle-Plan) is a drawn map boundary, not a fire — no
	# embers there.
	if not _fld_seam_ink and not ((UserSettings != null and not UserSettings.particles)
			or (UserSettings != null and UserSettings.reduce_motion)):
		var seam_embers := CPUParticles2D.new()
		seam_embers.name = "SeamEmbers"
		seam_embers.amount = 22
		seam_embers.lifetime = 2.4
		seam_embers.preprocess = 2.0
		seam_embers.direction = Vector2(0, -1)
		seam_embers.spread = 14.0
		seam_embers.gravity = Vector2(0, -10.0)
		seam_embers.initial_velocity_min = 6.0
		seam_embers.initial_velocity_max = 18.0
		seam_embers.scale_amount_min = 1.6
		seam_embers.scale_amount_max = 3.0
		seam_embers.z_index = 1
		seam_embers.emission_shape = CPUParticles2D.EMISSION_SHAPE_RECTANGLE
		var seam_grad := Gradient.new()
		seam_grad.set_color(0, Color(1.0, 0.75, 0.30, 0.0))
		seam_grad.set_color(1, Color(0.9, 0.25, 0.10, 0.0))
		seam_grad.add_point(0.18, Color(1.0, 0.70, 0.30, 0.75))
		seam_grad.add_point(0.7, Color(0.95, 0.40, 0.15, 0.4))
		seam_embers.color_ramp = seam_grad
		_midline.add_child(seam_embers)
		# The beam is anchor-sized after layout — place the emitter along it then.
		_midline.resized.connect(func():
			seam_embers.position = _midline.size * 0.5
			seam_embers.emission_rect_extents = Vector2(
				maxf(_midline.size.x * 0.5 - 24.0, 8.0), 2.0))
	# S5 aftermath MARKS layer — the quartermaster tags (salt pips, the noose)
	# and covered pits: physical objects ON the table. Added after the beam
	# because the gold rule paints over anything below it in the z stack
	# (shot-verified — two earlier placements vanished under it). Geometry
	# keeps it out of every card footprint, so nothing on it covers a token.
	_lane_aftermath_marks = LaneAftermath.new()
	_lane_aftermath_marks.draw_ground = false
	_lane_aftermath_marks.set_anchors_preset(Control.PRESET_FULL_RECT)
	board_zone.add_child(_lane_aftermath_marks)
	# Solo clash focus sits above the field but below the HUD/hand CanvasLayers.
	# It inks down every column except the one currently resolving.
	_clash_lane_focus = CLASH_LANE_FOCUS.new()
	_clash_lane_focus.name = "ClashLaneFocus"
	_clash_lane_focus.z_index = 8
	board_zone.add_child(_clash_lane_focus)


func _default_field_style() -> int:
	# The shipping default until the player's rating picks a winner. A saved
	# UserSettings.field_style (if the build adds the setting) wins; otherwise
	# the current campaign-table look.
	if UserSettings != null and "field_style" in UserSettings:
		return clampi(int(UserSettings.field_style), 0, FieldStyle.size() - 1)
	return FieldStyle.WAR_TABLE


func _build_field_ground(board_zone: Control) -> void:
	# Paints the board's ground + dressing for the active _field_style and sets
	# the _fld_* palette the lane tracks / numerals / clash seam read. Everything
	# added here is static and sits UNDER the lanes, so it costs nothing per
	# frame. Each branch is a complete, shippable treatment.
	match _field_style:
		FieldStyle.MEADOW:
			_ground_meadow(board_zone)
		FieldStyle.OBSIDIAN:
			_ground_obsidian(board_zone)
		FieldStyle.BATTLE_PLAN:
			_ground_battle_plan(board_zone)
		_:
			_ground_war_table(board_zone)


func _fld_substrate(board_zone: Control, bg: Color, border: Color,
		border_w: int, corner: int, shadow_a: float) -> Panel:
	# Shared substrate helper — the opaque play-surface plate every style seats
	# its dressing on. Returns it so callers can tweak further.
	var substrate := Panel.new()
	substrate.set_anchors_preset(Control.PRESET_FULL_RECT)
	substrate.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var st := StyleBoxFlat.new()
	st.bg_color = bg
	st.border_color = border
	st.set_border_width_all(border_w)
	st.set_corner_radius_all(corner)
	st.shadow_color = Color(0, 0, 0, shadow_a)
	st.shadow_size = 18
	substrate.add_theme_stylebox_override("panel", st)
	board_zone.add_child(substrate)
	return substrate


func _fld_stage_glow(board_zone: Control, inner: Color, mid: Color) -> void:
	# Warm additive pool re-lighting the board centre so the eye lands on the
	# play field first (the global StageLight draws below the opaque substrate).
	var g := Gradient.new()
	g.offsets = PackedFloat32Array([0.0, 0.55, 1.0])
	g.colors = PackedColorArray([inner, mid, Color(mid.r, mid.g, mid.b, 0.0)])
	var tex := GradientTexture2D.new()
	tex.gradient = g
	tex.fill = GradientTexture2D.FILL_RADIAL
	tex.fill_from = Vector2(0.5, 0.5)
	tex.fill_to = Vector2(1.0, 0.5)
	tex.width = 256
	tex.height = 256
	var glow := TextureRect.new()
	glow.texture = tex
	glow.stretch_mode = TextureRect.STRETCH_SCALE
	glow.set_anchors_preset(Control.PRESET_FULL_RECT)
	glow.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var mat := CanvasItemMaterial.new()
	mat.blend_mode = CanvasItemMaterial.BLEND_MODE_ADD
	glow.material = mat
	board_zone.add_child(glow)


func _fld_edge_feather(board_zone: Control) -> void:
	# Top + bottom internal shadow gradients so the ground's edges fall into
	# darkness (a frameless "feather" instead of a hard panel border). Keeps the
	# lit combat band in the middle and the figure/ground rule the opaque table
	# used to guarantee. Two thin gradient strips, non-additive.
	for top in [true, false]:
		var g := Gradient.new()
		g.offsets = PackedFloat32Array([0.0, 1.0])
		if top:
			g.colors = PackedColorArray([Color(0.02, 0.012, 0.01, 0.72),
				Color(0.02, 0.012, 0.01, 0.0)])
		else:
			g.colors = PackedColorArray([Color(0.02, 0.012, 0.01, 0.0),
				Color(0.02, 0.012, 0.01, 0.72)])
		var tex := GradientTexture2D.new()
		tex.gradient = g
		tex.fill = GradientTexture2D.FILL_LINEAR
		tex.fill_from = Vector2(0.5, 0.0)
		tex.fill_to = Vector2(0.5, 1.0)
		tex.width = 8
		tex.height = 128
		var strip := TextureRect.new()
		strip.texture = tex
		strip.stretch_mode = TextureRect.STRETCH_SCALE
		strip.mouse_filter = Control.MOUSE_FILTER_IGNORE
		strip.anchor_left = 0.0
		strip.anchor_right = 1.0
		if top:
			strip.anchor_top = 0.0
			strip.anchor_bottom = 0.0
			strip.offset_bottom = 132
		else:
			strip.anchor_top = 1.0
			strip.anchor_bottom = 1.0
			strip.offset_top = -132
		board_zone.add_child(strip)


func _ground_war_table(board_zone: Control) -> void:
	# STYLE 0 — the campaign table (shipping control). Lamplit wood-brown plate,
	# wood grain + fiber, an inked theater chart, a quiet bronze fillet, warm
	# stage glow. Pixel-identical to the pre-prototype board.
	_fld_substrate(board_zone, Color(0.118, 0.088, 0.062, 0.96),
		Color(0.0, 0.0, 0.0, 0.45), 2, 16, 0.55)
	if GameTheme.tex_card_wood_grain:
		var wood := TextureRect.new()
		wood.texture = GameTheme.tex_card_wood_grain
		wood.stretch_mode = TextureRect.STRETCH_TILE
		wood.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
		wood.set_anchors_preset(Control.PRESET_FULL_RECT)
		wood.offset_left = 6; wood.offset_top = 6
		wood.offset_right = -6; wood.offset_bottom = -6
		wood.modulate = Color(0.78, 0.56, 0.34, 0.22)
		wood.mouse_filter = Control.MOUSE_FILTER_IGNORE
		board_zone.add_child(wood)
