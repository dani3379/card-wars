## Pursuit ("the road answers the march", 2026-06-12): once the lord's gate
## threshold falls, the rival's response rides out to every hold still
## standing. Tier 0 below 2 broken holds; tier 1 at 2 (one outrider body on
## round 2); tier 2 at 3+ (again on round 4). Normal holds only — lords and
## their stronghold elites keep their authored kit pacing (§15.2). This is
## the act's tempo decision: rush the open gate, or farm the remaining
## holds knowing they harden.
func _pursuit_tier() -> int:
	if RunState.current_node_type != "combat":
		return 0
	if RunState.holds_broken_in_act >= 3:
		return 2
	if RunState.holds_broken_in_act >= 2:
		return 1
	return 0

var _pursuit_banner_shown: bool = false
var _escalation_banner_shown: bool = false
# Set by _place_starting_board; consumed by the first _enemy_place_creatures.
# Banks "this hold still owes its opening formation" rather than a count, so the
# count/formation roll happens at muster time and a legacy save mid-fight (which
# never carried this flag) correctly defaults to "already mustered".
var _opening_muster_pending: bool = false
## THE INITIATIVE (2026-07-30). "" on every ordinary hold, which is what keeps
## this change surgical: an unchosen fight opens EXACTLY as it did before.
##   "field"   — the player moves first against an empty field, and the hold
##               answers by mustering one extra body into RESERVE.
##   "form_up" — the hold takes the field first, at its ordinary strength, and
##               the player opens on one extra Command with the whole line and
##               its orders already on the table.
## Only Generals and keeps ask, because the fight trace that motivated TAKE THE
## FIELD showed the opening deciding those two fight kinds and nothing else.
var _initiative: String = ""
## Bodies the hold has committed THIS round, across every placement source.
## Reset in _start_round; spent in _enemy_place_creatures against
## ENEMY_ARRIVALS_PER_ROUND / _SURGE. The opening muster is exempt — it is the
## formation, not reinforcement, and returns before the budget is consulted.
var _enemy_arrivals_this_round: int = 0
# Bodies that arrived in the post-clash reinforcement window and must skip
# exactly one _start_round sweep so they pay the same muster delay a played
# card pays. Filled by the census/diff in _post_combat_sequence, drained by
# _start_round. Deliberately transient and Combat-local: it never survives a
# round boundary, so it needs no snapshot field and CombatNet (whose arrivals
# come from the peer's own plays, already symmetric) never populates it.
var _muster_deferred: Array = []
## instance_id -> true for every body THIS round's muster sweep formed up (plus
## the deferred ones still forming). Written by _start_round, read exactly once
## per round by KeywordEffects.dispatch_start_of_round so a fuse does not burn on
## the round its body fights for the first time. Derived state — never saved,
## never snapshotted, cleared at the top of every sweep.
var _mustered_this_round: Dictionary = {}


func _enemy_place_creatures() -> void:
	var enc = EncounterDB.get_encounter(_encounter_id) if _encounter_id != "" else {}
	var enc_type = enc.get("type", "combat")
	# THE OPENING MUSTER: on the first pass this hold deals the formation
	# _place_starting_board used to pre-seat. It takes over the whole beat —
	# the wave schedule, pursuit outriders and tough_hp rider below all belong
	# to the reinforcement drip and must not stack on top of the opening, or
	# round 1 would deal the formation AND a wave.
	if _opening_muster_pending:
		_opening_muster_pending = false
		_set_phase_caption("ENEMY DEPLOYMENT")
		await _deal_opening_muster()
		return
	# SET-PIECE `no_reinforce`: the authored opening formation above still
	# deploys once; only later reserves are suppressed. Gated here, at the
	# single reserve dealer, rather than by emptying the deck — an empty deck
	# would still fall through to the infinite `_reinforcement` backup body.
	# This keeps a finite-board objective finite without erasing its board.
	if _sp_id != "" and bool(_sp_data.get("rules", {}).get("no_reinforce", false)):
		return

	var max_place := 1
	var surge_now := false
	# Successor Wars: a faction wave schedule overrides the uniform drip in
	# normal holds (rounds 1-7). _next_wave_count() returns -1 when no
	# schedule applies — untagged/elite/boss fights and the round-8+
	# anti-stall escalation keep the exact legacy behavior below.
	var wave_n: int = _next_wave_count()
	if wave_n >= 0:
		max_place = wave_n
		surge_now = _wave_surge_pending()
		if surge_now:
			# Spend the Everflame's one-time surge and give the spike the
			# climax-banner treatment (rides _show_combat_banner like
			# Ignition / Lich Rises) so it never reads as random.
			_wave_surge_fired = true
			_show_combat_banner("THE FUSE CATCHES",
				"The hold is half-broken — the Everflame surges", Color(1.0, 0.45, 0.20))
	elif round_number <= 2:
		max_place = 1
	elif enc_type == "elite" or enc_type == "boss":
		max_place = 2
	else:
		max_place = 1 if not _combat_ops.chance(1.0 / ENEMY_FLOOP_CHANCE_DENOM) else 2
	# Pursuit — one extra body on the outrider rounds. Stacks on faction
	# waves by design: the wave is the kingdom's engine, the outriders are
	# the rival's answer. The banner fires on the first outrider beat so
	# the spike never reads as random (same rule as the Everflame surge).
	var pt: int = _pursuit_tier()
	if pt >= 1 and (round_number == 2 or (round_number == 4 and pt >= 2)):
		max_place += 1
		if not _pursuit_banner_shown:
			_pursuit_banner_shown = true
			_show_combat_banner("OUTRIDERS",
				"The rival reinforces the hold — the road has eyes",
				Color(0.85, 0.25, 0.18))

	# THE HOLD'S HAND — clamp every source to one per-ROUND budget. `max_place`
	# above is what this call WANTS; the budget is what the round has left. The
	# escalation branch calls this function a second time in the same round, so
	# the counter (not a per-call cap) is what actually stops the stack.
	# A licensed spike — the escalation commit, the Everflame surge, an outrider
	# round — may reach ENEMY_ARRIVALS_SURGE; everything else is held to
	# ENEMY_ARRIVALS_PER_ROUND, the player's own ceiling.
	var spike: bool = surge_now or pt >= 1 \
		or (enc_type != "boss" and round_number >= _esc_round(ESCALATION_REINFORCE_ROUND))
	var round_cap: int = ENEMY_ARRIVALS_SURGE if spike else ENEMY_ARRIVALS_PER_ROUND
	var budget: int = maxi(0, round_cap - _enemy_arrivals_this_round)
	max_place = mini(max_place, budget)
	if max_place <= 0:
		return
	var tough_hp: int = int(_wave_schedule().get("tough_hp", 0)) if wave_n >= 0 else 0
	var placed := 0
	# 4x4: priority is a list of {row, lane} slots — front first, then back.
	var slot_priority: Array = _get_placement_priority_4x4(enc_type)
	if wave_n > 0:
		_play_faction_wave_vfx(_encounter_faction, wave_n, surge_now, slot_priority)
		if DisplayServer.get_name() != "headless" \
				and not (UserSettings != null and UserSettings.reduce_motion):
			await _short_pause(0.12 if surge_now else 0.08)
	for slot in slot_priority:
		if placed >= max_place:
			break
		var arr = _row_array(true, slot.row)
		if arr[slot.lane] != null:
			continue
		if _lane_is_salted(int(slot.lane)):
			continue
		if _enemy_deck.is_empty():
			if not _reinforcement.is_empty():
				var rf: Dictionary = _reinforcement.duplicate(true)
				rf["is_reinforcement"] = true   # Poisoned Rations reads this tag
				_enemy_deck.append(rf)
			else:
				var eid = CardDB.random_enemy_for_act(RunState.get_act())
				_enemy_deck.append(CardDB.get_card_data(eid))
		var card_data = _enemy_deck.pop_front()
		# The Last Wall's rider: every scheduled body arrives a touch tougher.
		if tough_hp > 0:
			card_data = card_data.duplicate(true)
			card_data["hp"] = int(card_data.get("hp", 1)) + tough_hp
		# Announce BEFORE seating, and after the tough_hp rider — the face the
		# player reads must be the body that actually lands, buffed HP included.
		await _announce_enemy_muster(card_data)
		_place_enemy_card(card_data, slot.lane, slot.row, true)
		placed += 1
		_enemy_arrivals_this_round += 1   # spends the hold's per-round hand
		if AudioBank != null:
			AudioBank.play_sfx("card_play", 0.05, -3.0, 0.96)
		# Deal a multi-body wave one card at a time (windowed only) so each
		# landing is seen and heard, instead of a simultaneous teleport.
		if placed < max_place and DisplayServer.get_name() != "headless":
			await _short_pause(0.16)
	# The Owed collect their banked dead — only as many as actually mustered;
	# anything uncollected (board full) stays banked for the next round.
	if wave_n >= 0 and bool(_wave_schedule().get("collect", false)):
		_wave_deaths_banked = maxi(0, _wave_deaths_banked - placed)


func _get_placement_priority_4x4(enc_type: String) -> Array:
	## Returns an ordered list of {row, lane} placement candidates.
	## Front row is always preferred (it's the active combat line).
	var slots: Array = []
	match enc_type:
		"elite":
			# Target the player's strongest creature first — same column, front row.
			var best_lane := -1
			var best_atk := -1
			for i in range(LANES_PER_ROW):
				var pf = _player_field[i]
				if pf != null and _enemy_field[i] == null:
					var atk = pf.effective_atk()
					if atk > best_atk:
						best_atk = atk
						best_lane = i
			if best_lane >= 0:
				slots.append({"row": ROW_FRONT, "lane": best_lane})
			for i in range(LANES_PER_ROW):
				if i != best_lane and _player_field[i] != null and _enemy_field[i] == null:
					slots.append({"row": ROW_FRONT, "lane": i})
		"boss":
			# Bosses spread out — prefer back-row support placement so the front
			# stays as a wall.  Then fill front.
			var bossy: Array = []
			for i in range(LANES_PER_ROW):
				if _enemy_field[i] == null:
					bossy.append({"row": ROW_FRONT, "lane": i})
			_combat_ops.shuffle(bossy)
			slots.append_array(bossy)
		_:
			# Regular: block player columns first, then any empty front.
			for i in range(LANES_PER_ROW):
				if _player_field[i] != null and _enemy_field[i] == null:
					slots.append({"row": ROW_FRONT, "lane": i})
	# Always fall through: any open front slot, then any open back slot.
	for i in range(LANES_PER_ROW):
		if _enemy_field[i] == null and not _slot_in_list(slots, ROW_FRONT, i):
			slots.append({"row": ROW_FRONT, "lane": i})
	for i in range(LANES_PER_ROW):
		if _enemy_back[i] == null:
			slots.append({"row": ROW_BACK, "lane": i})
	return slots


func _slot_in_list(slots: Array, row: int, lane: int) -> bool:
	for s in slots:
		if s.row == row and s.lane == lane:
			return true
	return false


# One-shot per combat: the first creature a boss/General fields lands as a
# physical beat, so the entrance is felt on the board, not just read on the
# intro banner.
# Poisoned Rations relic: only the FIRST tagged reinforcement dies on arrival.
var _poisoned_rations_fired: bool = false
# Wolf-Pits spell: pending trap charges — each entry is the damage one arrival
# takes as it lands. Casts stack (two pits per cast, FIFO).
var _pit_traps: Array[int] = []
# The Sexton (Dead / SECOND WAVE): the grave, once opened, stays open for the
# whole fight — the flag lives HERE, not on the creature, so the engine survives
# the Sexton's own death. Indexed by side: 0 = not armed, 1 = base, 2 = forged
# (a faster wave). _grave_souls banks OTHER non-token friendly deaths per side.
var _grave_armed: Array[int] = [0, 0]
var _grave_souls: Array[int] = [0, 0]

# ── The other four tribe MOMENTS (2026-07-30) ────────────────────────────────
# docs/DRAW_AND_TRIBE_DIRECTION_20260724.md, Part C. Dead (Second Wave, above)
# and Stray (Defection) shipped first; these are the remaining four, each built on
# one of the doc's three durable devices so a board wipe cannot erase the tribe's
# identity mid-fight. All four are indexed by side (0 = player / host, 1 = foe) and
# live on Combat rather than on a creature, which is the whole point: an identity
# that dies with its keystone is an identity the player cannot commit to.
#
# THE ONCE-FIRED LATCH — Soldier. True once the Volley has gone off this fight;
# survives the line that fired it being wiped.
var _volley_fired: Array[bool] = [false, false]
# THE ARMING TRICK — Bastion. 0 = not armed, 1 = base, 2 = forged. Survives the
# keystone's own death (the arm_works on-enter writes it).
var _works_fortified: Array[int] = [0, 0]
# THE ARMING TRICK — Warlock. Same shape; the arm_ledger on-enter writes it.
var _ledger_open: Array[int] = [0, 0]
# PRESENT-TENSE — Beast. Arrivals this round, per side; reset in _start_round.
# Beast is the one tribe whose identity is genuinely momentary, so it gets a
# counter rather than a latch.
var _beasts_arrived_this_round: Array[int] = [0, 0]
# Warlock's per-round "the Ledger already paid" flag, so a five-spell turn pays
# the coven once. Reset in _start_round with the rest of the round-scoped latches.
var _ledger_paid_this_round: Array[bool] = [false, false]

func _place_enemy_card(data: Dictionary, lane_idx: int, row: int = ROW_FRONT,
		arc_in: bool = false) -> void:
	# Salted Ground rejects every enemy arrival path, not just the regular
	# reinforcement dealer. Scripted summons reroute to another open lane; if
	# the only seats are salted, the arrival waits/fizzles at its caller.
	# A set-piece's CLOSED ground rides the same choke point, for the same
	# reason: one place where "an enemy may not stand here" is decided.
	if _lane_is_salted(lane_idx) or _sp_lane_closed(lane_idx):
		var redirected := _find_empty_enemy_slot()
		if redirected.is_empty():
			return
		lane_idx = int(redirected.lane)
		row = int(redirected.row)
	var card = CARD_SCENE.instantiate()
	card.card_id = data.id
	card.is_opponent = true
	card.is_on_battlefield = true
	card.compact_mode = true   # battlefield cards use the smaller variant
	card.card_data = data
	# Summoned bodies arriving through this path carry is_token in their data
	# (authored EncounterDB kits never do), so the node flag matches summon_token.
	card.is_token = bool(data.get("is_token", false))
	card.current_lane = lane_idx
	card.current_row = row
	_row_array(true, row)[lane_idx] = card
	var slot = _slot_array(true, row)[lane_idx]
	_slot_set_card(slot, card)
	# Dealt creatures (opening board, reinforcement waves) arc in from above
	# the enemy line so placement reads as an act, not a teleport. Cosmetic
	# only — the card is already seated in the arrays, so combat logic never
	# waits on the flight. Encounter-effect spawns (lich, wraiths, bombs)
	# keep the plain drop-in.
	if arc_in and DisplayServer.get_name() != "headless" \
			and not (UserSettings != null and UserSettings.reduce_motion):
		var slot_center: Vector2 = slot.global_position + slot.size * 0.5
		_play_landing_pop(card,
			Vector2(slot_center.x + randf_range(-60.0, 60.0), -170.0), true)
	else:
		_play_landing_pop(card)
	# ★9: the old first-placement "entrance slam" fired HERE — during board
	# setup, before the intro banner, a shake with nothing to attach it to.
	# The weight moved to _play_army_rollcall at the end of the intro, where
	# the player is actually looking.
	card.destroyed.connect(_on_card_destroyed.bind(card))
	card.will_die.connect(_on_card_will_die.bind(card))
	_log_event("The foe fields %s." % _log_card_ref(card),
		_log_data(card), _log_side(card))
	if not _is_fortification(card) and _has_relic("philosophers_stone"):
		_relic_fired("philosophers_stone")
		card.current_atk += 1
	# Act thickening (2026-07-28, see ENEMY_BODY_HP_BY_ACT). Solo only — a
	# skirmish opponent is a person with their own deck, not a garrison that
	# scales with the campaign. Structures and fortifications carry authored HP
	# on purpose and are left alone.
	if not _is_net() and not _is_fortification(card) \
			and not card.has_keyword("structure"):
		var act_i: int = clampi(int(RunState.current_act_idx), 0,
			ENEMY_BODY_HP_BY_ACT.size() - 1)
		var thicken: int = ENEMY_BODY_HP_BY_ACT[act_i]
		if thicken > 0:
			card.card_data["hp"] = int(card.card_data.get("hp", 1)) + thicken
			card.current_hp += thicken
			card.update_stat_display()
	# A4 "Veteran garrisons" — Generals' and lords' creatures enter with +1 ATK.
	# Solo only: net opponents are real players, not garrisons.
	if not _is_fortification(card) and not _is_net() and RunState.asc_active(4) \
			and _fight_class() in ["elite", "boss"]:
		card.current_atk += 1
	# Shield keyword: grant shield on placement
	if card.has_keyword("shield"):
		card.state.has_shield = true
	# Effect immunity rides the card DATA rather than a passive-id check, so any
	# future encounter can field an untouchable centrepiece without Combat having
	# to learn its name. See Card2D.take_damage for what it actually blocks.
	if bool(card.card_data.get("effect_immune", false)):
		card.state.effect_immune = true
	# Mutator: stat/keyword bumps applied before the stat display catches up,
	# so the freshly-placed card shows its modified numbers from frame one.
	if not _is_fortification(card):
		_mutator_apply_to_enemy(card)
	# Encounter passives that grant a keyword to the WHOLE enemy line inject it
	# onto the card here (Card2D.take_damage / the strike paths read the card's
	# own keyword list — the encounter-keyword lookup is NOT consulted for
	# Armored). sentinel_stone (The Tooth-Stones): every enemy is living stone.
	# PROVENANCE (2026-07-29). `keywords` records THAT this body is Armored but not
	# WHO made it so, and several readers cannot tell a field rule from a printed
	# keyword — Defection loots it, Mirror Knight copies it, a deserter carries it
	# across. `grant_field_keyword` does the SAME keywords append (it must:
	# Card2D.has_keyword is the only reader of Armored for damage, the forecast and
	# the overkill maths, so relocating the write would silently strip Armored from
	# this fight) and files a receipt beside it.
	#
	# It returns false — and files nothing — for a body that already PRINTS Armored,
	# which is the point: most of the Tooth-Stones deck prints it, and the Captain
	# should still be able to loot a Granite Guard's own keyword. Only the LENT ones
	# are protected. Shared with EncounterEffects so all three field grants
	# (sentinel_stone here, iron_warden_siege and lockstep there) use one mechanism.
	if not _is_fortification(card) and _encounter_passive == "sentinel_stone":
		EncounterEffects.grant_field_keyword(card, "armored")
	card.update_stat_display()
	if not _is_fortification(card):
		KeywordEffects.dispatch_on_enter(card, lane_idx, true, self)
		if card.card_data.has("on_play"):
			_resolve_on_play_ability(card, lane_idx, true)
		_maybe_beast_encore(card, true)
		_maybe_stampede(card, true)
		_dispatch_encounter_on_enter(data, lane_idx)
		_update_intent_display(card, "ATK")
	else:
		card.state.current_intent = ""
		_update_intent_display(card, "")
	# Enemy/opponent adjacency works too — a foe's Battle Drummer buffs its own
	# line. Re-tally so the buffed numerals show and the strike math is correct.
	_refresh_adjacency_buffs()
	# A back-row arrival must dim the rule plaque hanging over that band
	# (placement doesn't always route through a HUD refresh).
	_refresh_passive_plaque()
	# Poisoned Rations: the FIRST tagged reinforcement each fight arrives
	# dead — placed, seen, then dropped through the canonical destroy path so
	# its On-Death still fires (that clause is the relic's double edge).
	if bool(data.get("is_reinforcement", false)) and not _poisoned_rations_fired \
			and _has_relic("poisoned_rations") and not _is_net():
		_poisoned_rations_fired = true
		spawn_floating_number(_card_center(card) + Vector2(0, -16),
			"POISONED RATIONS", Color(0.55, 0.85, 0.40), false)
		_relic_fired("poisoned_rations")
		card.take_damage(999)
	# Wolf-Pits: the next arrivals fall in as they land — one charge per body,
	# fired at the same late beat the Poisoned Rations kill uses (after the
	# on-enter, so the arrival is seen before it drops).
	if not _pit_traps.is_empty() and not _is_net() \
			and is_instance_valid(card) and card.current_hp > 0:
		var pit_dmg: int = _pit_traps.pop_front()
		_refresh_lane_aftermath()
		spawn_floating_number(_card_center(card) + Vector2(0, -16),
			"WOLF-PIT %d" % pit_dmg, Color(0.92, 0.62, 0.25), false)
		_log_event("%s falls into a wolf-pit — %d damage." \
			% [_log_card_ref(card), pit_dmg], _log_data(card), _log_side(card))
		card.take_damage(pit_dmg)


# ─────────────────────────────────────────────────────────────────────────
#  CINEMATIC COLOUR GRADE — per-act / per-encounter "mood"
# ─────────────────────────────────────────────────────────────────────────
# One screen-read grade shader sits above the battlefield and below the HUD
# and hand; _apply_combat_mood() drives its params (plus the existing
# vignette / hearth-glow / stage-light / ember layers) from a small mood table,
# so every act, boss, and elite gets its own identity at ~zero cost. The param
# sets were tuned in the look-lab (tools/screenshot/_probe_look.gd) and picked
# from rendered comparisons against genre hits.
var _grade_mat: ShaderMaterial = null

const COMBAT_GRADE_CODE := """
shader_type canvas_item;
uniform sampler2D screen_tex : hint_screen_texture, filter_linear;
uniform float u_sat = 1.0;
uniform float u_con = 1.0;
uniform float u_bright = 1.0;
uniform vec3 u_shadow = vec3(1.0);
uniform vec3 u_light = vec3(1.0);
uniform vec3 u_tint = vec3(1.0);
void fragment() {
	vec3 c = texture(screen_tex, SCREEN_UV).rgb;
	c *= u_bright;
	float l = dot(c, vec3(0.299, 0.587, 0.114));
	vec3 tone = mix(u_shadow, u_light, smoothstep(0.12, 0.78, l));
	c *= tone;
	c = (c - 0.5) * u_con + 0.5;
	float l2 = dot(c, vec3(0.299, 0.587, 0.114));
	c = mix(vec3(l2), c, u_sat);
	c *= u_tint;
	COLOR = vec4(clamp(c, 0.0, 1.0), 1.0);
}
"""

# mood → { backdrop tint, vignette strength/outer, glow/stage tint, ember count/tint,
#          grade saturation/contrast/brightness, split-tone shadow/light, overall tint }
const COMBAT_MOODS := {
	"navy_gold": {"bg": Color(0.62, 0.65, 0.72), "vig": 0.54, "vig_out": Color(0.02, 0.03, 0.07, 0.72),
		"glow": Color(1, 0.85, 0.55), "stage": Color(1, 0.82, 0.5), "emberN": 30, "ember": Color(1, 0.82, 0.45),
		"sat": 1.0, "con": 1.06, "bright": 1.04, "sh": Vector3(0.88, 0.92, 1.0), "li": Vector3(1.06, 1.02, 0.90), "tint": Vector3(1.0, 1.0, 1.0)},
	# Firelight is an accent, not a full-screen orange filter. The backdrop stays
	# warm, while neutral split-toning leaves gameplay colors intact.
	"infernal": {"bg": Color(0.64, 0.54, 0.50), "vig": 0.56, "vig_out": Color(0.05, 0.02, 0.01, 0.72),
		"glow": Color(1, 0.70, 0.44), "stage": Color(1, 0.68, 0.42), "emberN": 38, "ember": Color(1, 0.68, 0.38),
		"sat": 0.96, "con": 1.05, "bright": 1.06, "sh": Vector3(0.98, 0.94, 0.91), "li": Vector3(1.04, 0.98, 0.92), "tint": Vector3(1.0, 1.0, 1.0)},
	"noir": {"bg": Color(0.56, 0.54, 0.54), "vig": 0.72, "vig_out": Color(0, 0, 0, 0.82),
		"glow": Color(1, 0.7, 0.45), "stage": Color(1, 0.6, 0.35), "emberN": 24, "ember": Color(1, 0.6, 0.3),
		"sat": 0.78, "con": 1.18, "bright": 1.02, "sh": Vector3(0.88, 0.86, 0.90), "li": Vector3(1.05, 1.02, 0.98), "tint": Vector3(1, 1, 1)},
	"frost": {"bg": Color(0.76, 0.80, 0.88), "vig": 0.46, "vig_out": Color(0.04, 0.06, 0.09, 0.66),
		"glow": Color(0.7, 0.85, 1.0), "stage": Color(0.8, 0.92, 1.0), "emberN": 40, "ember": Color(0.8, 0.92, 1.0),
		"sat": 0.95, "con": 1.03, "bright": 1.08, "sh": Vector3(0.90, 0.96, 1.03), "li": Vector3(0.99, 1.02, 1.08), "tint": Vector3(0.98, 1.0, 1.03)},
	"verdant": {"bg": Color(0.64, 0.72, 0.60), "vig": 0.50, "vig_out": Color(0.02, 0.04, 0.02, 0.70),
		"glow": Color(0.9, 1.0, 0.6), "stage": Color(0.85, 1.0, 0.6), "emberN": 44, "ember": Color(0.85, 1.0, 0.55),
		"sat": 1.0, "con": 1.03, "bright": 1.05, "sh": Vector3(0.93, 0.98, 0.91), "li": Vector3(1.02, 1.05, 0.96), "tint": Vector3(1.0, 1.0, 1.0)},
}

# Successor Wars: normal holds wear their kingdom's mood (§15.2 — per-faction
# combat presets; the mood system was per-act before). Maps faction tag →
# COMBAT_MOODS key. Boss/elite overrides in _resolve_combat_mood still win,
# and untagged fights keep the act/biome pick.
const FACTION_COMBAT_MOODS := {
	"grasswake": "verdant",    # storm over green country
	"last_wall": "navy_gold",  # stone, standards, lamplight
	"owed": "noir",            # the rot drains the color out
	"lanternhall": "frost",    # frost & star
	"everflame": "infernal",   # fire country
}


func _build_grade_overlay() -> void:
	# Reduce Motion doubles as a performance mode: the cinematic grade is a
	# full-screen `hint_screen_texture` pass, which forces a whole-frame
	# framebuffer COPY + shader every frame — the single most
	# expensive per-frame GPU cost in combat. Skipping it (alongside the embers +
	# idle bob, which already honor Reduce Motion) turns combat into a light,
	# near-static scene for low-end / editor-embedded play. The look goes a touch
	# flatter (no split-tone/contrast grade); the default path is unchanged.
	# _grade_mat stays null → _apply_combat_mood's `if _grade_mat != null` no-ops.
	if UserSettings != null and UserSettings.reduce_motion:
		return
	var sh := Shader.new()
	sh.code = COMBAT_GRADE_CODE
	_grade_mat = ShaderMaterial.new()
	_grade_mat.shader = sh
	var layer := CanvasLayer.new()
	layer.name = "GradeLayer"
	layer.layer = 10   # battlefield only; HUD (12) and hand (20) keep true colors
	add_child(layer)
	var rect := ColorRect.new()
	rect.set_anchors_preset(Control.PRESET_FULL_RECT)
	rect.color = Color.WHITE
	rect.mouse_filter = Control.MOUSE_FILTER_IGNORE
	rect.material = _grade_mat
	layer.add_child(rect)


func _resolve_combat_mood() -> String:
	# Draft, Quick, Constructed, and Sealed all use one neutral, high-contrast
	# treatment instead of inheriting a stale campaign act or boss palette.
	if _is_net():
		return "navy_gold"
	# Boss / elite override everything; otherwise pick by biome keyword, then act.
	match RunState.current_node_type:
		"boss":
			return "infernal"
		"elite":
			return "noir"
	# Successor Wars: a tagged hold wears its kingdom's colors so the five
	# factions read as different enemies before a card is played.
	if FACTION_COMBAT_MOODS.has(_encounter_faction):
		return FACTION_COMBAT_MOODS[_encounter_faction]
	var eid: String = String(RunState.current_encounter_id).to_lower()
	for kw in ["frost", "ice", "winter", "snow", "glaci"]:
		if kw in eid:
			return "frost"
	if RunState.get_act() == 1:
		return "verdant"
	return "navy_gold"


func _apply_combat_mood() -> void:
	var m: Dictionary = COMBAT_MOODS.get(_resolve_combat_mood(), COMBAT_MOODS["navy_gold"])
	var bg = get_node_or_null("CombatBg")
	if bg != null:
		bg.self_modulate = m["bg"]
	var vig = get_node_or_null("Vignette")
	if vig != null and vig.material is ShaderMaterial:
		vig.material.set_shader_parameter("vignette_strength", float(m["vig"]))
		vig.material.set_shader_parameter("grad_outer", m["vig_out"])
	var hg = get_node_or_null("HearthGlow")
	if hg != null:
		hg.modulate = m["glow"]
	var sl = get_node_or_null("StageLight")
	if sl != null:
		sl.modulate = m["stage"]
	var em = get_node_or_null("AmbientEmbers")
	if em != null:
		em.amount = int(m["emberN"])
		em.modulate = m["ember"]
	if _grade_mat != null:
		_grade_mat.set_shader_parameter("u_sat", float(m["sat"]))
		_grade_mat.set_shader_parameter("u_con", float(m["con"]))
		_grade_mat.set_shader_parameter("u_bright", float(m["bright"]))
		_grade_mat.set_shader_parameter("u_shadow", m["sh"])
		_grade_mat.set_shader_parameter("u_light", m["li"])
		_grade_mat.set_shader_parameter("u_tint", m["tint"])


func _build_ambient_fx() -> void:
	# Focal vignette — darkens the painted backdrop toward the screen edges so
	# the eye is pulled to the lit board in the centre. Without it the hellscape
	# painting is evenly bright corner-to-corner and the scene reads flat. Sits
	# just above the background (tree index 1), below the embers and the board,
	# so ONLY the backdrop dims — board, cards and HUD keep full brightness.
	# Reuses the exact shader + "combat" mood the other screens get through
	# GameTheme.add_atmosphere; combat wires it directly because it builds its
	# own custom embers below instead of the generic ambient motes.
	# Push the painted backdrop back. The hellscape art is loud and shares the
	# cards' own red/orange palette, so at the .tscn default modulate it competed
	# with the foreground and nothing separated. Dim + slightly cool it so it
	# reads as deep-background atmosphere; the board substrate + stage glow carry
	# the lit foreground.
	var combat_bg := get_node_or_null("CombatBg") as TextureRect
	if combat_bg != null:
		combat_bg.self_modulate = Color(0.34, 0.30, 0.30, 1.0)
	var mood: Dictionary = GameTheme.SCREEN_MOODS.get("combat", {})
	var vignette := ColorRect.new()
	vignette.name = "Vignette"
	vignette.set_anchors_preset(Control.PRESET_FULL_RECT)
	vignette.mouse_filter = Control.MOUSE_FILTER_IGNORE
	vignette.color = Color.WHITE
	var vmat := ShaderMaterial.new()
	vmat.shader = GameTheme._get_atmosphere_shader()
	# Combat overrides the shared "combat" mood with a deeper, more confident
	# vignette than the other screens. The map/shop/rest can stay gentle; the
	# fight needs the screen edges to fall off hard into shadow so the lit board
	# in the centre is unambiguously the focal zone. Subtle vignettes read flat —
	# this commits: brighter relative centre, near-black corners.
	vmat.set_shader_parameter("vignette_strength", 0.52)
	vmat.set_shader_parameter("grad_inner", Color(0.10, 0.06, 0.04, 0.10))
	vmat.set_shader_parameter("grad_outer", Color(0.01, 0.006, 0.005, 0.68))
	vignette.material = vmat
	add_child(vignette)
	move_child(vignette, 1)

	# Hearth glow — a soft pool of warm firelight rising from the bottom-centre of
	# the battlefield, additively blended so it reads as LIGHT, not paint. Gives
	# the "burning meadow" its heat and keeps the dark frameless board from going
	# flat-shadow now that the gilt frames are gone. Behind the board so it warms
	# the scene without washing out the recessed sockets or the cards on top.
	var glow_grad := Gradient.new()
	glow_grad.offsets = PackedFloat32Array([0.0, 1.0])
	glow_grad.colors = PackedColorArray([
		Color(1.0, 0.52, 0.20, 0.20), Color(1.0, 0.38, 0.12, 0.0)])
	var glow_tex := GradientTexture2D.new()
	glow_tex.gradient = glow_grad
	glow_tex.fill = GradientTexture2D.FILL_RADIAL
	glow_tex.fill_from = Vector2(0.5, 0.5)
	glow_tex.fill_to = Vector2(1.0, 0.5)
	glow_tex.width = 256
	glow_tex.height = 256
	var glow := TextureRect.new()
	glow.name = "HearthGlow"
	glow.texture = glow_tex
	glow.stretch_mode = TextureRect.STRETCH_SCALE
	glow.mouse_filter = Control.MOUSE_FILTER_IGNORE
	glow.anchor_left = 0.5
	glow.anchor_right = 0.5
	glow.anchor_top = 1.0
	glow.anchor_bottom = 1.0
	glow.offset_left = -560
	glow.offset_right = 560
	glow.offset_top = -560
	glow.offset_bottom = 120
	var glow_mat := CanvasItemMaterial.new()
	glow_mat.blend_mode = CanvasItemMaterial.BLEND_MODE_ADD
	glow.material = glow_mat
	add_child(glow)
	move_child(glow, 2)

	# Stage light — a broad, soft elliptical pool centred ON the board (not the
	# bottom edge like the hearth glow above). Additively blended warm light so
	# the 4×4 play field is the brightest zone on screen, with the deepened
	# vignette pulling everything else into shadow around it. This is the lever
	# that turns "cards floating on an evenly-lit photo" into "a lit stage": the
	# eye lands on the lit board first, then the framing darkness reads as depth.
	var stage_grad := Gradient.new()
	stage_grad.offsets = PackedFloat32Array([0.0, 0.45, 1.0])
	stage_grad.colors = PackedColorArray([
		Color(1.0, 0.72, 0.40, 0.26),
		Color(1.0, 0.58, 0.28, 0.13),
		Color(1.0, 0.45, 0.18, 0.0)])
	var stage_tex := GradientTexture2D.new()
	stage_tex.gradient = stage_grad
	stage_tex.fill = GradientTexture2D.FILL_RADIAL
	stage_tex.fill_from = Vector2(0.5, 0.5)
	stage_tex.fill_to = Vector2(1.0, 0.5)
	stage_tex.width = 256
	stage_tex.height = 256
	var stage := TextureRect.new()
	stage.name = "StageLight"
	stage.texture = stage_tex
	stage.stretch_mode = TextureRect.STRETCH_SCALE
	stage.mouse_filter = Control.MOUSE_FILTER_IGNORE
	# Centred on the board area: wide ellipse covering the lanes, biased a touch
	# up from dead-centre so it lights the enemy rows too, not just the player half.
	stage.anchor_left = 0.5
	stage.anchor_right = 0.5
	stage.anchor_top = 0.5
	stage.anchor_bottom = 0.5
	stage.offset_left = -640
	stage.offset_right = 640
	stage.offset_top = -380
	stage.offset_bottom = 340
	var stage_mat := CanvasItemMaterial.new()
	stage_mat.blend_mode = CanvasItemMaterial.BLEND_MODE_ADD
	stage.material = stage_mat
	add_child(stage)
	move_child(stage, 3)

	# Drifting embers across the battlefield — warm sparks rising from the
	# burning meadow. CPUParticles2D (not GPU) so it renders identically on
	# every backend. Sits above the vignette + glow but below the board cards
	# (tree index 3) so cards always read clearly on top.
	#
	# Gated on the player's settings: this is a continuously-emitting particle
	# field, so it forces a full-scene redraw EVERY frame (the scene never idles)
	# and adds CPU sim + overdraw on top. "Particles: Off" should mean off — it
	# used to leak through here (only the combat burst FX honored the flag), so
	# players who lowered settings to fight lag still paid for the ambient field.
	# Reduce Motion suppresses it too (a calm, static backdrop). Skipping creation
	# is safe: _apply_combat_mood null-checks the "AmbientEmbers" node.
	if (UserSettings != null and not UserSettings.particles) \
			or (UserSettings != null and UserSettings.reduce_motion):
		return
	var vp := get_viewport_rect().size
	var embers := CPUParticles2D.new()
	embers.name = "AmbientEmbers"
	embers.amount = 46
	embers.lifetime = 5.0
	embers.preprocess = 4.0   # start mid-stream, not empty
	embers.position = Vector2(vp.x * 0.5, vp.y + 20.0)
	embers.emission_shape = CPUParticles2D.EMISSION_SHAPE_RECTANGLE
	embers.emission_rect_extents = Vector2(vp.x * 0.55, 30.0)
	embers.direction = Vector2(0, -1)
	embers.spread = 22.0
	embers.gravity = Vector2(0, -14.0)         # gentle upward float
	embers.initial_velocity_min = 26.0
	embers.initial_velocity_max = 64.0
	embers.angular_velocity_min = -40.0
	embers.angular_velocity_max = 40.0
	embers.scale_amount_min = 1.4
	embers.scale_amount_max = 3.2
	# Warm ember gradient: bright orange core → fade to dark red, alpha out.
	var grad := Gradient.new()
	grad.set_color(0, Color(1.0, 0.75, 0.30, 0.0))
	grad.set_color(1, Color(0.9, 0.25, 0.10, 0.0))
	grad.add_point(0.15, Color(1.0, 0.70, 0.30, 0.9))
	grad.add_point(0.7, Color(0.95, 0.40, 0.15, 0.55))
	embers.color_ramp = grad
	add_child(embers)
	move_child(embers, 3)   # above the vignette + hearth glow, still below the board


func _on_end_turn_confirmed() -> void:
	# Player accepted the end-turn warning dialog. Re-enter _on_end_turn with
	# the confirmed flag set so the warning check is bypassed.
	_end_turn_confirmed = true
	_on_end_turn()


func _request_space_end_turn() -> void:
	if phase != Phase.PLAYER_TURN or _space_end_turn_confirm_open:
		return
	# Do not turn an attempted targeting confirm into an end-turn request.
	if _targeting_spell != null or _targeting_potion_idx >= 0:
		return
	_space_end_turn_confirm_open = true
	GameTheme.show_confirm_dialog(self,
		"End Turn?",
		"End the turn now and begin the clash?",
		"END TURN",
		"KEEP PLAYING",
		Callable(self, "_confirm_space_end_turn"),
		Callable(self, "_cancel_space_end_turn"))


func _confirm_space_end_turn() -> void:
	_space_end_turn_confirm_open = false
	# This confirmation replaces the conditional playable-action warning; never
	# make the player approve the same end-turn twice.
	_end_turn_confirmed = true
	_on_end_turn()
	_end_turn_confirmed = false


func _cancel_space_end_turn() -> void:
	_space_end_turn_confirm_open = false


## On-Death effect types Read the Will must never fire. Both are IDENTITY arms
## that dispatch_on_death short-circuits BEFORE _run_on_death is reached, and
## both are nonsense on a living body: return_to_hand_once floats the card back
## to hand (the Griffin), and undying_grow writes a PERMANENT run-wide +1/+1 mod
## through RunState.grow_undying — an infinite growth engine for 1 Command if
## Read the Will were allowed to point at The Undying.
const READ_THE_WILL_DENY := {"return_to_hand_once": true, "undying_grow": true}


func _target_contract_available(data: Dictionary) -> bool:
	var targeting := String(data.get("targeting", "none"))
	var allies: Array = _all_player_creatures().filter(
		func(c): return is_instance_valid(c) and c.current_hp > 0 \
			and not c.is_inert_structure() and not _is_effect_immune(c))
	var enemies: Array = _all_enemy_creatures().filter(
		func(c): return is_instance_valid(c) and c.current_hp > 0 \
			and not c.is_inert_structure() and not _is_effect_immune(c))
	# PER-CARD CONTRACTS (2026-07-28 retinue starters). "No dead rewards": a
	# spell whose entire verb needs a particular KIND of body on the board must
	# not be castable into a board that hasn't got one. The targeting mode alone
	# cannot express these, so they are checked ahead of it and are the only two
	# card-specific arms in this function.
	match String(data.get("id", "")):
		"read_the_will":
			for rw_ally in allies:
				var rw_will: Dictionary = rw_ally.card_data.get("on_death", {})
				if not rw_will.is_empty() \
						and not READ_THE_WILL_DENY.has(String(rw_will.get("type", ""))):
					return true
			return false
		"touchpaper":
			for tp_ally in allies:
				if tp_ally.has_keyword("doom"):
					return true
			return false
	match targeting:
		"enemy_creature":
			return not enemies.is_empty()
		"friendly_creature":
			return not allies.is_empty()
		"any_creature":
			return not allies.is_empty() or not enemies.is_empty()
		"any":
			return true
		"friendly_then_enemy":
			return not allies.is_empty() and not enemies.is_empty()
		"two_enemies":
			return enemies.size() >= 2
		"friendly_lane":
			for ally in allies:
				for lane in [ally.current_lane - 1, ally.current_lane + 1]:
					if lane >= 0 and lane < LANES_PER_ROW \
							and not _sp_lane_closed(lane) \
							and _row_array(false, ally.current_row)[lane] == null:
						return true
			return false
	return true


func _has_playable_action() -> bool:
	# Returns true if the player has an affordable, meaningful card in hand.
	# Sacrifice is a free action but not worth nagging about.
	for card in _hand:
		if card == null or not is_instance_valid(card):
			continue
		if CardDB.is_curse(card.card_data.get("id", "")):
			continue
		var cost: int = _effective_cost(card)
		if player_mana >= cost:
			var card_type = card.card_data.get("type", "")
			if card_type == "creature":
				if card.has_keyword("sacrifice"):
					continue
				var has_slot := false
				for row in [ROW_FRONT, ROW_BACK]:
					for lane in range(LANES_PER_ROW):
						if _row_array(false, row)[lane] == null \
								and not _sp_lane_closed(lane):
							has_slot = true
							break
					if has_slot:
						break
				if not has_slot:
					continue
			elif card_type == "armament":
				if not _has_armament_bearer():
					continue
			elif card_type == "spell" and not _target_contract_available(card.card_data):
				continue
			return true
	return false


## A pause the player can cut short. Same scaling as _short_pause; returns true
## if the player asked for it to end early. Holding the mouse fast-forwards, so
## a player who wants the whole opening now can lean on the button through it.
func _rushable_pause(duration: float) -> bool:
	if DisplayServer.get_name() == "headless":
		await _short_pause(duration)
		return false
	var scaled: float = duration
	if UserSettings != null and UserSettings.anim_speed > 0.01:
		scaled = duration / UserSettings.anim_speed
	var deadline := Time.get_ticks_msec() + int(maxf(scaled, 0.0) * 1000.0)
	while Time.get_ticks_msec() < deadline:
		await get_tree().process_frame
		if _rush_requested():
			return true
	return false


## "Get on with it." Level-triggered on purpose (a held button keeps rushing).
func _rush_requested() -> bool:
	if DisplayServer.get_name() == "headless":
		return false
	return Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT) \
		or Input.is_action_pressed("ui_accept") \
		or Input.is_action_pressed("ui_cancel")


## Wait out a cinematic tween, but let the player dismiss it. This is the house
## answer to "the opening feels slow": the beat keeps its full length for the
## fight you have never seen, and costs nothing on the hundredth. `skip_surface`
## is the cinematic's own full-screen dimmer — it already stops mouse input, so
## it is the only thing that can hear the click.
##
## Skipping FAST-FORWARDS the tween rather than killing it: the chain's
## tween_callbacks are what free the banner's nodes, and a kill() would leave
## them on screen forever.
func _await_cinematic(tw: Tween, skip_surface: Control,
		guard_sec: float = 0.35) -> void:
	if tw == null or not tw.is_valid():
		return
	if DisplayServer.get_name() == "headless":
		await tw.finished
		return
	var state := {"done": false, "click": false}
	tw.finished.connect(func() -> void: state["done"] = true)
	if skip_surface != null and is_instance_valid(skip_surface):
		skip_surface.gui_input.connect(func(ev: InputEvent) -> void:
			if ev is InputEventMouseButton and ev.pressed:
				state["click"] = true)
	# A short guard so the very click that COMMITTED to this fight cannot also
	# dismiss the banner it just opened.
	var opened := Time.get_ticks_msec()
	while not state["done"]:
		await get_tree().process_frame
		if not tw.is_valid():
			return
		if Time.get_ticks_msec() - opened < int(guard_sec * 1000.0):
			continue
		if state["click"] or _rush_requested():
			tw.custom_step(9999.0)
			return


## Seconds are divided by this while the rush key is held — see the block below.
const CLASH_RUSH_FACTOR: float = 5.0

func _short_pause(duration: float) -> void:
	# Scaled by UserSettings.anim_speed so the player's animation-speed pref
	# affects ALL combat pacing (draw, attack, death, end-of-turn). Speed 3.0
	# (Instant) collapses pauses to a single frame.
	var scaled: float = duration
	if UserSettings != null and UserSettings.anim_speed > 0.01:
		scaled = duration / UserSettings.anim_speed
	# HOLD TO RUSH (2026-07-29). Serializing the clash bought legibility with time:
	# a full 16-body board went from ~9.3 s to ~15.7 s end-turn-to-playable. Nielsen's
	# 10 s limit is the point at which a skip affordance stops being optional, and
	# combat had none.
	#
	# This is deliberately a HELD key rather than an engine ramp. Hearthstone
	# Battlegrounds auto-accelerates its combat as the fight goes on and the player
	# reports are "the board would pretty much just explode" and "could barely follow
	# with my eyes" — the speed-up arrives exactly when the board is most complex and
	# the player has no say. Holding the key means the player chooses, per clash,
	# with the information in front of them. Releasing restores full pacing mid-beat.
	#
	# Polled rather than wired through `_input` on purpose: `_input` is owned by
	# spell targeting, and a second consumer there is how targeting bugs start.
	if scaled > 0.0 and Input.is_action_pressed("ui_accept"):
		scaled /= CLASH_RUSH_FACTOR
	if scaled <= 0.0:
		await get_tree().process_frame
		return
	await get_tree().create_timer(scaled).timeout


## How long to hold after a blow lands, in seconds.
##
## This REPLACED a two-valued 130/260 ms split that put every ordinary hit at
## 130 ms — inside the window where a strike and its own damage number stop
## reading as cause and effect. The floor is now 150 ms and the ceiling 230 ms,
## the band fighting games have shipped for thirty years (Street Fighter IV:
## 9/11/13 frames by attack strength). Sakurai's rule applies — scale with the
## damage dealt, but CAP it, or a big hit stops the game dead.
##
## A lethal blow always takes the ceiling: it is the one beat in the clash the
## player most needs to attribute, and the corpse is about to leave the board.
func _impact_hold(damage: int, was_lethal: bool) -> float:
	if was_lethal:
		return IMPACT_HOLD_MAX
	return clampf(IMPACT_HOLD_MIN + 0.012 * float(maxi(damage, 0)),
		IMPACT_HOLD_MIN, IMPACT_HOLD_MAX)


## The eye's rest between serialized lanes.
##
## `_do_combat` already resolves ONE COLUMN AT A TIME (front row lanes 0->3, then
## back row lanes 0->3) — the serialization this pass wanted was structurally
## there all along. What was missing is the dwell: scene-viewing fixations run
## 200-300 ms and you must budget 250-350 ms per location you actually want read
## (Rayner 2009). Each lane was getting ~30 ms of exclusive attention, so eight
## sequential single-column exchanges presented as one undifferentiated burst.
##
## Only called when the lane actually did something — a dwell on an empty lane is
## the "phase caption naming an empty beat" mistake in another costume.
##
## Skipped in net (the turn machine's clocks are not ours to stretch) and headless.
## PLAYER-OWNED, NEVER ENGINE-CHOSEN. The Settings row "Clash Pause"
## (UserSettings.clash_dwell_scale, steps Off/Brief/Normal/Long/Study) multiplies
## this. It is deliberately a SEPARATE dial from Animation Speed: anim_speed scales
## every tween in the game including menus and card deals, whereas this is
## specifically the "let me read the board" pause. A player may reasonably want
## fast animations AND long reading pauses, or the reverse.
##
## The two compose: clash_dwell_time() multiplies by the player's dwell preference
## (it does NOT divide by anim_speed — that would double-scale), then _short_pause
## divides by anim_speed like every other combat beat.
##
## Hearthstone Battlegrounds is the cautionary tale here: it ships combat that
## AUTO-ACCELERATES as the fight goes on, and the player reports are "the board
## would pretty much just explode" and "could barely follow with my eyes". Speed
## belongs to the player. Never ramp this from code.
## The fusion beat for a lane that did nothing worth registering separately.
## Deliberately BELOW the causality window, so a chip-damage lane reads as part of
## the same sweep as its neighbour rather than as its own event demanding a look.
## Still honours the player's Clash Pause dial.
func _lane_dwell_minor() -> void:
	if _is_net() or DisplayServer.get_name() == "headless":
		return
	var base: float = LANE_DWELL_MINOR
	if UserSettings != null:
		base = UserSettings.clash_dwell_time(base)
	if base <= 0.0:
		return
	await _short_pause(base)


func _lane_dwell(produced_a_corpse: bool = false) -> void:
	if _is_net() or DisplayServer.get_name() == "headless":
		return
	var base: float = LANE_DWELL_KILL if produced_a_corpse else LANE_DWELL
	if UserSettings != null:
		base = UserSettings.clash_dwell_time(base)
	if base <= 0.0:
		return   # "Off" means no pause at all — not a zero-length timer
	await _short_pause(base)


func _round_beat() -> void:
	## A breath between the round-open's VISIBLE groups. `_start_round` used to
	## fire ~40 state changes on a SINGLE frame — every Regenerate/Wither/Doom
	## tick, every Doom detonation, the tribe keystone grants, Summoner tokens,
	## Trebuchet volleys, the encounter passive, the mutator tick, eight intent
	## badges and a dozen relic branches — and then handed control back. The
	## player had to read the whole round at once, unordered. Splitting it lets
	## the round ASSEMBLE in front of them instead of arriving assembled.
	##
	## MUST NOT SUSPEND IN NET. `_start_round` is called from CombatNet's
	## `_sealed_open_orders_local` and `_net_local_turn_begin`, which are plain
	## `void` functions with several callers each and their own Combat-side
	## delegators; making the chain await would push a coroutine through the
	## hardest-to-verify layer in the project for a purely cosmetic gain the
	## skirmish turn machine does not need. So in net this returns synchronously
	## and `_start_round` behaves exactly as it did before.
	##
	## Headless yields a frame rather than sleeping: the probe harness drives
	## thousands of rounds and has nothing to look at. Same bail as
	## `_play_landing_pop`'s arc.
	if _is_net():
		return
	if DisplayServer.get_name() == "headless":
		return
	await _short_pause(ROUND_BEAT)


# =====================================================================
#  CARD PLAY
# =====================================================================

func _effective_cost(card: Control) -> int:
	## Side-effect-free computation of how much mana playing this card right
	## now will actually cost. Used by both the play-attempt check and the
	## hand-affordability visual so the two are guaranteed to agree.
	##
	## Modifier order matches _on_card_played:
	##   1. Base cost from card_data
	##   2. Taxed mutator (+N, min 1) — spells only
	##   3. Ember Crown — free first spell each turn (relic, spells only)
	##   4. Ironclad Veteran discount (-1 per charge, min 0)
	var cost: int = int(card.card_data.get("cost", 0))
	if card.is_spell() and _mutator_spell_cost_increase > 0:
		cost = maxi(1, cost + _mutator_spell_cost_increase)
	if card.is_spell() and _has_relic("ember_crown") and not _first_spell_this_turn:
		cost = 0
	# Witch (first_spell_discount): your first spell each turn costs 1 less while
	# she stands on your field. Persistent engine — no charge to consume; once the
	# first spell resolves, _first_spell_this_turn flips and the discount rests.
	if card.is_spell() and not _first_spell_this_turn and cost > 0 \
			and _has_passive_on_field("first_spell_discount"):
		cost = maxi(0, cost - 1)
	if _card_cost_discount > 0 and cost > 0:
		cost = maxi(0, cost - 1)
	# Spell Tome — spell-heavy deck discounts spells by 1.
	if card.is_spell() and _spell_tome_active and cost > 0:
		cost = maxi(0, cost - 1)
	# Familiar's Quill: a Warlock played earlier this turn scribes one spell.
	if card.is_spell() and _familiars_quill_charge > 0 and cost > 0:
		cost = maxi(0, cost - 1)
	# Articles of War: positive tribal commitment, never a tax on other cards.
	# The minimum-1 floor means it cannot create free creature loops.
	if card.is_creature() and not _is_net() and _has_relic("articles_of_war") \
			and RunState.articles_of_war_tribe != "" \
			and String(card.card_data.get("ctype", "")) == RunState.articles_of_war_tribe \
			and cost > 1:
		cost -= 1
	# Mana Tide — a banked-mana charge discounts the next creature by 1.
	if card.is_creature() and _mana_tide_creature_discount > 0 and cost > 0:
		cost = maxi(0, cost - 1)
	# Sigil of Hunger — discount charge from a friendly death this round.
	if card.is_creature() and _sigil_of_hunger_charge > 0 and cost > 0:
		cost = maxi(0, cost - 1)
	# Mummified Hand — per-card meta tag set when a spell cast picked this one.
	if card.state.mummified_zero:
		cost = 0
	# Pact of Embers — turn-start tag for the highest-cost card in hand.
	if card.state.pact_of_embers_zero:
		cost = 0
	# Trickster's Glove — hand size 4+ discounts every card by 1.
	if _has_relic("tricksters_glove") and _hand.size() >= 4 and cost > 0:
		cost = maxi(0, cost - 1)
	# Last Breath — creatures with 1 base HP cost 1 less.
	if _has_relic("last_breath") and card.is_creature() \
			and int(card.card_data.get("hp", 99)) == 1 and cost > 0:
		cost = maxi(0, cost - int(RelicDB.get_relic("last_breath").get("value", 1)))
	return cost


func _on_card_played(card: Control) -> void:
	if phase != Phase.PLAYER_TURN:
		_layout_hand()  # bounce the dragged card back into the fan
		return
	# Skirmish: you may only play on your own turn (full-alternating model).
	if _is_net() and _net_active_index != NetMatch.local_player_index:
		_show_info("Not your turn.")
		_layout_hand()
		return
	if _targeting_spell != null:
		_cancel_targeting()

	# Curses: "Can't be played" is enforced HERE, not just written on the card.
	# (Before this gate a dragged Curse resolved as a free no-op spell and
	# cycled to discard — the card text was a lie.) Playable-at-a-price curses
	# (Cowardice) carry curse_playable and fall through to the normal cost check.
	if CardDB.is_curse(String(card.card_data.get("id", ""))) \
			and not bool(card.card_data.get("curse_playable", false)):
		_show_info("%s cannot be played. It stays in your hand until the fight ends." \
			% String(card.card_data.get("name", "The Curse")))
		_layout_hand()  # bounce the dragged card back into the fan
		return
	if card.is_armament():
		if _is_net():
			_show_info("Armaments aren't available in skirmish yet.")
			_layout_hand()
			return
		if not _has_armament_bearer():
			_show_info("No unequipped creature can bear this Armament.")
			_layout_hand()
			return
	elif card.is_spell() and not _target_contract_available(card.card_data):
		_show_info("No legal targets for %s." % String(card.card_data.get("name", "that spell")))
		_layout_hand()
		return
	elif card.is_creature():
		if card.has_keyword("sacrifice"):
			_show_info("This creature needs a sacrifice target before it can be played.")
			_layout_hand()
			return
		var preflight_drop = _nearest_player_slot(
			card.global_position + card.size * 0.5)
		var preflight_lane: int = int(preflight_drop.lane)
		var preflight_row: int = int(preflight_drop.row)
		if _row_array(false, preflight_row)[preflight_lane] != null:
			_show_info("That slot is occupied.")
			_layout_hand()
			return
		if _sp_lane_closed(preflight_lane):
			_show_info("No footing there - the ground is closed this fight.")
			_layout_hand()
			return
		if _is_sealed() and not _sealed_in_orders():
			_show_info("Orders are locked. Creatures must wait until your next turn.")
			_layout_hand()
			return

	# Velvet Choker: max 5 cards per turn
	if _has_relic("velvet_choker") and _cards_played_this_turn >= 5:
		_show_info("Velvet Choker: can't play more than 5 cards!")
		# A REFUSAL is a state change too — the rail names which relic said no.
		_relic_fired("velvet_choker")
		_layout_hand()  # bounce the dragged card back into the fan
		return

	# Effective cost factors in mutators (Taxed +N), Ember Crown (free first
	# spell), and Ironclad Veteran's per-charge discount. _effective_cost is
	# the single source of truth — _refresh_hand_affordability calls the same
	# helper so the dimmed/affordable visual ALWAYS matches the actual play
	# check. Previously the affordability check read raw card_data.cost and
	# the play check applied the modifiers — so e.g. with Taxed +1 active,
	# a 1-cost Fireball looked "affordable" at 1 mana but failed to play.
	var cost = _effective_cost(card)
	if player_mana < cost:
		_show_info("Not enough Command!")
		_layout_hand()  # bounce the dragged card back into the fan
		return
	# Targeted Armaments have not resolved yet. Preserve the few generic
	# one-shot discounts that _on_card_played consumes so right-click cancel is
	# a true rollback rather than silently spending a charge or zero-cost tag.
	if card.is_armament() or (card.is_spell() \
			and String(card.card_data.get("targeting", "none")) != "none"):
		_armament_targeting_rollback = {
			"card_cost_discount": _card_cost_discount,
			"mana_tide": _mana_tide_creature_discount,
			"sigil_hunger": _sigil_of_hunger_charge,
			"familiars_quill": _familiars_quill_charge,
			"mummified_zero": bool(card.state.mummified_zero),
			"pact_zero": bool(card.state.pact_of_embers_zero),
			"first_spell": _first_spell_this_turn,
		}
	# HS trinket beats: flash the discount relic's chip when its cut actually
	# paid on this play (base cost > 0, condition met). Read the flags BEFORE
	# the play flips them below/inside the resolvers.
	if int(card.card_data.get("cost", 0)) > 0:
		if card.is_spell() and _has_relic("ember_crown") and not _first_spell_this_turn:
			_relic_fired("ember_crown")
		elif card.is_spell() and _spell_tome_active:
			_relic_fired("spell_tome")
		if card.is_creature() and _has_relic("last_breath") \
				and int(card.card_data.get("hp", 99)) == 1:
			_relic_fired("last_breath")
	# Consume the Ironclad Veteran discount charge ONLY if it actually applied
	# (i.e. cost was still > 0 after mutator+Ember adjustments). _effective_cost
	# itself is side-effect free so this consumption happens here, where we
	# know the play is going through.
	if _card_cost_discount > 0:
		var pre_discount: int = int(card.card_data.get("cost", 0))
		if card.is_spell() and _mutator_spell_cost_increase > 0:
			pre_discount = maxi(1, pre_discount + _mutator_spell_cost_increase)
		if card.is_spell() and _has_relic("ember_crown") and not _first_spell_this_turn:
			pre_discount = 0
		if pre_discount > 0:
			_card_cost_discount -= 1
	# Mana Tide — playing a creature consumes one banked-mana discount charge.
	if card.is_creature() and _mana_tide_creature_discount > 0:
		_mana_tide_creature_discount -= 1
	# Sigil of Hunger — same model as mana_tide; a creature consumes the charge.
	if card.is_creature() and _sigil_of_hunger_charge > 0:
		_sigil_of_hunger_charge -= 1
	if card.is_spell() and _familiars_quill_charge > 0:
		_familiars_quill_charge -= 1
		_relic_fired("familiars_quill")
	# Mummified Hand / Pact of Embers meta tags are one-shot. Clear them when
	# the tagged card is actually played so the discount doesn't carry over to
	# whatever creature/spell happens to draw the meta next turn.
	if card.state.mummified_zero:
		card.state.mummified_zero = false
	if card.state.pact_of_embers_zero:
		card.state.pact_of_embers_zero = false

	# Witch (first_spell_discount): flash her cut when it actually paid out, so the
	# cheaper cast is attributable. _effective_cost is side-effect-free, so probing
	# "what would this cost without the first-spell discount" via the flag is safe.
	# (Skipped under Ember Crown — the relic already made the first spell free.)
	if card.is_spell() and not _first_spell_this_turn \
			and _has_passive_on_field("first_spell_discount") and not _has_relic("ember_crown"):
		_first_spell_this_turn = true
		var witch_undiscounted: int = _effective_cost(card)
		_first_spell_this_turn = false
		if witch_undiscounted > cost:
			for _wi in _all_player_creatures():
				if _wi.card_data.get("passive", "") == "first_spell_discount":
					spawn_floating_number(_wi.global_position \
						+ Vector2(_wi.size.x * _wi.scale.x * 0.5, -10),
						"-1 COMMAND", Color(0.55, 0.78, 1.0), false)
					break

	if card.is_spell():
		_play_spell(card, cost)
	elif card.is_armament():
		_play_armament(card, cost)
	else:
		_play_creature(card, cost)


func _apply_starter_creature_play_relics(card: Control, row: int, lane_idx: int) -> void:
	if _is_net() or card == null or not is_instance_valid(card):
		return
	if row == ROW_BACK and _has_relic("rearward_horn") \
			and not _rearward_horn_used_this_round:
		_rearward_horn_used_this_round = true
		_grant_starter_temp_swift(card, 1, "REARWARD HORN")
		_relic_fired("rearward_horn")
	if row == ROW_BACK and _has_relic("reserve_standard") \
			and not _reserve_standard_used_this_round:
		var front_mate = _player_field[lane_idx]
		if front_mate != null and is_instance_valid(front_mate) and front_mate.current_hp > 0:
			_reserve_standard_used_this_round = true
			# Normalised 2026-07-28 (behaviour change): this set state.has_shield
			# raw, skipping _grant_combat_shield's already-shielded guard and its
			# net text. A body that walked in already carrying Shield now no
			# longer prints a second, meaningless SHIELD callout.
			_grant_combat_shield(card)
			_relic_fired("reserve_standard")
	# War Bellows — the Kindler's first-win unlock. It used to hand +1/+1 AND push
	# the fuse out a round; a first-win unlock that carries a DRAWBACK is a poor
	# reward, and the delay fought the Kindler's other doctrine (Chain Censer)
	# which exists to pull timers in. 2026-07-28: the timer clause is gone and the
	# body is worth more.
	if card.has_keyword("doom") and _has_relic("war_bellows") \
			and not _war_bellows_used_this_round:
		_war_bellows_used_this_round = true
		var wb_n: int = maxi(1, int(RelicDB.get_relic("war_bellows").get("value", 2)))
		card.card_data["atk"] = int(card.card_data.get("atk", card.current_atk)) + wb_n
		card.current_atk += wb_n
		card.card_data["hp"] = int(card.card_data.get("hp", card.current_hp)) + wb_n
		card.current_hp += wb_n
		card.update_stat_display()
		_relic_fired("war_bellows")


func _play_creature(card: Control, cost: int) -> void:
	if card.has_keyword("sacrifice"):
		_show_info("Click a creature to sacrifice for this card.")
		_layout_hand()  # bounce the dragged card back into the fan
		return

	# 4x4: derive both lane and row from the drop position. Use the card's CENTER
	# (not its top-left origin) so the slot we pick matches the one the drag
	# highlight lit up — `dragging` emits `global_position + size*0.5`, and the
	# drag pivot is centred, so size*0.5 (NOT size*scale*0.5) is the true on-screen
	# centre = the cursor. Reading the raw origin biased every drop one row up.
	# Drops on occupied slots are rejected (no replace) — creatures stay where
	# they were placed unless an explicit effect moves them.
	var drop = _nearest_player_slot(card.global_position + card.size * 0.5)
	var lane_idx: int = drop.lane
	var row: int = drop.row
	var field = _row_array(false, row)
	if field[lane_idx] != null:
		_show_info("That slot is occupied.")
		_layout_hand()
		return
	# A set-piece's closed ground rejects the player's drop the same way it
	# rejects an enemy arrival — the rule is symmetric or it is not a rule.
	if _sp_lane_closed(lane_idx):
		_show_info("No footing there — the ground is closed this fight.")
		_layout_hand()
		return

	# ── SEALED ORDERS: a play during the orders phase is a PRIVATE commitment —
	# nothing seats for real and nothing crosses the wire but a face-down ghost
	# at the lane. Both bundles seat together at the reveal. ──
	if _is_sealed():
		if not _sealed_in_orders():
			_show_info("Orders are locked. Creatures must wait until your next turn.")
			_layout_hand()
			return
		_sealed_commit_creature(card, cost, lane_idx, row)
		return

	# ── Skirmish CLIENT: don't seat locally. Spend Command, drop the hand card,
	# and send a play intent — the creature reappears on this screen via the next
	# board snapshot from the host (which runs its on-enter authoritatively). ──
	if _is_client():
		if _net_active_index != NetMatch.local_player_index:
			_show_info("Not your turn.")
			_layout_hand()
			return
		var c_uid: int = card.deck_uid
		var c_id: String = card.card_id
		# Capture the fly-in origin + face BEFORE freeing the hand card — the cosmetic
		# arc below needs them, and global_position is meaningless once it's removed.
		var fly_origin: Vector2 = card.global_position + card.size * 0.5
		var fly_data: Dictionary = card.card_data.duplicate(true)
		player_mana -= cost
		_pulse_mana_label(cost)
		_hand.erase(card)
		_hand_container.remove_child(card)
		card.queue_free()
		if AudioBank != null:
			AudioBank.play_sfx("card_play")
		# Send the intent FIRST (no animation latency on the authoritative play), then
		# bridge the visual gap with a fire-and-forget fly-in to the destination slot.
		NetMatch.send_intent({
			"t": NetMatch.IN_PLAY_CREATURE, "uid": c_uid, "id": c_id,
			"lane": lane_idx, "row": row,
			# Unspent Command AFTER paying this card — the host reads it for
			# play-time passives that scale off the caster's pool (Condottiere).
			"mana": player_mana,
		})
		_net_broadcast_hand_count()
		_layout_hand()
		_update_hud()
		_client_animate_own_play(fly_data, lane_idx, row, fly_origin)
		return

	# PlayLog: record the play with pre-mutation state (state→action pair).
	_pl_log("play_creature", {"card": card.card_id, "uid": card.deck_uid,
		"cost": cost, "lane": lane_idx, "row": row})
	_log_event("You field %s." % _log_card_ref(card),
		_log_data(card), _log_side(card))

	# Capture hand position BEFORE remove_child so the landing arc knows where
	# this card flew in from. Once removed, global_position no longer reflects
	# the on-screen hand slot.
	var play_start_global: Vector2 = card.global_position
	player_mana -= cost
	_pulse_mana_label(cost)
	_cards_played_this_turn += 1
	if _is_net():
		_net_cards_played[0] += 1   # host's per-side card tally (Ironclad Veteran)
	# The Tally-Stick (vanguard_banner id, 2026-07-16 reshape): the turn's 3rd
	# card cuts a notch — the whole line gains +1 ATK this round (temp_atk_buff,
	# the established this-round channel). The card being played right now isn't
	# on the board yet; it collects its share from the late-arrival check below.
	if _cards_played_this_turn == 3 and _has_relic("vanguard_banner") and not _is_net():
		_tally_notched = true
		var tally_val: int = int(RelicDB.get_relic("vanguard_banner").get("value", 1))
		for tc in _all_player_creatures():
			tc.temp_atk_buff += tally_val
			tc.update_stat_display()
			spawn_floating_number(_card_center(tc), "+%d" % tally_val,
				Color(1.0, 0.85, 0.45), false)
		_relic_fired("vanguard_banner")
	# Flag BEFORE remove_child: pulling a hovered card out of the hand can
	# fire its mouse_exited, and the exit handler's return-to-hand-pose
	# branch must already see "this is a battlefield card" or it writes
	# hand-fan coordinates onto a card being seated into a slot.
	card.is_on_battlefield = true
	card.current_lane = lane_idx
	card.current_row = row
	_hand.erase(card)
	_hand_container.remove_child(card)
	if AudioBank != null:
		AudioBank.play_sfx("card_play")
	# Hand → battlefield: shrink to the compact variant so the 4x4 grid fits.
	card.set_compact_mode(true)

	# Forlorn Hope: an always-live opening buff, with the storming-party version
	# reserved for Generals and lords. Swift is round-scoped via the same meta
	# War Cry uses and is cleared in end-of-round cleanup.
	if _has_relic("forlorn_hope") and not _forlorn_hope_used_this_fight:
		_forlorn_hope_used_this_fight = true
		var storming: bool = RunState.current_node_type in ["elite", "boss"]
		card.current_atk += 2 if storming else 1
		if storming:
			card.state.war_cry_swift = true
			spawn_keyword_callout_kw(card, "granted_swift")
		card.update_stat_display()
		_relic_fired("forlorn_hope")

	# The Cerecloth: the newest fallen soldier lends only beneficial printed
	# combat keywords. Rules markers and liabilities (Doom/Wither/Sacrifice)
	# are deliberately excluded; a blank shroud still grants +1/+1.
	if _has_relic("cerecloth") and not _cerecloth_used_this_fight \
			and not RunState.fallen.is_empty():
		_cerecloth_used_this_fight = true
		var last_fall: Dictionary = RunState.fallen.back()
		var fallen_data: Dictionary = CardDB.get_card_data(String(last_fall.get("id", "")))
		var beneficial := ["armored", "swift", "thorns", "regenerate", "summon",
			"last_stand", "piercing", "sniper", "poison", "shield", "guardian",
			"rampage", "lifelink", "overrun", "formation"]
		var copied := 0
		for kw in fallen_data.get("keywords", []):
			if kw in beneficial and not card.card_data.keywords.has(kw):
				card.card_data.keywords.append(kw)
				copied += 1
		if copied == 0:
			card.current_atk += 1
			card.current_hp += 1
			card.card_data.hp += 1
		card.update_stat_display()
		_relic_fired("cerecloth")

	# The Second Rank: building a Soldier column improves both bodies now,
	# instead of creating a timing exception inside simultaneous death cleanup.
	if _has_relic("second_rank") and row == ROW_BACK \
			and String(card.card_data.get("ctype", "")) == "soldier":
		var front_soldier = _player_field[lane_idx]
		if front_soldier != null and is_instance_valid(front_soldier) \
				and String(front_soldier.card_data.get("ctype", "")) == "soldier":
			for rank_soldier in [front_soldier, card]:
				rank_soldier.current_atk += 1
				rank_soldier.current_hp += 1
				rank_soldier.card_data.hp += 1
				rank_soldier.update_stat_display()
			_relic_fired("second_rank")

	if _has_relic("familiars_quill") \
			and String(card.card_data.get("ctype", "")) == "warlock":
		_familiars_quill_charge = 1
		_relic_fired("familiars_quill")
	if _verse_of_you_buff_pending > 0:
		var verse_gain: int = _verse_of_you_buff_pending
		_verse_of_you_buff_pending = 0
		card.current_atk += verse_gain
		card.current_hp += verse_gain
		card.card_data.hp += verse_gain
		card.update_stat_display()
		_relic_fired("verse_of_you")

	if _has_relic("iron_buckler") and not _iron_buckler_used_this_fight:
		_iron_buckler_used_this_fight = true
		if "last_stand" not in card.card_data.keywords:
			card.card_data.keywords.append("last_stand")
			if card.has_method("_spawn_keyword_chip"):
				card._spawn_keyword_chip("LAST STAND", Color(1.0, 0.85, 0.45))
			_relic_fired("iron_buckler")
	# Forced March — the round's first body arrives already formed up. Granting
	# the real Swift keyword (rather than poking ready_to_swing) is deliberate:
	# Card2D.ignores_muster_delay() honours granted Swift, and _creature_hits_face
	# separately bars arriving Swift from the face, so the relic cannot become a
	# burst finisher. `_first_creature_played` is set later in this same function,
	# so reading it here is still "is this the first creature this round".
	if _has_relic("mana_drunkard") and card.is_creature() and not _first_creature_played:
		if "swift" not in card.card_data.keywords:
			card.card_data.keywords.append("swift")
			card.update_stat_display()
			if card.has_method("_spawn_keyword_chip"):
				card._spawn_keyword_chip("SWIFT", Color(0.62, 0.88, 1.0))
		_relic_fired("mana_drunkard")
	# Vanguard's Cry — the fight's first creature bellows across the line:
	# 2 damage to whatever stands in its column. Positional: WHERE you open
	# matters now (was an invisible "+1 to On-Enter damage").
	if _has_relic("vanguards_cry") and not _vanguard_cry_used_this_fight \
			and card.is_creature() and not _is_net():
		_vanguard_cry_used_this_fight = true
		var cry_target = _get_creature_in_column(true, lane_idx)
		if cry_target != null and is_instance_valid(cry_target):
			_show_info("Vanguard's Cry: deal 2 damage to the opposing creature.")
			_relic_fired("vanguards_cry")
			cry_target.take_damage(int(RelicDB.get_relic("vanguards_cry").get("value", 2)))
	# Banner of Unity — closing a rank is a moment: a creature played BETWEEN
	# two friendlies rallies all three (+1 ATK this fight). Was an invisible
	# "+1 to Adj. Buff effects".
	if _has_relic("banner_of_unity") and card.is_creature() and not _is_net():
		var band_row = _row_array(false, row)
		var band_left = band_row[lane_idx - 1] if lane_idx > 0 else null
		var band_right = band_row[lane_idx + 1] if lane_idx < LANES_PER_ROW - 1 else null
		if band_left != null and is_instance_valid(band_left) \
				and band_right != null and is_instance_valid(band_right):
			for band_c in [band_left, card, band_right]:
				band_c.current_atk += 1
				band_c.update_stat_display()
			_relic_fired("banner_of_unity")
			_show_info("Banner of Unity: these 3 creatures gain +1 ATK this fight.")
	if _has_relic("veterans_medal") and card.card_data.cost == 1 and card.is_creature():
		_relic_fired("veterans_medal")
		card.current_atk += 1
		card.current_hp += 1
		card.card_data.hp += 1
	if _has_relic("glass_cannon") and card.is_creature():
		card.current_hp = maxi(1, card.current_hp - 1)
		card.card_data.hp = maxi(1, card.card_data.hp - 1)
	# Iron Legion: creature-heavy deck (≥60%) grants +1 HP to friendlies on entry.
	if _has_relic("iron_legion") and card.is_creature() and _deck_creature_ratio() >= 0.6:
		_relic_fired("iron_legion")
		card.current_hp += 1
		card.card_data.hp += 1
	# Totem Pole: grant the run-picked keyword to every friendly on placement.
	if _has_relic("totem_pole") and card.is_creature() and RunState.totem_pole_keyword != "":
		var kw: String = RunState.totem_pole_keyword
		if not card.card_data.keywords.has(kw):
			_relic_fired("totem_pole")
			card.card_data.keywords.append(kw)
			card.update_stat_display()
	# Bone Hourglass: apply the run-picked ramp on placement.
	if _has_relic("bone_hourglass") and card.is_creature():
		match RunState.bone_hourglass_choice:
			"front_atk":
				if row == ROW_FRONT:
					card.current_atk += 1
			"back_hp":
				if row == ROW_BACK:
					card.current_hp += 1
					card.card_data.hp += 1
		card.update_stat_display()

	# Hourglass of Ruin: your Doom creatures detonate sooner. Seed the per-creature
	# countdown low on placement (floored at 1 so it still gets one live round on
	# the board to threaten — "1 round sooner", not "instantly").
	if _has_relic("hourglass_of_ruin") and card.is_creature() and card.has_keyword("doom"):
		_relic_fired("hourglass_of_ruin")
		if card.has_method("_ensure_doom_init"):
			card._ensure_doom_init()
		var ruin: int = int(RelicDB.get_relic("hourglass_of_ruin").get("value", 1))
		card.doom_counter = maxi(1, card.doom_counter - ruin)
		if card.has_method("update_doom_display"):
			card.update_doom_display()

	# Shield keyword: grant shield on placement
	if card.has_keyword("shield"):
		card.state.has_shield = true
	# Mutator: extra keyword grant ("Swift Winds") or HP weaken ("Cursed") on
	# the freshly-played creature. Mirrors the enemy hook in _place_enemy_card.
	_mutator_apply_to_player_creature(card)
	_first_creature_played = true
	# Butcher's Cleaver — consume armed state, grant +2 ATK for 2 rounds.
	if _butchers_cleaver_armed and _has_relic("butchers_cleaver"):
		_butchers_cleaver_armed = false
		_relic_fired("butchers_cleaver")
		var bc_value: int = RelicDB.get_relic("butchers_cleaver").get("value", 2)
		card.persistent_atk_buff += bc_value
		card.persistent_atk_buff_rounds = 2
		card.update_stat_display()
	# with_arc=false: the player has already dragged the card to this slot,
	# so the arc animation would loop back over their own gesture — at the
	# slot itself it reads as a pointless circle. The scale-punch settle in
	# _play_landing_pop's no-arc path is the right amount of feedback.
	_place_card_in_slot(card, lane_idx, row, play_start_global, false)
	_apply_starter_creature_play_relics(card, row, lane_idx)
	if String(card.card_id) == "sword_on_credit":
		card.state.credit_due_round = round_number + 1

	# Mimic Ring relic: copy one combat keyword from an adjacent friendly. Canonical
	# adjacency (row ±1 + column-mate) — the card copies from any adjacent ally,
	# collecting their combat keywords and appending the first one it lacks. Skipped
	# if no adjacent ally or no copyable keyword is available.
	if _has_relic("mimic_ring") and card.is_creature():
		var neighbors: Array = []
		for adj_ally in _adjacent_creatures(false, row, lane_idx):
			if adj_ally != card:
				neighbors.append(adj_ally)
		var picked_kw := ""
		for n in neighbors:
			for kw in n.card_data.get("keywords", []):
				if kw in KeywordEffects.COMBAT_KEYWORDS \
						and not card.card_data.keywords.has(kw):
					picked_kw = kw
					break
			if picked_kw != "":
				break
		if picked_kw != "":
			card.card_data.keywords.append(picked_kw)
			if card.has_method("_spawn_keyword_chip"):
				card._spawn_keyword_chip("MIMIC", Color(0.65, 0.85, 1.0))
			card.update_stat_display()
			_relic_fired("mimic_ring")

	# Encounter passive: collector heals on creature played
	if _encounter_passive == "collector_heal":
		enemy_hp = mini(enemy_hp + 1, enemy_max_hp)
	elif _encounter_passive == "collector_phase2":
		enemy_hp = mini(enemy_hp + 2, enemy_max_hp)
		_buff_random_enemy_atk(1)

	# Linked Banner: HP-half snapshot scan. Re-check every friendly so a
	# brand-new adjacency that pushed an ally from 1→2 picks up the +1 HP.
	_apply_linked_banner_hp()

	# On-enter effects + the Summon keyword (single dispatch point; the
	# ON_PLAYER_SUMMON reactive fires from inside it as well).
	KeywordEffects.dispatch_on_enter(card, lane_idx, false, self)
	# On-play ability (formerly floop): fires immediately when the creature
	# lands. Fire-and-forget so any modal pickers match the on-enter convention.
	if card.card_data.has("on_play"):
		_resolve_on_play_ability(card, lane_idx, false)
	_maybe_beast_encore(card, false)   # Bloodmoon Alpha doubles a Beast's arrival
	_maybe_stampede(card, false)       # The Dire Alpha charges the pack in

	# Blueprint: replay the previously-played friendly creature's on-enter on
	# this card, then cache this card's own on-enter for the NEXT play. Chains
	# through every friendly creature played this combat. Triggered after the
	# card's own on-enter so the "echo" reads as a separate beat.
	if _has_relic("blueprint") and card.is_creature():
		if not _blueprint_last_on_enter.is_empty():
			_relic_fired("blueprint")
			KeywordEffects._run_on_enter(_blueprint_last_on_enter, card, lane_idx, false, self)
		if card.card_data.has("on_enter"):
			_blueprint_last_on_enter = card.card_data["on_enter"].duplicate(true)

	# Reaper's Scythe: an on-play ability stolen from a sacrificed creature is
	# grafted onto the next-played creature and fires immediately.
	if _has_relic("reapers_scythe") and card.is_creature() \
			and not _reapers_scythe_pending_floop.is_empty():
		card.card_data["on_play"] = _reapers_scythe_pending_floop.duplicate(true)
		_relic_fired("reapers_scythe")
		_resolve_on_play_ability(card, lane_idx, false)
		card.update_stat_display()
		_reapers_scythe_pending_floop = {}

	# Enter-with-a-bonus passives (Ironclad / Hexblade / Warchief / Tallow Doll) plus
	# Standard Bearer's first-1-cost summon. Extracted so the net spawn path runs the
	# SAME for the CLIENT's creatures, reading the client's per-side counters.
	_apply_play_time_passives(card, false)

	# Raider's Oath (class-restricted): playing a Swift creature refunds 1 mana
	# this turn. Stacks with itself — multiple Swift plays each refund.
	if _has_relic("raiders_oath") and card.is_creature() and card.has_keyword("swift"):
		var ro_n := int(RelicDB.get_relic("raiders_oath").get("value", 1))
		player_mana += ro_n
		_pulse_mana_label(ro_n, true)   # a refund the player must SEE to spend
		_relic_fired("raiders_oath")    # ...and the rail names what paid for it
	# The Tally-Stick (vanguard_banner id, 2026-07-16 reshape): creatures played
	# after the turn's 3rd card still share the notch — the buff belongs to the
	# TURN, not the moment it was cut. (The notch itself fires at the play
	# counter in this function, above.)
	if _tally_notched and _has_relic("vanguard_banner") and card.is_creature() and not _is_net():
		card.temp_atk_buff += int(RelicDB.get_relic("vanguard_banner").get("value", 1))
		card.update_stat_display()
	# The Sunken Road Stone (set-piece trophy): whatever you put down first each
	# round digs in the way the line in the ditch did. Once per ROUND, not per
	# turn — the round is the unit the player plans in.
	if _has_relic("sunken_road_stone") and card.is_creature() 			and not _road_stone_used_this_round:
		_road_stone_used_this_round = true
		if not card.has_keyword("armored"):
			card.card_data.keywords.append("armored")
			if card.has_method("_refresh_status_rail"):
				card._refresh_status_rail()
			if card.has_method("_spawn_keyword_chip"):
				card._spawn_keyword_chip("ARMORED", Color(0.80, 0.86, 1.0))
		_relic_fired("sunken_road_stone")
	# Spotter's Glass: if the column (BOTH rows in that lane) had no other
	# friendly before this placement, the new creature gets +1 ATK permanently.
	if _has_relic("spotters_glass") and card.is_creature():
		var col_empty := true
		var other_row: int = ROW_BACK if row == ROW_FRONT else ROW_FRONT
		if _row_array(false, other_row)[lane_idx] != null:
			col_empty = false
		if col_empty:
			card.current_atk += int(RelicDB.get_relic("spotters_glass").get("value", 1))
			card.update_stat_display()
			_relic_fired("spotters_glass")

	# Brainstorm: each round, the first creature played copies the keywords of
	# the FIRST creature played this combat. Captures the seed creature on its
	# play; later rounds graft those keywords onto the round's first creature.
	if _has_relic("brainstorm") and card.is_creature():
		if _brainstorm_first_keywords.is_empty():
			_brainstorm_first_keywords = card.card_data.get("keywords", []).duplicate()
		elif not _brainstorm_fired_this_round:
			for kw in _brainstorm_first_keywords:
				if kw in KeywordEffects.COMBAT_KEYWORDS \
						and not card.card_data.keywords.has(kw):
					card.card_data.keywords.append(kw)
			_brainstorm_fired_this_round = true
			card.update_stat_display()
			_relic_fired("brainstorm")

	# Wormwood / Stalwart's Anvil react inside _on_friendly_damaged.
	# Pen Nib counts every card played (creature OR spell).
	if _has_relic("pen_nib"):
		_pen_nib_counter += 1
		var threshold: int = int(RelicDB.get_relic("pen_nib").get("value", 10))
		if threshold > 0 and _pen_nib_counter >= threshold:
			_pen_nib_counter = 0
			_pen_nib_trigger()

	card.update_stat_display()
	_update_hud()

	# ── Skirmish HOST: the host played its own creature (real local Card2D, real
	# on-enter above). Stamp its network id (= deck uid) and push the new board to
	# the client so the opponent sees it. ──
	if _is_host():
		card.entity_id = card.deck_uid
		NetMatch.register_entity(card.entity_id, card)
		_net_broadcast_hand_count()
		_net_sync_board()


func _play_spell(card: Control, cost: int) -> void:
	# Skirmish routes spells through the host-authoritative net resolver.
	if _is_net():
		_net_play_spell(card, cost)
		return
	# PlayLog: stash pre-cast snapshot; emitted at _after_spell with the target.
	_pl_spell_pending = {"card": card.card_id, "uid": card.deck_uid, "cost": cost,
		"targeting": card.card_data.get("targeting", "none"), "snap": _pl_snapshot()}
	var targeting = card.card_data.get("targeting", "none")
	# Capture hand position so the cast-ghost knows where the spell card flew
	# from. For targeted spells the ghost lingers until the player clicks; for
	# non-targeted spells it dissolves immediately above the play line.
	var spell_start_global: Vector2 = card.global_position
	if targeting != "none":
		player_mana -= cost
		_targeting_paid_cost = cost
		_pulse_mana_label(cost)
		_first_spell_this_turn = true
		_cards_played_this_turn += 1
		_hand.erase(card)
		_hand_container.remove_child(card)
		_spawn_spell_cast_ghost(card.card_data, spell_start_global, null)
		_targeting_spell = card
		_targeting_data = card.card_data
		_targeting_first_target = null
		# Persistent, named prompt — set DIRECTLY (not via _show_info, whose 2s
		# timer would wipe it while targeting is still armed). Names the spell, the
		# legal target, and the cancel gesture. Cleared on resolve/cancel.
		_info_token += 1   # invalidate any pending _show_info clear-timer
		_clear_info_queue()   # this prompt now OWNS the label — drop queued lines
		_info_label.text = "%s — choose %s    ·    right-click to cancel" % [
			String(card.card_data.get("name", "Spell")), _targeting_human(targeting)]
		_info_label.modulate = Color(1, 1, 1, 1)
		_show_targeting_arrow()
		_update_hud()
		return

	# Non-targeted spell: resolve immediately
	player_mana -= cost
	_pulse_mana_label(cost)
	_first_spell_this_turn = true
	_cards_played_this_turn += 1
	_hand.erase(card)
	_hand_container.remove_child(card)
	_spawn_spell_cast_ghost(card.card_data, spell_start_global, null)
	await _resolve_spell(card.card_data, null, -1)
	_after_spell(card)


func _play_armament(card: Control, cost: int) -> void:
	# Armaments are a campaign card type, not spells. They use the familiar
	# click-to-target interaction, but deliberately skip every spell counter,
	# spell relic, reactive, Echo history, and first-spell discount.
	if _is_net():
		_show_info("Armaments aren't available in skirmish yet.")
		_layout_hand()
		return
	if not _has_armament_bearer():
		_show_info("No unequipped creature can bear this Armament.")
		_layout_hand()
		return

	player_mana -= cost
	_targeting_paid_cost = cost
	_pulse_mana_label(cost)
	_cards_played_this_turn += 1
	_hand.erase(card)
	_hand_container.remove_child(card)
	_targeting_spell = card
	_targeting_data = card.card_data
	_targeting_first_target = null
	_info_token += 1
	_clear_info_queue()   # this prompt now OWNS the label
	_info_label.text = "%s — choose an unequipped creature    ·    right-click to cancel" \
		% String(card.card_data.get("name", "Armament"))
	_info_label.modulate = Color(1, 1, 1, 1)
	_show_targeting_arrow()
	_update_hud()


func _has_armament_bearer() -> bool:
	for bearer in _all_player_creatures():
		if _can_equip_armament(bearer):
			return true
	return false


func _can_equip_armament(target: Control) -> bool:
	return target != null and is_instance_valid(target) and target.is_creature() \
		and target.current_hp > 0 and not target.has_keyword("structure") \
		and not _is_effect_immune(target) \
		and target.card_data.get("equipped_armament", {}).is_empty()


func _equipped_armament_id(card: Control) -> String:
	if card == null or not is_instance_valid(card):
		return ""
	return String(card.card_data.get("equipped_armament", {}).get("id", ""))


func _apply_armament(data: Dictionary, bearer: Control) -> bool:
	if not _can_equip_armament(bearer):
		return false
	var spec: Dictionary = data.get("armament", {}).duplicate(true)
	if spec.is_empty():
		return false
	var arm_id := String(data.get("id", ""))
	var upgraded := bool(data.get("is_upgraded", false))
	var payload: Dictionary = spec.duplicate(true)
	payload["id"] = arm_id
	payload["name"] = String(data.get("name", "Armament"))
	payload["desc"] = String(data.get("desc", "Equipped for this fight."))

	var atk_gain: int = int(spec.get("atk", 0))
	var hp_gain: int = int(spec.get("hp", 0))
	match arm_id:
		"hooked_pike":
			if upgraded: atk_gain += 1
		"tower_shield":
			if upgraded: hp_gain += 2
		"grave_bell", "witchbrand":
			if upgraded:
				atk_gain += 1
				hp_gain += 1
		"forked_spear":
			if upgraded: atk_gain += 2
		"repeating_arbalest":
			if upgraded: hp_gain += 2
	if atk_gain > 0:
		bearer.current_atk += atk_gain
	if hp_gain > 0:
		bearer.card_data["hp"] = int(bearer.card_data.get("hp", bearer.current_hp)) + hp_gain
		bearer.current_hp += hp_gain
	var granted_keywords: Array = []
	for kw in spec.get("keywords", []):
		if not bearer.card_data.get("keywords", []).has(kw):
			bearer.card_data.keywords.append(kw)
			granted_keywords.append(kw)
	# Provenance keeps copy/transform effects from inheriting an Armament's folded
	# max HP or granted keywords after the attachment itself has been stripped.
	payload["applied_atk"] = atk_gain
	payload["applied_hp"] = hp_gain
	payload["granted_keywords"] = granted_keywords
	bearer.card_data["equipped_armament"] = payload
	# Repeating Arbalest supplies a fresh Last Stand even if the bearer had
	# already spent one before being equipped.
	if arm_id == "repeating_arbalest":
		bearer.last_stand_used = false
	bearer.update_stat_display()
	spawn_trigger_callout(bearer.global_position \
		+ Vector2(bearer.size.x * bearer.scale.x * 0.5, -12),
		String(data.get("name", "ARMAMENT")).to_upper(), false, int(bearer.entity_id))
	_log_event("You equip %s with [color=%s]%s[/color]." % [
		_log_card_ref(bearer), _LOG_PLAYER_COL, String(data.get("name", "an Armament"))],
		data, 0)
	return true


func _after_armament(card: Control) -> void:
	# The physical card is tied to its bearer for this fight and cannot cycle
	# back through the discard pile. The bearer payload disappears naturally
	# when that creature leaves play.
	_exhaust_pile.append(_pile_entry(card.card_id, card.deck_uid))
	_armament_targeting_rollback = {}
	if _has_relic("pen_nib"):
		_pen_nib_counter += 1
		var threshold: int = int(RelicDB.get_relic("pen_nib").get("value", 10))
		if threshold > 0 and _pen_nib_counter >= threshold:
			_pen_nib_counter = 0
			_pen_nib_trigger()
	card.queue_free()
	_layout_hand()
	_update_hud()


func _is_relic_damage_spell(data: Dictionary) -> bool:
	var spell: Dictionary = data.get("spell", {})
	var spell_type: String = String(spell.get("type", ""))
	if spell_type in ["damage", "damage_face", "damage_all_enemies", "damage_all"]:
		return true
	return spell_type == "custom" \
		and _canonical_custom_spell_id(String(spell.get("id", ""))) in RELIC_DAMAGE_CUSTOMS


func _resolve_spell(data: Dictionary, target: Control, target_lane: int,
		primary_target: Control = null) -> void:
	var spell = data.get("spell", {})
	var spell_type = spell.get("type", "")
	var value = spell.get("value", 0)
	var is_damage_spell: bool = _is_relic_damage_spell(data)
	var relic_damage_bonus := 0
	var spell_key: String = String(data.get("id", spell.get("id", data.get("name", ""))))
	var repeated: bool = int(_spell_names_cast_this_fight.get(spell_key, 0)) > 0
	_spell_names_cast_this_fight[spell_key] = int(_spell_names_cast_this_fight.get(spell_key, 0)) + 1
	if repeated and _has_relic("worn_spellbook"):
		draw_one()
		if is_damage_spell:
			relic_damage_bonus += int(RelicDB.get_relic("worn_spellbook").get("value", 2))
		_relic_fired("worn_spellbook")
	# Cinder Crown — the Pyromancer's alternate doctrine (reshaped 2026-07-28; it
	# shipped as "your first non-damage spell each round costs 0", which is both
	# Command manipulation and a strictly narrower Ember Crown, a relic she can
	# simply FIND). Now a damage doctrine on this same plumbing: Worn Spellbook
	# above is the exact precedent, and the two never collide — the Spellbook pays
	# on a REPEAT, the Crown on the round's first.
	#
	# The latch spends only on a spell the bonus can actually reach ("no dead
	# rewards"): opening the round with Star Chart must not silently burn it.
	if is_damage_spell and _has_relic("cinder_crown") and not _cinder_crown_used_this_round:
		_cinder_crown_used_this_round = true
		relic_damage_bonus += int(RelicDB.get_relic("cinder_crown").get("value", 1))
		_relic_fired("cinder_crown")
	if is_damage_spell and _has_relic("powder_horn") and _powder_charges > 0:
		relic_damage_bonus += _powder_charges \
			* int(RelicDB.get_relic("powder_horn").get("value", 2))
		_powder_charges = 0
		_relic_fired("powder_horn")
	if spell_type in ["damage", "damage_face", "damage_all_enemies", "damage_all"]:
		value += relic_damage_bonus
	var meg_pos: Dictionary = {}
	if target != null and is_instance_valid(target) and is_damage_spell:
		var candidate_pos: Dictionary = _find_creature_position(target)
		if not candidate_pos.is_empty() and bool(candidate_pos.get("is_enemy", false)):
			meg_pos = candidate_pos.duplicate()

	# Battle log — the cast is the beat to remember (a doubled Echo/Doubled
	# Hour cast logs twice, which is the truth). Solo only: in net the resolver
	# runs host-side for both players, so "You cast" could name the wrong hand.
	if not _is_net():
		var cast_line := "You cast [color=%s]%s[/color]" \
			% [_LOG_PLAYER_COL, String(data.get("name", "a spell"))]
		if target != null and is_instance_valid(target):
			cast_line += " on %s" % _log_card_ref(target)
		_log_event(cast_line + ".", data, 0)

	# Reagent Pouch: first spell each combat is Sharpened (+spell.value bonus).
	if _has_relic("reagent_pouch") and not _reagent_pouch_consumed \
			and spell_type in ["damage", "damage_face", "damage_all_enemies", "damage_all"]:
		_reagent_pouch_consumed = true
		value += int(RelicDB.get_relic("reagent_pouch").get("value", 2))
		_relic_fired("reagent_pouch")
	# Mana Pearl: 0-cost spells deal +3 damage. _doubling_active_spell read
	# prevents the relic counting the Pyromancer Scar re-cast against itself
	# (the doubled cast inherits cost=0 in the call path).
	var spell_cost: int = int(data.get("cost", 0))
	if _has_relic("mana_pearl") and spell_cost == 0 \
			and spell_type in ["damage", "damage_face", "damage_all_enemies", "damage_all"]:
		value += int(RelicDB.get_relic("mana_pearl").get("value", 3))
		_relic_fired("mana_pearl")
	# Glowing Hand shares the same damage-spell definition as Worn Spellbook,
	# Powder Horn and Old Meg, including bespoke custom damage resolvers.
	if _has_relic("glowing_hand") and is_damage_spell:
		var cap: int = int(RelicDB.get_relic("glowing_hand").get("value", 5))
		var glowing_bonus: int = mini(cap, _glowing_hand_spells_cast)
		if spell_type == "custom":
			relic_damage_bonus += glowing_bonus
		else:
			value += glowing_bonus
		# The fight's FIRST damage spell earns nothing — a chip on a +0 would
		# teach the player the relic works when it hasn't started yet.
		if glowing_bonus > 0:
			_relic_fired("glowing_hand")

	# Fire a colored burst at the spell's resolution point so every spell has
	# visible feedback (the underlying effect like take_damage shakes the target
	# but doesn't read as "you cast something"). Passes the full card_data so
	# Tier-2 family dispatch can read the spell's id; falls back to type-based
	# color for any spell missing from SPELL_FAMILIES. Lane + primary ride along
	# for the S6 signatures (lane bars, twin bolts).
	_play_spell_cast_vfx(data, target, target_lane, primary_target)

	# S6 lob delivery (The Petard / Breach Bomb): the shell is IN THE AIR for
	# SPELL_LOB_TRAVEL — hold resolution the same beat so the damage numbers
	# pop WITH the blast, not before the bomb arrives. Gated on the same
	# condition as the visual (windowed, motion on), so headless probes and
	# Reduce Motion never pay the pause. Precedent: apocalypse's own 0.35 hold.
	if SPELL_LOB.has(String(data.get("id", ""))) and _spell_fx_lob_active():
		await _short_pause(SPELL_LOB_TRAVEL)

	# JUICE — board-wide and heavy spells earn an extra jolt on cast + a brief
	# hit-stop AFTER they land, so a screen-clearing Earthquake / Apocalypse hits
	# with the weight it deserves rather than every creature's HP just dropping at
	# once. Single-target chip spells skip this so casting stays snappy. The jolt
	# fires now (with the cast VFX); the hit-stop is applied just below, after the
	# match block resolves the damage. Awaitable: all callers of _resolve_spell
	# already await it, so this never desyncs the turn.
	var _aoe_spell: bool = spell_type in ["damage_all_enemies", "damage_all", "buff_all_atk"]
	var _big_spell: bool = spell_type in ["damage", "damage_face"] and int(value) >= HEAVY_HIT_DAMAGE
	if _aoe_spell or _big_spell:
		screen_shake(10.0 if _aoe_spell else 7.0)

	# Witch-Shot (bridge_watcher id, 2026-07-16 reshape): raise the pierce flag
	# for the whole resolve — every take_damage this spell causes (built-in AND
	# custom resolvers) passes through enemy Armored/Shield. Cleared right after
	# the match block and defensively at turn start. Solo-only (not net-ported).
	var witch_shot_pierce: bool = is_damage_spell \
		and _has_relic("bridge_watcher") and not _is_net()
	if witch_shot_pierce:
		Card2D.spell_pierce_active = true
		_relic_fired("bridge_watcher")

	match spell_type:
		"damage":
			if target != null:
				target.take_damage(value)
		"damage_face":
			damage_enemy_hero(value)
		"damage_all_enemies":
			for c in _all_enemy_creatures():
				c.take_damage(value)
		"damage_all":
			for c in _all_creatures_both_sides():
				c.take_damage(value)
			_cleanup_dead()
		"buff_atk":
			if target != null:
				_sound_war_horn()
				if spell.get("permanent", false):
					target.current_atk += value
				else:
					target.temp_atk_buff += value
				target.update_stat_display()
		"buff_hp":
			if target != null:
				target.current_hp += value
				target.card_data.hp += value
				target.update_stat_display()
		"heal":
			if target != null:
				var before: int = target.current_hp
				target.current_hp = mini(target.current_hp + value, target.card_data.hp)
				target.update_stat_display()
				if target.has_method("show_heal_number"):
					target.show_heal_number(target.current_hp - before)
		"draw":
			for i in value:
				draw_one()
		"buff_all_atk":
			_sound_war_horn()
			for c in _all_player_creatures():
				if spell.get("permanent", false):
					c.current_atk += value
				else:
					c.temp_atk_buff += value
				c.update_stat_display()
		"custom":
			await _resolve_custom_spell(spell.get("id", ""), target, target_lane, data,
				relic_damage_bonus, primary_target)

	# Old Meg shells the other rank in the targeted creature's column. It is a
	# separate two-damage event, so armor and death triggers stay honest.
	if _has_relic("old_meg") and not _old_meg_used_this_round and not meg_pos.is_empty():
		_old_meg_used_this_round = true
		var meg_lane: int = int(meg_pos.get("lane", target_lane))
		var meg_row: int = int(meg_pos.get("row", ROW_FRONT))
		var meg_other = _row_array(true, ROW_BACK if meg_row == ROW_FRONT else ROW_FRONT)[meg_lane]
		if meg_other != null and is_instance_valid(meg_other) and meg_other.current_hp > 0:
			meg_other.take_damage(int(RelicDB.get_relic("old_meg").get("value", 2)))
		else:
			damage_enemy_hero(int(RelicDB.get_relic("old_meg").get("value", 2)))
		_relic_fired("old_meg")

	# JUICE (cont.) — the post-impact hit-stop for AoE / heavy spells. Lands after
	# the damage above so the player sees the board get hit, THEN feels the beat.
	if _aoe_spell or _big_spell:
		await _short_pause(HITSTOP_BEAT)

	# Witch-Shot: the spell has fully resolved — lower the pierce flag before
	# any other damage source (clash, recoil, on-death) can ride it.
	if witch_shot_pierce:
		Card2D.spell_pierce_active = false
	_last_spell_played_this_turn = data
	# Echo replays against the same target. Skip the bookkeeping for Echo
	# itself so an "Echo → Echo" chain doesn't overwrite the real last target.
	if data.get("spell", {}).get("id", "") != "echo_spell":
		_last_spell_target_ref = weakref(target) if target != null else null
		_last_spell_primary_target_ref = weakref(primary_target) \
			if primary_target != null else null
		_last_spell_target_lane = target_lane


## Legacy spell-id fold: the 2026-07-10 boring-cards swap renamed three custom
## spell ids (shield_wall→Testudo, inspire→Turncoat, adrenaline→Countermarch).
## Both resolvers key their arms on the NEW ids; this folds any stale reference
## (an Echo memory from an old save, a legacy net peer) onto them.
func _canonical_custom_spell_id(spell_id: String) -> String:
	match spell_id:
		"shield_wall":
			return "testudo"
		"inspire":
			return "turncoat"
		"adrenaline":
			return "baggage_train"
		"mending_light":
			return "censer_light"
	return spell_id


func _resolve_custom_spell(spell_id: String, target: Control, _target_lane: int,
		data: Dictionary = {}, relic_damage_bonus: int = 0,
		primary_target: Control = null) -> void:
	spell_id = _canonical_custom_spell_id(spell_id)
	var spell_dmg_bonus: int = relic_damage_bonus
	# Per-card "+" upgrade bonuses. The Rest screen's plus upgrade merges
	# these into card_data via RunState._apply_plus_upgrade. Resolvers that
	# care read whichever fields are relevant; the rest no-op cleanly.
	var plus_dmg: int = int(data.get("dmg_bonus", 0))
	var plus_slay_draw: int = int(data.get("slay_draw", 0))
	var plus_slay_gold: int = int(data.get("slay_gold", 0))
	var plus_slay_mana: int = int(data.get("slay_mana", 0))
	var plus_draw: int = int(data.get("extra_draw", 0))
	var plus_mana: int = int(data.get("extra_mana", 0))
	# Retinue starters (2026-07-28). Their "+" deltas use their own UPGRADES keys,
	# so reading plus_dmg for a Spur Forward would silently print a blank forge.
	var plus_atk: int = int(data.get("atk_bonus", 0))        # spur_forward
	var plus_hp: int = int(data.get("hp_bonus", 0))          # close_ranks_order / countermarch_levy
	var plus_reveal: int = int(data.get("extra_reveal", 0))  # star_chart
	var plus_doom: int = int(data.get("doom_tick", 0))       # touchpaper
	var is_plus: bool = bool(data.get("is_upgraded", false))
	match spell_id:
		"blood_tithe":
			damage_enemy_hero(4 + spell_dmg_bonus + plus_dmg)
			damage_player_hero(2)
		"petard":
			# The Petard: a real placed bomb now. It can still hit either side,
			# but the player chooses the body and owns the splash risk.
			if target != null:
				var pd_pos: Dictionary = _find_creature_position(target)
				var pd_main: int = 5 + spell_dmg_bonus + plus_dmg
				var pd_splash: int = 2 + spell_dmg_bonus + plus_dmg
				target.take_damage(pd_main)
				if not pd_pos.is_empty():
					var pd_row = _row_array(bool(pd_pos.is_enemy), int(pd_pos.row))
					for pd_lane in [int(pd_pos.lane) - 1, int(pd_pos.lane) + 1]:
						if pd_lane >= 0 and pd_lane < LANES_PER_ROW:
							var pd_adj = pd_row[pd_lane]
							if pd_adj != null and is_instance_valid(pd_adj) and pd_adj.current_hp > 0:
								pd_adj.take_damage(pd_splash)
		"slow_match":
			# Slow Match: base 2 + the fuse banked while it waited in hand
			# (_start_round caps the charge at +4). The hover prediction reads
			# the same card_data key, so the shown number is the landed number.
			if target != null:
				target.take_damage(2 + int(data.get("fuse", 0)) + spell_dmg_bonus + plus_dmg)
		"sappers_charge":
