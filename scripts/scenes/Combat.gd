# ═════════════════════════════════════════════════════════════════════════
#  EMOTES — Hearthstone-style canned phrases (solo + skirmish)
#
#  A speech-bubble orb by the player's portrait opens a short menu of set lines.
#  Firing one floats a bubble over your own portrait; in skirmish it also ships
#  EV_EMOTE so the opponent sees the SAME line over your (their-foe) plate. In
#  solo / vs-bot the enemy sometimes barks a menacing reply, so the board never
#  feels one-sided. Presentation only — emotes never touch game state. A short
#  cooldown throttles spam (the Hearthstone squelch, minus the mute button).
# ═════════════════════════════════════════════════════════════════════════

## The lines the player can send. The INDEX is the wire payload (EV_EMOTE.idx),
## so both machines read the same string from this list — keep the order stable.
## This is the GENERIC voice — a lord with a HERO_EMOTES table speaks in its own.
const EMOTES: Array = [
	"Steel greets steel.",         # greeting
	"Well fought.",                # salute
	"A kindness, remembered.",     # thanks (the ledger never forgets)
	"Etna felt that one.",         # wow
	"Blame the recruits.",             # oops (a lord never errs — his conscripts do)
	"You will burn.",              # threat (title drop)
]
## Per-lord emote voices — the SAME six slots as EMOTES (greeting / salute /
## thanks / wow / oops / threat), so the wire payload stays the index and each
## machine renders line #idx from the SPEAKER'S table (both know both lobby
## picks). Missing table → generic EMOTES. Keep lines ≤ ~27 chars — the bubble
## label is single-line at its 330px clamp.
const HERO_EMOTES: Dictionary = {
	"raider": [
		"Race you to the keep.",
		"Well ridden.",
		"Salt and speed to you.",
		"That horse has wings.",
		"Wrong road. It happens.",
		"You can't outrun me.",
	],
	"stalwart": [
		"Come break on the wall.",
		"A worthy siege.",
		"The wall remembers.",
		"Even stone blinks.",
		"A crack. We mortar it.",
		"I will still be here.",
	],
	"acolyte": [
		"Your account is open.",
		"Paid in full.",
		"Noted in the ledger.",
		"What a deposit.",
		"A clerical error.",
		"Everything is owed.",
	],
	"pyromancer": [
		"I have seen this game.",
		"Well played. As foreseen.",
		"The circle thanks you.",
		"Even I didn't see that.",
		"Recalculating.",
		"You end in fire.",
	],
	"kindler": [
		"Smell that? Fuses.",
		"You burned bright.",
		"Kindness is kindling.",
		"BOOM. Beautiful.",
		"That one went early.",
		"Everything burns.",
	],
}
## The enemy's answering barks — solo / vs-bot only, chosen at random. A darker
## register than the player's courtly lines (this is a war, and it wants you dead).
const ENEMY_EMOTES: Array = [
	"Kneel.",
	"The meadow is patient.",
	"This ground is mine.",
	"Burn with the rest.",
	"Another lord, another pyre.",
	"Your bones feed the meadow.",
]

