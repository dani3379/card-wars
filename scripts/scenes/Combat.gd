					if is_instance_valid(target):
						target.take_damage(plus_dmg)
					_cleanup_dead()
		"flanking_order":
			if primary_target != null and is_instance_valid(primary_target) \
					and _target_lane >= 0 and _target_lane < LANES_PER_ROW:
				var old_lane: int = primary_target.current_lane
				var move_row: int = primary_target.current_row
				if abs(old_lane - _target_lane) == 1 \
						and _row_array(false, move_row)[_target_lane] == null \
						and _relocate_creature(primary_target, false, move_row,
							_target_lane, false):
					# The flank shuffles ALONG a row, so the row it left is the row
					# it is standing in — move_row is old_row. (The declaration for
					# this argument had been left stranded in the `gallows_writ`
					# arm above, where `primary_target` is null for a lane-targeted
					# spell; Combat.gd did not compile at all until it was removed.)
					await _dispatch_creature_relocated(primary_target, move_row, old_lane)
					if is_instance_valid(primary_target) \
							and _get_creature_in_column(true, _target_lane) == null:
						await _ordered_face_strike(primary_target, plus_dmg)

		# ─────────────────────────────────────────────────────────────────────
		#  HERO RETINUE STARTERS (2026-07-28). Campaign-only: every one is
		#  draftable:false, and SkirmishState.skirmish_legal_pool() builds from
		#  CardDB.get_pool_by_rarity(), which filters on that flag — so none of
		#  them can reach a skirmish deck and no CombatNet mirror is required.
		#  Every local below carries its own arm tag. A `var` declared in one
		#  match arm and read from another is a SCOPE error Godot only reports at
		#  load time (--check-only passes it); that took Combat.gd down once
		#  already — see the flanking_order note just above.
		# ─────────────────────────────────────────────────────────────────────
		"starter_spur_forward":
			# The Grasswake's verb: pick a body up, set it down where it matters,
			# and let the new angle count as a charge. The move is the point, so
			# it is offered across BOTH rows — _pick_empty_slot_any is the same
			# headless-safe picker Trail Scout's redeploy uses (_pick_friendly_creature
			# has no headless branch and would hang every probe). A full board
			# degrades to the rider alone rather than eating the card silently.
			if target != null and is_instance_valid(target) and target.current_hp > 0:
				var sf_src_row: int = int(target.current_row)
				var sf_src_lane: int = int(target.current_lane)
				var sf_dest: Dictionary = await _pick_empty_slot_any(false,
					"Spur Forward - choose where it rides")
				if not sf_dest.is_empty() and is_instance_valid(target):
					# trigger_lane_change=false + an explicit await, exactly as
					# flanking_order does it: _relocate_creature calls the
					# dispatcher WITHOUT awaiting it, and the payoff hooks
					# (Marching Spurs, Wheeling Lancer) must settle before the
					# rider lands on top of them.
					if _relocate_creature(target, false, int(sf_dest.row),
							int(sf_dest.lane), false):
						await _dispatch_creature_relocated(target, sf_src_row, sf_src_lane)
				if is_instance_valid(target) and target.current_hp > 0:
					_grant_starter_temp_swift(target, 2 + plus_atk, "SPUR FORWARD")
				_refresh_adjacency_buffs()
		"starter_cut_them_off":
			# The bolt that punishes a body already out of position. It reads the
			# HERO's own mobility (_player_moved_a_friendly_this_round), because
			# enemy movement is far too rare to carry a card in the Raider's
			# opening ten — Trail Scout, Spur Forward and Marching Spurs all arm
			# it. The latch is cleared in _start_round.
			if target != null and is_instance_valid(target):
				var co_moved: bool = _player_moved_a_friendly_this_round
				var co_dmg: int = (4 if co_moved else 2) + spell_dmg_bonus + plus_dmg
				if co_moved:
					# "marked" has no _CALLOUT_STYLE entry, so the honest cheap
					# telegraph is a worded float — the player has to be able to
					# see WHY the number doubled.
					spawn_floating_number(_card_center(target) + Vector2(0, -14),
						"CAUGHT IN THE OPEN", Color(1.0, 0.72, 0.36), false)
				target.take_damage(co_dmg)
				_cleanup_dead()
		"starter_close_ranks":
			# Dress the Line (card id close_ranks_order — NOT the uncommon
			# `close_ranks`, whose arm above shoves the enemy line toward the
			# seam). The line thickens where it is touched: canonical adjacency
			# (row +-1 plus the column-mate, Diagonal Crest included), and the
			# named body counts itself.
			if target != null and is_instance_valid(target) and target.current_hp > 0:
				var cn_gain: int = 1 + plus_hp
				var cn_pos: Dictionary = _find_creature_position(target)
				var cn_bodies: Array = [target]
				if not cn_pos.is_empty():
					for cn_a in _adjacent_creatures(false, int(cn_pos.row), int(cn_pos.lane)):
						if cn_a != null and is_instance_valid(cn_a) and cn_a.current_hp > 0 \
								and cn_a not in cn_bodies:
							cn_bodies.append(cn_a)
				for cn_c in cn_bodies:
					# BOTH lines are load-bearing: card_data.hp is the MAX every
					# heal caps against, so a current_hp-only bump is silently
					# erased by the next Patch Up. update_stat_display is the
					# "+N HP" float funnel — never add a second float here.
					cn_c.card_data["hp"] = int(cn_c.card_data.get("hp", cn_c.current_hp)) + cn_gain
					cn_c.current_hp += cn_gain
					cn_c.update_stat_display()
					_vfx_blessing(_card_center(cn_c))
				_log_event("%s dresses the line — [color=#d8b060]+%d HP[/color] to %d." \
					% [_log_card_ref(target), cn_gain, cn_bodies.size()],
					_log_data(target), _log_side(target))
		"starter_read_the_will":
			# The Owed's verb: call a bequest due while the body still stands.
			# _run_on_death, NOT dispatch_on_death — the dispatcher's identity
			# arms (Griffin's return-to-hand, The Undying's PERMANENT run-wide
			# +1/+1 mod) are one-shot death events and would be farmable on a
			# living body. The doubling ladder (Warden of Graves, Lich's Bargain,
			# Grave Bell) is skipped on purpose: this is ONE reading of the will,
			# not a second death. _target_contract_available gates the cast, so an
			# unreadable board never offers it in the first place.
			if target != null and is_instance_valid(target) and target.current_hp > 0 \
					and target.card_data.has("on_death"):
				var rw_eff: Dictionary = target.card_data["on_death"]
				if READ_THE_WILL_DENY.has(String(rw_eff.get("type", ""))):
					spawn_floating_number(_card_center(target) + Vector2(0, -14),
						"NOTHING TO READ", Color(0.80, 0.76, 0.66), false)
				else:
					var rw_pos: Dictionary = _find_creature_position(target)
					var rw_lane: int = int(rw_pos.get("lane", target.current_lane))
					var rw_row: int = int(rw_pos.get("row", target.current_row))
					_play_trigger_fx(rw_eff, target, rw_lane, false, "death",
						_card_center(target), rw_row)
					_log_event("%s's will is read early." % _log_card_ref(target),
						_log_data(target), _log_side(target))
					KeywordEffects._run_on_death(rw_eff, rw_lane, false, self, rw_row)
					_cleanup_dead()
					_refresh_adjacency_buffs()
		"starter_last_due":
			# The Owed's collection: a soldier pays with his body and the debt is
			# taken out of whatever stands across from him. Read the lane BEFORE
			# the kill — the node's current_lane is unreliable once it is dying.
			# No random-enemy middle branch (Fuel the Pyre has one): this card
			# says "or to enemy face if empty", so an empty column goes face.
			if target != null and is_instance_valid(target):
				var ld_lane: int = int(target.current_lane)
				var ld_dmg: int = 2 + spell_dmg_bonus + plus_dmg
				_trigger_player_sacrifice(target)
				_force_destroy_creature(target)
				var ld_opp: Control = get_opposing_card(ld_lane, false)
				if ld_opp != null and is_instance_valid(ld_opp) and ld_opp.current_hp > 0:
					ld_opp.take_damage(ld_dmg)
				else:
					damage_enemy_hero(ld_dmg)
				_cleanup_dead()
				_refresh_adjacency_buffs()
		"starter_star_chart":
			# Lanternhall's verb: read the road ahead. Same data _enemy_place_creatures
			# pops from (the front of _enemy_deck, then the endless _reinforcement),
			# so the face shown IS the body that lands. A held beat, then gone —
			# no persistent reserve-face UI, no carry-over to the next round.
			var sk_n: int = 1 + plus_reveal
			var sk_seen: int = 0
			for sk_i in range(sk_n):
				var sk_data: Dictionary = {}
				if sk_i < _enemy_deck.size():
					sk_data = _enemy_deck[sk_i]
				elif not _reinforcement.is_empty():
					sk_data = _reinforcement
				if sk_data.is_empty():
					break
				sk_seen += 1
				_log_event("The star chart reads the road: [color=#f2e6c8]%s[/color] comes next." \
					% String(sk_data.get("name", "?")), sk_data, 1)
				# _reveal_cast_card does NOT self-gate headless (its callers do)
				# and it builds a real Card2D, so a probe would pay for it.
				if DisplayServer.get_name() != "headless":
					await _reveal_cast_card(sk_data,
						"NEXT ARRIVAL" if sk_i == 0 else "AND THEN",
						Color(0.75, 0.85, 1.0))
					await _short_pause(0.45)
			if sk_seen == 0:
				_log_event("The star chart reads an empty road. No one else is coming.", {}, 0)
		"starter_countermarch":
			# Change Step (card id countermarch_levy). The same body, re-read from
			# the other rank. A blocked seat SWAPS with the column-mate instead of
			# no-opping, so the cast is never dead — the one place this parts
			# company with Countermarch's _apply_reserve_orders, whose shield is
			# that other card's identity.
			# A row-only change is not a lane change, so this correctly does not
			# feed Marching Spurs or Wheeling Lancer — but it DOES arm Cut Them
			# Off, which asks only whether a friendly moved.
			if target != null and is_instance_valid(target) and target.current_hp > 0:
				var cm_gain: int = 1 + plus_hp
				var cm_src_row: int = int(target.current_row)
				var cm_lane: int = int(target.current_lane)
				var cm_dest_row: int = ROW_BACK if cm_src_row == ROW_FRONT else ROW_FRONT
				var cm_mate: Control = _row_array(false, cm_dest_row)[cm_lane]
				if cm_mate != null and is_instance_valid(cm_mate):
					_swap_creature_positions(target, cm_mate)
				elif _relocate_creature(target, false, cm_dest_row, cm_lane, false):
					await _dispatch_creature_relocated(target, cm_src_row, cm_lane)
				if is_instance_valid(target) and target.current_hp > 0:
					target.card_data["hp"] = int(target.card_data.get("hp",
						target.current_hp)) + cm_gain
					target.current_hp += cm_gain
					target.update_stat_display()
					_vfx_blessing(_card_center(target))
				_refresh_adjacency_buffs()
		"starter_touchpaper":
			# The Everflame's verb: pull a fuse forward. _tick_doom_counter owns
			# the badge, the tick flash and the at-zero detonation queue (a
			# re-entrancy-latched queue, so a chain of blasts is safe), which
			# leaves this arm as one call plus its telegraph.
			# _target_contract_available gates the cast on a friendly Doom body
			# existing, so the miss branch is only reachable if the fuse died
			# between the drag and the drop.
			if target != null and is_instance_valid(target):
				var tp_tick: int = 1 + plus_doom
				if _tick_doom_counter(target, -tp_tick, true):
					_log_event("Touchpaper burns %s's fuse down by [color=#f2e6c8]%d[/color]." \
						% [_log_card_ref(target), tp_tick],
						_log_data(target), _log_side(target))
				else:
					spawn_floating_number(_card_center(target) + Vector2(0, -14),
						"NO FUSE TO LIGHT", Color(0.80, 0.76, 0.66), false)
				_cleanup_dead()

		"hex":
			if target != null:
				var had_keywords: bool = _strip_hex_keywords(target)
				target.take_damage((4 if had_keywords else 1) + spell_dmg_bonus + plus_dmg)
		_:
			pass

	_update_hud()


func _strip_hex_keywords(target: Control) -> bool:
	if target == null or not is_instance_valid(target):
		return false
	if _is_fortification(target):
		return false
	var had_keywords: bool = not target.card_data.get("keywords", []).is_empty() or target.state.has_shield
	var stripped: Array = target.card_data.get("keywords", []).duplicate()
	target.card_data["keywords"] = []
	if stripped.has("on_death"):
		target.card_data.erase("on_death")
	if stripped.has("adj_buff"):
		target.card_data.erase("adj_buff")
	if stripped.has("wither"):
		target.card_data.erase("wither")
	if stripped.has("doom"):
		target.card_data.erase("doom")
		target.card_data.erase("doom_damage")
	if stripped.has("sniper"):
		target.card_data.erase("sniper")
	for key in ["rampage", "lifelink", "overrun", "formation"]:
		if stripped.has(key):
			target.card_data.erase(key)
	target.state.temp_armored = false
	target.state.temp_thorns = false
	target.state.temp_piercing = false
	target.state.bonus_thorns = 0
	target.state.has_shield = false
	if target.has_method("update_doom_display"):
		target.update_doom_display()
	target.update_stat_display()
	_refresh_adjacency_buffs()
	return had_keywords


func _after_spell(card: Control) -> void:
	_armament_targeting_rollback = {}
	# The board payoffs below run AFTER card.queue_free(), and three of the
	# retinue passives (Mirror Guard / Glass Savant, plus the Mirror Primer
	# relic) need to know WHAT was cast. Hold the dictionary itself — card_data
	# is refcounted, so this reference survives the node it came off.
	var sp_cast_data: Dictionary = card.card_data
	# PlayLog: emit the player's spell play (stashed at _play_spell) with the
	# resolved target, using the pre-cast snapshot for a clean state→action pair.
	if not _pl_spell_pending.is_empty():
		var tgt_brief = null
		if _last_spell_target_ref != null:
			var mt = _last_spell_target_ref.get_ref()
			if mt != null and is_instance_valid(mt):
				var side := "enemy" if (_enemy_field.has(mt) or _enemy_back.has(mt)) else "player"
				tgt_brief = {"id": mt.card_id, "lane": mt.current_lane,
					"row": mt.current_row, "side": side}
		_pl_log("play_spell", {
			"card": _pl_spell_pending.get("card", ""),
			"uid": _pl_spell_pending.get("uid", -1),
			"cost": _pl_spell_pending.get("cost", 0),
			"targeting": _pl_spell_pending.get("targeting", "none"),
			"target": tgt_brief,
		}, _pl_spell_pending.get("snap"))
		_pl_spell_pending = {}

	# Pyromancer's Scar (class-restricted): the first spell each combat fires
	# a second time against the same target before bookkeeping. We snapshot
	# the spell data (in case the doubled cast mutates it) and the cached
	# last-target ref; non-targeted spells re-resolve with target=null, while
	# targeted spells reuse the original target if it is still valid.
	# _doubling_active_spell stays true through the re-entry so the second
	# pass can't re-trigger the relic recursively.
	if _has_relic("pyromancers_scar") and not _pyromancers_scar_consumed \
			and not _doubling_active_spell:
		_pyromancers_scar_consumed = true
		_doubling_active_spell = true
		_relic_fired("pyromancers_scar")
		var tgt: Control = null
		if _last_spell_target_ref != null:
			var maybe_tgt = _last_spell_target_ref.get_ref()
			if maybe_tgt is Control and is_instance_valid(maybe_tgt):
				tgt = maybe_tgt
		var primary_tgt: Control = null
		if _last_spell_primary_target_ref != null:
			var maybe_primary = _last_spell_primary_target_ref.get_ref()
			if maybe_primary is Control and is_instance_valid(maybe_primary):
				primary_tgt = maybe_primary
		var tlane: int = _last_spell_target_lane
		await _resolve_spell(card.card_data.duplicate(true), tgt, tlane, primary_tgt)
		_doubling_active_spell = false
	var was_exhausted: bool = card.has_keyword("exhaust")
	if was_exhausted:
		_exhaust_pile.append(_pile_entry(card.card_id, card.deck_uid))
		var ex_anchor := card.global_position \
			+ Vector2(card.size.x * card.scale.x * 0.5, card.size.y * card.scale.y * 0.10)
		spawn_keyword_callout(ex_anchor, "EXHAUST",
			_CALLOUT_STYLE["exhaust"]["col"], GameTheme.get_keyword_icon("exhaust"))
		if AudioBank != null:
			AudioBank.play_sfx("card_discard", 0.06, -6.0, 0.74)
	else:
		_player_discard_pile.append(_pile_entry(card.card_id, card.deck_uid))
	# Acolyte's Tome (class-restricted): exhausting a spell refunds a card.
	# Hooks here so any path that exhausts (intrinsic exhaust keyword, Imbue
	# "Double + Exhaust" upgrade) counts uniformly.
	if was_exhausted and _has_relic("acolytes_tome"):
		draw_one()
		_relic_fired("acolytes_tome")
	# The Burnt Dispatches (lantern id, 2026-07-16 reshape): the first spell
	# exhausted each turn sends a dispatch back — a random spell returns from
	# the discard pile and costs 0 this turn. Mechanism mirrors grave_robbery:
	# pull the "id#uid" entry, push it on top of the draw pile, draw it, then
	# tag the drawn card mummified_zero (the established costs-0-this-turn
	# channel; _effective_cost reads it, end-of-turn clears it).
	if was_exhausted and _has_relic("lantern") and not _dispatches_used_this_turn \
			and not _is_net() and _hand.size() < MAX_HAND_SIZE:
		var dispatch_spells: Array = []
		for entry in _player_discard_pile:
			var did := String(entry).split("#")[0]
			if String(CardDB.get_card_data(did).get("type", "")) == "spell":
				dispatch_spells.append(String(entry))
		if not dispatch_spells.is_empty():
			_dispatches_used_this_turn = true
			var dispatch_entry: String = _combat_ops.pick(dispatch_spells)
			_player_discard_pile.erase(dispatch_entry)
			_player_draw_pile.push_front(dispatch_entry)
			var hand_before: int = _hand.size()
			draw_one()
			if _hand.size() > hand_before and is_instance_valid(_hand.back()):
				var freed: Control = _hand.back()
				freed.state.mummified_zero = true
				spawn_floating_number(_card_center(freed), "FREE THIS TURN",
					Color(1.0, 0.85, 0.45), false)
			_relic_fired("lantern")
	card.queue_free()
	# Pen Nib counts cards played (creatures already increment in _play_creature).
	if _has_relic("pen_nib"):
		_pen_nib_counter += 1
		var threshold: int = int(RelicDB.get_relic("pen_nib").get("value", 10))
		if threshold > 0 and _pen_nib_counter >= threshold:
			_pen_nib_counter = 0
			_pen_nib_trigger()
	_record_spell_cast_board_payoffs(sp_cast_data)
	# Inkpot of Many: every Nth spell, copy a random spell into hand.
	if _has_relic("inkpot_of_many"):
		_inkpot_counter += 1
		var ink_threshold: int = int(RelicDB.get_relic("inkpot_of_many").get("value", 5))
		if ink_threshold > 0 and _inkpot_counter >= ink_threshold:
			_inkpot_counter = 0
			_relic_fired("inkpot_of_many")
			_inkpot_copy_random_spell()
	# Runebound Idol: spell-matters payoff. Each spell cast permanently buffs a
	# random friendly creature +value/+value, turning a spell-heavy deck into a
	# board-growth engine. No-op cleanly when the board is empty.
	if _has_relic("runebound_idol"):
		var ri_targets: Array = _all_player_creatures()
		if ri_targets.size() > 0:
			var ri: int = int(RelicDB.get_relic("runebound_idol").get("value", 1))
			var pick: Control = _combat_ops.pick(ri_targets)
			pick.current_atk += ri
			pick.card_data["hp"] = int(pick.card_data.get("hp", 0)) + ri
			pick.current_hp += ri
			pick.update_stat_display()
			var ri_pos := pick.global_position + Vector2(pick.size.x * pick.scale.x * 0.5, -10)
			spawn_floating_number(ri_pos, "+%d/+%d" % [ri, ri], Color(0.70, 0.55, 1.0), false)
			_relic_fired("runebound_idol")
	# Mummified Hand: pick a random creature in hand and zero its cost. Marks
	# the chosen card with a meta so _effective_cost picks it up; cleared at
	# end of turn alongside the discard.
	if _has_relic("mummified_hand"):
		var creature_cards: Array[Control] = []
		for c in _hand:
			if c != null and is_instance_valid(c) and c.is_creature():
				creature_cards.append(c)
		if creature_cards.size() > 0:
			_combat_ops.pick(creature_cards).state.mummified_zero = true
			_relic_fired("mummified_hand")
	# Glowing Hand counter for damage-spell bonus stacking.
	_glowing_hand_spells_cast += 1
	# Encounter passive: demon_spell_buff
	if _encounter_passive == "demon_spell_buff":
		_buff_random_enemy_atk(1)
	# Reactive passive: ON_PLAYER_SPELL
	_dispatch_reactive("ON_PLAYER_SPELL", null, -1)
	_cleanup_dead()
	_update_hud()


## Chaos Imp creates a spell without playing a hand card, so it does not enter a
## pile or trigger card-play relics. It still counts for the battlefield's spell
## engines (Leyline, Hexblade, Emberwright and combo history), matching skirmish.
func _after_generated_spell(spell_data: Dictionary = {}) -> void:
	_record_spell_cast_board_payoffs(spell_data)
	_cleanup_dead()
	_update_hud()


## Shared solo battlefield payoffs for both hand-played and generated spells.
## Called after resolution so combo spells read only PRIOR casts this turn.
func _record_spell_cast_board_payoffs(spell_data: Dictionary = {}) -> void:
	# THE THREE ROUND QUESTIONS the Lanternhall retinue asks about a cast, all
	# answered ONCE here and then read as plain locals. Two traps live in this
	# block and both are silent if you get them wrong:
	#   1. _spells_cast_this_turn is INCREMENTED below, so "is this the round's
	#      first spell" must be sampled above the ++ (this is also why the
	#      column-shield call sits where it does). _first_spell_this_turn is a
	#      DIFFERENT, cost-time flag — never reuse it here.
	#   2. _starter_second_distinct_seen_this_round is a SHARED latch: Glass
	#      Savant AND the Mirror Primer relic both fire off it. Whichever
	#      re-tested the flag would find it already true and never fire, so both
	#      consume the computed local `sp_second_distinct` instead.
	var sp_first_this_round: bool = _spells_cast_this_turn == 0
	# "Non-damage" has exactly one definition in this file (Worn Spellbook,
	# Powder Horn, Glowing Hand and Old Meg all share it, bespoke custom damage
	# resolvers included). Never author a second one.
	var sp_first_non_damage: bool = false
	if not spell_data.is_empty() and not _is_relic_damage_spell(spell_data) \
			and not _starter_non_damage_spell_seen_this_round:
		_starter_non_damage_spell_seen_this_round = true
		sp_first_non_damage = true
	# "Differently named" keyed exactly as _resolve_spell keys the per-FIGHT
	# repeat set, so the two readings can never drift apart.
	var sp_second_distinct: bool = false
	if not spell_data.is_empty():
		var sp_key: String = String(spell_data.get("id",
			spell_data.get("spell", {}).get("id", spell_data.get("name", ""))))
		if sp_key != "" and not _starter_spell_ids_this_round.has(sp_key):
			_starter_spell_ids_this_round[sp_key] = true
			if _starter_spell_ids_this_round.size() >= 2 \
					and not _starter_second_distinct_seen_this_round:
				_starter_second_distinct_seen_this_round = true
				sp_second_distinct = true
	if _spells_cast_this_turn == 0:
		_trigger_first_spell_column_shields(false)
	# The Ledger reads the count BEFORE this cast, same sampling rule as
	# sp_first_this_round above and for the same reason — the ++ is on the next line.
	_maybe_pay_ledger(false, _spells_cast_this_turn)
	_spells_cast_this_turn += 1
	_spells_cast_this_fight += 1
	# Mirror Primer (Pyromancer doctrine relic) — shares the distinct-name latch
	# with Glass Savant, so it reads the local, not the flag. Fires once, before
	# the board loop, so the draw lands whether or not a Savant is standing.
	if sp_second_distinct and _has_relic("mirror_primer"):
		for _mp_i in maxi(1, int(RelicDB.get_relic("mirror_primer").get("value", 1))):
			draw_one()
		_relic_fired("mirror_primer")
	for spell_friend in _all_player_creatures():
		# Witchbrand listens only to completed spell casts. Armaments never enter
		# this hook, and Echo's internal repeat resolves inside one completed cast,
		# so the bearer grows once per card as the short text promises.
		var equipped: Dictionary = spell_friend.card_data.get("equipped_armament", {})
		if String(equipped.get("effect", "")) == "spell_growth":
			var brand_gain: int = maxi(1, int(equipped.get("value", 1)))
			spell_friend.current_atk += brand_gain
			spell_friend.card_data["hp"] = int(spell_friend.card_data.get(
				"hp", spell_friend.current_hp)) + brand_gain
			spell_friend.current_hp += brand_gain
			spell_friend.update_stat_display()
			spawn_floating_number(spell_friend.global_position \
				+ Vector2(spell_friend.size.x * spell_friend.scale.x * 0.5, -10),
				"+%d/+%d" % [brand_gain, brand_gain], Color(0.76, 0.48, 0.92), false)
		match String(spell_friend.card_data.get("passive", "")):
			"atk_per_spell":
				spell_friend.temp_atk_buff += 1
				spell_friend.update_stat_display()
			"starter_lens_apprentice":
				# Lens Apprentice — the round's FIRST working focuses through her
				# glass. temp_atk_buff, not persistent_atk_buff: the card says
				# "this round", and Coven Mother two arms down (the nearest
				# template) writes the FIGHT-long field instead.
				if sp_first_this_round:
					spell_friend.temp_atk_buff += 1
					spell_friend.update_stat_display()
					spawn_trigger_callout(_card_center(spell_friend) + Vector2(0, -14),
						"FOCUS", false, int(spell_friend.entity_id))
			"starter_mirror_guard":
				# Mirror Guard — the working that does no HARM is the one that
				# glazes her. _grant_combat_shield owns the chip, the callout, the
				# status log and the net text; a second callout here double-logs.
				if sp_first_non_damage:
					_grant_combat_shield(spell_friend)
			"starter_glass_savant":
				# Glass Savant — two differently named workings in a round and the
				# lens throws. Positional like Cinder Acolyte: an empty opposing
				# column throws nothing. The forge's scalar is spell_ping_bonus
				# (CardDB.UPGRADES), asserted by tools/_probe_progression.gd.
				if sp_second_distinct:
					var gs_t = get_opposing_card(spell_friend.current_lane, false)
					if gs_t != null and is_instance_valid(gs_t) and gs_t.current_hp > 0:
						spawn_trigger_callout(_card_center(spell_friend) + Vector2(0, -14),
							"THE LENS", false, int(spell_friend.entity_id))
						gs_t.take_damage(1 + int(spell_friend.card_data.get(
							"spell_ping_bonus", 0)))
			"ember_per_spell":
				damage_enemy_hero(3 if bool(spell_friend.card_data.get("is_upgraded", false)) else 2)
			"coven_spell":
				# Coven Mother — every incantation permanently grows the coven. Buffs
				# ALL your Warlocks +1 ATK for the fight (the forged writ also heals 1).
				var cv_fx: Array = []
				for wl in _all_player_creatures():
					if not is_instance_valid(wl) or String(wl.card_data.get("ctype", "")) != "warlock":
						continue
					wl.persistent_atk_buff += 1
					wl.persistent_atk_buff_rounds = 99
					wl.update_stat_display()
					if wl != spell_friend:
						cv_fx.append(_card_center(wl))
				# The working passes THROUGH the coven: the Mother pulses violet,
				# then the incantation hops sister to sister (warlock signature).
				if _hud_layer != null and DisplayServer.get_name() != "headless":
					var cv_col: Color = CTYPE_COLORS["warlock"]
					_spawn_vfx_ring(_card_center(spell_friend),
						Color(cv_col.r, cv_col.g, cv_col.b, 0.70),
						20.0, 1.55, 0.30, 218, 2.5)
					cv_fx.sort_custom(func(a: Vector2, b: Vector2): return a.x < b.x)
					_trigger_fx_grace_wave(cv_fx, cv_col)
				if bool(spell_friend.card_data.get("is_upgraded", false)):
					_heal_owner_hero(false, 1)
			"spark_on_spell":
				# Cinder Acolyte — each incantation sparks off her brazier at
				# whoever stands across (2 forged). Positional: her lane is the
				# choice; an empty lane sparks nothing.
				var sp_t = get_opposing_card(spell_friend.current_lane, false)
				if sp_t != null and is_instance_valid(sp_t) and sp_t.current_hp > 0:
					sp_t.take_damage(2 if bool(spell_friend.card_data.get("is_upgraded", false)) else 1)
			"shield_on_spell":
				# Ember Warden — the working wraps her in cinders: Shield on every
				# cast (forged: her column-mate shields too). Shield is binary, so
				# repeat casts while shielded are no-ops by _grant_combat_shield.
				_grant_combat_shield(spell_friend)
				if bool(spell_friend.card_data.get("is_upgraded", false)):
					var ew_row: int = ROW_BACK if spell_friend.current_row == ROW_FRONT else ROW_FRONT
					var ew_mate = _row_array(false, ew_row)[spell_friend.current_lane]
					if ew_mate != null and is_instance_valid(ew_mate):
						_grant_combat_shield(ew_mate)


## The Magister's Ledger (arm_ledger) — the WARLOCK signature MOMENT. Once the
## Ledger is open, the round's SECOND working is paid on the board: every one of
## that side's Warlocks looses a glyph at whatever stands across from it.
##
## WHAT THIS REPLACES AND WHY. The old keystone (`coven_spell`) handed every
## Warlock +1 ATK per spell for the fight — a ledger that accrues on bodies that
## are about to die, in a game whose own pacing doc says creatures die in one or
## two rounds. It paid glacially, and a wipe erased the whole investment. The
## Ledger pays THIS ROUND, ON THE BOARD, and the arming survives the Magister's
## own death, so spell volume converts to pressure instead of to bookkeeping.
##
## KNOWN DIVERGENCE FROM THE SPEC, stated rather than hidden: the design doc's
## Overload doubles the NEXT spell (a re-cast). That needs the Echo denylist, the
## `_auto_target_for` fallback and a recursion guard threaded through two resolvers
## and their net mirrors — a materially riskier change than the moment is worth on
## its own. The volume trigger, the in-turn payment, the board climax and the
## death-proof arming are all preserved; only the re-cast is deferred.
##
## `spells_before` is the count of casts BEFORE this one, which is what both call
## sites already have to hand (each increments after resolution).
func _maybe_pay_ledger(owner_is_enemy: bool, spells_before: int) -> void:
	var side: int = int(owner_is_enemy)
	if _ledger_open[side] <= 0 or _ledger_paid_this_round[side]:
		return
	# Forged, the Ledger opens on the FIRST working of the round instead of the
	# second — the commit turn-on, priced as a forge rather than as deck density
	# (density is solo-only, and this moment has to fire in skirmish too).
	var need: int = 0 if _ledger_open[side] >= 2 else 1
	if spells_before < need:
		return
	var struck: Array = []
	for wl in _all_friendly(owner_is_enemy):
		if not is_instance_valid(wl) \
				or String(wl.card_data.get("ctype", "")) != "warlock":
			continue
		var t = get_opposing_card(wl.current_lane, owner_is_enemy)
		if t == null or not is_instance_valid(t) or t.current_hp <= 0:
			continue
		var hp_before: int = int(t.current_hp)
		t.take_damage(2)
		_net_log_hit(wl, t, hp_before, false)
		struck.append(_card_center(wl))
	if struck.is_empty():
		return
	# Paid only when it actually landed. An empty board opposite is not a spent
	# Ledger — the coven simply had nothing to aim at, and the player should get
	# the payoff on their next working instead of losing it silently.
	_ledger_paid_this_round[side] = true
	if _hud_layer != null and DisplayServer.get_name() != "headless":
		struck.sort_custom(func(a: Vector2, b: Vector2): return a.x < b.x)
		_trigger_fx_grace_wave(struck, CTYPE_COLORS["warlock"])
	spawn_trigger_callout(struck[0] + Vector2(0, -20), "THE LEDGER", false)


## Canonical mid-fight Shield grant for the new formation/spell bridges. Shield
## is binary, so an already-shielded body does not generate a fake second proc.
func _grant_combat_shield(card: Control) -> void:
	if card == null or not is_instance_valid(card) or card.current_hp <= 0:
		return
	if card.state.has_shield:
		return
	card.state.has_shield = true
	if card.has_method("_spawn_keyword_chip"):
		card._spawn_keyword_chip("SHIELD", Color(0.65, 0.85, 1.0), "shield")
	card.update_stat_display()
	spawn_keyword_callout_kw(card, "shield")
	_net_fx_text(card, "SHIELD", Color(0.65, 0.85, 1.0))


## Leyline Conduit: each conduit and the friendly sharing its column gain Shield
## after their owner's first spell of the turn. Side-aware for skirmish; solo only
## calls the player side.
func _trigger_first_spell_column_shields(owner_is_enemy: bool) -> void:
	for conduit in _all_friendly(owner_is_enemy):
		if not is_instance_valid(conduit) \
				or conduit.card_data.get("passive", "") != "first_spell_column_shield":
			continue
		_grant_combat_shield(conduit)
		var mate_row: int = ROW_BACK if int(conduit.current_row) == ROW_FRONT else ROW_FRONT
		var mate = _row_array(owner_is_enemy, mate_row)[int(conduit.current_lane)]
		if mate != null:
			_grant_combat_shield(mate)


## Countermarch (legacy id adrenaline/baggage_train): change rows when the
## matching slot is open, then protect the ordered body. The forged writ also
## shields its canonical neighbours, turning row choice into a Formation setup.
func _apply_reserve_orders(target: Control, is_plus: bool) -> void:
	if target == null or not is_instance_valid(target):
		return
	var side_is_enemy: bool = bool(target.is_opponent)
	var dest_row: int = ROW_BACK if int(target.current_row) == ROW_FRONT else ROW_FRONT
	_relocate_creature(target, side_is_enemy, dest_row, int(target.current_lane))
	_grant_combat_shield(target)
	if is_plus:
		for ally in _adjacent_creatures(side_is_enemy, int(target.current_row), int(target.current_lane)):
			_grant_combat_shield(ally)
	_refresh_adjacency_buffs()


## Rain of Blows (legacy id smite_spell): mark one body for the shared second-
## strike pass. The pass itself handles all real combat riders and repeat caps.
func _arm_battle_order(target: Control) -> void:
	if target == null or not is_instance_valid(target):
		return
	target.state.battle_order_second_strike = true
	# Routed onto the rider funnel (2026-07-28) so the flash carries the same
	# colour and device as the standing orb it leaves on the token. It used to
	# borrow the battlecry family's cyan, which said "something entered" — the
	# wrong sentence for a rule landing on a body already on the field.
	spawn_keyword_callout_kw(target, "double_strike")


## Frenzy (legacy id turbo): turn any friendly into a Fuse, or cash an existing
## Fuse immediately. The ATK is round-scoped; Doom's canonical detonation path
## supplies the death, blast, relic and On-Death interactions.
func _apply_frenzy(target: Control, is_plus: bool) -> void:
	if target == null or not is_instance_valid(target):
		return
	var atk_gain := 5 if is_plus else 3
	target.temp_atk_buff += atk_gain
	target.update_stat_display()
	spawn_floating_number(target.global_position \
		+ Vector2(target.size.x * target.scale.x * 0.5, -10),
		"+%d ATK" % atk_gain, Color(1.0, 0.48, 0.22), false)
	if target.has_keyword("doom"):
		_detonate_doom(target)
		return
	if not target.card_data.get("keywords", []).has("doom"):
		target.card_data["keywords"].append("doom")
	target.doom_counter = 2
	target.card_data["doom"] = 2
	if target.has_method("ensure_doom_badge"):
		target.ensure_doom_badge()
	if target.has_method("update_doom_display"):
		target.update_doom_display()
	if target.has_method("flash_doom_tick"):
		target.flash_doom_tick()


# =====================================================================
#  TARGETING MODE
# =====================================================================

func _input(event: InputEvent) -> void:
	# Glossary hotkeys are handled here (before UI focus traversal) so Tab and
	# ? are not consumed by button focus navigation.
	if event is InputEventKey and event.pressed:
		match event.keycode:
			KEY_TAB, KEY_QUESTION, KEY_SLASH:
				_toggle_glossary()
				get_viewport().set_input_as_handled()
				return
			KEY_ESCAPE:
				if _glossary_layer != null and is_instance_valid(_glossary_layer):
					_close_glossary()
					get_viewport().set_input_as_handled()
					return
				if _pile_viewer_layer != null and is_instance_valid(_pile_viewer_layer):
					_close_pile_viewer()
					get_viewport().set_input_as_handled()
					return
			KEY_F1:
				# Debug builds only — in an exported release this key must be dead,
				# or every player who brushes F1 instant-wins the fight.
				if OS.is_debug_build() and phase != Phase.GAME_OVER:
					_debug_auto_win()
					get_viewport().set_input_as_handled()
					return
	if _targeting_spell != null and event is InputEventMouseButton:
		if event.button_index == MOUSE_BUTTON_LEFT and event.pressed:
			_try_resolve_target(event.global_position)
			get_viewport().set_input_as_handled()
		elif event.button_index == MOUSE_BUTTON_RIGHT and event.pressed:
			_cancel_targeting()
			get_viewport().set_input_as_handled()
	elif _targeting_potion_idx >= 0 and event is InputEventMouseButton:
		if event.button_index == MOUSE_BUTTON_LEFT and event.pressed:
			_try_resolve_potion_target(event.global_position)
			get_viewport().set_input_as_handled()
		elif event.button_index == MOUSE_BUTTON_RIGHT and event.pressed:
			_cancel_potion_targeting()
			get_viewport().set_input_as_handled()


func _clicked_target_from(pos: Vector2, pool: Array) -> Control:
	for card in pool:
		if card != null and is_instance_valid(card) and card.current_hp > 0 \
				and not card.is_inert_structure() \
				and not _is_effect_immune(card) \
				and _is_click_on_card(pos, card):
			return card
	return null


## The Old King's Body: "only a creature's strike touches it." Damage is stopped
## dead in Card2D.take_damage (whitelist flag); this is the OTHER half — the body
## cannot be CHOSEN. Filtering the one click-funnel above means every targeted
## spell, potion and effect declines it without each needing its own check, and
## the player gets the honest feedback of a target that will not take.
func _is_effect_immune(card) -> bool:
	return card != null and is_instance_valid(card) \
		and card.get("state") != null and bool(card.state.effect_immune)


## Stun / Freeze funnels (2026-07-20). These were seven scattered
## `state.stunned = true` writes; an effect-immune body would have needed a guard
## at every one, and the eighth site someone adds later would silently break the
## promise. Route every application through here instead — same pattern as
## _log_event / _play_trigger_fx / _relic_fired. Returns true if it actually stuck.
func _apply_stun(card) -> bool:
	if card == null or not is_instance_valid(card) or card.current_hp <= 0:
		return false
	if _is_fortification(card):
		return false
	if _is_effect_immune(card):
		return false
	card.state.stunned = true
	return true


func _apply_freeze(card) -> bool:
	if card == null or not is_instance_valid(card) or card.current_hp <= 0:
		return false
	if _is_fortification(card):
		return false
	if _is_effect_immune(card):
		return false
	card.state.is_frozen = true
	return true


func _clicked_lane(pos: Vector2) -> int:
	for owner_is_enemy in [false, true]:
		for row in [ROW_FRONT, ROW_BACK]:
			var slots := _slot_array(owner_is_enemy, row)
			for lane in range(mini(LANES_PER_ROW, slots.size())):
				var slot: Control = slots[lane]
				if slot != null and is_instance_valid(slot) and slot.get_global_rect().has_point(pos):
					return lane
	return -1


func _finish_targeted_spell(target: Control, target_lane: int,
		primary_target: Control = null) -> void:
	var spell_card := _targeting_spell
	if spell_card == null or not is_instance_valid(spell_card):
		return
	_targeting_paid_cost = 0
	_targeting_spell = null
	_targeting_data = {}
	_targeting_first_target = null
	_info_label.text = ""
	_hide_targeting_arrow()
	await _resolve_spell(spell_card.card_data, target, target_lane, primary_target)
	_after_spell(spell_card)


func _try_resolve_target(pos: Vector2) -> void:
	var targeting = _targeting_data.get("targeting", "none")
	# Lane-only and two-step cards resolve before the legacy single-target scan.
	if targeting == "lane":
		var lane := _clicked_lane(pos)
		if lane >= 0:
			await _finish_targeted_spell(null, lane)
		return
	if targeting == "friendly_then_enemy":
		if _targeting_first_target == null:
			var ally := _clicked_target_from(pos, _all_player_creatures())
			if ally != null:
				_targeting_first_target = ally
				_info_label.text = "%s chosen — now choose an enemy creature    ·    right-click to cancel" \
					% String(ally.card_data.get("name", "Friendly"))
			return
		if not is_instance_valid(_targeting_first_target):
			_targeting_first_target = null
			return
		var enemy := _clicked_target_from(pos, _all_enemy_creatures())
		if enemy != null:
			await _finish_targeted_spell(enemy, enemy.current_lane,
				_targeting_first_target)
		return
	if targeting == "two_enemies":
		var enemy_pick := _clicked_target_from(pos, _all_enemy_creatures())
		if enemy_pick == null:
			return
		if _targeting_first_target == null:
			_targeting_first_target = enemy_pick
			_info_label.text = "%s chosen — now choose a different enemy    ·    right-click to cancel" \
				% String(enemy_pick.card_data.get("name", "Enemy"))
			return
		if enemy_pick == _targeting_first_target:
			_info_label.text = "Choose a different enemy creature."
			return
		await _finish_targeted_spell(enemy_pick, enemy_pick.current_lane,
			_targeting_first_target)
		return
	if targeting == "friendly_lane":
		if _targeting_first_target == null:
			var mover := _clicked_target_from(pos, _all_player_creatures())
			if mover != null:
				_targeting_first_target = mover
				_info_label.text = "%s chosen — click an empty adjacent lane in its row    ·    right-click to cancel" \
					% String(mover.card_data.get("name", "Friendly"))
			return
		if not is_instance_valid(_targeting_first_target):
			_targeting_first_target = null
			return
		var dest_lane := _clicked_lane(pos)
		if dest_lane < 0:
			return
		var mover_row: int = _targeting_first_target.current_row
		if abs(dest_lane - _targeting_first_target.current_lane) != 1 \
				or _sp_lane_closed(dest_lane) \
				or _row_array(false, mover_row)[dest_lane] != null:
			_info_label.text = "Choose an empty adjacent lane in the creature's row."
			return
		await _finish_targeted_spell(null, dest_lane, _targeting_first_target)
		return
	# 4x4: scan both rows for clickable targets. Structures (Pyres, Mausoleums,
	# Altars) are board objects and can never be the target of spells — clicks
	# on them fall through to the dead-zone case below.
	#
	# IMPORTANT: _resolve_spell awaits internally for `custom` spell types and
	# any spell that triggers a discover modal. Without `await` here, the
	# _after_spell post-processing (combo counter bump, Hexblade buff,
	# ON_PLAYER_SPELL reactive, cleanup) used to fire BEFORE the spell actually
	# resolved — observable as "Hexblade gets +1 ATK but the spell didn't seem
	# to do anything." Mirror the non-targeted path at _play_spell line ~2270.
	if targeting in ["enemy_creature", "any_creature", "any"]:
		for e in _all_enemy_creatures():
			# INERT structures are scenery; an `attackable` one is a real obstacle.
			# This scan filtered the raw keyword while _target_contract_available
			# and _clicked_target_from both filter is_inert_structure() — so the
			# Trebuchet ("Break the Trebuchet to stop it", attackable: true) armed
			# targeting mode and then silently swallowed the click. Potions broke
			# it, spells declined, and if it stood alone the player had to
			# right-click out of a targeting mode with nothing clickable.
			if e.current_hp <= 0 or e.is_inert_structure() \
					or _is_effect_immune(e):
				continue
			if _is_click_on_card(pos, e):
				# Snapshot the in-flight spell card BEFORE awaiting — if we
				# read _targeting_spell after the await, another spell cast
				# could have replaced it (e.g. a discover reward) and we'd
				# discard the wrong card.
				var spell_card := _targeting_spell
				_targeting_paid_cost = 0
				_targeting_spell = null
				_targeting_data = {}
				_info_label.text = ""
				_hide_targeting_arrow()
				if _is_net():
					_net_cast_targeted(spell_card, e)
					return
				await _resolve_spell(spell_card.card_data, e, e.current_lane)
				_after_spell(spell_card)
				return
	if targeting in ["friendly_creature", "any_creature", "any"]:
		for p in _all_player_creatures():
			# See the enemy scan above — inert-vs-attackable, not the raw keyword.
			if p.current_hp <= 0 or p.is_inert_structure() \
					or _is_effect_immune(p):
				continue
			if _is_click_on_card(pos, p):
				var spell_card := _targeting_spell
				# Armaments borrow the targeting cursor only. An occupied bearer is
				# an invalid target, so keep targeting armed without spending or
				# discarding anything further.
				if spell_card.is_armament():
					if not _can_equip_armament(p):
						_info_label.text = "%s already bears an Armament — choose another creature." \
							% String(p.card_data.get("name", "That creature"))
						return
					_targeting_paid_cost = 0
					_targeting_spell = null
					_targeting_data = {}
					_info_label.text = ""
					_hide_targeting_arrow()
					if _apply_armament(spell_card.card_data, p):
						_after_armament(spell_card)
					return
				_targeting_paid_cost = 0
				_targeting_spell = null
				_targeting_data = {}
				_info_label.text = ""
				_hide_targeting_arrow()
				if _is_net():
					_net_cast_targeted(spell_card, p)
					return
				await _resolve_spell(spell_card.card_data, p, p.current_lane)
				_after_spell(spell_card)
				return
	# "any" targeting: check if clicked enemy hero area (top of screen). Route
	# through _resolve_spell with target=null so custom spells (Quick Shot)
	# resolve their else-branch face damage, draw their card, fire reactives,
	# and pick up Worn Spellbook — the old inline path read spell.value (=0
	# for custom spells) and silently dealt no damage.
	if targeting == "any" and pos.y < get_viewport_rect().size.y * 0.15:
		var spell_card := _targeting_spell
		_targeting_paid_cost = 0
		_targeting_spell = null
		_targeting_data = {}
		_info_label.text = ""
		_hide_targeting_arrow()
		if _is_net():
			_net_cast_targeted(spell_card, null)
			return
		await _resolve_spell(spell_card.card_data, null, -1)
		_after_spell(spell_card)
		return


func _use_combat_potion(index: int) -> void:
	## Click handler for a combat HUD potion slot. Cancels any in-flight spell
	## targeting (you can't target both at once). Non-targeted potions resolve
	## immediately; targeted ones enter potion-targeting mode.
	if phase != Phase.PLAYER_TURN:
		return
	# Net: only on your own active turn (the belt draws no potions the foe owns).
	if _is_net() and _net_active_index != _net_my_index():
		return
	var belt: Array = _ctx_potions()
	if index < 0 or index >= belt.size():
		return
	if _targeting_spell != null:
		_cancel_targeting()
	var pid: String = String(belt[index])
	var data: Dictionary = PotionDB.get_potion(pid)
	if data.is_empty() or data.get("usable_in", "combat") == "map":
		return
	# Grave-Digger's Nip with a clean hand would drink for nothing — refuse
	# instead of consuming (targeted potions can't waste; this one could).
	if data.get("effect", "") == "purge_hand_curses" \
			and not _hand.any(func(c): return CardDB.is_curse(c.card_id)):
		_show_info("No Curses in hand to bury.")
		return
	_pl_log("potion", {"potion": pid})
	# Skirmish: non-targeted potions route straight through the net dispatcher
	# (host-authoritative board/HP / caster-local Command + draw); targeted ones
	# enter potion-targeting mode exactly like solo, then resolve on the click via
	# _try_resolve_potion_target → _net_use_potion with the picked entity.
	if _is_net():
		var net_targeting: String = String(data.get("targeting", "none"))
		if net_targeting == "none":
			_net_use_potion(pid, index)
		else:
			_targeting_potion_idx = index
			_info_label.text = "%s — target a %s" % [
				data.get("name", pid),
				"friendly creature" if net_targeting == "friendly_creature" else "creature"
			]
		return
	var targeting: String = data.get("targeting", "none")
	if targeting == "none":
		_resolve_combat_potion(pid, null)
		RunState.consume_potion(index)
		_dregs_bottle_throw()
		_rebuild_potion_bar()
		_update_hud()
	else:
		_targeting_potion_idx = index
		_info_label.text = "%s — target a %s" % [
			data.get("name", pid),
			"friendly creature" if targeting == "friendly_creature" else "creature"
		]


func _try_resolve_potion_target(pos: Vector2) -> void:
	if _targeting_potion_idx < 0:
		return
	# _ctx_potions() is the belt for BOTH modes (RunState in solo, the net slot in
	# skirmish), so the index resolves against the same list the click drew from.
	var belt: Array = _ctx_potions()
	if _targeting_potion_idx >= belt.size():
		_cancel_potion_targeting()
		return
	var pid: String = String(belt[_targeting_potion_idx])
	var data: Dictionary = PotionDB.get_potion(pid)
	var targeting: String = data.get("targeting", "none")
	var pool: Array = []
	if targeting in ["friendly_creature", "any_creature"]:
		pool.append_array(_all_player_creatures())
	if targeting in ["enemy_creature", "any_creature"]:
		pool.append_array(_all_enemy_creatures())
	var target := _clicked_target_from(pos, pool)
	if target == null:
		return
	if _is_net():
		# Net: the host-authoritative resolver applies + board-syncs; the
		# belt consume + foe drink-beat ride inside _net_use_potion.
		_net_use_potion(pid, _targeting_potion_idx, target)
	else:
		_resolve_combat_potion(pid, target)
		RunState.consume_potion(_targeting_potion_idx)
		_dregs_bottle_throw()
	_targeting_potion_idx = -1
	_info_label.text = ""
	_rebuild_potion_bar()
	_update_hud()


func _cancel_potion_targeting() -> void:
	_targeting_potion_idx = -1
	_info_label.text = ""


func _play_potion_drink_fx(pid: String, target: Control) -> void:
	## Solo drink beat: the bottle lifts off the belt, tips as it flies, and a
	## splash of the draught's colour bursts where it lands (the target for
	## targeted potions, above the belt for self-draughts). The net game has
	## its own reveal (_net_show_potion_reveal) — this is the solo counterpart,
	## so a quaff reads as an action instead of numbers changing.
	if _hud_layer == null or DisplayServer.get_name() == "headless" or _is_net():
		return
	if UserSettings != null and UserSettings.reduce_motion:
		return
	var data: Dictionary = PotionDB.get_potion(pid)
	var col: Color = data.get("color", Color(0.6, 0.8, 0.5))
	var icon: Texture2D = PotionDB.icon_for(pid)
	var from: Vector2 = Vector2(120.0, get_viewport_rect().size.y * 0.60)
	if _potion_bar_root != null and is_instance_valid(_potion_bar_root):
		from = _potion_bar_root.get_global_rect().get_center()
	var to: Vector2 = from + Vector2(46.0, -110.0)
	if target != null and is_instance_valid(target):
		to = _card_center(target)
	if icon != null:
		var b := TextureRect.new()
		b.texture = icon
		b.modulate = Color.WHITE if PotionDB.is_painted_icon(pid) else col
		# Painted potion icons are full-size PNGs — without EXPAND_IGNORE_SIZE
		# the texture draws at native resolution and floods the screen.
		b.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
		b.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
		b.size = Vector2(44, 44)
		b.pivot_offset = Vector2(22, 30)
		b.position = from - Vector2(22, 22)
		b.z_index = 235
		b.mouse_filter = Control.MOUSE_FILTER_IGNORE
		_hud_layer.add_child(b)
		var tw := b.create_tween()
		tw.tween_property(b, "position", to - Vector2(22, 22),
			UserSettings.anim_time(0.26)) \
			.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
		tw.parallel().tween_property(b, "rotation_degrees", -38.0,
			UserSettings.anim_time(0.26)).set_ease(Tween.EASE_OUT)
		tw.parallel().tween_property(b, "scale", Vector2(1.18, 1.18),
			UserSettings.anim_time(0.26))
		tw.tween_property(b, "modulate:a", 0.0,
			UserSettings.anim_time(0.18)).set_ease(Tween.EASE_IN)
		tw.tween_callback(b.queue_free)
	# The splash lands on the tip-back beat.
	get_tree().create_timer(UserSettings.anim_time(0.24)).timeout.connect(func():
		spawn_spell_burst(to, col))


func _dregs_bottle_throw() -> void:
	## Dregs relic: the drained bottle follows the draught — 2 damage to a
	## random enemy creature, or the enemy face if the field is clear. Fired
	## from both drink paths (instant + targeted), after the potion resolves.
	if not _has_relic("dregs") or _is_net():
		return
	var dmg: int = int(RelicDB.get_relic("dregs").get("value", 2))
	_relic_fired("dregs")
	var pool: Array = _all_enemy_creatures()
	if pool.size() > 0:
		var t: Control = _combat_ops.pick(pool)
		spawn_floating_number(_card_center(t) + Vector2(0, -14),
			"DREGS %d" % dmg, Color(0.55, 0.85, 0.45), false)
		t.take_damage(dmg)
	else:
		damage_enemy_hero(dmg)


func _resolve_combat_potion(pid: String, target: Control) -> void:
	## Apply the in-combat effect of `pid`. `target` is non-null only for
	## targeted potions. Effects mirror existing combat primitives so each
	## handler stays tiny.
	var data: Dictionary = PotionDB.get_potion(pid)
	var quaff_line := "You quaff the [color=%s]%s[/color]" \
		% [_LOG_PLAYER_COL, String(data.get("name", pid))]
	if target != null and is_instance_valid(target):
		quaff_line += " on %s" % _log_card_ref(target)
	# Potion glyph in the margin: painted PNG shows untinted, the white
	# silhouette kit renders tinted by the potion's colour (same rule as Shop).
	var pot_icon: Texture2D = PotionDB.icon_for(pid)
	var pot_tint: Color = Color.WHITE if PotionDB.is_painted_icon(pid) \
		else data.get("color", Color(0.7, 0.7, 0.7))
	_log_event(quaff_line + ".", {}, 0, pot_icon, pot_tint)
	_play_potion_drink_fx(pid, target)
	# The Apothecary (tonic_vigor) drinks along — fires per DRINK, before the
	# effect resolves, so even a heal at full HP still feeds her.
	_apply_tonic_vigor(false)
	match data.get("effect", ""):
		"heal_hp":
			var pot_before: int = player_hp
			RunState.heal_hero(8)
			player_hp = RunState.hero_hp
			if player_hp > pot_before:
				_show_lifelink_heal(player_hp - pot_before)
		"column_strike":
			# Sapper's Charge: collapse a column — the target and whoever shares
			# its lane in the other row both take 4. Grab the lane-mate BEFORE
			# damage so a dying target can't orphan the second hit.
			if target != null and target.is_creature():
				var sap_lane: int = target.current_lane
				var sap_other: int = ROW_BACK if target.current_row == ROW_FRONT else ROW_FRONT
				var sap_mate: Control = _row_array(true, sap_other)[sap_lane]
				_vfx_fire(target.get_global_rect().get_center())
				target.take_damage(4)
				if sap_mate != null and is_instance_valid(sap_mate):
					_vfx_fire(sap_mate.get_global_rect().get_center())
					sap_mate.take_damage(4)
				_cleanup_dead()
		"gain_mana":
			player_mana += 2
		"aoe_enemies":
			for c in _all_enemy_creatures():
				c.take_damage(3)
		"draw":
			for _i in range(3):
				draw_one()
		"revive_last_dead":
			_revive_last_dead_friendly()
		"grant_rampage":
			# War Paint: bolt Rampage 2 + +1 ATK onto a friendly for the fight.
			# Adds the runtime keyword so _apply_combat_strike_riders grows it on
			# every kill, and bumps the rampage value so the trigger is +2.
			if target != null and target.is_creature():
				if "rampage" not in target.card_data.get("keywords", []):
					target.card_data.keywords.append("rampage")
				target.card_data["rampage"] = maxi(2, int(target.card_data.get("rampage", 0)))
				target.persistent_atk_buff += 1
				target.persistent_atk_buff_rounds = 99  # rest of this fight
				if target.has_method("_spawn_keyword_chip"):
					target._spawn_keyword_chip("RAMPAGE", Color(1.0, 0.62, 0.20))
				_vfx_fire(target.get_global_rect().get_center())
				target.update_stat_display()
		"grant_lifelink":
			# Vampiric Draught: friendly heals you for the damage it deals this
			# fight, plus a 4 HP top-up now. Mirrors Censer Light's runtime
			# keyword-grant pattern so _apply_combat_strike_riders heals off it.
			if target != null and target.is_creature():
				if "lifelink" not in target.card_data.get("keywords", []):
					target.card_data.keywords.append("lifelink")
				if target.has_method("_spawn_keyword_chip"):
					target._spawn_keyword_chip("LIFESTEAL", Color(0.95, 0.35, 0.45))
				_vfx_blight(target.get_global_rect().get_center())
				target.update_stat_display()
			var elx_before: int = player_hp
			RunState.heal_hero(4)
			player_hp = RunState.hero_hp
			if player_hp > elx_before:
				_show_lifelink_heal(player_hp - elx_before)
		"chain_lightning":
			# Chain-Lightning Flask: 4 jumps of 2 damage to random enemy creatures.
			# Re-rolls the pool each jump so it spreads across the board (and keeps
			# arcing even as bodies drop). Mirrors the Ricochet spell shape.
			for _i in range(4):
				var pool := _all_enemy_creatures()
				if pool.is_empty():
					break
				var pick: Control = _combat_ops.pick(pool)
				_vfx_shock(pick.get_global_rect().get_center())
				pick.take_damage(2)
				if pick.current_hp <= 0:
					_cleanup_dead()
		"detonate_doom_all":
			# Doomsday Draught: fire every friendly Doom creature's detonation now.
			# Snapshot the list first — _detonate_doom destroys via the canonical
			# path, mutating the field arrays mid-iteration would skip neighbours.
			var bombs: Array = []
			for c in _all_player_creatures():
				if c.has_keyword("doom"):
					bombs.append(c)
			for c in bombs:
				if is_instance_valid(c) and c.current_hp > 0:
					_detonate_doom(c)
			_cleanup_dead()
		"shield_wall":
			# Aegis Brew: every friendly creature gains Shield (one free hit).
			for c in _all_player_creatures():
				c.state.has_shield = true
				if c.has_method("_spawn_keyword_chip"):
					c._spawn_keyword_chip("SHIELD", Color(0.65, 0.85, 1.0))
				_vfx_blessing(c.get_global_rect().get_center())
				c.update_stat_display()
		"sacrifice_for_command":
			# Butcher's Dram: pay a body, seize the turn. Routes through the
			# canonical sacrifice trigger (Bone Pile / Cleaver / Scythe / the
			# ON_PLAYER_SACRIFICE reactive all fire), then the 999 kill mirrors
			# the Offering spell.
			if target != null and target.is_creature():
				_trigger_player_sacrifice(target)
				_force_destroy_creature(target)
				player_mana += 3
		"purge_hand_curses":
			# Grave-Digger's Nip: bury (exhaust) every Curse-family card in hand,
			# draw one per burial — the hand-exhaust flow mirrors Recycle. Note
			# the replacement draws can sting (curse_on_draw fires as normal);
			# the ground gives as good as it gets.
			var buried: int = 0
			for nip_card in _hand.duplicate():
				if CardDB.is_curse(nip_card.card_id):
					_hand.erase(nip_card)
					if nip_card.get_parent() != null:
						nip_card.get_parent().remove_child(nip_card)
					_exhaust_pile.append(_pile_entry(nip_card.card_id, nip_card.deck_uid))
					nip_card.queue_free()
					buried += 1
			for _i in range(buried):
				draw_one()
			_layout_hand()
			if buried > 0:
				_show_info("Buried %d — drew %d." % [buried, buried])
		"summon_recruits":
			# Conscription Brew: muster two 3/3 Recruits into empty lanes (front
			# preferred). summon_token falls through to the other row of a column
			# if the front slot is taken, so this fills sensibly on a busy board.
			var made: int = 0
			for r in [ROW_FRONT, ROW_BACK]:
				if made >= 2:
					break
				var arr = _row_array(false, r)
				for l in range(LANES_PER_ROW):
					if made >= 2:
						break
					if arr[l] == null:
						summon_token(3, 3, l, false, r)
						var nt = _row_array(false, r)[l]
						if nt != null and is_instance_valid(nt):
							nt.card_data["name"] = "Recruit"
							_vfx_blessing(nt.get_global_rect().get_center())
						made += 1
		_:
			push_warning("Combat: unknown potion effect '%s'" % data.get("effect", ""))


func _revive_last_dead_friendly() -> void:
	## Phoenix Brew: return the player's last dead creature to the foremost
	## empty lane as a 1/1 with its keywords. Falls back to no-op if nothing
	## died or no empty slot exists.
	if _last_dead_creature_id == "":
		return
	var src: Dictionary = CardDB.get_card_data(_last_dead_creature_id)
	if src.is_empty() or src.get("type", "") != "creature":
		return
	var empties: Array = []
	for r in [ROW_FRONT, ROW_BACK]:
		var arr = _row_array(false, r)
		for l in range(LANES_PER_ROW):
			if arr[l] == null:
				empties.append({"row": r, "lane": l})
	if empties.is_empty():
		return
	# Front-preferred, left-to-right (empties was built front row first) —
	# same fill as Conscription Brew. A random lane threw away the one
	# placement read the revive could offer.
	var pick: Dictionary = empties[0]
	# Synthetic card_data — 1/1 body but inherits keywords and persistent
	# abilities (floop, on_death, adj_buff, passive) from the source so the
	# revived creature still "remembers" what it was.
	var token: Dictionary = src.duplicate(true)
	token["id"] = "phoenix_%s" % _last_dead_creature_id
	token["atk"] = 1
	token["hp"] = 1
	token["cost"] = 0
	token["is_token"] = true
	# Drop on-enter so reviving doesn't re-fire its play effect (often damage).
	token.erase("on_enter")
	var card = CARD_SCENE.instantiate()
	card.card_id = token["id"]
	card.is_opponent = false
	card.is_on_battlefield = true
	card.is_token = true
	card.compact_mode = true
	card.card_data = token
	card.current_atk = 1
	card.current_hp = 1
	card.current_lane = pick.lane
	card.current_row = pick.row
	_row_array(false, pick.row)[pick.lane] = card
	var slot = _slot_array(false, pick.row)[pick.lane]
	_slot_set_card(slot, card)
	card.destroyed.connect(_on_card_destroyed.bind(card))
	card.will_die.connect(_on_card_will_die.bind(card))


func _cancel_targeting() -> void:
	if _targeting_spell == null:
		return
	# Return the targeted card to hand.
	var restored_pending_state := false
	if not _armament_targeting_rollback.is_empty():
		restored_pending_state = true
		_card_cost_discount = int(_armament_targeting_rollback.get(
			"card_cost_discount", _card_cost_discount))
		_mana_tide_creature_discount = int(_armament_targeting_rollback.get(
			"mana_tide", _mana_tide_creature_discount))
		_sigil_of_hunger_charge = int(_armament_targeting_rollback.get(
			"sigil_hunger", _sigil_of_hunger_charge))
		_familiars_quill_charge = int(_armament_targeting_rollback.get(
			"familiars_quill", _familiars_quill_charge))
		_targeting_spell.state.mummified_zero = bool(
			_armament_targeting_rollback.get("mummified_zero", false))
		_targeting_spell.state.pact_of_embers_zero = bool(
			_armament_targeting_rollback.get("pact_zero", false))
		_first_spell_this_turn = bool(_armament_targeting_rollback.get(
			"first_spell", _first_spell_this_turn))
		_armament_targeting_rollback = {}
	player_mana += _targeting_paid_cost
	_targeting_paid_cost = 0
	_cards_played_this_turn = maxi(0, _cards_played_this_turn - 1)
	# A canceled target never became a cast, so first-spell engines/discounts stay
	# available when no earlier spell resolved this turn.
	if not restored_pending_state:
		_first_spell_this_turn = (_net_spells_this_turn > 0) if _is_net() \
			else (_spells_cast_this_turn > 0)
	_pl_spell_pending = {}
	_hand_container.add_child(_targeting_spell)
	_hand.append(_targeting_spell)
	_targeting_spell = null
	_targeting_data = {}
	_targeting_first_target = null
	_info_label.text = ""
	_hide_targeting_arrow()
	_layout_hand()
	_update_hud()


func _targeting_human(targeting: String) -> String:
	# Plain-language name of a spell's legal target set, for the targeting prompt.
	match targeting:
		"enemy_creature": return "an enemy creature"
		"friendly_creature": return "a friendly creature"
		"any_creature": return "any creature"
		"any": return "any creature — or click the enemy banner to hit their face"
		"lane": return "a lane"
		"friendly_then_enemy": return "a friendly, then an enemy"
		"two_enemies": return "two enemy creatures"
		"friendly_lane": return "a friendly, then its destination lane"
		_: return "a target"


func _is_click_on_card(pos: Vector2, card: Control) -> bool:
	var rect = Rect2(card.global_position, card.size)
	return rect.has_point(pos)


