# ═══════════════════════════════════════════
#  ★7 — THE PORTRAIT TAKES THE WAR
#  (docs/ANIMATION_COOL_PITCH_20260717.md §5b)
#
#  A hero portrait is a PAINTED PANEL pinned to the war table, and it used to be
#  a static painting with a number under it — the hero never reacted to anything
#  that happened to them. Now the panel scorches as its owner breaks: soot
#  climbing from the base, an ember frontier creeping up as the HP falls.
#
#  It reuses ★1's burn shader outright, held partway instead of run to
#  completion, in `consume = 0` mode so the panel CHARS rather than developing a
#  hole in the UI. Both sides char — you can read how close the foe is to
#  breaking without reading their number.
#
#  INFORMATIONAL by the reduce-motion contract (it IS the HP read, at a glance,
#  across the table), so it is never gated off; only the CREEP is a tween, and
#  the state itself is a held shader value.
# ═══════════════════════════════════════════
# CALIBRATED AGAINST SHOTS, not theory. The burn field's real range puts the
# char band at the panel's very bottom edge, so a curve running 0 → 0.34 showed
# NOTHING until ~10% HP — useless as a glanceable read (caught in
# _shot_portrait_char: the 30%-HP frame was indistinguishable from full).
# Because `consume = 0` makes a hole impossible, the range can be pushed much
# harder than a card's: MIN is the faintest visible singe, MAX is deep soot.
const PORTRAIT_CHAR_FROM: float = 0.66   # HP ratio where the panel starts to singe
const PORTRAIT_CHAR_MIN: float = 0.20    # burn the moment it crosses that line
const PORTRAIT_CHAR_MAX: float = 0.55    # burn at 0 HP — soot, never a hole
var _player_portrait_rect: TextureRect = null
var _enemy_portrait_rect: TextureRect = null
var _player_portrait_mat: ShaderMaterial = null
var _enemy_portrait_mat: ShaderMaterial = null


func _portrait_burn_for(ratio: float) -> float:
	# Whole above PORTRAIT_CHAR_FROM, then scorching in proportion to the wound.
	# Continuous, not stepped: the char IS the HP bar, and a stepped one would
	# read as a bug the first time 1 damage jumped it a rung.
	if ratio >= PORTRAIT_CHAR_FROM:
		return 0.0
	var t: float = 1.0 - clampf(ratio, 0.0, PORTRAIT_CHAR_FROM) / PORTRAIT_CHAR_FROM
	return lerpf(PORTRAIT_CHAR_MIN, PORTRAIT_CHAR_MAX, t)


func _refresh_portrait_char(is_enemy: bool) -> void:
	if DisplayServer.get_name() == "headless":
		return
	var rect: TextureRect = _enemy_portrait_rect if is_enemy else _player_portrait_rect
	if rect == null or not is_instance_valid(rect):
		return
	var cur: int = enemy_hp if is_enemy else player_hp
	var maxv: int = enemy_max_hp if is_enemy else player_max_hp
	var ratio: float = float(cur) / float(maxi(maxv, 1))
	var want: float = _portrait_burn_for(ratio)
	var mat: ShaderMaterial = _enemy_portrait_mat if is_enemy else _player_portrait_mat
	if mat == null:
		mat = Motion.burn_material()
		# CHAR, don't consume: a hole in the HUD would read as a bug, where soot
		# reads as a panel that has been through a war.
		mat.set_shader_parameter("consume", 0.0)
		rect.material = mat
		if is_enemy:
			_enemy_portrait_mat = mat
		else:
			_player_portrait_mat = mat
	var from: float = float(mat.get_shader_parameter("burn"))
	if is_equal_approx(from, want):
		return
	# The char CREEPS to its new depth rather than snapping — a blow should look
	# like it spread, not like a value changed.
	var tw := rect.create_tween()
	tw.tween_method(func(v: float):
		if is_instance_valid(mat):
			mat.set_shader_parameter("burn", v),
		from, want, UserSettings.anim_time(0.45)).set_ease(Tween.EASE_OUT)

# Colors — local aliases for GameTheme constants used heavily in this file.
const GILT := Color(0.82, 0.66, 0.30, 1.0)
const IVORY := Color(0.96, 0.92, 0.78, 1.0)


# ─────────────────────────────────────────────────────────────────────────
#  ONLINE SKIRMISH — mode helpers & context indirection
#  (docs/MULTIPLAYER_SKIRMISH_PLAN.md §12.1-12.2)
#
#  These are the *only* hooks the campaign cares about: in SOLO every _is_net()
#  is false, so all of this is dead weight that the optimizer skips. In net mode
#  they redirect the handful of RunState reads (HP / deck / mana / card-data)
#  that would otherwise pull the wrong player's run, and they force every
#  relic/mutator path inert so a leftover campaign RunState can't bleed in.
# ─────────────────────────────────────────────────────────────────────────

func _is_net() -> bool:    return combat_mode != CombatMode.SOLO
func _is_host() -> bool:   return combat_mode == CombatMode.NET_HOST
func _is_client() -> bool: return combat_mode == CombatMode.NET_CLIENT


# ─────────────────────────────────────────────────────────────────────────
# PlayLog hooks — structured per-action telemetry (see scripts/state/PlayLog.gd).
# Solo campaign only (skirmish/net excluded). Snapshots are taken at DECISION
# time so each record is a usable state→action pair for analysis / bot training.
# ─────────────────────────────────────────────────────────────────────────
var _pl_combat_logged: bool = false
var _pl_spell_pending: Dictionary = {}
var _pl_last_end_turn_round: int = -1

func _pl_card_brief(c) -> Dictionary:
	if c == null or not is_instance_valid(c):
		return {}
	var d: Dictionary = c.card_data if c.card_data != null else {}
	return {"id": c.card_id, "atk": c.effective_atk(), "hp": c.current_hp,
		"kw": d.get("keywords", [])}

func _pl_board(is_enemy: bool) -> Array:
	# 8 slots in read order [front 0..3, back 0..3]; null where the slot is empty.
	var out: Array = []
	for row in [0, 1]:
		var arr = _row_array(is_enemy, row)
		for lane in range(4):
			var c = arr[lane] if lane < arr.size() else null
			out.append(_pl_card_brief(c) if c != null else null)
	return out

func _pl_hand() -> Array:
	var out: Array = []
	for c in _hand:
		if c == null or not is_instance_valid(c):
			continue
		var d: Dictionary = c.card_data if c.card_data != null else {}
		out.append({"id": c.card_id, "cost": int(d.get("cost", 0)),
			"type": d.get("type", "")})
	return out

func _pl_snapshot() -> Dictionary:
	return {"round": round_number, "php": player_hp, "ehp": enemy_hp,
		"mana": player_mana, "max_mana": player_max_mana,
		"hand": _pl_hand(),
		"player_board": _pl_board(false), "enemy_board": _pl_board(true)}

func _pl_log(type: String, action: Dictionary, snap = null) -> void:
	# Central emit. Skips net/skirmish; lazily emits combat_start once per fight.
	if _is_net():
		return
	if not _pl_combat_logged:
		_pl_combat_logged = true
		PlayLog.log_event("combat_start", {
			"encounter": _encounter_id, "name": _encounter_name,
			"act": RunState.get_act(), "mutator": _mutator_id,
			"node_type": RunState.current_node_type, "enemy_max_hp": enemy_max_hp})
	var rec: Dictionary = {}
	rec.merge(action, true)
	rec["state"] = snap if snap != null else _pl_snapshot()
	PlayLog.log_event(type, rec)

## The local player's index (0 = host slot, 1 = client slot). -1 in solo.
func _net_my_index() -> int:
	return NetMatch.local_player_index

## The local player's SkirmishState slot (deck / HP / mana). Null in solo.
func _net_my_slot() -> SkirmishState.PlayerSlot:
	return SkirmishState.get_slot(_net_my_index())

## Which player (0 host / 1 client) takes the FIRST turn this game. The raw seed
## coin flip decides who WINS THE TOSS; since 2026-07-11 the winner CHOOSES the
## order (march first / hold back) and the settled pick lands here as
## _net_first_player_override on both machines (EV/IN_ORDER_PICK). The flip
## alternates each game of a Best-of-N series, so the toss changes hands.
## Pre-choice, both machines derive the same flip from SkirmishState.rng_seed
## (= NetMatch.match_seed) + series_game with no negotiation; only the host
## drives the authoritative turn loop off the settled order.
func _net_first_player() -> int:
	if _net_first_player_override >= 0:
		return _net_first_player_override
	var rng := RandomNumberGenerator.new()
	rng.seed = SkirmishState.rng_seed
	var base: int = rng.randi() & 1
	# Alternate the opener each game (game 1 = base, game 2 = the other, …).
	return base ^ ((SkirmishState.series_game - 1) & 1)

## True if `player_index` (0/1) takes the SECOND turn — the going-second player gets
## the +1 opening card and pre-deals their hand. Complement of _net_first_player.
func _net_goes_second(player_index: int) -> bool:
	return player_index != _net_first_player()

## Map a global owner index (0 host / 1 client) to THIS screen's board side.
## Each client renders itself on the bottom (player side, is_enemy=false) and the
## opponent on top (enemy side, is_enemy=true), so "enemy" is purely a local
## rendering fact keyed off who owns the creature.
func _side_for_owner(owner_index: int) -> bool:
	return owner_index != _net_my_index()

# ── Context accessors: deck / HP / mana / card-data source ──

func _ctx_hero_hp() -> int:
	return _net_my_slot().hero_hp if _is_net() else RunState.hero_hp

func _ctx_hero_max_hp() -> int:
	return _net_my_slot().hero_max_hp if _is_net() else RunState.hero_max_hp

func _ctx_deck() -> Array:
	return _net_my_slot().deck if _is_net() else RunState.deck

func _ctx_deck_uids() -> Array:
	return _net_my_slot().deck_uids if _is_net() else RunState.deck_uids

func _ctx_max_mana() -> int:
	return _net_my_slot().base_max_mana if _is_net() else RunState.get_max_mana()

## Drafted battle potions (skirmish) vs the campaign potion belt (solo).
func _ctx_potions() -> Array:
	return _net_my_slot().potions if _is_net() else RunState.potions

## How many potion slots the belt draws. Solo shows the full MAX_POTIONS belt
## (consumed slots go empty); skirmish shows exactly what was drafted this match.
func _ctx_max_potions() -> int:
	return _net_potion_slots if _is_net() else RunState.MAX_POTIONS

## Consume the potion at `index` from whichever belt is live.
func _ctx_consume_potion(index: int) -> void:
	if _is_net():
		var pots: Array = _net_my_slot().potions
		if index >= 0 and index < pots.size():
			pots.remove_at(index)
	else:
		RunState.consume_potion(index)


func _combat_seed() -> int:
	if _is_net():
		return int(SkirmishState.rng_seed) ^ (int(SkirmishState.series_game) * 104729)
	return int(RunState.run_seed) ^ String(RunState.current_encounter_id).hash() \
		^ (int(RunState.current_floor) * 7919)


## OPENING-COST TRACE. Silent unless the process was launched with
## `--combat_trace` (after a bare `--`). The opening is a chain of very
## different costs — a threaded art warm, one big synchronous build block, a
## scripted banner, an animated muster — and only a per-milestone stamp can say
## which one the player is actually waiting on. Cost when off: one array scan
## per combat entry.
var _trace_open := false
var _trace_t0 := 0


func _trace(label: String) -> void:
	if not _trace_open:
		return
	print("[combat-open] %8.1f ms  %s" % [
		float(Time.get_ticks_usec() - _trace_t0) / 1000.0, label])


func _ready() -> void:
	_trace_open = OS.get_cmdline_user_args().has("--combat_trace")
	_trace_t0 = Time.get_ticks_usec()
	set_process(false)
	# Re-arm the hand-play gate every combat: a skirmish that locked the hand on
	# the foe's turn must not leak that lock into a later solo fight (statics live
	# for the whole app run). Net turns toggle it from here on.
	Card2D.hand_interactive = true
	# Decide combat mode FIRST — everything downstream branches on it. Gated on a
	# live NetMatch connection so a stale SkirmishState left over from a previous
	# skirmish can never make a campaign fight think it's networked.
	if SkirmishState.combat_mode != SkirmishState.CombatMode.SOLO \
			and NetMatch.is_connected_to_peer():
		combat_mode = SkirmishState.combat_mode   # int values align with CombatMode
	else:
		combat_mode = CombatMode.SOLO
	_combat_ops.reseed(_combat_seed())
	_rebuild_relic_cache()
	_compute_spell_tome()
	_banking_tutorial_shown = UserSettings.banking_tutorial_seen
	_intents_tutorial_shown = UserSettings.intents_tutorial_seen
	_pile_tutorial_shown = UserSettings.pile_tutorial_seen
	_combat_model_tutorial_shown = UserSettings.combat_model_tutorial_seen
	_dismiss_tutorial_shown = UserSettings.dismiss_tutorial_seen
	_swap_background_for_act()
	_trace("background swapped")
	_setup_fight_state()
	_trace("fight state set up")
	# Stand the map's idle deck warm down before we ask for the bake viewport.
	# CardTextureCache serializes bakers through _bake_busy, so committing to a
	# node mid-warm used to park this fight's art prewarm behind the rest of the
	# deck. The warm bakes the same cards our own _prebake_hand_textures does.
	ScenePreload.cancel_deck_warm()
	# Warm the enemy art cache now, before _place_starting_board lays the opening
	# formation — otherwise each creature's art disk-loads on the frame it appears.
	# MEASURED (2026-07-24 A/B): warming here beats warming after _build_board —
	# moving it late cost +209 ms to playable and +178 ms to board-visible, and
	# "bought" its smaller worst-stall only by hiding the work inside a block that
	# renders nothing. Keep the prewarm EARLY.
	await _prewarm_enemy_art()
	_trace("enemy art warmed")
	# Music: every fight class rotates a pool (the picker excludes the
	# currently-playing track, and play_music resumes saved positions). Acts
	# escalate to heavier books. AudioBank no-ops if a file is missing.
	var node_type: String = RunState.current_node_type
	var act: int = RunState.get_act()
	if _is_net():
		# Skirmish has no acts or node types — the solo run state read below
		# is stale here. Rotate the whole combat book instead, so each game
		# of a Bo3 gets a fresh song.
		AudioBank.play_music_random([
			"combat", "combat_act1_b", "combat_act1_c", "combat_act1_d",
			"combat_act2", "combat_act2_b", "combat_act2_c", "combat_act2_d",
			"combat_act3", "combat_act3_b", "combat_act3_c", "combat_act3_d"])
	else:
		match node_type:
			"boss":
				# Act 3 keeps its fixed heavyweight. Earlier keeps: each rival
				# lord carries his own leitmotif; non-rival strongholds rotate
				# the general boss book.
				if act >= 3:
					AudioBank.play_music("combat_boss_act3")
				else:
					match String(RunState.current_encounter_id):
						"rival_stalwart":  # the Last Wall — a forge-march
							AudioBank.play_music("combat_boss_b")
						"rival_raider":  # the Grasswake — driving pursuit
							AudioBank.play_music("combat_boss_c")
						"rival_acolyte":  # the Owed — gothic choral rite
							AudioBank.play_music("combat_boss_e")
						"rival_pyromancer":  # the Lanternhall — cold spellwork
							AudioBank.play_music("combat_boss_d")
						"rival_kindler":  # the Everflame — building force
							AudioBank.play_music("combat_boss")
						_:
							AudioBank.play_music_random(["combat_boss", "combat_boss_b", "combat_boss_c"])
			"elite":
				AudioBank.play_music_random(
					["combat_elite", "combat_elite_b", "combat_elite_c"])
			_:
				var pool: Array
				match act:
					2: pool = ["combat_act2", "combat_act2_b", "combat_act2_c", "combat_act2_d"]
					3: pool = ["combat_act3", "combat_act3_b", "combat_act3_c", "combat_act3_d"]
					_: pool = ["combat", "combat_act1_b", "combat_act1_c", "combat_act1_d"]
				AudioBank.play_music_random(pool)
	_trace("music started")
	# THE OPENING BUILD IS INTERLEAVED (2026-07-26). Board + ambient FX + grade +
	# HUD + decks is ~340 ms of contiguous main-thread work, and run in one block
	# it renders NO frame for that whole time: the player stares at a bare arena,
	# frozen, then everything pops in at once. Handing the frame back between the
	# stages turns that single stall into a fast, live build-up. The order is
	# unchanged (each stage still reads what the previous one made) — only the
	# frames in between are new, and nothing here is interactive yet.
	_build_board()
	_trace("board built")
	await get_tree().process_frame
	_build_ambient_fx()
	# Cinematic per-act/per-encounter grade — must follow _build_ambient_fx so
	# the CombatBg / Vignette / HearthGlow / StageLight / AmbientEmbers nodes it
	# re-tones already exist.
	_build_grade_overlay()
	_apply_combat_mood()
	_trace("ambient fx + grade built")
	await get_tree().process_frame
	await _build_hud()
	_trace("HUD built")
	await get_tree().process_frame
	_init_decks()
	_trace("decks initialised")
	if not _is_net():
		_place_starting_board()   # no AI enemy in skirmish — the opponent is a player
	_trace("starting board placed")
	# Living Antagonist makes its entrance once the board is set.
	get_tree().create_timer(0.45).timeout.connect(presence_enter)
	# Pre-bake static-display textures for every unique card in the draw pile so
	# _draw_card's live_baked_mode Card2D finds a warm cache. FIRE-AND-FORGET (no
	# await): round 1 no longer waits on the bake — it runs in the background
	# during the intro banner and the opening turn, so a cold entry is interactive
	# immediately instead of freezing ~30 ms/card. All Combat-state reads happen
	# synchronously before its first await (the to_bake list is built up front),
	# so the coroutine is safe to outlive this call. Cards drawn before their bake
	# lands hit the v4 live fallback inside _build_layout — slower but visually
	# identical — and pick up the baked texture on the next draw.
	_prebake_hand_textures()
	_trace("hand prebake kicked off")
	var supersample := get_node_or_null("/root/Supersample")
	if supersample != null:
		supersample.begin_adaptive_scope(self)
	# Online skirmish takes over here: no relic combat-start bundle, no encounter
	# intro, no solo round loop. The host drives the turn sequence; the client
	# waits for events. Everything below is campaign-only.
	if _is_net():
		_net_begin_combat()
		return
	# Gambler's Coin: once at fight start, coin flip — draw 1 extra OR deal 3
	# to a random enemy. Lives here (after enemies are placed, before round 1
	# starts) so the damage option can find a target and the draw lands before
	# the player's first turn read.
	_apply_gamblers_coin()
	_apply_conscription_muster()
	# Marked One event payoff: if the player took the mark in a prior event
	# room, the gift lands here — a free creature in front-left and/or a
	# whole-fight mana bonus. Both flags clear so the next combat is clean.
	_apply_marked_one_gift()
	# Combat-start relic bundle: each guard-checks its own _has_relic so this
	# stays a single entry point for "stuff that fires once when the fight
	# begins, after enemies are placed but before round 1 draws".
	_apply_combat_start_relics()
	_trace("combat-start relics applied — intro banner begins")
	# Boss / elite encounters get a dramatic intro banner (name + passive)
	# before the first round begins. Normal fights get a quick one only when
	# there is something to announce — a fight passive, a mutator, or a
	# faction wave schedule (the intro names the kingdom's engine, §15.2) —
	# so the threat is read before it fires; untagged vanilla skirmishes
	# still start instantly.
	# node_type was already captured above for the music branch — reuse it.
	# A NAMED ACTION gets a despatch to READ instead of a banner that flashes:
	# it states the ground, the order, the trophy and the toll, and waits for
	# the player to accept it. Nothing else needs the intro after that.
	if _sp_id != "":
		await _sp_show_despatch()
	elif node_type == "boss" or node_type == "elite":
		await _show_encounter_intro(node_type == "boss")
	elif _encounter_passive_desc != "" or has_mutator() or _wave_schedule_active \
			or _pursuit_tier() >= 1 or _encounter_preamble != "":
		await _show_encounter_intro(false, true)
	else:
		await _show_encounter_intro(false, true)
	_trace("intro banner done")
	# Awaited: _start_round paces its visible groups apart (see _round_beat), so
	# round 1 must be fully open before the opening muster runs against it.
	await _start_round()
	_trace("round 1 started")
	# THE OPENING MUSTER (2026-07-25) — the hold forms its line as a visible act
	# at the top of round 1 instead of being pre-seated by _place_starting_board.
	#
	# The ORDER here is load-bearing, both ways:
	#   * AFTER _start_round, because _start_round sweeps every body on the board
	#     to ready_to_swing. Mustering before that sweep would make the hold's
	#     opening line ready on round 1 while the player's own round-1 plays are
	#     still forming up — a free enemy clash the player cannot answer.
	#   * BEFORE the player can act, so round 1 is planned against a real board
	#     and a Charge body (which DOES reach the face on its arrival round) is
	#     met by a front line instead of an empty field.
	# TAKE THE FIELD (2026-07-27) — the PLAYER moves first. `_opening_muster_pending`
	# is deliberately left standing here: `_post_combat_sequence` calls
	# `_enemy_place_creatures`, which consumes it, so the hold forms up at the END
	# of round 1 instead of before the player may touch a card. That second path
	# already existed and was simply unreachable while this call always fired.
	#
	# WHY, measured. A round-by-round trace of the act-1 General (tools/
	# _probe_fighttrace.gd, orc_warband) showed the player opening against FOUR
	# bodies totalling 14 ATK holding 3 Command and an empty board — then, because
	# the muster delay stops an arrival swinging the round it lands, whatever they
	# played died before it could answer, leaving the board empty again on rounds
	# 3, 4 and 5 while the hold climbed to eight bodies. A run simulator
	# (tools/_probe_runsim.gd) won 0 of 15 runs at an average of 1.5 fights, and
	# −25% enemy HP, +50% player HP and threat-aware positioning each moved that by
	# ~0.1 — because none of them touch a fight that is decided before turn one.
	#
	# WHY THIS SHAPE. Slay the Spire — the model this game names — also opens with
	# the enemy line already on the board, but the PLAYER ACTS FIRST and the enemy
	# telegraphs; that ordering is treated as core to its strategic depth. Burning
	# Meadow had the pre-set board AND the enemy's first turn, which is strictly
	# harsher than the game it is modelled on.
	#
	# SAFE BY CONSTRUCTION, and the code already argued it (see
	# _place_starting_board): an empty enemy board on round 1 grants the player no
	# free face damage, because `can_attack()` refuses every body that arrived this
	# round and `_creature_hits_face` separately bars an arriving Swift from the
	# face. Round 1 stays a muster round for BOTH sides.
	_trace("take the field — player moves first; hold musters at end of round 1")
	# THE INITIATIVE (2026-07-30) — the one place moving first becomes a DECISION
	# rather than a gift. Generals and keeps only; ordinary holds fall straight
	# through and behave exactly as the block above describes.
	await _offer_initiative()


func _exit_tree() -> void:
	var supersample := get_node_or_null("/root/Supersample")
	if supersample != null:
		supersample.end_adaptive_scope(self)


func _sound_war_horn() -> void:
	# War Horn (redesigned 2026-07-03): the FIRST ATK-buff spell each fight
	# rallies the whole line (+1 ATK this round) instead of an invisible +1 on
	# the spell. Called from the buff_atk / buff_all_atk resolvers.
	if not _has_relic("war_horn") or _war_horn_blown_this_fight or _is_net():
		return
	_war_horn_blown_this_fight = true
	_relic_fired("war_horn")
	for c in _all_player_creatures():
		c.temp_atk_buff += 1
		c.update_stat_display()
	_show_info("WAR HORN — the whole line surges: +1 ATK this round!")


func _apply_conscription_muster() -> void:
	# Conscription (redesigned 2026-07-03): a 1/1 Conscript reports to the back
	# row at the start of every fight — a visible body instead of only the
	# invisible token-HP bonus (which the relic also keeps).
	if not _has_relic("conscription_relic") or _is_net():
		return
	_relic_fired("conscription_relic")
	summon_token(1, 1, _combat_ops.index(LANES_PER_ROW), false, ROW_BACK)
	_show_info("Conscription — a recruit reports for the fight.")


func _apply_gamblers_coin() -> void:
	if not _has_relic("gamblers_coin"):
		return
	# Either face of the flip is a real beat — the draw and the 3 damage both
	# arrive with no other cue naming the coin as the cause.
	_relic_fired("gamblers_coin")
	if _combat_ops.chance(0.5):
		draw_one()
	else:
		var enemies = _all_enemy_creatures()
		if enemies.size() > 0:
			_combat_ops.pick(enemies).take_damage(3)
		else:
			damage_enemy_hero(3)


func _apply_marked_one_gift() -> void:
	if _is_net():
		return   # campaign event payoff — never in skirmish
	# Consume both Marked One flags from RunState. The mana bonus is snapshot
	# to a local var that _start_round adds to max mana every round; the
	# creature is placed via summon_token (which auto-falls-through to the
	# back row if front-left is somehow occupied — e.g. encounter structure).
	_marked_one_mana_bonus = RunState.next_combat_mana_bonus
	RunState.next_combat_mana_bonus = 0
	var gift: Dictionary = RunState.next_combat_gift_creature
	RunState.next_combat_gift_creature = {}
	if not gift.is_empty():
		var atk: int = int(gift.get("atk", 2))
		var hp: int = int(gift.get("hp", 3))
		# The gift keeps its given name and any promised keywords (the Patent
		# Ladder's Armored, the Garrison Shade's Last Stand) — events that
		# advertise "(0/7, Armored)" deliver exactly that.
		summon_token(atk, hp, 0, false, ROW_FRONT, {},
			String(gift.get("name", "")), gift.get("kw", []))


func _apply_combat_start_relics() -> void:
	# Heads on Pikes: campaign routing becomes combat power. The strongest body
	# is the honest target; the cap keeps an elite-heavy road from trivializing.
	if _has_relic("heads_on_pikes") and RunState.generals_broken_run > 0:
		var pike_target: Control = null
		for enemy in _all_enemy_creatures():
			if pike_target == null or enemy.effective_atk() > pike_target.effective_atk():
				pike_target = enemy
		if pike_target != null:
			var fear: int = mini(3, RunState.generals_broken_run)
			pike_target.current_atk = maxi(0, pike_target.current_atk - fear)
			pike_target.update_stat_display()
			spawn_trigger_callout(_card_center(pike_target), "PIKES -%d ATK" % fear, false)
			_relic_fired("heads_on_pikes")
	# The Paymaster's Tally (set-piece trophy): the clerk finally pays somebody.
	# A flat purse every fight — the Fourth's back pay, drawn one march at a time.
	if _has_relic("paymasters_tally"):
		var tally_gold: int = int(RelicDB.get_relic("paymasters_tally").get("value", 12))
		RunState.gain_gold(tally_gold)
		_relic_fired("paymasters_tally")
		_show_info("Paymaster's Coin: gain %d gold." % tally_gold)
	# Bag of Marbles: 1 damage to every enemy on the field.
	if _has_relic("bag_of_marbles"):
		var dmg: int = int(RelicDB.get_relic("bag_of_marbles").get("value", 1))
		var marbles_hit := false
		for e in _all_enemy_creatures():
			e.take_damage(dmg)
			marbles_hit = true
		if marbles_hit:
			_relic_fired("bag_of_marbles")
	# Champion's Belt: turn-1-only ATK buff. The +1 is applied in
	# _effective_attack via _champions_belt_active; we just flip the latch.
	if _has_relic("champions_belt"):
		_champions_belt_active = true
	# War Drum: pull a random creature from the player's draw pile and place
	# it in lane 1 (front-left). If lane 1 is occupied, summon_token's
	# fall-through to back row covers it.
	if _has_relic("war_drum"):
		_war_drum_spawn()
	# Witch's Brew: cast a random spell from the run deck at no cost, with
	# auto-targeting via _auto_target_for (reused from Chaos Imp).
	if _has_relic("witchs_brew"):
		_witchs_brew_cast()
	# Mark of Pain: shuffle 2 curses into the draw pile at fight start.
	if _has_relic("mark_of_pain"):
		var n: int = int(RelicDB.get_relic("mark_of_pain").get("value", 1))
		for _i in 2:  # always 2 per the relic desc
			_player_draw_pile.append(_pile_entry(CardDB.random_curse_id(), _ephemeral_uid_counter))
			_ephemeral_uid_counter -= 1
		_combat_ops.shuffle(_player_draw_pile)
		# The two curses go into the PILE, so the player meets them rounds later
		# with nothing tying them to the relic. Name the cause at the moment
		# they are seeded.
		_relic_fired("mark_of_pain")
	# Toolbox: open a discover-style picker for 1 of 3 extra cards.
	if _has_relic("toolbox"):
		_relic_fired("toolbox")
		_show_discover("any", "")
	# Bottled Talisman: pull the player-bound card into the opening hand.
	if _has_relic("bottled_talisman"):
		_bottled_talisman_open()
	# Sellsword's Retainer: a fat purse hires muscle — 150+ gold fields a 3/3
	# Sellsword in the back row. His fee settles at victory (see the victory
	# block): 10 gold if he lives; the dead collect nothing.
	if _has_relic("sellswords_retainer") and not _is_net() \
			and RunState.gold >= int(RelicDB.get_relic("sellswords_retainer").get("value", 150)):
		for sw_lane in range(LANES_PER_ROW):
			if _player_back[sw_lane] == null:
				_relic_fired("sellswords_retainer")
				summon_token(3, 3, sw_lane, false, ROW_BACK, {}, "Sellsword")
				break


func _war_drum_spawn() -> void:
	# Pick a random creature from the run deck (not curses, not spells) and
	# spawn it as a token in lane 1 front. Falls through to back if occupied.
	var creature_ids: Array[String] = []
	for cid in RunState.deck:
		if CardDB.is_curse(cid):
			continue
		var d: Dictionary = CardDB.get_card_data(cid)
		if d.get("type", "") == "creature":
			creature_ids.append(cid)
	if creature_ids.is_empty():
		return
	var pick: String = String(_combat_ops.pick(creature_ids))
	var data: Dictionary = CardDB.get_card_data(pick)
	_relic_fired("war_drum")
	summon_token(int(data.get("atk", 1)), int(data.get("hp", 1)), 0, false, ROW_FRONT)


func _witchs_brew_cast() -> void:
	# Cast a random spell from the run deck at no cost, auto-targeted via the
	# same helper Chaos Imp uses. Skips curses + non-spell entries.
	var spell_ids: Array[String] = []
	for cid in RunState.deck:
		if CardDB.is_curse(cid):
			continue
		var d: Dictionary = CardDB.get_card_data(cid)
		if d.get("type", "") == "spell" and bool(_random_spell_context_for(d).get("ok", false)):
			spell_ids.append(cid)
	if spell_ids.is_empty():
		return
	var pick: String = String(_combat_ops.pick(spell_ids))
	var data: Dictionary = CardDB.get_card_data(pick)
	var cast_ctx: Dictionary = _random_spell_context_for(data)
	if not bool(cast_ctx.get("ok", false)):
		return
	var target: Control = cast_ctx.get("target", null)
	var tlane: int = int(cast_ctx.get("lane", -1))
	_relic_fired("witchs_brew")
	_show_info("Witch's Brew casts %s!" % data.get("name", "a spell"))
	_resolve_spell(data, target, tlane)


func _bottled_talisman_open() -> void:
	# Pull the card the player bound to Bottled Talisman into the opening hand.
	# Binding happens at acquire (Reward/Shop/Treasure) or via the MapView
	# catch-all; if somehow still unbound or the bound card was later removed
	# from the deck, skip silently.
	var uid: int = RunState.bottled_talisman_uid
	if uid < 0:
		return
	var idx: int = RunState.deck_uids.find(uid)
	if idx < 0:
		return
	# Remove the bound card's existing draw-pile entry (matched by uid) so it is
	# not BOTH pulled to the opening hand AND drawn again later as a duplicate
	# uid — _init_decks already seeded the full deck into the pile above.
	for i in _player_draw_pile.size():
		if _entry_uid(_player_draw_pile[i]) == uid:
			_player_draw_pile.remove_at(i)
			break
	_player_draw_pile.push_front(_pile_entry(RunState.deck[idx], uid))
	_relic_fired("bottled_talisman")
	draw_one()


func _prebake_hand_textures() -> void:
	# Headless guard: CardTextureCache.bake_many awaits RenderingServer.
	# frame_post_draw, which never fires under the dummy display server — so
	# _ready would park here forever in automated headless runs (probes/tests).
	# There is nothing to draw to headless, and uncached cards fall back to the
	# live layout path (visually identical), so skipping the bake only affects
	# off-screen test runs, never the real windowed game.
	if DisplayServer.get_name() == "headless":
		return
	# Build a unique-card list from _player_draw_pile (Array[String]) so we
	# bake each card identity once even if the deck has duplicates.
	var seen := {}
	var to_bake: Array = []
	for entry in _player_draw_pile:
		if seen.has(entry):
			continue
		seen[entry] = true
		to_bake.append(_resolve_card_data(_entry_id(entry), _entry_uid(entry)))
	await CardTextureCache.bake_many(to_bake)
	await CardTextureCache.bake_battlefield_many(to_bake)


func _prewarm_enemy_art() -> void:
	# First placement of an enemy creature otherwise does a synchronous disk read +
	# decode + mipmap of its art ON the gameplay frame it appears — the opening
	# formation and every reinforcement wave hitch as a result. Warm both the
	# source painting and the flattened compact background for every creature the
	# encounter deck + reinforcement can show before _place_enemy_card seats it.
	# Headless probes never render, so warming there is pure wasted I/O — skip it and
	# leave placement's existing lazy load unchanged.
	if DisplayServer.get_name() == "headless":
		return
	var roster: Array = _enemy_deck.duplicate()
	if not _reinforcement.is_empty():
		roster.append(_reinforcement)
	var to_warm: Array = []
	var seen := {}
	for cd in roster:
		if typeof(cd) != TYPE_DICTIONARY or cd.is_empty():
			continue
		var cid := String(cd.get("id", ""))
		if seen.has(cid):
			continue
		seen[cid] = true
		to_warm.append(cd)
	# Named MID-FIGHT spawns are the remaining decode hitch: fight-passive waves
	# ("Alpha Wolf"), amalgam transition summons ("Star-Reader"), reactive spawns,
	# and on-death bequests all synthesize card data on the fly, so their painting
	# would otherwise disk-load + decode on the very frame the creature appears.
	# Walk the encounter definition, the armed reactive passive, and each deck
	# card's nested effect dicts for anything name-shaped and warm those too.
	# Over-collecting is fine — misses are memoized as a few exists() probes.
	var names := {}
	_collect_spawn_names(EncounterDB.get_encounter(_encounter_id), names)
	_collect_spawn_names(_reactive_passive, names)
	for cd in roster:
		_collect_spawn_names(cd, names)
	for n in names:
		if not seen.has(n):
			seen[n] = true
			to_warm.append({"name": n, "type": "creature"})
	# ONE parallel decode wave for every painting the fight can show. This used
	# to be a serial `await` per creature — a full main-thread round trip each,
	# with the loader's worker pool mostly idle and the table still blank.
	var paths: Array[String] = []
	for cd in to_warm:
		var p := CardArtAliases.card_art_path(cd)
		if p != "":
			paths.append(p)
	if _encounter_id != "":
		var enc: Dictionary = EncounterDB.get_encounter(_encounter_id)
		var enc_type := String(enc.get("type", ""))
		if enc_type == "boss" or enc_type == "elite":
			paths.append("res://assets/portraits/boss_%s.png" % _encounter_id)
		if enc_type == "boss":
			paths.append(
				"res://assets/portraits/boss_act%d.png" % RunState.get_act())
	await CardArtAliases.prewarm_texture_paths(paths)
	# Bind each card to its resolved painting. Cache hits after the wave above,
	# so this loop no longer yields a frame per creature.
	for cd in to_warm:
		await CardArtAliases.prewarm_card_art(cd)
	# ONE batched pass for the flattened compact backgrounds. Baking these one at
	# a time cost two vsync frames plus a full GPU readback stall PER CREATURE —
	# the single biggest reason a fight sat on an empty table before opening.
	await CardTextureCache.bake_battlefield_many(to_warm)


## Recursively collect every "name"/"id" string inside nested dicts/arrays —
## the superset of identifiers a summon/wave/transition/bequest could resolve
## art with. Deliberately shape-agnostic so new encounter fields keep working.
func _collect_spawn_names(v, out: Dictionary) -> void:
	match typeof(v):
		TYPE_DICTIONARY:
			for k in v:
				var val = v[k]
				if (k == "name" or k == "id") and typeof(val) == TYPE_STRING \
						and val != "":
					out[val] = true
				else:
					_collect_spawn_names(val, out)
		TYPE_ARRAY:
			for item in v:
				_collect_spawn_names(item, out)


# =====================================================================
#  SETUP
# =====================================================================

# Per-act combat background swap. combat.tscn ships an Act 1 painting in its
# Background TextureRect; this rebinds the texture to act 2 / act 3 paintings
# when the player is deeper in the run. Falls back to whatever combat.tscn
# already had when an act-specific painting isn't on disk yet — so missing
# assets degrade gracefully instead of crashing or showing pink.
const COMBAT_BG_PATHS := {
	2: "res://assets/backgrounds/combat_arena_act2.png",
	3: "res://assets/backgrounds/combat_arena_act3.png",
}


## Skirmish must not inherit the act from the last campaign save. Every deck
## acquisition format shares this neutral visual context; campaign follows its
## live act.
func _combat_visual_act() -> int:
	return 1 if _is_net() else RunState.get_act()


func _swap_background_for_act() -> void:
	var act: int = _combat_visual_act()
	if not COMBAT_BG_PATHS.has(act):
		return  # Act 1 uses the .tscn default
	var path: String = COMBAT_BG_PATHS[act]
	if not ResourceLoader.exists(path):
		return
	# The backdrop node is "CombatBg" (see combat.tscn + the mood code, which
	# modulates "CombatBg"). This used to look up "Background" — a node that does
	# not exist — so it silently no-op'd and EVERY act kept the act-1 default red
	# burning-meadow hellscape. The cooler act-2 / act-3 backdrops never showed,
	# which made the whole game read as monochrome red.
	var bg := get_node_or_null("CombatBg") as TextureRect
	if bg == null:
		return
	bg.texture = load(path)


func _setup_fight_state() -> void:
	if _is_net():
		_setup_net_fight_state()
		return
	player_max_hp = RunState.hero_max_hp
	player_hp = RunState.hero_hp
	_starting_hp = player_hp
	_init_mutator_state()
	# A NAMED ACTION supplies its own board, deck, face HP and rule, so it
	# short-circuits the encounter branch entirely. The map generator already
	# refuses to deal a set-piece node a mutator (its GROUND is the one twisted
	# rule) — _init_mutator_state above still runs so the Daily March omen is
	# evaluated and correctly finds nothing to fill.
	if SetPieceDB.exists(RunState.current_setpiece_id):
		_sp_id = RunState.current_setpiece_id
		_sp_setup_fight_state()
		if _sp_id != "":
			return
	var enc_id = RunState.current_encounter_id
	if enc_id != "":
		var enc = EncounterDB.get_encounter(enc_id)
		if not enc.is_empty():
			_encounter_id = enc_id
			# Successor Wars: per-faction reinforcement wave schedules arm for
			# NORMAL holds only — elites/bosses/rival lords keep their kit
			# pacing (§15.2: true slow-burn belongs to strongholds and lords),
			# and untagged fights keep the legacy uniform drip exactly.
			_encounter_faction = String(enc.get("faction", ""))
			_wave_schedule_active = String(enc.get("type", "")) == "combat" \
				and FACTION_WAVE_SCHEDULES.has(_encounter_faction)
			# Successor Wars cross-act borrows: scale the fight to the map
			# slot it actually landed in (kingdoms pull their faction's
			# fights from other acts; demoted bosses fight at elite band).
			var t_act: int = RunState.get_act()
			var t_type: String = RunState.current_node_type \
				if RunState.current_node_type in ["combat", "elite", "boss"] else ""
			_siege_data = EncounterDB.get_siege(enc_id) if t_type == "boss" else {}
			_siege_active = not _siege_data.is_empty()
			var face_hp: int = EncounterDB.get_siege_face_hp(enc_id, t_act, t_type) \
				if _siege_active else EncounterDB.get_face_hp(enc_id, t_act, t_type)
			enemy_max_hp = _scale_enemy_hp(face_hp, t_type)
			_encounter_passive = enc.get("passive_id", "")
			_encounter_name = enc.get("name", "")
			_encounter_passive_desc = enc.get("passive_desc", "")
			_encounter_preamble = enc.get("preamble", "")
			if _siege_active:
				_siege_saved_passive = _encounter_passive
				_siege_saved_passive_desc = _encounter_passive_desc
				_encounter_passive = ""
				_encounter_passive_desc = String(_siege_data.get("rule", ""))
			_enemy_deck = EncounterDB.build_enemy_deck(enc_id, t_act)
			_combat_ops.shuffle(_enemy_deck)
			# VANGUARD: an entry flagged `vanguard` is pulled back to the front
			# AFTER the shuffle, so an encounter can guarantee its centrepiece is
			# fielded from round one. The Old King's Body REQUIRES this — the foe's
			# face takes nothing, so a shuffle that buries the Body leaves the
			# player with no legal way to deal damage at all. Authored order among
			# multiple vanguards is preserved.
			var _van: Array[Dictionary] = []
			var _rest: Array[Dictionary] = []
			for _e in _enemy_deck:
				if bool(_e.get("vanguard", false)):
					_van.append(_e)
				else:
					_rest.append(_e)
			if not _van.is_empty():
				_enemy_deck = _van
				_enemy_deck.append_array(_rest)
			_reinforcement = EncounterDB.get_reinforcement(enc_id, t_act)
			_boss_phases = EncounterDB.get_boss_phases(enc_id, RunState.rival_lords)
			# A throne fight is authored by THIS run's conquests. Phase zero is
			# already in force when combat opens, so replace the finale kit's
			# legacy default rule with the first defeated kingdom's rule.
			if enc_id.begins_with("amalgam_") and not _boss_phases.is_empty():
				var first_phase: Dictionary = _boss_phases[0]
				_encounter_passive = String(first_phase.get("passive_id", ""))
				_encounter_passive_desc = String(first_phase.get("passive_desc", ""))
				var history_names: Array[String] = []
				for history_phase in _boss_phases:
					var source_id := String(history_phase.get("source_rival", ""))
					if source_id == "":
						continue
					var source_data: Dictionary = HeroDB.get_hero(source_id)
					history_names.append(String(source_data.get(
						"name", source_id.capitalize())))
				if history_names.size() == 3:
					_encounter_preamble = (
						"The throne answers in the order the kingdoms fell: %s, then %s, then %s."
						% [history_names[0], history_names[1], history_names[2]])
			# Phase thresholds are authored against the kit's own face HP —
			# rescale by the act ratio so a lord fought in act 3 still turns
			# phases at the same point in the bar. (Ascension deliberately
			# does NOT rescale thresholds; that drift is live behavior.)
			# Duplicate first: get_boss_phases returns the const array.
			# ...and by the GLOBAL enemy-HP dial for the same reason. Thresholds are
			# absolute HP numbers authored against the printed kit value, so any
			# dial below 1.0 slides the lord's whole bar underneath them: at 0.60
			# the Stalwart opened at 11 HP against a threshold of 11 and turned
			# phase 2 before the player had acted, silently replacing his posted
			# rule. Ascension is deliberately still EXCLUDED here — A5's +25% on
			# keeps delaying phases, which is long-standing intended drift.
			var base_hp: int = int(enc.hp)
			var act_scaled_hp: int = face_hp
			if base_hp > 0 and not _boss_phases.is_empty():
				_boss_phases = _boss_phases.duplicate(true)
				for ph in _boss_phases:
					ph.threshold = int(round(float(ph.threshold)
						* float(act_scaled_hp) / float(base_hp) * ENEMY_HP_SCALE))
			_reactive_passive = EncounterDB.get_reactive_passive(enc_id)
			_encounter_script = EncounterDB.get_encounter_script(enc_id)
			enemy_hp = enemy_max_hp
			return
	var act = RunState.get_act()
	var node_type = RunState.current_node_type
	match node_type:
		"combat":
			enemy_max_hp = _scale_enemy_hp([12, 17, 21][act - 1] + _combat_ops.rangei(0, 3), "combat")
		"elite":
			enemy_max_hp = _scale_enemy_hp([18, 26, 30][act - 1] + _combat_ops.rangei(0, 3), "elite")
		"boss":
			enemy_max_hp = _scale_enemy_hp([25, 32, 40][act - 1], "boss")
	_build_legacy_enemy_deck(act)
	enemy_hp = enemy_max_hp


func _scale_enemy_hp(base: int, fight_type: String = "") -> int:
	# Global enemy-HP tuning. Was +20% (2026-06) → 0.90 → 0.60 on 2026-07-27:
	# the owner's "reduce the enemy health like x2 at least", applied as exactly
	# half the ORIGINAL effective value (1.20 → 0.60).
	#
	# The first attempt at this cut was measurably INERT — an A/B over 15 seeded
	# runs moved the result by nothing — because the lord's health was not what
	# killed runs. It only became a live lever once TAKE THE FIELD and the
	# open-lane rule made the face REACHABLE at all; before them a fight trace had
	# the foe's health moving 16 → 14 across nine rounds. Order of operations
	# mattered more than the number: fix reachability, then tune.
	#
	# Calibration: with the deliberately weak run-sim bot (never banks Command,
	# never sequences, drafts by cost) the losing fight removed 36% of the foe's
	# health at 0.90. Halving puts that near 54%; a competent human plays well
	# clear of that. Tuning until THIS bot wins would make the game trivial for a
	# person — see the note at the foot of tools/_probe_runsim.gd.
	# A run simulation (tools/_probe_runsim.gd, the first harness to measure under
	# real run conditions — carried HP, growing deck, correct act scaling) won
	# 0 of 10 runs and averaged 1.4 fights survived out of 21, with every death in
	# act 1 and the player always dying at 0 HP rather than failing to kill. Face
	# HP is the fight's LENGTH, and length is what kills here: every extra round
	# is another tick of uncounterable passive damage and another reinforcement.
	# Shortening fights is the same lever that answers "too much happens at once".
	var scaled: float = base * ENEMY_HP_SCALE
	# Ascension no longer sponges every face (see RunState.ASCENSION_RULES).
	# Only A5 "Kings at bay" touches HP, and only at the lords' keeps (stacks
	# on top of the global bump).
	if RunState.asc_active(5) and fight_type == "boss":
		scaled *= 1.25
	return int(round(scaled))


func _esc_round(base: int) -> int:
	# A1 "Pressed marches" — every escalation beat lands one round earlier.
	return base - 1 if RunState.asc_active(1) else base


func _fight_class() -> String:
	# "combat" / "elite" / "boss" — prefers the encounter's own type, falls back
	# to the map node type for legacy random fights.
	if _encounter_id != "":
		return String(EncounterDB.get_encounter(_encounter_id).get("type", "combat"))
	return String(RunState.current_node_type) if RunState.current_node_type != "" else "combat"


func _build_legacy_enemy_deck(act: int) -> void:
	for i in range(8):
		var eid = CardDB.random_enemy_for_act(act)
		_enemy_deck.append(CardDB.get_card_data(eid))


func _setup_net_fight_state() -> void:
	## Skirmish fight setup (docs/MULTIPLAYER_SKIRMISH_PLAN.md §12.1-12.2). The
	## "enemy" is the remote player, not an EncounterDB lineup — so there is no
	## encounter, no AI deck, no passive/boss/reactive machinery, and no enemy
	## reinforcement drip (the opponent supplies their own board via intents).
	## Both heroes start at SkirmishState.START_HP in v1.
	player_max_hp = _ctx_hero_max_hp()
	player_hp = _ctx_hero_hp()
	_starting_hp = player_hp
	_init_mutator_state()              # clears to empty in net mode
	enemy_max_hp = SkirmishState.START_HP
	enemy_hp = enemy_max_hp
	_encounter_id = ""
	_encounter_faction = ""
	_wave_schedule_active = false
	_encounter_passive = ""
	# Title the fight with the OPPONENT'S lord — both players picked a character
	# in the lobby, so "Skirmish" would waste the marquee. Reads like a boss
	# surface: name · lord title (e.g. "Raider · The Landless Brother").
	var foe_hero := HeroDB.get_hero(_foe_hero_id())
	var foe_faction: Dictionary = HeroDB.faction_info(String(foe_hero.get("faction", "")))
	_encounter_name = "%s · %s" % [String(foe_hero.get("name", "Rival Lord")),
		String(foe_faction.get("lord_title", "Rival Lord"))]
	_encounter_passive_desc = ""
	_encounter_preamble = ""
	_enemy_deck = []                   # remote-driven; never AI-dealt
	_reinforcement = {}
	_boss_phases = []
	_reactive_passive = {}
	_encounter_script = []


## The lord the LOCAL player marches as: the lobby pick in skirmish (synced to
## the opponent), the campaign hero in solo. Cosmetic identity only — it drives
## the plate portrait and the emote voice, never rules.
func _my_hero_id() -> String:
	if _is_net():
		return SkirmishState.hero_for(SkirmishState.local_index)
	return RunState.current_hero_id


## The opposing lord's hero id — skirmish only ("" in solo, where the foe is an
## EncounterDB lineup, not a lord).
func _foe_hero_id() -> String:
	if _is_net():
		return SkirmishState.hero_for(1 - SkirmishState.local_index)
	return ""


# =====================================================================
#  4x4 FIELD HELPERS — single source of truth for row/column access.
# =====================================================================

func _row_array(is_enemy: bool, row: int) -> Array:
	# Returns the underlying array reference for a given side+row.
	if is_enemy:
		return _enemy_back if row == ROW_BACK else _enemy_field
	return _player_back if row == ROW_BACK else _player_field


func _slot_array(is_enemy: bool, row: int) -> Array:
	if is_enemy:
		return _enemy_back_slots if row == ROW_BACK else _enemy_slots
	return _player_back_slots if row == ROW_BACK else _player_slots


func _all_friendly(is_enemy: bool) -> Array:
	# Flat list (non-null) of every creature on a side, both rows.
	var out: Array = []
	for c in _row_array(is_enemy, ROW_FRONT):
		if c != null:
			out.append(c)
	for c in _row_array(is_enemy, ROW_BACK):
		if c != null:
			out.append(c)
	return out


func _all_player_creatures() -> Array:
	return _all_friendly(false)


func _all_enemy_creatures() -> Array:
	return _all_friendly(true)


func _all_creatures_both_sides() -> Array:
	return _all_player_creatures() + _all_enemy_creatures()


func _has_adjacent_royal_guard(defender: Control) -> bool:
	# Royal Guard's passive grants -1 dmg to friendly creatures in its
	# canonical-adjacent seats (row ±1 + column-mate). Returns true if such
	# a Royal Guard exists for `defender`'s position.
	var pos = _find_creature_position(defender)
	if pos.is_empty():
		return false
	for neighbor in _adjacent_creatures(pos.is_enemy, pos.row, pos.lane):
		if neighbor != defender \
				and neighbor.card_data.get("passive", "") == "royal_guard" \
				and neighbor.current_hp > 0:
			return true
	return false


## Canonical creature-strike reduction. Every attack mode uses this before
## damage lands so zero-ATK bodies stay at zero and defensive rules do not drift.
func _creature_strike_amount(defender: Control, raw_amount: int,
		attacker_is_enemy: bool) -> int:
	var amount := maxi(0, raw_amount)
	if amount <= 0:
		return 0
	if _has_adjacent_royal_guard(defender):
		amount = maxi(1, amount - 1)
	# The Archlich's line may be wounded by creatures, but not killed by them.
	if _encounter_passive == "archlich_immortal" and not attacker_is_enemy:
		amount = mini(amount, maxi(0, defender.current_hp - 1))
	return amount


## The one sink for damage caused by a creature strike. The scoped flag is the
## whitelist used by effect-immune bodies; return only HP actually removed so a
## Shielded hit cannot trigger Poison or over-heal Lifesteal.
func _deal_creature_strike_damage(defender: Control, amount: int) -> int:
	if defender == null or not is_instance_valid(defender) or amount <= 0:
		return 0
	var hp_before: int = defender.current_hp
	Card2D.strike_damage_active = true
	defender.take_damage(amount)
	Card2D.strike_damage_active = false
	if not is_instance_valid(defender):
		return hp_before
	var dealt: int = maxi(0, hp_before - maxi(defender.current_hp, 0))
	# THE ONE OWNER OF A CREATURE STRIKE'S SCREEN SHAKE (2026-07-30).
	#
	# It used to be two owners for one event: Card2D.take_damage called
	# creature_hit_feedback (magnitude scaled by the blow, capped 6.5) AND the
	# clash sites fired their own screen_shake(6.0) on a kill / (4.0) on a heavy.
	# Both scale with the same proposition, and both are admitted into the same
	# trauma reservoir — a 6-damage kill asked for 0.60 + 0.577 = 1.18 trauma,
	# clamped to 1.0, i.e. the maximum shake in the game on a mid-round trade,
	# indistinguishable from a boss death. The bug was never accumulation across
	# blows; it was counting ONE blow twice.
	#
	# Keyed on damage ACTUALLY DEALT, which also retires a quieter version of the
	# same defect: a warded or shielded hit used to rock the screen for damage that
	# never landed on anything.
	var mag: float = clampf(0.9 + float(dealt) * 0.95, 1.6, 6.5)
	if defender.current_hp <= 0:
		mag = maxf(mag, 8.0)      # a kill is its own event class, however small the blow
	elif dealt >= HEAVY_HIT_DAMAGE:
		mag = maxf(mag, 6.5)
	if dealt > 0:
		screen_shake(mag)
	return dealt


func _apply_creature_strike_poison(attacker: Control, defender: Control,
		attacker_is_enemy: bool, damage_dealt: int) -> bool:
	if _is_fortification(defender):
		return false
	if damage_dealt <= 0 or attacker == null or defender == null \
			or not is_instance_valid(attacker) or not is_instance_valid(defender) \
			or defender.current_hp <= 0:
		return false
	if not attacker.has_keyword("poison") \
			and not _virulence_active[1 if attacker_is_enemy else 0]:
		return false
	defender.current_hp = 0
	defender.update_stat_display()
	spawn_keyword_callout_kw(defender, "poison")
	if not Card2D.defer_deaths:
		defender.try_die()
	return true


## Royal Guard / Berserker "grows when hit". `strike_amount` is HP THE DEFENDER
## ACTUALLY LOST — the return of `_deal_creature_strike_damage`, never the raw blow.
##
## 2026-07-30: every one of the six call sites passed the raw blow instead, so a
## defender that took NOTHING still grew: an Oathbound Squire's ward moves the hit
## to another body, and a Shield eats it whole, but `atk` is still > 0 on this side
## of the call. The board then showed a Royal Guard gaining +1 ATK while the damage
## numeral sat on a different card. The early-return below was always the author's
## intent ("no damage, no growth") — it was simply being handed a number that could
## not express "no damage". Armored reductions ride this correctly for free.
func _apply_creature_struck_growth(defender: Control, strike_amount: int) -> void:
	if strike_amount <= 0 or defender == null or not is_instance_valid(defender) \
			or defender.current_hp <= 0:
		return
	match String(defender.card_data.get("passive", "")):
		"royal_guard":
			var gain: int = 2 if bool(
				defender.card_data.get("is_upgraded", false)) else 1
			defender.current_atk += gain
			defender.update_stat_display()
		"rage_on_hit":
			var gain: int = 3 if bool(
				defender.card_data.get("is_upgraded", false)) else 2
			defender.current_atk += gain
			defender.update_stat_display()


func _find_creature_position(card: Control) -> Dictionary:
	# Returns {is_enemy, row, lane} or {} if not on board.
	for is_enemy in [false, true]:
		for row in [ROW_FRONT, ROW_BACK]:
			var arr = _row_array(is_enemy, row)
			for lane in range(LANES_PER_ROW):
				if arr[lane] == card:
					return {"is_enemy": is_enemy, "row": row, "lane": lane}
	return {}


func _get_creature_in_column(is_enemy: bool, lane: int) -> Control:
	# Returns front-row creature if alive, else back-row creature, else null.
	# Guards against (and scrubs) a stale FREED reference left in a slot — a
	# back-row creature can die without its slot being nulled on every path, and
	# returning the freed instance crashes callers like get_opposing_card.
	var front = _row_array(is_enemy, ROW_FRONT)
	if front[lane] != null:
		if is_instance_valid(front[lane]):
			return front[lane]
		front[lane] = null
	var back = _row_array(is_enemy, ROW_BACK)
	if back[lane] != null:
		if is_instance_valid(back[lane]):
			return back[lane]
		back[lane] = null
	return null


func _relocate_creature(card: Control, side_is_enemy: bool, dest_row: int, dest_lane: int,
		trigger_lane_change: bool = true) -> bool:
	if _is_fortification(card):
		return false
	# Move an on-board creature to an empty slot on its OWN side (board-
	# manipulation verbs: Shove pushes an enemy front→back, Hook pulls back→
	# front). Mirrors the proven reposition sequence in _on_field_move_dropped:
	# clear the source array cell, update the card's row/lane, re-slot the visual
	# node, and write the destination cell. Returns false (no-op) if the card is
	# invalid, the destination is out of range, occupied, or the same slot.
	if not is_instance_valid(card):
		return false
	if dest_lane < 0 or dest_lane >= LANES_PER_ROW:
		return false
	if _sp_lane_closed(dest_lane) \
			or _row_array(side_is_enemy, dest_row)[dest_lane] != null:
		return false
	var src_row: int = card.current_row
	var src_lane: int = card.current_lane
	if src_row == dest_row and src_lane == dest_lane:
		return false
	_row_array(side_is_enemy, src_row)[src_lane] = null
	# Detach the card from its SOURCE cell (+ hide that slot's contact shadow) before
	# re-slotting. _slot_set_card clears only the DESTINATION cell, so without this
	# detach `cell.add_child(card)` fails ("already has a parent") and the visual node
	# stays stuck in the old slot while the board array points to the new one — the
	# real "mirrors _on_field_move_dropped" step (it calls _reset_card_after_drag too).
	var src_slot: Control = _slot_array(side_is_enemy, src_row)[src_lane]
	if src_slot != null:
		var sh = src_slot.get_node_or_null("ContactShadow")
		if sh != null:
			sh.visible = false
	card.current_row = dest_row
	card.current_lane = dest_lane
	_reset_card_after_drag(card)
	_slot_set_card(_slot_array(side_is_enemy, dest_row)[dest_lane], card)
	_row_array(side_is_enemy, dest_row)[dest_lane] = card
	_play_landing_pop(card)
	if trigger_lane_change:
		_dispatch_creature_relocated(card, src_row, src_lane)
	return true

## One successful relocation funnel for both row and column moves. Column-only
## passives keep their old hook; starter signatures can react to either kind.
func _dispatch_creature_relocated(card: Control, old_row: int, old_lane: int) -> void:
	if card == null or not is_instance_valid(card) or card.current_hp <= 0:
		return
	var pos := _find_creature_position(card)
	if pos.is_empty() or (old_row == int(pos.row) and old_lane == int(pos.lane)):
		return
	var owner_is_enemy: bool = bool(pos.is_enemy)
	# "Moved" must mean MOVED (2026-07-28). The enemy latch used to count COLUMN
	# changes only, so every front<->back push in the game (Shove, Earthquake,
	# Scatter the Line, Sapper's Charge, Hook and Chain) relocated a body without
	# a single card being able to notice it had happened.
	var moved_lane: bool = old_lane != int(pos.lane)
	var moved_row: bool = old_row != int(pos.row)
	if not _is_net() and owner_is_enemy and (moved_lane or moved_row):
		_enemy_changed_columns_this_round[card.get_instance_id()] = true
	if not _is_net() and not owner_is_enemy:
		# Cut Them Off's clause. The Grasswake's own mobility is what arms its
		# bolt — see the declaration comment on this latch.
		_player_moved_a_friendly_this_round = true
	if not _is_net() and not owner_is_enemy and _has_relic("marching_spurs") \
			and not _marching_spurs_used_this_round:
		_marching_spurs_used_this_round = true
		_grant_starter_temp_swift(card, 1, "MARCHING SPURS")
		_relic_fired("marching_spurs")
	if moved_lane:
		await _dispatch_lane_changed(card, old_lane)


func _grant_starter_temp_swift(card: Control, atk_gain: int, label: String) -> void:
	if card == null or not is_instance_valid(card) or card.current_hp <= 0:
		return
	card.temp_atk_buff += atk_gain
	card.state.war_cry_swift = true
	card.update_stat_display()
	spawn_keyword_callout_kw(card, "granted_swift")
	spawn_floating_number(_card_center(card) + Vector2(0, -14),
		"%s +%d" % [label, atk_gain], Color(1.0, 0.72, 0.36), false)


## THE ONE reading of "a surviving friendly in this column" (2026-07-28). Two
## things say it — Burial Goods' on_death bequest (starter_buff_column_ally) and
## the Ledger Seal relic — and they must not drift, so both call this.
##
## Front seat first, then the back (the _get_creature_in_column convention).
## "This fight" = current_atk + card_data.hp + current_hp, the permanent
## convention every other bequest uses (see buff_in_front / swell_on_ally_death);
## writing current_hp WITHOUT card_data.hp is silently erased by the next heal,
## since every heal caps at card_data.hp.
##
## `precaptured` exists for ORDERING: a relic that fires late in the death chain
## must be able to name the body that stood in the column BEFORE anything else in
## that chain summoned into it — otherwise the Ledger Seal buffs a token that
## arrived a microsecond ago. Pass the occupant sampled at the top of the chain;
## it is used only while still valid and alive, else the search runs.
## Returns the buffed body, or null when the column emptied.
func _buff_column_survivor(is_enemy: bool, lane: int, exclude: Control,
		atk_gain: int, hp_gain: int, precaptured: Control = null) -> Control:
	if lane < 0 or lane >= LANES_PER_ROW:
		return null
	var heir: Control = null
	if precaptured != null and is_instance_valid(precaptured) \
			and precaptured != exclude and precaptured.current_hp > 0:
		heir = precaptured
	else:
		for row in [ROW_FRONT, ROW_BACK]:
			var c = _row_array(is_enemy, row)[lane]
			if c == null or not is_instance_valid(c) or c == exclude or c.current_hp <= 0:
				continue
			heir = c
			break
	if heir == null:
		return null
	heir.current_atk += atk_gain
	heir.card_data["hp"] = int(heir.card_data.get("hp", heir.current_hp)) + hp_gain
	heir.current_hp += hp_gain
	heir.update_stat_display()
	var bequest_text := "+%d/+%d" % [atk_gain, hp_gain]
	spawn_floating_number(_card_center(heir) + Vector2(0, -14),
		bequest_text, Color(1.0, 0.62, 0.20), false)
	_net_fx_text(heir, bequest_text, Color(1.0, 0.62, 0.20))
	return heir



## Shared lateral-move hook. Any successful change of COLUMN routes through
## here; changing only front/back row is not a lane change.
func _dispatch_lane_changed(card: Control, old_lane: int) -> void:
	if card == null or not is_instance_valid(card) or card.current_hp <= 0:
		return
	if old_lane == card.current_lane:
		return
	var pos := _find_creature_position(card)
	if pos.is_empty():
		return
	var owner_is_enemy: bool = bool(pos.is_enemy)
	var facing = _get_creature_in_column(not owner_is_enemy, int(pos.lane))
	match String(card.card_data.get("passive", "")):
		"wheeling_lancer":
			if facing != null and is_instance_valid(facing) and facing.current_hp > 0:
				spawn_trigger_callout(_card_center(card) + Vector2(0, -14),
					"WHEELING STRIKE", false, int(card.entity_id))
				await _ordered_strike(card, facing, 0)
		"rolling_tower":
			if facing != null and is_instance_valid(facing) and facing.current_hp > 0:
				var tower_dmg: int = 4 if bool(card.card_data.get("is_upgraded", false)) else 3
				spawn_trigger_callout(_card_center(card) + Vector2(0, -14),
					"ROLLING TOWER %d" % tower_dmg, false, int(card.entity_id))
				facing.take_damage(tower_dmg)
				_cleanup_dead()


## A card-ordered extra strike uses the full combat strike pipeline (Thorns,
## Lifesteal, Rampage and veterancy), but does not consume the creature's normal
## clash attack. `bonus` is temporary for this single blow.
func _ordered_strike(attacker: Control, defender: Control, bonus: int = 0) -> void:
	if attacker == null or defender == null \
			or not is_instance_valid(attacker) or not is_instance_valid(defender) \
			or attacker.current_hp <= 0 or defender.current_hp <= 0:
		return
	var spent_before: bool = attacker.has_attacked_this_turn
	if bonus != 0:
		attacker.temp_atk_buff += bonus
		attacker.update_stat_display()
	await _creature_attacks_creature(attacker, defender, attacker.current_lane,
		bool(_find_creature_position(attacker).get("is_enemy", attacker.is_opponent)))
	if is_instance_valid(attacker):
		if bonus != 0:
			attacker.temp_atk_buff -= bonus
			attacker.update_stat_display()
		attacker.has_attacked_this_turn = spent_before
	_cleanup_dead()


func _ordered_face_strike(attacker: Control, bonus: int = 0) -> void:
	if attacker == null or not is_instance_valid(attacker) or attacker.current_hp <= 0:
		return
	var spent_before: bool = attacker.has_attacked_this_turn
	if bonus != 0:
		attacker.temp_atk_buff += bonus
		attacker.update_stat_display()
	var pos := _find_creature_position(attacker)
	if not pos.is_empty():
		await _creature_hits_face(attacker, int(pos.lane), bool(pos.is_enemy),
			true, false)
	if is_instance_valid(attacker):
		if bonus != 0:
			attacker.temp_atk_buff -= bonus
			attacker.update_stat_display()
		attacker.has_attacked_this_turn = spent_before


func _swap_creature_positions(a: Control, b: Control) -> bool:
	if _is_fortification(a) or _is_fortification(b):
		return false
	if a == null or b == null or a == b \
			or not is_instance_valid(a) or not is_instance_valid(b):
		return false
	var pa := _find_creature_position(a)
	var pb := _find_creature_position(b)
	if pa.is_empty() or pb.is_empty() or pa.is_enemy != pb.is_enemy:
		return false
	var owner_is_enemy: bool = bool(pa.is_enemy)
	_slot_take_card(_slot_array(owner_is_enemy, int(pa.row))[int(pa.lane)], a)
	_slot_take_card(_slot_array(owner_is_enemy, int(pb.row))[int(pb.lane)], b)
	_row_array(owner_is_enemy, int(pa.row))[int(pa.lane)] = b
	_row_array(owner_is_enemy, int(pb.row))[int(pb.lane)] = a
	a.current_row = int(pb.row)
	a.current_lane = int(pb.lane)
	b.current_row = int(pa.row)
	b.current_lane = int(pa.lane)
	_slot_set_card(_slot_array(owner_is_enemy, a.current_row)[a.current_lane], a)
	_slot_set_card(_slot_array(owner_is_enemy, b.current_row)[b.current_lane], b)
	_play_landing_pop(a)
	_play_landing_pop(b)
	_refresh_adjacency_buffs()
	_dispatch_creature_relocated(a, int(pa.row), int(pa.lane))
	_dispatch_creature_relocated(b, int(pb.row), int(pb.lane))
	return true


func _wheel_side_right(owner_is_enemy: bool, forged_drill: bool) -> void:
	var moved: Array = []
	for row in [ROW_FRONT, ROW_BACK]:
		for lane in range(LANES_PER_ROW):
			var c = _row_array(owner_is_enemy, row)[lane]
			if c != null and is_instance_valid(c):
				if _is_fortification(c):
					# Fixed terrain prevents an all-side formation wheel.
					return
				moved.append({"card": c, "row": row, "lane": lane})
	if moved.is_empty():
		return
	# Detach every body first: a full row rotates into occupied seats, so this
	# must be atomic rather than four ordinary relocate calls.
	for rec in moved:
		_slot_take_card(_slot_array(owner_is_enemy, int(rec.row))[int(rec.lane)], rec.card)
	for row in [ROW_FRONT, ROW_BACK]:
		for lane in range(LANES_PER_ROW):
			_row_array(owner_is_enemy, row)[lane] = null
	for rec in moved:
		var c: Control = rec.card
		var new_lane: int = (int(rec.lane) + 1) % LANES_PER_ROW
		c.current_lane = new_lane
		c.current_row = int(rec.row)
		_row_array(owner_is_enemy, c.current_row)[new_lane] = c
		_slot_set_card(_slot_array(owner_is_enemy, c.current_row)[new_lane], c)
		_play_landing_pop(c)
		if forged_drill:
			c.temp_atk_buff += 1
			c.update_stat_display()
	_refresh_adjacency_buffs()
	# Payoffs fire after every body is seated, so "now facing" sees the final
	# rotated line rather than a half-built intermediate board.
	for rec in moved:
		var c: Control = rec.card
		if is_instance_valid(c):
			await _dispatch_creature_relocated(c, int(rec.row), int(rec.lane))


func _flank_push(card: Control, crash_dmg: int, dir_override: int = 0) -> Dictionary:
	# Into-the-Breach lateral push (2026-07-09 removal slate): shove `card` one
	# lane sideways in its own row. Direction defaults to the NEAREST FLANK
	# (lanes 0-1 go left, lanes 2-3 go right); dir_override (-1/+1) forces it
	# (Sapper's Charge blasts outward from the bomb, not flank-relative).
	# Empty destination → the creature slides over. Blocked by the field's edge
	# or another body → no move, and the crash deals crash_dmg to the pushed
	# creature AND the blocker. Structures are bolted down: they never move,
	# never take crash damage, but DO block (the pushed body eats the crash).
	# Side-agnostic (reads the card's own position), so the net resolver can
	# call it directly. Returns {moved, crashed, blocker}.
	var out := {"moved": false, "crashed": false, "blocker": null}
	if not is_instance_valid(card) or card.current_hp <= 0:
		return out
	if _is_fortification(card):
		return out
	if card.has_keyword("structure"):
		return out
	# Effect-immune (The Old King's Body): a push is an effect, so it does not
	# budge — and like a structure it still BLOCKS, so a body shoved into it
	# crashes. Bolted down by holiness rather than by carpentry.
	if _is_effect_immune(card):
		return out
	var pos: Dictionary = _find_creature_position(card)
	if pos.is_empty():
		return out
	var dir: int = dir_override
	if dir == 0:
		dir = -1 if int(pos.lane) <= 1 else 1
	var dest: int = int(pos.lane) + dir
	if dest < 0 or dest >= LANES_PER_ROW:
		# Crushed against the field's edge.
		out.crashed = true
		if crash_dmg > 0:
			card.take_damage(crash_dmg)
		return out
	var blocker = _row_array(bool(pos.is_enemy), int(pos.row))[dest]
	if blocker == null:
		out.moved = _relocate_creature(card, bool(pos.is_enemy), int(pos.row), dest)
		if out.moved:
			spawn_floating_number(card.global_position \
				+ Vector2(card.size.x * card.scale.x * 0.5, -10),
				"SHOVED", Color(0.75, 0.85, 1.0), false)
		return out
	out.crashed = true
	out.blocker = blocker
	if crash_dmg > 0:
		card.take_damage(crash_dmg)
		if is_instance_valid(blocker) and blocker.current_hp > 0 \
				and not blocker.has_keyword("structure"):
			blocker.take_damage(crash_dmg)
	return out


func _adjacent_in_row(is_enemy: bool, row: int, lane: int) -> Array:
	# Returns alive same-row creatures at lane ±1.
	var arr = _row_array(is_enemy, row)
	var out: Array = []
	for adj in [lane - 1, lane + 1]:
		if adj >= 0 and adj < LANES_PER_ROW and arr[adj] != null:
			out.append(arr[adj])
	return out


func _adjacent_creatures(is_enemy: bool, row: int, lane: int) -> Array:
	## THE canonical "adjacent" (2026-07-10): same-row lane ±1 PLUS the column-mate
	## in the other row of the same lane. Every effect whose card text says
	## "adjacent" resolves through this — the old row-only and either-row-±1
	## readings are retired. Row-flavored mechanics that say "beside" / push along
	## the line (Formation, the Stalwart drill, flank physics) stay _adjacent_in_row.
	var out: Array = _adjacent_in_row(is_enemy, row, lane)
	var other_row: int = ROW_BACK if row == ROW_FRONT else ROW_FRONT
	var mate = _row_array(is_enemy, other_row)[lane]
	if mate != null and is_instance_valid(mate):
		out.append(mate)
	# Diagonal Crest (player relic): "Diagonal friendlies count as adjacent." Widen
	# the set with the two diagonal seats (other row, lane ±1) so EVERY adjacency verb
	# — Sprite / Crystal Sentry / Glutton / Royal Guard / adj_buff — honours the relic,
	# not just the linked-banner density counter. Player side only (the relic is the
	# player's) and net-inert (diagonal_crest isn't in NET_RELIC_POOL → _has_relic is
	# false in skirmish, so both peers still read the plain row+column set).
	if not is_enemy and _has_relic("diagonal_crest"):
		var diag_arr = _row_array(is_enemy, other_row)
		for dl in [lane - 1, lane + 1]:
			if dl >= 0 and dl < LANES_PER_ROW:
				var diag = diag_arr[dl]
				if diag != null and is_instance_valid(diag) and diag not in out:
					out.append(diag)
	return out


func _adjacent_empty_seats(is_enemy: bool, row: int, lane: int) -> Array:
	## Canonical-adjacent EMPTY seats as {row, lane} dicts — same-row ±1 first,
	## then the column-mate seat. The placement twin of _adjacent_creatures.
	var seats: Array = []
	var arr = _row_array(is_enemy, row)
	for adj in [lane - 1, lane + 1]:
		if adj >= 0 and adj < LANES_PER_ROW and arr[adj] == null:
			seats.append({"row": row, "lane": adj})
	var other: int = ROW_BACK if row == ROW_FRONT else ROW_FRONT
	if _row_array(is_enemy, other)[lane] == null:
		seats.append({"row": other, "lane": lane})
	return seats


# ── Draw/discard pile entries ──
# Pile entries are "<card_id>#<deck_uid>" so each entry carries which copy in
# RunState.deck it came from. That lets _draw_card resolve per-copy upgrades
# (Sharpen/Fortify/Imbue from rest sites) at draw time. Synthetic cards
# (curses, tokens, resurrected) use a bare id (uid -1 → no upgrade). All the
# structural pile ops (shuffle/slice/pop/erase/duplicate) treat entries as
# opaque strings, so they need no changes.
func _pile_entry(card_id: String, uid: int) -> String:
	return "%s#%d" % [card_id, uid]


func _entry_id(entry: String) -> String:
	var h := entry.rfind("#")
	return entry.substr(0, h) if h >= 0 else entry


func _entry_uid(entry: String) -> int:
	var h := entry.rfind("#")
	return entry.substr(h + 1).to_int() if h >= 0 else -1


func _resolve_card_data(card_id: String, uid: int) -> Dictionary:
	# Online skirmish (v1) has no card upgrades and uses SkirmishState uids that
	# don't index RunState — resolve straight from the base definition. (Even
	# without this guard the RunState.deck_uids.find below would miss and fall
	# back to CardDB; the guard makes that explicit and dodges a stray uid
	# collision with a leftover campaign deck.)
	if _is_net():
		return SkirmishState.skirmish_card_data(card_id)
	# Upgraded copies pull their modified stats/keywords from RunState; synthetic
	# or un-upgraded cards fall back to the base definition.
	var data: Dictionary
	if uid >= 0:
		var idx := RunState.deck_uids.find(uid)
		if idx >= 0:
			data = RunState.get_upgraded_card_data(idx)
		else:
			data = CardDB.get_card_data(card_id)
	else:
		data = CardDB.get_card_data(card_id)
	# Apply any pending Familiar buffs accumulated this fight.
	if uid >= 0 and _familiar_buffs.has(uid):
		var buff: Dictionary = _familiar_buffs[uid]
		if data.get("type", "") == "creature":
			data["atk"] = int(data.get("atk", 0)) + int(buff.get("atk", 0))
			data["hp"] = int(data.get("hp", 0)) + int(buff.get("hp", 0))
	return data


func _apply_familiar_buff_live(target_uid: int, atk_buf: int, hp_buf: int) -> void:
	## Apply a Familiar's +atk/+hp buff to any live copy of `target_uid` in
	## hand or on the player's battlefield. Future draws of this uid will pick
	## the buff up via _resolve_card_data + _familiar_buffs.
	for c in _hand:
		if c != null and c.deck_uid == target_uid:
			c.card_data["atk"] = int(c.card_data.get("atk", 0)) + atk_buf
			c.card_data["hp"] = int(c.card_data.get("hp", 0)) + hp_buf
			c.current_atk = int(c.card_data["atk"])
			c.current_hp = int(c.card_data["hp"])
			c.update_stat_display()
	for r in [ROW_FRONT, ROW_BACK]:
		var arr = _row_array(false, r)
		for l in range(LANES_PER_ROW):
			var c = arr[l]
			if c != null and c.deck_uid == target_uid and c.current_hp > 0:
				c.card_data["atk"] = int(c.card_data.get("atk", 0)) + atk_buf
				c.card_data["hp"] = int(c.card_data.get("hp", 0)) + hp_buf
				c.current_atk += atk_buf
				c.current_hp += hp_buf
				c.update_stat_display()


# ── On-enter ability support (Stray Cat / Doppelganger / Chaos Imp) ──

func _last_dead_copy_data() -> Dictionary:
	# Doppelganger's "copy last dead" — prefer the last enemy that died (the
	# interesting case), else the player's last dead creature.
	if not _last_dead_enemy_data.is_empty():
		return _last_dead_enemy_data
	if _last_dead_creature_id != "":
		return CardDB.get_card_data(_last_dead_creature_id)
	return {}


func _look_top_pick(n: int) -> void:
	# Stray Cat: examine the top n entries of the draw pile and draw the
	# cheapest (most immediately playable), leaving the rest in place.
	if _player_draw_pile.is_empty():
		return
	# A full hand makes _draw_card a no-op — bail BEFORE removing the entry,
	# or the picked card falls out of every pile and the deck shrinks for
	# the rest of the fight.
	if _hand.size() >= MAX_HAND_SIZE:
		return
	var count := mini(n, _player_draw_pile.size())
	var best_i := 0
	var best_cost := 9999
	for i in range(count):
		var cd := _resolve_card_data(_entry_id(_player_draw_pile[i]), _entry_uid(_player_draw_pile[i]))
		var c := int(cd.get("cost", 0))
		if c < best_cost:
			best_cost = c
			best_i = i
	var entry: String = _player_draw_pile[best_i]
	_player_draw_pile.remove_at(best_i)
	_draw_card(entry)


func cast_random_spell_free() -> void:
	# Chaos Imp: cast a random spell from the card pool for free.
	# Auto-targets a random valid creature. Custom spells are allowed but a
	# denylist excludes ones that hurt the player or run (Bloodletting, Black Contract),
	# sacrifice your own creatures (Offering, Fuel the Pyre, Dark Pact),
	# or recurse (Echo). Previously the function filtered ALL custom spells,
	# which left the candidate pool nearly empty since almost every spell in
	# CardDB now routes through type:"custom".
	const CHAOS_DENY := {
		"offering": true, "fuel_the_pyre": true, "dark_pact": true,  # sacrifice cost
		"bloodletting": true, "unholy_bargain": true,  # self-harm / persistent run debt
		"blood_tithe": true,  # face damage to self
		"apocalypse": true,  # board-wipe player too
		"echo_spell": true,  # recursion
		"recycle": true, "scrap": true, "gambit": true, "war_chant": true,  # need player hand input
		"mentioned_dispatches": true, "crossed_orders": true,
		"flanking_order": true, "salted_ground": true, "gallows_writ": true,
		"coin": true,  # the going-second system card — not a real campaign spell
	}
	var candidates: Array = []
	for id in CardDB.CARD_POOL:
		if CHAOS_DENY.has(id):
			continue
		var d = CardDB.CARD_POOL[id]
		# Hero-private cards are not in ANY roll pool (2026-07-28). This loop
		# walked CARD_POOL raw, so once the retinue starters landed the Imp could
		# hand any hero another hero's private spell — including The Last Due,
		# which sacrifices one of your own creatures.
		if not bool(d.get("draftable", true)):
			continue
		# Cap the roll at cheap spells (cost 1 or less): a 1-mana 1/2 free-casting a
		# 4-cost Inferno was a pure high-roll. Keeps the chaos fun, not a blowout.
		if d.get("type", "") == "spell" and not CardDB.is_curse(id) and int(d.get("cost", 0)) <= 1 \
				and bool(_random_spell_context_for(d).get("ok", false)):
			candidates.append(id)
	if candidates.is_empty():
		return
	var data := CardDB.get_card_data(String(_combat_ops.pick(candidates)))
	var cast_ctx: Dictionary = _random_spell_context_for(data)
	if not bool(cast_ctx.get("ok", false)):
		return
	var target: Control = cast_ctx.get("target", null)
	var tl: int = int(cast_ctx.get("lane", -1))
	_show_info("Chaos Imp casts %s!" % data.get("name", "a spell"))
	# Show the actual card — a random cast used to be a mystery (you saw the
	# effect but never which spell). Fire-and-forget; it doesn't gate the resolve.
	_reveal_cast_card(data, "CHAOS IMP CASTS")
	await _resolve_spell(data, target, tl)
	# The Imp's cast is a real cast: it counts for the distinct-name set and the
	# damage/non-damage test exactly like a card played from hand.
	_after_generated_spell(data)


func _random_spell_context_for(data: Dictionary) -> Dictionary:
	var targeting := String(data.get("targeting", "none"))
	if targeting == "none":
		return {"ok": _untargeted_random_spell_can_resolve(data), "target": null, "lane": -1}
	var target: Control = _auto_target_for(targeting)
	if target != null:
		return {"ok": true, "target": target, "lane": target.current_lane}
	if targeting == "any":
		return {"ok": true, "target": null, "lane": -1}
	return {"ok": false, "target": null, "lane": -1}


## Places a player-side battlefield body built from raw card data (a token —
## never a deck card, so its death files into no pile). Shared by Turncoat's
## desertion, the Whisper-Widow's on-death steal and Pit Brawler's split.
func _spawn_player_body(data: Dictionary, lane: int, row: int, atk: int, hp: int,
		shielded: bool = false) -> Control:
	var body = CARD_SCENE.instantiate()
	body.card_id = String(data.get("id", "deserter"))
	body.is_opponent = false
	body.is_on_battlefield = true
	body.is_token = true   # not a deck card — its death never files into your piles
	body.compact_mode = true
	data["is_token"] = true
	body.card_data = data
	body.current_atk = atk
	body.current_hp = hp
	body.current_lane = lane
	body.current_row = row
	_row_array(false, row)[lane] = body
	_slot_set_card(_slot_array(false, row)[lane], body)
	body.destroyed.connect(_on_card_destroyed.bind(body))
	body.will_die.connect(_on_card_will_die.bind(body))
	body.state.has_shield = shielded or data.get("keywords", []).has("shield")
	_refresh_adjacency_buffs()
	return body


## An ENEMY creature walks over to the player's side with its live stats —
## banish-style removal (no On-Death, no kill ledger, no reactives), then a
## fresh token body in the player's camp. Returns false (no side effects)
## when the target is a structure or no front seat is open.
func _desert_enemy_to_player(target: Control) -> bool:
	if target == null or not is_instance_valid(target):
		return false
	if _is_fortification(target):
		return false
	var spot: Dictionary = _pick_empty_for_summon(false, ROW_FRONT)
	if target.has_keyword("structure") or spot.is_empty():
		return false
	var d_data: Dictionary = target.card_data.duplicate(true)
	var d_atk: int = target.current_atk
	var d_hp: int = target.current_hp
	var d_shield: bool = target.state.has_shield
	var d_pos := _find_creature_position(target)
	if not d_pos.is_empty():
		_row_array(d_pos.is_enemy, d_pos.row)[d_pos.lane] = null
		var d_slots = _slot_array(d_pos.is_enemy, d_pos.row)
		if d_pos.lane < d_slots.size():
			_restore_slot_label(d_slots[d_pos.lane], d_pos.lane)
	# The new body exists in the arrays IMMEDIATELY (state never waits on
	# presentation); the WALK below is the old token bridging the gap.
	var body = _spawn_player_body(d_data, spot.lane, spot.row, d_atk, d_hp, d_shield)
	_log_event("%s deserts to your banner." % _log_card_ref(body),
		_log_data(body), _log_side(body))
	# The desertion WALK: a soldier changing sides used to queue_free + pop on
	# your side — a blink, for one of the most dramatic board events in the
	# game. Now the old token itself marches across the table, still wearing
	# the foe's colours, and dons your banner ON ARRIVAL (the body reveal +
	# the DESERTED chip). Windowed + motion only; otherwise the old instant
	# swap, chip included.
	var d_walk: bool = _hud_layer != null \
		and DisplayServer.get_name() != "headless" \
		and not (UserSettings != null and UserSettings.reduce_motion) \
		and is_instance_valid(body)
	if not d_walk:
		target.queue_free()
		if body.has_method("_spawn_keyword_chip"):
			body._spawn_keyword_chip("DESERTED", Color(0.42, 0.75, 0.58))
		return true
	var wr: Rect2 = target.get_global_rect()
	_detach_token_for_fx(target)
	target.position = wr.position
	body.modulate.a = 0.0
	var d_from: Vector2 = wr.position
	var d_dest: Vector2 = _slot_global_center(false, int(spot.row), int(spot.lane)) \
		- wr.size * 0.5
	var d_apex: Vector2 = (d_from + d_dest) * 0.5 + Vector2(0.0, -46.0)
	var walker: Control = target
	var d_body: Control = body
	var tw := walker.create_tween()
	tw.tween_method(func(t: float):
		if is_instance_valid(walker):
			walker.position = _bezier_quad(d_from, d_apex, d_dest, t),
		0.0, 1.0, UserSettings.anim_time(0.42)) \
		.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN_OUT)
	tw.tween_callback(func():
		if is_instance_valid(walker):
			walker.queue_free()
		if not is_instance_valid(d_body):
			return
		d_body.modulate.a = 1.0
		Motion.punch(d_body, 1.10)
		_spawn_vfx_ring(d_body.get_global_rect().get_center(),
			Color(1.0, 0.82, 0.34, 0.60), 30.0, 1.5, 0.32, 224, 2.5, 0.55,
			Vector2(1.0, 0.72))
		if d_body.has_method("_spawn_keyword_chip"):
			d_body._spawn_keyword_chip("DESERTED", Color(0.42, 0.75, 0.58))
		if AudioBank != null:
			AudioBank.play_sfx("card_play", 0.03, -4.0, 0.92))
	return true


func _play_banish_exit(card: Control) -> void:
	# Banish's exit: the body is TORN FROM THE FIGHT — not a death (no ash, no
	# On-Death, and it used to just vanish frame-to-frame): the token itself
	# spirals small into a contracting pale ring and is gone. The caller has
	# already cleared the row arrays, so state never waits — the node is a
	# pure visual for its last 0.3s. Headless / Reduce Motion: instant free,
	# the historical behaviour.
	if card == null or not is_instance_valid(card):
		return
	if _hud_layer == null or DisplayServer.get_name() == "headless" \
			or (UserSettings != null and UserSettings.reduce_motion):
		card.queue_free()
		return
	var r: Rect2 = card.get_global_rect()
	_detach_token_for_fx(card)
	card.position = r.position
	card.pivot_offset = r.size * 0.5
	var center: Vector2 = r.get_center()
	_spawn_vfx_ring(center, Color(0.82, 0.90, 1.0, 0.62), 40.0, 0.30, 0.30,
		226, 3.0, 1.15, Vector2.ONE)
	_spawn_family_particles(center, {
		"amount": 12, "lifetime": 0.5,
		"direction": Vector2(0, 0), "spread": 180.0,
		"velocity_min": 30.0, "velocity_max": 90.0,
		"gravity": Vector2(0, -40.0),
		"scale_min": 2.0, "scale_max": 4.0,
		"color": Color(0.85, 0.92, 1.0, 0.85),
	})
	var b_card: Control = card
	var tw := card.create_tween().set_parallel(true)
	tw.tween_property(card, "scale", Vector2(0.04, 0.04),
		UserSettings.anim_time(0.30)) \
		.set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_IN)
	tw.tween_property(card, "rotation", 0.9, UserSettings.anim_time(0.30)) \
		.set_ease(Tween.EASE_IN)
	tw.tween_property(card, "modulate:a", 0.0, UserSettings.anim_time(0.32)) \
		.set_ease(Tween.EASE_IN)
	tw.chain().tween_callback(func():
		if is_instance_valid(b_card):
			b_card.queue_free())
	if AudioBank != null:
		AudioBank.play_sfx("spell_cast", 0.03, -6.0, 1.25)


func _detach_token_for_fx(card: Control) -> void:
	# Lift a board token OUT of play as a pure visual: the caller has already
	# cleared it from the row arrays, so nothing can strike or read it — the
	# node keeps its exact look for one last beat on the HUD layer and the
	# caller's tween owns freeing it. Bob/input disarmed so nothing else
	# writes its transform.
	if card == null or not is_instance_valid(card):
		return
	card._idle_bob_enabled = false
	card.mouse_filter = Control.MOUSE_FILTER_IGNORE
	if card.get_parent() != null:
		card.get_parent().remove_child(card)
	if _hud_layer != null:
		_hud_layer.add_child(card)
	card.z_index = 233


func _pick_combat_option(title: String, options: Array, headless_pick: int = 0) -> int:
	if options.is_empty():
		return -1
	if DisplayServer.get_name() == "headless":
		return clampi(headless_pick, 0, options.size() - 1)
	return await GameTheme.show_option_picker(self, title, options)


func _load_pay_wagon(card: Control) -> void:
	if card == null or not is_instance_valid(card) or _is_net():
		return
	var cap: int = 30 if bool(card.card_data.get("is_upgraded", false)) else 20
	var aboard: int = int(card.state.pay_wagon_gold)
	var available: int = mini(maxi(0, cap - aboard), maxi(0, RunState.gold))
	if available <= 0:
		return
	var values: Array[int] = [0]
	for n in range(5, available + 1, 5):
		values.append(n)
	if not values.has(available):
		values.append(available)
	var opts: Array = []
	for n in values:
		opts.append({"label": "%d gold" % n,
			"desc": "Load %d; a surviving wagon returns %d." % [n, n + n / 2],
			"color": Color(0.34, 0.24, 0.13)})
	var pick: int = await _pick_combat_option("THE PAY-WAGON — load its strongbox",
		opts, values.size() - 1)
	if pick < 0 or pick >= values.size() or not is_instance_valid(card):
		return
	var stake: int = mini(values[pick], RunState.gold)
	if stake <= 0:
		return
	RunState.gold -= stake
	card.state.pay_wagon_gold = aboard + stake
	spawn_trigger_callout(_card_center(card) + Vector2(0, -14),
		"%d GOLD ABOARD" % (aboard + stake), false, int(card.entity_id))
	_update_hud()


func _fallen_printed_data(entry: Dictionary) -> Dictionary:
	var uid: int = int(entry.get("uid", -1))
	var deck_index: int = RunState.deck_uids.find(uid)
	if deck_index >= 0:
		return RunState.get_upgraded_card_data(deck_index)
	return CardDB.get_card_data(String(entry.get("id", "")))


func _pallbearers_carry(card: Control) -> void:
	if card == null or not is_instance_valid(card) or _is_net() or RunState.fallen.is_empty():
		return
	var opts: Array = []
	for entry in RunState.fallen:
		var fallen_data := _fallen_printed_data(entry)
		opts.append({
			"label": String(entry.get("name", fallen_data.get("name", "The unnamed"))),
			"desc": "%d ATK · %d HP — fell at %s" % [
				int(fallen_data.get("atk", 0)), int(fallen_data.get("hp", 0)),
				String(entry.get("enc", "the road"))],
			"color": Color(0.24, 0.20, 0.26),
		})
	var pick: int = await _pick_combat_option("THE PALLBEARERS — carry one name to rest",
		opts, 0)
	if pick < 0 or pick >= RunState.fallen.size() or not is_instance_valid(card):
		return
	var entry: Dictionary = RunState.fallen[pick]
	var carried := _fallen_printed_data(entry)
	var gain_atk: int = maxi(0, int(carried.get("atk", 0)))
	var gain_hp: int = maxi(0, int(carried.get("hp", 0)))
	RunState.fallen.remove_at(pick)
	card.current_atk += gain_atk
	card.card_data["hp"] = int(card.card_data.get("hp", card.current_hp)) + gain_hp
	card.current_hp += gain_hp
	card.update_stat_display()
	spawn_trigger_callout(_card_center(card) + Vector2(0, -14),
		"CARRIES +%d/+%d" % [gain_atk, gain_hp], false, int(card.entity_id))


func _absorb_friendly_wounds(card: Control, owner_is_enemy: bool) -> void:
	if card == null or not is_instance_valid(card):
		return
	var wounds := 0
	for ally in _all_friendly(owner_is_enemy):
		if ally == card or not is_instance_valid(ally):
			continue
		var missing: int = maxi(0,
			int(ally.card_data.get("hp", ally.current_hp)) - int(ally.current_hp))
		if missing <= 0:
			continue
		wounds += missing
		ally.current_hp += missing
		# Passing the old wound away also restores an already-spent Last Stand.
		ally.last_stand_used = false
		ally.update_stat_display()
		if ally.has_method("show_heal_number"):
			ally.show_heal_number(missing)
	if wounds > 0 and is_instance_valid(card):
		spawn_trigger_callout(_card_center(card) + Vector2(0, -14),
			"TAKES %d WOUNDS" % wounds, true, int(card.entity_id))
		card.take_damage_bypass_armor(wounds)
		_cleanup_dead()


func _drag_adjacent_enemy(card: Control, owner_is_enemy: bool) -> void:
	if card == null or not is_instance_valid(card):
		return
	var candidates: Array = []
	for enemy in _all_friendly(not owner_is_enemy):
		if not is_instance_valid(enemy) or enemy.has_keyword("structure"):
			continue
		if abs(enemy.current_lane - card.current_lane) != 1:
			continue
		if _row_array(not owner_is_enemy, enemy.current_row)[card.current_lane] != null:
			continue
		candidates.append(enemy)
	if candidates.is_empty():
		return
	var chosen: Control = candidates[0]
	if not owner_is_enemy and candidates.size() > 1:
		var opts: Array = []
		for enemy in candidates:
			opts.append({"label": String(enemy.card_data.get("name", "Enemy")),
				"desc": "Lane %d · %d/%d" % [enemy.current_lane + 1,
					enemy.current_atk, enemy.current_hp],
				"color": Color(0.36, 0.18, 0.15)})
		var pick: int = await _pick_combat_option("HOOK-AND-CHAIN — choose whom to drag",
			opts, 0)
		if pick < 0 or pick >= candidates.size() or not is_instance_valid(card):
			return
		chosen = candidates[pick]
	if not is_instance_valid(chosen):
		return
	if _relocate_creature(chosen, not owner_is_enemy, chosen.current_row,
			card.current_lane):
		spawn_trigger_callout(_card_center(card) + Vector2(0, -14),
			"HOOKED", false, int(card.entity_id))
		if bool(card.card_data.get("is_upgraded", false)) and is_instance_valid(chosen):
			chosen.take_damage(2)
			_cleanup_dead()


func _desert_player_to_enemy(card: Control) -> bool:
	if card == null or not is_instance_valid(card):
		return false
	var src := _find_creature_position(card)
	if src.is_empty() or bool(src.is_enemy):
		return false
	var spot: Dictionary = {}
	# Keep the deserter opposite its old post when possible, then its column's
	# other rank, then any legal unsalted enemy seat.
	for row in [int(src.row), ROW_BACK if int(src.row) == ROW_FRONT else ROW_FRONT]:
		if _row_array(true, row)[int(src.lane)] == null and not _lane_is_salted(int(src.lane)):
			spot = {"row": row, "lane": int(src.lane)}
			break
	if spot.is_empty():
		spot = _find_empty_enemy_slot()
	_row_array(false, int(src.row))[int(src.lane)] = null
	_slot_take_card(_slot_array(false, int(src.row))[int(src.lane)], card)
	card.state.credit_due_round = 999999
	if spot.is_empty():
		card.queue_free()
		_refresh_adjacency_buffs()
		return true
	card.is_opponent = true
	var old_damage_hook := _on_friendly_damaged.bind(card)
	if card.damaged.is_connected(old_damage_hook):
		card.damaged.disconnect(old_damage_hook)
	card.current_row = int(spot.row)
	card.current_lane = int(spot.lane)
	_row_array(true, card.current_row)[card.current_lane] = card
	_slot_set_card(_slot_array(true, card.current_row)[card.current_lane], card)
	_play_landing_pop(card)
	_update_intent_display(card, "ATK")
	_refresh_adjacency_buffs()
	spawn_trigger_callout(_card_center(card) + Vector2(0, -14),
		"DESERTS", true, int(card.entity_id))
	_log_event("%s deserts to the foe's line." % _log_card_ref(card),
		_log_data(card), _log_side(card))
	return true


func _collect_sword_credit() -> void:
	if _is_net():
		return
	var debts: Array = []
	for card in _all_player_creatures():
		if is_instance_valid(card) and String(card.card_id) == "sword_on_credit" \
				and int(card.state.credit_due_round) <= round_number:
			debts.append(card)
	for card in debts:
		if not is_instance_valid(card) or _find_creature_position(card).is_empty():
			continue  # dead owe nothing
		card.state.credit_due_round = 999999
		var paid := false
		if player_mana >= 2:
			var opts := [
				{"label": "Pay 2 Command", "desc": "Keep the sword in your line.",
					"color": Color(0.24, 0.38, 0.20)},
				{"label": "Default", "desc": "It deserts to the foe.",
					"color": Color(0.42, 0.18, 0.15)},
			]
			var pick: int = await _pick_combat_option("SWORD ON CREDIT — the bill falls due",
				opts, 0)
			paid = pick == 0 and player_mana >= 2
		if paid:
			player_mana -= 2
			spawn_trigger_callout(_card_center(card) + Vector2(0, -14),
				"DEBT PAID", false, int(card.entity_id))
		else:
			_desert_player_to_enemy(card)
		_update_hud()


func _settle_pay_wagons() -> int:
	var payout := 0
	for card in _all_player_creatures():
		if not is_instance_valid(card) or String(card.card_id) != "pay_wagon":
			continue
		var cargo: int = maxi(0, int(card.state.pay_wagon_gold))
		if cargo <= 0:
			continue
		var returned: int = cargo + cargo / 2
		payout += returned
		card.state.pay_wagon_gold = 0
	if payout > 0:
		RunState.gain_gold(payout)
		_show_info("The Pay-Wagon comes home — +%d gold." % payout)
	return payout


func _try_body_snatch(dead_enemy: Control, lane: int) -> void:
	if dead_enemy == null or not is_instance_valid(dead_enemy) \
			or lane < 0 or lane >= LANES_PER_ROW or dead_enemy.has_keyword("structure"):
		return
	var snatcher: Control = null
	for row in [ROW_FRONT, ROW_BACK]:
		var candidate = _row_array(false, row)[lane]
		if candidate != null and is_instance_valid(candidate) \
				and candidate.card_data.get("passive", "") == "body_snatcher" \
				and not bool(candidate.state.body_snatcher_used):
			snatcher = candidate
			break
	if snatcher == null:
		return
	snatcher.state.body_snatcher_used = true
	if _player_back[lane] != null:
		spawn_trigger_callout(_card_center(snatcher) + Vector2(0, -14),
			"NO ROOM FOR THE BODY", true, int(snatcher.entity_id))
		return
	var risen_data: Dictionary = dead_enemy.card_data.duplicate(true)
	# Arrival text belongs to the first life; the stolen corpse keeps its combat
	# keywords, death text and passive identity.
	risen_data.erase("on_enter")
	risen_data.erase("on_play")
	var bonus: int = 1 if bool(snatcher.card_data.get("is_upgraded", false)) else 0
	var atk: int = maxi(0, int(risen_data.get("atk", 0))) + bonus
	var hp: int = maxi(1, int(risen_data.get("hp", 1))) + bonus
	risen_data["atk"] = atk
	risen_data["hp"] = hp
	var body := _spawn_player_body(risen_data, lane, ROW_BACK, atk, hp)
	spawn_trigger_callout(_card_center(snatcher) + Vector2(0, -14),
		"BODY SNATCHED", false, int(snatcher.entity_id))
	_log_event("The Body-Snatcher raises %s behind your line." % _log_card_ref(body),
		_log_data(body), _log_side(body))


func _deck_is_highlander() -> bool:
	# The Long Roll: true when no two cards in the RUN deck share an id (ids
	# map 1:1 to names). The fight's piles are the same list shuffled, and
	# ephemera (Discover finds, the Coin) never march home, so the run deck
	# is the honest ledger.
	var seen := {}
	for cid in RunState.deck:
		if seen.has(cid):
			return false
		seen[cid] = true
	return true


func _untargeted_random_spell_can_resolve(data: Dictionary) -> bool:
	var spell: Dictionary = data.get("spell", {})
	var stype := String(spell.get("type", ""))
	var sid := String(spell.get("id", ""))
	match stype:
		"damage_face", "draw":
			return true
		"damage_all_enemies":
			return not _all_enemy_creatures().is_empty()
		"damage_all":
			return not _all_creatures_both_sides().is_empty()
		"buff_all_atk":
			return not _all_player_creatures().is_empty()
	if stype != "custom":
		return true
	match sid:
		"provision", "muster_fallen":
			return _has_open_creature_slot(false)
		"reanimate":
			return not _last_dead_copy_data().is_empty() and _has_open_creature_slot(false)
		"grave_robbery":
			return _last_dead_creature_id != ""
		"long_roll":
			# Floored heal (2026-07-13): the highlander deck barely exists, so the
			# card no longer DEMANDS it — a base heal always lands, the singleton
			# roll call just pays far more. Only full HP greys it now.
			return player_hp < player_max_hp
		"wolf_pits":
			# Pits are dug for FUTURE arrivals — dead only once nothing more
			# can ever arrive.
			return not _enemy_deck.is_empty() or not _reinforcement.is_empty()
		"informer":
			return not _enemy_deck.is_empty()
		"forgefire":
			for fg_c in _hand:
				if is_instance_valid(fg_c) and String(fg_c.card_data.get("id", "")) != "forgefire" \
						and not bool(fg_c.card_data.get("is_upgraded", false)) \
						and CardDB.is_upgradeable(fg_c.card_id):
					return true
			return false
		"mass_grave":
			# The grave must hold someone — greyed until a friendly has fallen.
			# The forged writ's flat + 2 keeps it live from the first round.
			return not _all_enemy_creatures().is_empty() \
				and (_friendly_deaths_this_fight > 0 or bool(data.get("is_upgraded", false)))
		"ricochet", "wildfire":
			return not _all_enemy_creatures().is_empty()
		"ambush":
			return not _all_enemy_creatures().is_empty() or _has_swift_friendly(false)
		"plague_bell", "earthquake":
			return not _all_creatures_both_sides().is_empty()
		"war_cry", "virulence", "kings_command":
			return not _all_player_creatures().is_empty()
		"censer_light":
			# The smoke needs one of your Dead to settle on — grey without one.
			for cl_g in _all_player_creatures():
				if is_instance_valid(cl_g) and String(cl_g.card_data.get("ctype", "")) == "dead":
					return true
			return false
		"testudo":
			# Base writ reaches only the front row; the forged one takes any body.
			if bool(data.get("is_upgraded", false)):
				return not _all_player_creatures().is_empty()
			for tst_g in _row_array(false, ROW_FRONT):
				if tst_g != null and is_instance_valid(tst_g):
					return true
			return false
		"doubled_hour":
			return true
	return true


func _has_open_creature_slot(is_enemy: bool) -> bool:
	for row in [ROW_FRONT, ROW_BACK]:
		for lane in range(LANES_PER_ROW):
			if _row_array(is_enemy, row)[lane] == null:
				return true
	return false


func _has_swift_friendly(is_enemy: bool) -> bool:
	for c in _all_friendly(is_enemy):
		if is_instance_valid(c) and _is_swift_attacker(c):
			return true
	return false


func _auto_target_for(targeting: String) -> Control:
	# Pick a random valid creature for an auto-cast spell (Chaos Imp / Echo).
	# Structures aren't valid creature targets — strip them out before rolling.
	var pool: Array = []
	match targeting:
		"enemy_creature":
			pool = _all_enemy_creatures()
		"friendly_creature":
			pool = _all_player_creatures()
		"any_creature", "any":
			pool = _all_enemy_creatures() + _all_player_creatures()
	var valid := pool.filter(func(c): return is_instance_valid(c) and not c.has_keyword("structure"))
	if valid.size() > 0:
		return _combat_ops.pick(valid)
	return null


func _init_decks() -> void:
	_player_draw_pile.clear()
	_player_discard_pile.clear()
	# Context-routed deck: campaign → RunState; skirmish → the local SkirmishState
	# slot. The opponent's draw pile lives on the host and is never built here.
	var deck: Array = _ctx_deck()
	var deck_uids: Array = _ctx_deck_uids()
	for i in deck.size():
		_player_draw_pile.append(_pile_entry(deck[i], deck_uids[i]))
	# NOTE: Mark of Pain's 2 curses are added once, in _apply_combat_start_relics()
	# (the canonical combat-start relic entry point, with proper _pile_entry uids).
	# A second add here used to stack them to 4 — double the relic's stated cost.
	_combat_ops.shuffle(_player_draw_pile)


func _place_starting_board() -> void:
	## Runs once at fight start, BEFORE round 1. As of 2026-07-25 this seats
	## only what is terrain — the enemy's fighting bodies are no longer on the
	## table when the player first looks at it.
	# A NAMED ACTION opens on a board someone placed on purpose — no count roll,
	# no formation roll, and both sides seated. That authored opening IS half
	# the scenario: it is the position the player is asked to solve, so a
	# set-piece keeps its pre-seated line and never musters in.
	if _sp_id != "":
		_sp_place_opening()
		return
	var enc = EncounterDB.get_encounter(_encounter_id) if _encounter_id != "" else {}

	# Structures go down FIRST — they're board objects (Pyres, Mausoleums,
	# Altars) anchored to specific back-row lanes that drive the encounter's
	# signature mechanic. They are the ARENA, not the army: an encounter whose
	# whole read is "there is a Pyre in lane 3" must still open on that board.
	# _deal_opening_muster's fill_order keeps its defensive null-check, so the
	# mustering line can never overwrite them.
	_spawn_encounter_structures(enc)
	_spawn_siege_fortifications()

	# THE OPENING MUSTER (2026-07-25): the hold's line is DEALT on round 1 by
	# _enemy_place_creatures instead of being pre-seated here, so a fight opens
	# with both armies off the table and both sides forming up into it — the
	# skirmish opening, where neither player starts already dug in. The muster
	# delay (2026-07-21) makes round 1 a no-swing round for both sides, so an
	# empty enemy board grants the player no free face damage: `can_attack()`
	# refuses every body that arrived this round, and `_creature_hits_face`
	# separately bars arriving Swift from the face.
	_opening_muster_pending = true


func _run_opening_muster() -> void:
	## Drives the round-1 opening muster and puts the board back the way
	## _start_round left it. The muster is the enemy TAKING A TURN, so the player
	## must not be able to drag, play or end the turn through it — otherwise a
	## card could be committed against a line that is still arriving.
	# The muster is the ENEMY acting, so the phase must say so. _start_round has
	# already set PLAYER_TURN, and freezing the board only stops a HUMAN: every
	# headless driver (probes, the autorun pilot) polls `phase` and would happily
	# play into the enemy's opening action, landing its on_enter effects on a
	# creature the player had supposedly already committed. Caught by
	# _probe_relics, where a freshly played Lookout was being damaged mid-muster.
	phase = Phase.RESOLVING
	Card2D.board_interactive = false
	if _end_turn_btn != null:
		_end_turn_btn.disabled = true
	await _enemy_place_creatures()   # consumes _opening_muster_pending
	# _place_enemy_card only stamps the ATK default on arrival; the real intent
	# cycle is assigned here so round 1 reads its orders like any other round.
	# Hand the turn back BEFORE the threat readouts: _refresh_lane_forecast bails
	# unless the phase is PLAYER_TURN, so recomputing first would paint nothing.
	phase = Phase.PLAYER_TURN
	_assign_intents()
	_refresh_passive_threat_glow()
	_refresh_incoming_damage_chip()
	_update_reserves_chip()   # the muster just spent bodies out of the hold
	_request_lane_forecast_refresh()
	Card2D.board_interactive = true
	if _end_turn_btn != null:
		_end_turn_btn.disabled = false
	# Hand the phase line back to the player turn. _update_hud paints "YOUR TURN"
	# for PLAYER_TURN, but _phase_caption is cleared too so a later RESOLVING
	# refresh can't resurrect "ENEMY DEPLOYMENT" mid-clash.
	_phase_caption = ""
	_update_hud()


func _deal_opening_muster() -> void:
	## The hold's opening formation, dealt one body at a time on round 1.
	## 4x4: scales starting count up a touch since there are more slots, and
	## prefers front-row placement (back-row only used as overflow).
	##
	## Variety: randomized count (±1) and formation per fight so two runs of
	## the same encounter open differently. Formations: spread front, packed
	## front, split (front+back ambush), siege (back row only). The formation
	## roll is what keeps the muster from collapsing into the reactive
	## column-targeting drill that _get_placement_priority_4x4 runs on later
	## rounds — the opening is a SHAPE the hold chose, not an answer to the
	## player's board.
	var enc = EncounterDB.get_encounter(_encounter_id) if _encounter_id != "" else {}
	var enc_type = enc.get("type", "combat")
	var act = enc.get("act", RunState.get_act())

	# A LANE IS ALWAYS LEFT OPEN (2026-07-27). The ceiling is LANES_PER_ROW - 1,
	# not LANES_PER_ROW: with four lanes, a four-body opening seals every one of
	# them, and a sealed front means the player's win condition — the lord's own
	# health — is physically unreachable until they clear a lane and hold it
	# through a clash. A fight trace of the act-1 General had the foe's face move
	# 16 -> 14 across NINE rounds for exactly that reason: the board was contested
	# the whole time and never once opened. The hold may bring a wall; it may not
	# bring a lid.
	var starting_count := 0
	var open_lane_cap: int = maxi(1, LANES_PER_ROW - 1)
	match enc_type:
		"combat":
			# Base count varies by act, then ±1 random for fight-to-fight variety.
			var base: int = [2, 3, 3][act - 1]
			starting_count = clampi(base + _combat_ops.rangei(-1, 1), 1, open_lane_cap)
		"elite":
			# Elites stay scarier — never just 1 creature on the field.
			starting_count = clampi((3 if act == 1 else 4) + _combat_ops.rangei(-1, 1),
				2, open_lane_cap)
		"boss":
			starting_count = mini(3, open_lane_cap)

	var placed := 0
	var fill_order: Array = []

	# Pick a random formation. Each shapes the opening read differently:
	#   spread  — evenly-distributed front line (classic / default)
	#   packed  — clumped on one half of front (flanking pressure)
	#   split   — half front, half back (ambush formation)
	#   siege   — back row only (creates breathing room turn 1)
	var formations: Array[String] = ["spread", "packed", "split"]
	# Siege only makes sense with >=2 creatures, and only for non-boss fights.
	if starting_count >= 2 and enc_type != "boss":
		formations.append("siege")
	# Elites get more aggressive formations.
	if enc_type == "elite":
		formations = ["spread", "packed", "split"]
	var formation: String = String(_combat_ops.pick(formations))

	match formation:
		"spread":
			for l in _evenly_spread_lanes(starting_count):
				fill_order.append({"row": ROW_FRONT, "lane": l})
		"packed":
			# Cluster on one side: lanes 0-1 or 2-3, then overflow inward.
			var left_side: bool = _combat_ops.chance(0.5)
			var lanes: Array = [0, 1, 2, 3] if left_side else [3, 2, 1, 0]
			for l in lanes:
				fill_order.append({"row": ROW_FRONT, "lane": l})
		"split":
			# Half front, half back — picks alternating columns.
			var cols = [0, 1, 2, 3]
			_combat_ops.shuffle(cols)
			var front_count: int = (starting_count + 1) / 2
			for i in range(cols.size()):
				if i < front_count:
					fill_order.append({"row": ROW_FRONT, "lane": cols[i]})
				else:
					fill_order.append({"row": ROW_BACK, "lane": cols[i]})
		"siege":
			# Back row only — opening turn has no front line, telegraphs trouble.
			for l in _evenly_spread_lanes(starting_count):
				fill_order.append({"row": ROW_BACK, "lane": l})

	# Fallback / overflow — fill remaining lanes if formation runs short.
	for l in range(LANES_PER_ROW):
		if not _slot_in_list(fill_order, ROW_FRONT, l):
			fill_order.append({"row": ROW_FRONT, "lane": l})
	var back_order = [0, 1, 2, 3]
	_combat_ops.shuffle(back_order)
	for l in back_order:
		if not _slot_in_list(fill_order, ROW_BACK, l):
			fill_order.append({"row": ROW_BACK, "lane": l})

	for slot in fill_order:
		if placed >= starting_count:
			break
		if _enemy_deck.is_empty():
			break
		# Defensive: never overwrite an already-occupied slot. The fill_order
		# is built without duplicates, but if any caller ever reuses this
		# logic on a non-empty board we want stacking ruled out at the source.
		if _row_array(true, slot.row)[slot.lane] != null:
			continue
		var card_data = _enemy_deck.pop_front()
		await _announce_enemy_muster(card_data)
		_place_enemy_card(card_data, slot.lane, slot.row, true)
		placed += 1
		if AudioBank != null:
			AudioBank.play_sfx("card_play", 0.05, -3.0, 0.96)
		# Deal the opening one body at a time (windowed only) so the line
		# visibly forms up instead of appearing all at once — the same beat
		# _enemy_place_creatures uses for a reinforcement wave. Rushable, and
		# once rushed the rest of the line seats at speed.
		if placed < starting_count and DisplayServer.get_name() != "headless":
			if _muster_rushed:
				await get_tree().process_frame
			elif await _rushable_pause(0.16):
				_muster_rushed = true

	# THE INITIATIVE's price for moving first, paid AFTER the formation is seated
	# and paid strictly into RESERVE.
	#
	# It cannot be paid by raising starting_count, which was the first shape and is
	# wrong: fill_order's overflow appends every unused FRONT lane before it ever
	# reaches the back row, so a fourth body would seal the last lane and turn the
	# price into the lid _deal_opening_muster's ceiling exists to forbid. The hold
	# may answer the player's tempo with depth; it may not answer it by closing the
	# board.
	if _initiative == "field":
		await _place_initiative_reserves(INITIATIVE_FIELD_RESERVES)


## Seat up to `n` extra bodies in empty BACK-row lanes. Silent about running out
## of room or out of deck — a hold with a full reserve simply cannot bill the
## price, which is a strictly better failure than stacking or than a lid.
func _place_initiative_reserves(n: int) -> void:
	var lanes: Array = []
	for l in range(LANES_PER_ROW):
		lanes.append(l)
	_combat_ops.shuffle(lanes)
	var seated := 0
	for l in lanes:
		if seated >= n or _enemy_deck.is_empty():
			break
		if _row_array(true, ROW_BACK)[l] != null:
			continue
		var card_data = _enemy_deck.pop_front()
		await _announce_enemy_muster(card_data)
		_place_enemy_card(card_data, l, ROW_BACK, true)
		seated += 1
		if AudioBank != null:
			AudioBank.play_sfx("card_play", 0.05, -3.0, 0.96)


func _evenly_spread_lanes(n: int) -> Array:
	# Returns up to n lane indices spread across the 4 lanes so the starting
	# board reads as a balanced front line instead of a left-clumped huddle.
	# Picks one of two mirrored layouts at random for variety.
	match clampi(n, 0, LANES_PER_ROW):
		0: return []
		1: return [1] if _combat_ops.chance(0.5) else [2]
		2: return [0, 2] if _combat_ops.chance(0.5) else [1, 3]
		3: return [0, 1, 3] if _combat_ops.chance(0.5) else [0, 2, 3]
		_: return [0, 1, 2, 3]


# =====================================================================
#  ROUND FLOW
# =====================================================================

func _start_round() -> void:
	round_number += 1
	# THE MUSTER: every body that survived to see a new round has formed up and
	# may swing in the clash that ends it. Bodies that arrive later this round
	# stay unready (CreatureInstance defaults the flag false), so they wait one
	# round — the Cross Blitz summoning-sickness rule, Swift excepted.
	#
	# This MUST be round start, not the end-of-turn upkeep beside the
	# has_attacked_this_turn reset: that upkeep runs BEFORE
	# _enemy_place_creatures(), so sweeping there would leave every enemy
	# arrival unready through the following round and delay it twice.
	#
	# CombatNet routes its round starts through this same function, so solo and
	# skirmish get one rule for both sides from one place.
	#
	# THE FUSE IS NOT LIT UNTIL THE BODY HAS FORMED UP (2026-07-28). The sweep
	# also records who it just readied, because that body is about to fight its
	# FIRST clash and KeywordEffects' Doom tick must skip it this round — see
	# dispatch_start_of_round. `_mustered_this_round` is DERIVED here rather than
	# stored on CreatureInstance: it is a fact about this round, not about the
	# body, so it stays out of saves and net snapshots. Instance ids, not node
	# refs, so a body freed between the sweep and the tick can't poison the set.
	# Swift/Charge bodies never enter it — they fight on arrival, so their fuse
	# was never delayed and must not gain a free round.
	_mustered_this_round.clear()
	for c in _all_creatures_both_sides():
		if is_instance_valid(c):
			# Reserves that landed after the last clash owe one round exactly as
			# a played card does — they skip this sweep and are readied by the
			# next one. See the census/diff in _post_combat_sequence. Their fuse
			# stays cold for the same reason: they have not fought yet either.
			if _muster_deferred.has(c):
				if not c.ignores_muster_delay():
					_mustered_this_round[c.get_instance_id()] = true
				c.refresh_muster_mark()
				continue
			if not c.state.ready_to_swing and not c.ignores_muster_delay():
				_mustered_this_round[c.get_instance_id()] = true
			c.state.ready_to_swing = true
			c.refresh_muster_mark()
	_muster_deferred.clear()
	_dbgp("[PACING] R%d open   | P_board:%d E_board:%d | P_HP:%d E_HP:%d" % [round_number, _all_player_creatures().size(), _all_enemy_creatures().size(), player_hp, enemy_hp])
	# Slow Match: every copy that WAITED in hand through a full turn banks +1
	# damage on its fuse (cap +4) — charged before the refill so fresh draws
	# start cold. The hover prediction reads the same card_data key, so the
	# number the player sees is the number that lands.
	if round_number >= 2:
		for _fc in _hand:
			if is_instance_valid(_fc) and String(_fc.card_id) == "slow_match":
				var _fuse: int = int(_fc.card_data.get("fuse", 0))
				if _fuse < 4:
					_fc.card_data["fuse"] = _fuse + 1
					spawn_floating_number(_fc.global_position + Vector2(_fc.size.x * _fc.scale.x * 0.5, -8), "FUSE +1", Color(1.0, 0.62, 0.25), false)
					# S5: the burning cord on the writ is the STANDING read of
					# the banked charge (the float above is only the event).
					_fc.set_fuse_glow(_fuse + 1)
	# S5: repaint the persistent-spell layer each round — expired salt stops
	# drawing the moment its last blocked round has passed.
	_refresh_lane_aftermath()
	# Champion's Belt: turn-1-only ATK buff. Clear at round 2 start so the
	# bonus stops applying after the first round of combat.
	if round_number >= 2:
		_champions_belt_active = false
	# Tutorials — sequenced so new players see one tip per round, not a wall.
	# Intents tip on round 1 (when intent badges first appear above enemies);
	# pile tip on round 2 (when the discard pile is guaranteed non-empty).
	if round_number == 1:
		_maybe_show_intents_tutorial()
	elif round_number == 2:
		_maybe_show_pile_tutorial()
	_first_creature_played = false
	_first_spell_this_turn = false
	_spells_cast_this_turn = 0
	_starter_spell_ids_this_round.clear()
	_starter_non_damage_spell_seen_this_round = false
	_starter_second_distinct_seen_this_round = false
	# The two ROUND-scoped halves of the tribe moments. The fight-scoped halves
	# (_volley_fired / _works_fortified / _ledger_open) deliberately are NOT reset
	# here — that is what makes them survive a wipe. This is the shared solo +
	# skirmish round-open chokepoint, so both sides get one rule from one place.
	_beasts_arrived_this_round = [0, 0]
	_ledger_paid_this_round = [false, false]
	_cinder_crown_used_this_round = false
	_marching_spurs_used_this_round = false
	_rearward_horn_used_this_round = false
	_centurions_rule_used_this_round = false
	_reserve_standard_used_this_round = false
	_funeral_lantern_used_this_round = false
	_ledger_seal_used_this_round = false
	_war_bellows_used_this_round = false
	_chain_censer_used_this_round = false
	_debt_guard_used_this_round.clear()
	_player_moved_a_friendly_this_round = false
	# _enemy_changed_columns_this_round is deliberately NOT cleared here — it is
	# cleared at the top of _post_combat_cleanup instead. The only AI-driven enemy
	# column change in solo is the RETREAT intent, which executes INSIDE
	# _post_combat_cleanup, i.e. after this function has already run for the round
	# it belongs to. Clearing it here meant the flag was wiped before the player
	# could ever act on it, so nothing could read it. See _post_combat_cleanup.
	_doom_detonation_queue.clear()
	_doom_detonation_active = false

	# Round-scoped spell states expire with the round they were cast for (solo;
	# net decays per side in _net_decay_side_states after the clash instead).
	if not _is_net():
		_virulence_active = [false, false]
		_doubled_hour = [false, false]
	_butchers_cleaver_armed = false
	_stalwarts_anvil_fired_this_turn = false
	_sigil_of_hunger_fired_this_round = false
	_brainstorm_fired_this_round = false
	_old_meg_used_this_round = false
	_portcullis_used_this_round = false
	_familiars_quill_charge = 0
	# Tick down persistent ATK buffs (e.g. Butcher's Cleaver) on all creatures.
	for c in _all_creatures_both_sides():
		if c.persistent_atk_buff_rounds > 0:
			c.persistent_atk_buff_rounds -= 1
			if c.persistent_atk_buff_rounds <= 0:
				c.persistent_atk_buff = 0
			c.update_stat_display()
	_cards_played_this_turn = 0
	_tally_notched = false
	_dispatches_used_this_turn = false
	Card2D.spell_pierce_active = false   # defensive: never leak across turns
	Card2D.strike_damage_active = false  # ditto — a stuck flag would un-immune the Body
	_moves_used_this_turn = 0
	_card_cost_discount = 0
	_last_spell_played_this_turn = {}
	_last_spell_target_ref = null
	_last_spell_primary_target_ref = null
	_last_spell_target_lane = -1
	_friendly_deaths_this_round = 0
	_enemy_deaths_this_round = 0
	_soul_lantern_used_this_round = false
	_verse_of_you_used_this_round = false
	_road_stone_used_this_round = false
	_extra_draws_this_turn = 0
	_refill_draws_this_turn = 0
	phase = Phase.PLAYER_TURN

	# War school (veterancy rung 3) — solo only, fired at the top of the player
	# phase so the modal never lands mid-clash. Round 1 sweeps the deck for
	# veterans who crossed 10 kills on a fight's LAST kill (or on an old save).
	# Fire-and-forget coroutine: the overlay blocks all input until the pick.
	if not _is_net():
		if round_number == 1:
			_queue_war_school_catchup()
			_queue_doctrine_catchup()
		if not _war_school_queue.is_empty():
			_offer_war_school()
		if not _doctrine_queue.is_empty():
			_offer_doctrine()

	# Start-of-round keyword ticks (Regenerate heal / Wither ATK-decay / Doom
	# countdown) are HOST-AUTHORITATIVE in net. The client must NOT run them on its
	# own placement turn: its _start_round is non-authoritative, so a local tick
	# DOUBLE-applied the effect — a spurious REGEN/WITHER callout + hp/atk flicker on
	# the client's own turn, and a doom counter the snapshot couldn't reconcile
	# (it isn't in the board dict). The host runs it once per round; the results
	# reach the client via the snapshot (hp/atk + the new doom counter) and the
	# regen/wither callouts ride the fx queue (spawn_keyword_callout_kw enqueues
	# host-side). Solo is unaffected (_is_client() is always false there).
	if not _is_client():
		KeywordEffects.dispatch_start_of_round(self)
	# Iron Rations — the round's first act is the army eating. Sits with the
	# other start-of-round board ticks (and under the same non-client guard) so
	# a heal is never applied twice. Damaged bodies only: update_stat_display is
	# the single funnel that floats "+N HP" on a gain, so a no-op heal would
	# still print a float and read as a bug.
	if not _is_client() and _has_relic("ice_cream"):
		var ration: int = int(RelicDB.get_relic("ice_cream").get("value", 1))
		var fed := false
		for c in _all_player_creatures():
			if c == null or not is_instance_valid(c):
				continue
			var cap_hp: int = int(c.card_data.get("hp", c.current_hp))
			if c.current_hp >= cap_hp:
				continue
			c.current_hp = mini(c.current_hp + ration, cap_hp)
			c.update_stat_display()
			fed = true
		if fed:
			_relic_fired("ice_cream")
	# The hold's hand refreshes with the round. Reset here rather than at the
	# placement site because the escalation branch calls _enemy_place_creatures
	# a SECOND time in the same round — a per-call reset would hand it a fresh
	# budget and the stack would survive the cap.
	_enemy_arrivals_this_round = 0
	# BEAT 1 — the body ticks have spoken (regen heals, wither decay, doom
	# counters and their detonations, the army's rations). Let them land before
	# the board passives start granting keywords on top.
	await _round_beat()
	# Riteforge ramp + Warchief aura + Summoner muster — HOST-AUTHORITATIVE in net,
	# same as the keyword ticks above. The host runs the client's side here via
	# _net_start_turn's `_apply_start_round_passives(true)` hook and ships the result
	# in the snapshot; the client must NOT run it on its own placement turn. For the
	# ATK ramps it was merely redundant (the snapshot overwrites current_atk), but
	# Summoner's `summon_each_round` calls summon_token(), which spawns a LOCAL token
	# node the client never registers — the board-sync reconcile only despawns
	# REGISTERED entities, so that phantom is permanent and accumulates one per round
	# (a whole extra creature on the client's board the host never shows). Solo is
	# unaffected (_is_client() is always false there).
	if not _is_client():
		_apply_start_round_passives(false)
	_dispatch_passive_start_of_round()
	# BEAT 2 — the standing rules have fired: the tribe keystones (warden HOLD,
	# bastion SIEGE), Summoner tokens, the Trebuchet's volley, and the
	# encounter's own passive, which can itself damage the face, buff four bodies
	# and summon two. That is the loudest group in the round; it gets its own
	# moment rather than sharing a frame with the intents that follow.
	await _round_beat()
	# The clash phrase restarts each round: strike audio climbs through an
	# exchange (Card2D._next_clash_pitch) and this is the one place that puts it
	# back at the root note, so every round opens at the same pitch rather than
	# the fight ratcheting upward forever. Solo and net alike — the cue is local
	# to whoever renders the strike.
	Card2D.reset_clash_pitch()
	# Warlord's Standard: snowballing front-row aggro. Every round after the
	# first, front-row friendlies gain permanent +1 ATK. Round 1 is setup-only,
	# so gating on round_number >= 2 means the first buff lands going into the
	# first real combat round.
	if _has_relic("warlords_standard") and round_number >= 2:
		var ws: int = int(RelicDB.get_relic("warlords_standard").get("value", 1))
		var ws_raised := false
		for c in _all_player_creatures():
			if c.current_row == ROW_FRONT:
				c.persistent_atk_buff += ws
				c.persistent_atk_buff_rounds = 99  # effectively permanent this fight
				c.update_stat_display()
				ws_raised = true
		# Only when the standard actually raised somebody — an empty front row
		# is not a firing, and a chip that pulses on nothing teaches nothing.
		if ws_raised:
			_relic_fired("warlords_standard")
	# (Bulwark Engine moved to _apply_start_round_passives so it fires per-side —
	# host-authoritative for the client's copy too in skirmish.)
	# Reset phantom_veil one-per-round flag.
	_phantom_veil_used = false
	# Mutator round-start chip damage (currently "burning").
	_mutator_round_start_tick()

	# Boss phase check
	_check_boss_phase_transition()

	# Scripted encounter beats — fire any events queued for this round.
	_run_encounter_script(round_number)

	# BEAT 3 — the fight-level beats are done (mutator tick, boss phase turn,
	# scripted events and their banners). What follows is the read the player
	# actually plans against, so it arrives on its own frame rather than buried
	# under whatever the encounter just shouted.
	await _round_beat()

	# Assign + display intents for every enemy so the player can always read
	# what's coming. Non-boss enemies without intent cycles default to ATK
	# which now renders as a visible damage chip via _update_intent_display.
	_assign_intents()
	# Mark the creature the start-of-round passive will snipe, so the threat reads
	# on the board itself — not only as text. Read-only; uses the passive's own
	# target picker.
	_refresh_passive_threat_glow()

	# Successor Wars: telegraph what the faction's wave schedule musters at
	# the end of this round — the persistent chip under the enemy plate owns
	# this readout. Only the RARE surge still gets a center call-out (it's a
	# dramatic beat); the routine per-round "wave musters" toast duplicated
	# the chip and was center-screen noise every round.
	_update_wave_telegraph()
	_update_reserves_chip()
	if _next_wave_count() >= 2 and _wave_surge_pending():
		_show_info("Fire on the water — the Everflame surges")

	# Escalation check
	_check_escalation()

	# Mana — unspent mana carries over (banked)
	# 2026-07-25: the uncapped-banking branch went with Miser's Coffer. Command is
	# a FIXED resource — the bank cap is now the same for everyone, always.
	var bank_cap = mini(player_mana, MAX_BANKED_MANA)
	var banked = bank_cap if round_number > 1 else 0
	player_max_mana = _ctx_max_mana() + _bonus_mana_next_turn
	# Mutator: "Blessed" adds permanent max-mana for the duration of this fight.
	player_max_mana += _mutator_max_mana_increase
	# Marked One: +1 max mana for every round of this fight if the player took
	# the "mark on the heart" branch in the preceding event.
	player_max_mana += _marked_one_mana_bonus
	# (lantern's turn-1 Command grant removed 2026-07-16 — the id is now The
	# Burnt Dispatches; see the exhaust hook in _recycle_spell_card.)
	if _has_relic("happy_flower") and round_number > 0 and round_number % PASSIVE_HEAL_INTERVAL == 0:
		# Periodic, so it IS a moment (unlike the flat max-Command relics beside it,
		# which are standing rules and correctly stay silent).
		_relic_fired("happy_flower")
		player_max_mana += 1
	# Cavalry Sigil: +1 mana per EMPTY edge column (lanes 1 & 4, both rows clear).
	if _has_relic("cavalry_sigil"):
		var cav_val: int = int(RelicDB.get_relic("cavalry_sigil").get("value", 1))
		for col in [0, LANES_PER_ROW - 1]:
			if _player_field[col] == null and _player_back[col] == null:
				player_max_mana += cav_val
				_relic_fired("cavalry_sigil")
	# Junk Slot: 4+ empty board slots (both rows, both sides) → +1 max mana.
	if _has_relic("junk_slot") and _empty_player_slots_count() >= 4:
		player_max_mana += int(RelicDB.get_relic("junk_slot").get("value", 1))
	# Lean Mean: +1 max mana while the deck is ≤14 cards.
	if _has_relic("lean_mean") and RunState.deck.size() <= 14:
		player_max_mana += int(RelicDB.get_relic("lean_mean").get("value", 1))
	# Marathoner's Sash: +2 max mana (read from value).
	if _has_relic("marathoners_sash"):
		player_max_mana += int(RelicDB.get_relic("marathoners_sash").get("value", 2))
	# Bone Hourglass "mana_center": +1 max mana when both center lanes (1 & 2)
	# are filled. Checks both rows of those columns for any friendly.
	if _has_relic("bone_hourglass") and RunState.bone_hourglass_choice == "mana_center":
		var center_full := true
		for col in [1, 2]:
			if _player_field[col] == null and _player_back[col] == null:
				center_full = false
				break
		if center_full:
			player_max_mana += 1
	# Mana Drunkard / Skull Throne: per-fight cumulative max-mana grants.
	# Clamp to 0 so debuffs (Bandit Camp's mana steal) can't push max_mana
	# negative. _bonus_mana_next_turn can be negative now that the bandit
	# passive applies a real -1 each round.
	player_max_mana = maxi(0, player_max_mana)
	_bonus_mana_next_turn = 0
	_bandit_steal_fired_this_round = false
	# Teach the dismissal once, on the first turn that actually HOLDS cards
	# over (round 2+): that's the moment the persistent hand becomes visible.
	if round_number == 2 and not _is_net():
		_maybe_show_dismiss_tutorial()
	player_mana = player_max_mana + banked
	# Marathoner's Sash partial: round 1 starts with 1 mana (the "ramp" trade
	# for +2 max). Round 2+ flows normally so the +2 ceiling actually matters.
	if _has_relic("marathoners_sash") and round_number == 1:
		player_mana = 1
	# Warm Knucklebone (event relic): 1 in 6 turns the bones come up warm.
	# After the Sash override so the bonus survives a round-1 ramp.
	if _has_relic("warm_knucklebone") and _combat_ops.chance(1.0 / 6.0):
		var wk_n := int(RelicDB.get_relic("warm_knucklebone").get("value", 1))
		player_mana += wk_n
		_pulse_mana_label(wk_n, true)   # random gift: silent, it reads as a miscount
		_relic_fired("warm_knucklebone")  # ...and the pulse alone never names the bones
	# Tutorial: first round where mana actually carries over.
	if banked > 0:
		_maybe_show_banking_tutorial()
		if _has_relic("powder_horn"):
			_powder_charges = mini(3, _powder_charges + 1)
			_relic_fired("powder_horn")
		# Mana Tide: banking arms a "next creature costs 1 less" charge.
		if _has_relic("mana_tide"):
			_mana_tide_creature_discount += int(RelicDB.get_relic("mana_tide").get("value", 1))
			_relic_fired("mana_tide")

	# Sword on Credit bills after every start-of-turn Command source has landed.
	# The option picker blocks input while this fire-and-forget coroutine runs.
	_collect_sword_credit()

	# Per-turn cost meta cleared on every retained card so last turn's tags
	# don't keep zeroing the cost of cards held over by Runic Pyramid.
	for c in _hand:
		if c != null and is_instance_valid(c):
			c.state.mummified_zero = false
			c.state.pact_of_embers_zero = false
	# Snecko Eye: re-randomize the cost of every card already in hand (retained
	# from last turn). Newly drawn cards get randomized inside _draw_card.
	if _has_relic("snecko_eye"):
		for c in _hand:
			if c != null and is_instance_valid(c):
				_snecko_randomize_card_cost(c)
		if not _hand.is_empty():
			_relic_fired("snecko_eye")

	# Draw — staggered so cards deal in one at a time instead of fanning in
	# simultaneously. Each card already tweens from the deck into its hand slot
	# (Card2D.set_hand_target); spacing the spawns by ~80 ms makes the deal
	# read as a real motion sequence instead of a single fanned poof.
	# Per-turn draw. PERSISTENT_HAND switches the model (see the const header):
	#   • persistent → REFILL up to a target (draw-to-N). Draw-boosting relics
	#     raise the target; if the hand is already at/over target, draw_count = 0.
	#   • fresh → the original fixed HAND_DRAW_PER_TURN (+ relic/mutator mods).
	var draw_count: int
	if PERSISTENT_HAND:
		var target := HAND_REFILL_TARGET
		if _has_relic("snecko_eye"):
			target = int(RelicDB.get_relic("snecko_eye").get("value", 6))
		# Deep Satchel: the refill target itself grows by 1 (5 → 6) — the old
		# baseline-6 hand as a relic payoff. Net-safe: the refill runs per-peer.
		if _has_relic("deep_satchel"):
			target += int(RelicDB.get_relic("deep_satchel").get("value", 1))
		if _has_relic("couriers_bag") and round_number == 1:
			target += 1
			_relic_fired("couriers_bag")
		if _has_relic("tome_of_many") and _ctx_deck().size() >= 20:
			target += int(RelicDB.get_relic("tome_of_many").get("value", 2))
			_relic_fired("tome_of_many")
		if _mutator_hand_draw_increase > 0:
			target += _mutator_hand_draw_increase
		if _mutator_hand_draw_reduce > 0:
			target = maxi(1, target - _mutator_hand_draw_reduce)
		draw_count = maxi(0, target - _hand.size())
		# Always deal at least one fresh card per turn. With the persistent hand,
		# holding a full hand (5+ at the default target) refilled to 0 cards, so a
		# turn could open with no new option — which felt dead. Guarantee a single
		# draw instead. draw_one() still respects MAX_HAND_SIZE, so a hand already
		# at 10 simply no-ops here (no overflow).
		if draw_count == 0:
			draw_count = 1
	else:
		draw_count = HAND_DRAW_PER_TURN
		# Snecko Eye: draws 6 instead of 4 (boss-relic trade for the cost chaos).
		if _has_relic("snecko_eye"):
			draw_count = int(RelicDB.get_relic("snecko_eye").get("value", 6))
		# Mutator: "Famine" trims the per-turn draw, never below 1 card.
		if _mutator_hand_draw_reduce > 0:
			draw_count = maxi(1, draw_count - _mutator_hand_draw_reduce)
		# Mutator: "Wisdom" — opposite of Famine, bumps the per-turn draw.
		if _mutator_hand_draw_increase > 0:
			draw_count += _mutator_hand_draw_increase
		if _has_relic("couriers_bag") and round_number == 1:
			draw_count += 1
		# Tome of Many: deck has 20+ cards → +2 extra draw.
		if _has_relic("tome_of_many") and _ctx_deck().size() >= 20:
			draw_count += int(RelicDB.get_relic("tome_of_many").get("value", 2))
	# Skirmish: when an opening hand was pre-dealt at match start (so the player
	# going second can see it during the opener — and pick up the +1 going-second
	# card), skip this turn's draw so the pre-dealt hand isn't topped up again.
	if _is_net() and _net_skip_draw_this_round:
		_net_skip_draw_this_round = false
		_refill_draws_this_turn = _extra_draws_this_turn
	else:
		# Everything drawn up to and including this refill is "free"; the
		# reactive/relic only pay out on genuinely extra draws past it.
		_refill_draws_this_turn = _extra_draws_this_turn + draw_count
		for i in draw_count:
			if i == 0:
				draw_one()
			else:
				get_tree().create_timer(0.08 * float(i)).timeout.connect(draw_one)

	# Pact of Embers fires AFTER the last delayed draw lands so the highest-
	# cost candidate sees the freshly drawn hand. A pinch of slack on top of
	# the last draw's timer keeps it stable across animation jitter.
	if _has_relic("pact_of_embers") and draw_count > 0:
		var delay: float = 0.08 * float(draw_count) + 0.05
		get_tree().create_timer(delay).timeout.connect(_apply_pact_of_embers)

	# Board is interactive again — the player can reposition creatures (and floop)
	# during their turn. Cleared in _on_end_turn so grabs can't start mid-combat.
	Card2D.board_interactive = true
	_end_turn_btn.disabled = false
	_update_hud()
	_show_turn_banner()


func _on_end_turn() -> void:
	if phase != Phase.PLAYER_TURN:
		return
	if _targeting_spell != null:
		_cancel_targeting()
		return
	# Skirmish: the end-turn button is the DONE (finish placing) button. Once both
	# sides have placed, the host runs one simultaneous clash. Host finishes its own
	# placement directly; the client asks the host to.
	if _is_net():
		_net_on_done_placing()
		return
	# PlayLog: record end-of-turn (deduped per round so the confirm re-entry
	# and the warning path don't double-log).
	if round_number != _pl_last_end_turn_round:
		_pl_last_end_turn_round = round_number
		_pl_log("end_turn", {})
	# End-turn warning: if the player still has playable actions, prompt
	# before ending the turn. Most accidental end-t}rn clicks happen at
	# exactly these moments. _end_turn_confirmed gates the recursive
	# re-entry — set true ONLY when the player confirms in the dialog.
	if UserSettings != null and UserSettings.end_turn_warning \
			and not _end_turn_confirmed and _has_playable_action():
		GameTheme.show_confirm_dialog(self,
			"End Turn?",
			"You still have Command or an action available.\n(Disable in Settings)",
			"END TURN",
			"KEEP PLAYING",
			Callable(self, "_on_end_turn_confirmed"))
		return
	_end_turn_confirmed = false
	# First-run teaching: the simultaneous-combat model, taught the instant the
	# player commits their first clash (before the swing resolves).
	_maybe_show_combat_model_tutorial()
	_end_turn_btn.disabled = true
	phase = Phase.RESOLVING
	_clear_threat_flags()  # JUICE: drop the pre-combat threat outlines; the clash itself now reads
	Card2D.board_interactive = false
	# Marked discards cash out now — AFTER the phase flip (a second [E] press
	# during the cascade's pause must not re-enter and double-run the clash).
	# The cascade gets a short beat of its own so the cards visibly peel away
	# before the lines meet.
	var shed := _flush_marked_discards()
	if shed > 0:
		await _short_pause(0.15 + 0.09 * float(mini(shed, 4)))
	_dbgp("[PACING] R%d commit | played:%d | P_board:%d E_board:%d | P_HP:%d E_HP:%d" % [round_number, _cards_played_this_turn, _all_player_creatures().size(), _all_enemy_creatures().size(), player_hp, enemy_hp])
	# Mime: at end of turn, the player picks ONE creature-with-floop in hand to
	# play for free with its floop pre-armed. Skipped when nothing qualifies.
	if _has_relic("mime"):
		await _mime_trigger_floop_from_hand()
	_play_clash_commit_vfx()
	_update_hud()

	# Resolve enemy intents (non-attack intents execute now)
	_resolve_intents()

	await _do_combat()


## Command / draws earned by a CREATURE BATTLECRY (on-enter / on-play / on-death),
## granted to the side that OWNS the creature. `is_enemy` = the creature's side from
## the resolving instance's POV.
##   Solo — only the player side (is_enemy=false) has these resources; enemy
##          battlecries no-op, exactly as the old `if not is_enemy` guards did.
##   Net  — the HOST resolves EVERY battlecry, so route through the same
##          EV_MANA / EV_DRAW caster channel the spell resolver already uses.
##          Without this the CLIENT's "gain Command" / "draw" battlecries silently
##          vanished: `if not is_enemy` is the host's own side, so a client creature's
##          Errand Sprite / Witch / Leyline gave the client no Command and its
##          Lookout / Bloodhound drew it nothing. The client never resolves
##          battlecries itself (its creatures arrive via the host's board snapshot),
##          so guarding on _is_host() is correct.
func _battlecry_gain_command(is_enemy: bool, n: int) -> void:
	if n <= 0:
		return
	if _is_net():
		if _is_host():
			_net_caster_gain_mana(is_enemy, n)
	elif not is_enemy:
		player_mana += n
		_pulse_mana_label(n, true)
		_update_hud()


func _battlecry_draw(is_enemy: bool, n: int) -> void:
	if n <= 0:
		return
	if _is_net():
		if _is_host():
			_net_caster_draw(is_enemy, n)
	elif not is_enemy:
		for _i in n:
			draw_one()


## Compatibility route for an owner-scoped next-turn Command modifier. Nothing
## in the current card pool calls this after Mourner's rework, but the EV_MANA
## `next` shape remains useful to old peers and future encounter/relic hooks.
func _battlecry_bonus_mana_next_turn(is_enemy: bool, n: int) -> void:
	if n <= 0:
		return
	if _is_net():
		if not _is_host():
			return
		if is_enemy:
			NetMatch.send_to_client({"t": NetMatch.EV_MANA, "n": n, "next": true})
		else:
			_bonus_mana_next_turn += n
	elif not is_enemy:
		_bonus_mana_next_turn += n


func _resolve_on_play_ability(card: Control, lane_idx: int, is_enemy: bool) -> void:
	var floop_data = card.card_data.get("on_play", {})
	var times = 1
	if not is_enemy and _has_relic("echo_staff"):
		times = 2
		# Only report when there is actually an ability to double — a creature
		# with no battlecry runs the loop twice over an empty dict.
		if not floop_data.is_empty():
			_relic_fired("echo_staff")
	if is_instance_valid(card) and card.has_method("play_floop_pulse"):
		card.play_floop_pulse()
	# The ability's material beat (delivery / wave / grace in the tribe's
	# colour). The floop pulse above is this channel's announce, so
	# _play_trigger_fx skips its own ring for "play".
	_play_trigger_fx(floop_data, card, lane_idx, is_enemy, "play")
	# 4x4: adjacency-based floops operate within the flooping creature's row.
	# "All friendly/enemy" floops use the broad helpers below.
	var my_row: int = card.current_row
	var friendly_field = _row_array(is_enemy, my_row)
	var enemy_field = _row_array(not is_enemy, ROW_FRONT)  # opposing front (for column-aligned damage)
	var all_friendly = _all_friendly(is_enemy)
	var all_enemy = _all_friendly(not is_enemy)
	var play_type: String = String(floop_data.get("type", ""))
	if play_type == "starter_heal_adjacent":
		play_type = "heal_adjacent"
	for _i in times:
		match play_type:
			# --- BOARD MANIPULATION (4x4 position verbs) ---
			"shove_back":
				# Shove: push the opposing FRONT creature into its own back row,
				# clearing your lane to reach the back line or face. If its back
				# lane is blocked (or the front is empty) it can't be moved, so
				# deal `value` to the column's target instead — never a dead play.
				var front_opp = _row_array(not is_enemy, ROW_FRONT)[lane_idx]
				var pushed := false
				if front_opp != null and is_instance_valid(front_opp):
					pushed = _relocate_creature(front_opp, not is_enemy, ROW_BACK, lane_idx)
					if pushed:
						spawn_floating_number(front_opp.global_position \
							+ Vector2(front_opp.size.x * front_opp.scale.x * 0.5, -10),
							"SHOVED", Color(0.75, 0.85, 1.0), false)
				if not pushed:
					var t = get_opposing_card(lane_idx, is_enemy)
					if t != null:
						t.take_damage(floop_data.value)
			"haul_front":
				# Hook: drag the opposing BACK-row creature to the front, exposing a
				# hidden Ranged / support body to combat, and deal `value` to it.
				# Harpy's 2026-07-13 trim runs this at value 0 / no stun — a pure
				# pull; damage and winding fire only for cards that still pay for
				# riders. If the front is occupied or the back is empty, `value`
				# hits whatever the lane would hit instead (a 0-value pure pull
				# that finds no reserve simply does nothing).
				var back_opp = _row_array(not is_enemy, ROW_BACK)[lane_idx]
				var pulled := false
				if back_opp != null and is_instance_valid(back_opp):
					pulled = _relocate_creature(back_opp, not is_enemy, ROW_FRONT, lane_idx)
					if pulled:
						spawn_floating_number(back_opp.global_position \
							+ Vector2(back_opp.size.x * back_opp.scale.x * 0.5, -10),
							"HOOKED", Color(1.0, 0.82, 0.4), false)
						if int(floop_data.get("value", 0)) > 0:
							back_opp.take_damage(floop_data.value)
						# The hauled creature lands winded — it forfeits its
						# attack this round (the assisted-assassination window).
						if bool(floop_data.get("stun", false)) \
								and is_instance_valid(back_opp) and back_opp.current_hp > 0:
							_apply_stun(back_opp)
							if back_opp.has_method("_spawn_keyword_chip"):
								back_opp._spawn_keyword_chip("STUNNED", Color(0.85, 0.78, 0.45))
				if not pulled:
					# No hook landed (front held / back empty): the talons rake the
					# lane's front instead — same damage, same winding, never a dead
					# On-Enter for a card whose value pays for one.
					var t2 = get_opposing_card(lane_idx, is_enemy)
					if t2 != null and int(floop_data.get("value", 0)) > 0:
						t2.take_damage(floop_data.value)
						if bool(floop_data.get("stun", false)) and is_instance_valid(t2) and t2.current_hp > 0:
							_apply_stun(t2)
							if t2.has_method("_spawn_keyword_chip"):
								t2._spawn_keyword_chip("STUNNED", Color(0.85, 0.78, 0.45))
			"redeploy_friendly":
				# Deserter (Stray common): move ONE of your creatures to any empty
				# slot, free — this fires on-play and spends no battlefield move.
				# Optional (floors to a plain body with no other friendly or no
				# empty slot). The moved creature keeps ready_to_swing — a
				# reposition is not a re-muster.
				await _deserter_redeploy(card, is_enemy)
			"vanguard_split":
				# Vanguard: placement is the decision. Played to the FRONT row it
				# gains +value ATK for the round; played to the BACK row it draws a
				# card (the watcher reports in). current_row is set at placement.
				if card.current_row == ROW_FRONT:
					card.temp_atk_buff += int(floop_data.value)
					card.update_stat_display()
					spawn_floating_number(card.global_position \
						+ Vector2(card.size.x * card.scale.x * 0.5, -10),
						"VANGUARD +%d" % int(floop_data.value), Color(1.0, 0.78, 0.25), false)
				else:
					# Back row → the watcher reports in: reveal the foe's NEXT
					# arrival (the front of the encounter deck; the endless
					# reinforcement once it runs dry). Chronicled with the scouted
					# card's art. Solo-only intel — the card is skirmish-denylisted
					# (a human foe's hand can't be scried).
					var scout_data: Dictionary = {}
					if not _enemy_deck.is_empty():
						scout_data = _enemy_deck[0]
					elif not _reinforcement.is_empty():
						scout_data = _reinforcement
					if not scout_data.is_empty():
						var scout_name := String(scout_data.get("name", "?"))
						_log_event("The Lookout espies the foe's next arrival: %s." \
							% scout_name, scout_data, 1)
						spawn_floating_number(card.global_position \
							+ Vector2(card.size.x * card.scale.x * 0.5, -10),
							"ESPIED: %s" % scout_name.to_upper(), Color(0.75, 0.85, 1.0), false)
					else:
						_log_event("The Lookout espies the road behind the foe: empty. No one else is coming.", {}, 0)
			"summon_back":
				# Rat Piper: a rat scurries into the same lane's back seat
				# (one size bigger once the piper is forged); if the back seat
				# is taken, summon_token's fall-through finds the front instead.
				var rp_a: int = int(floop_data.get("atk", 1))
				var rp_h: int = int(floop_data.get("hp", 1))
				if bool(card.card_data.get("is_upgraded", false)):
					rp_a += 1
					rp_h += 1
				summon_token(rp_a, rp_h, lane_idx, is_enemy, ROW_BACK, {}, "Rat")
			"snipe_back":
				# Snipe: pick off a random enemy BACK-row creature (support dies
				# first); if the back row is empty, hit a random front body instead.
				var snipe_pool: Array = []
				for c in _row_array(not is_enemy, ROW_BACK):
					if c != null and is_instance_valid(c):
						snipe_pool.append(c)
				if snipe_pool.is_empty():
					for c in _row_array(not is_enemy, ROW_FRONT):
						if c != null and is_instance_valid(c):
							snipe_pool.append(c)
				if snipe_pool.size() > 0:
					_combat_ops.pick(snipe_pool).take_damage(floop_data.value)
			# --- DAMAGE ---
			"damage_any":
				if all_enemy.size() > 0:
					_combat_ops.pick(all_enemy).take_damage(floop_data.value)
			"damage_opposing":
				var opp = get_opposing_card(lane_idx, is_enemy)
				if opp != null:
					opp.take_damage(floop_data.value)
			"damage_opposing_grow":
				# Ratling: damage opposing AND gain permanent ATK whether or not
				# there was a target. The atk gain triggers even on an empty lane.
				var opp_g = get_opposing_card(lane_idx, is_enemy)
				if opp_g != null:
					opp_g.take_damage(floop_data.value)
				card.current_atk += int(floop_data.get("atk_gain", 1))
				card.update_stat_display()
			"damage_opposing_splash":
				var opp = get_opposing_card(lane_idx, is_enemy)
				if opp != null:
					opp.take_damage(floop_data.value)
				# 4x4: splash hits the frontmost creature in each adjacent column
				# (front if alive, else back) — matching how get_opposing_card
				# resolves the direct target. The old code read enemy_field
				# directly, which is the opposing FRONT row only, so back-row
				# creatures behind empty front lanes were silently skipped.
				for adj_lane in [lane_idx - 1, lane_idx + 1]:
					if adj_lane >= 0 and adj_lane < LANES_PER_ROW:
						var adj_opp = _get_creature_in_column(not is_enemy, adj_lane)
						if adj_opp != null:
							adj_opp.take_damage(floop_data.value)
			"damage_opposing_heal":
				var opp = get_opposing_card(lane_idx, is_enemy)
				if opp != null:
					opp.take_damage(floop_data.value)
				card.current_hp = mini(card.current_hp + floop_data.get("heal", 1), card.card_data.hp)
				card.update_stat_display()
			"damage_all_enemies":
				for c in all_enemy:
					c.take_damage(floop_data.value)
			"damage_all":
				for c in all_enemy:
					c.take_damage(floop_data.value)
				for c in all_friendly:
					if c != card:
						c.take_damage(floop_data.value)
				card.take_damage(floop_data.value)
			"damage_face":
				if is_enemy:
					damage_player_hero(floop_data.value)
				else:
					damage_enemy_hero(floop_data.value)
			"damage_self_opposing":
				var opp = get_opposing_card(lane_idx, is_enemy)
				if opp != null:
					opp.take_damage(floop_data.value)
				card.take_damage(floop_data.get("self_damage", 1))
			"drain":
				var opp = get_opposing_card(lane_idx, is_enemy)
				if opp != null:
					opp.take_damage(floop_data.value)
					card.current_hp = mini(card.current_hp + floop_data.value, card.card_data.hp)
					card.update_stat_display()
			"execute":
				# Assassin (2026-07-10): unconditional — the HP-threshold gate
				# made it dead vs anything worth killing. value <= 0 means "no
				# threshold"; a positive value keeps the old conditional form
				# for any future card that wants it.
				var opp = get_opposing_card(lane_idx, is_enemy)
				var exe_cap: int = int(floop_data.get("value", 0))
				if opp != null and (exe_cap <= 0 or opp.current_hp <= exe_cap):
					opp.take_damage(999)
			"slay_draw":
				var opp = get_opposing_card(lane_idx, is_enemy)
				if opp != null:
					opp.take_damage(floop_data.value)
					if opp.current_hp <= 0:
						_battlecry_draw(is_enemy, 1)
			"unleash_atk":
				var opp = get_opposing_card(lane_idx, is_enemy)
				if opp != null:
					opp.take_damage(card.effective_atk())
			"graveyard_damage":
				var opp = get_opposing_card(lane_idx, is_enemy)
				if opp != null:
					var discard_creatures = 0
					for idx in _player_discard_pile:
						var cdata = CardDB.get_card_data(_entry_id(idx))
						if cdata.get("type", "") == "creature":
							discard_creatures += 1
					opp.take_damage(discard_creatures)
			"discard_top_damage":
				if _player_draw_pile.size() > 0:
					var top_idx = _player_draw_pile.pop_front()
					var top_data = CardDB.get_card_data(_entry_id(top_idx))
					_player_discard_pile.append(top_idx)
					var cost_dmg = top_data.get("cost", 0)
					if cost_dmg > 0 and all_enemy.size() > 0:
						_combat_ops.pick(all_enemy).take_damage(cost_dmg)

			# --- BUFF / HEAL ---
			"heal_self":
				card.current_hp = mini(card.current_hp + floop_data.value, card.card_data.hp)
				card.update_stat_display()
			"heal_adjacent":
				for adj_c in _adjacent_creatures(is_enemy, my_row, lane_idx):
					adj_c.current_hp = mini(adj_c.current_hp + floop_data.value, adj_c.card_data.hp)
					adj_c.update_stat_display()
			"starter_fuse_tender":
				# Canonical adjacency (2026-07-28 fix): row ±1 PLUS the column-mate.
				# This resolved through _adjacent_in_row, so the Tender was the one
				# card in the game whose printed word "adjacent" quietly meant
				# something narrower than every other card's — and its own hero's
				# Cinderward is exactly the body you post behind it.
				var fuse_gain: int = 1 + int(card.card_data.get("doom_atk_bonus", 0))
				for fuse_ally in _adjacent_creatures(is_enemy, my_row, lane_idx):
					if fuse_ally != null and is_instance_valid(fuse_ally) \
							and fuse_ally.current_hp > 0 and fuse_ally.has_keyword("doom"):
						fuse_ally.card_data["atk"] = int(fuse_ally.card_data.get(
							"atk", fuse_ally.current_atk)) + fuse_gain
						fuse_ally.current_atk += fuse_gain
						_tick_doom_counter(fuse_ally, 1, false)
						fuse_ally.update_stat_display()

			"heal_all_friendly":
				for c in all_friendly:
					c.current_hp = mini(c.current_hp + floop_data.value, c.card_data.hp)
					c.update_stat_display()
			"grow_atk":
				card.current_atk += floop_data.value
				card.update_stat_display()
			"grow_per_enemies":
				card.current_atk += all_enemy.size()
				card.update_stat_display()
			"buff_all_atk_permanent":
				for c in all_friendly:
					c.current_atk += floop_data.value
					c.update_stat_display()
			"buff_target_hp":
				# Buff random adjacent friendly (simplified from targeted)
				var adj: Array = _adjacent_creatures(is_enemy, my_row, lane_idx)
				if adj.size() > 0:
					var target = _combat_ops.pick(adj)
					target.card_data.hp += floop_data.value
					target.current_hp += floop_data.value
					target.update_stat_display()
			"buff_tokens_atk":
				for c in all_friendly:
					if c.card_data.get("is_token", false):
						c.temp_atk_buff += floop_data.value
						c.update_stat_display()

			# --- DEFENSE ---
			"temp_armored":
				if "armored" not in card.card_data.keywords:
					card.card_data.keywords.append("armored")
					card.state.temp_armored = true
			"grant_armored_all":
				for c in all_friendly:
					if "armored" not in c.card_data.keywords:
						c.card_data.keywords.append("armored")
						c.state.temp_armored = true
			"shield_adjacent":
				for adj_c in _adjacent_creatures(is_enemy, my_row, lane_idx):
					if "armored" not in adj_c.card_data.keywords:
						adj_c.card_data.keywords.append("armored")
						adj_c.state.temp_armored = true
			"grant_shield_adjacent":
				for adj_c in _adjacent_creatures(is_enemy, my_row, lane_idx):
					if not adj_c.state.has_shield:
						adj_c.state.has_shield = true
						if adj_c.has_method("_spawn_keyword_chip"):
							adj_c._spawn_keyword_chip("SHIELD", Color(0.65, 0.85, 1.0))
			"buff_thorns":
				card.state.bonus_thorns = card.state.bonus_thorns + floop_data.value
			"grant_thorns_adjacent":
				for adj_c in _adjacent_creatures(is_enemy, my_row, lane_idx):
					if "thorns" not in adj_c.card_data.keywords:
						adj_c.card_data.keywords.append("thorns")
						adj_c.state.temp_thorns = true
			"redirect_adjacent":
				card.state.redirecting = true
				spawn_keyword_callout_kw(card, "redirecting")
			"stun_opposing":
				var opp = get_opposing_card(lane_idx, is_enemy)
				if opp != null:
					_apply_stun(opp)

			# --- CARD / ECONOMY ---
			"load_pay_wagon":
				if not is_enemy:
					await _load_pay_wagon(card)
			"pallbearers":
				if not is_enemy:
					await _pallbearers_carry(card)
			"absorb_friendly_wounds":
				_absorb_friendly_wounds(card, is_enemy)
			"draw":
				_battlecry_draw(is_enemy, int(floop_data.value))
			"scry":
				# Lookout: peek at the top card; player keeps it on top or sends
				# it to the bottom. Awaited so combat doesn't resolve while the
				# modal is open (otherwise the "top of deck" the player sees may
				# already have been drawn by the time they click).
				if not is_enemy and _player_draw_pile.size() > 0:
					await _show_scry_modal()
			"reorder_deck":
				# Raven: reveal the top N cards and let the player click them
				# in their desired draw order (1st click = drawn first).
				if not is_enemy and _player_draw_pile.size() >= 2:
					await _show_reorder_modal(int(floop_data.value))
			"filter_draw":
				if not is_enemy:
					# Mule: draw FIRST, then pitch the worst card you now hold — you
					# choose the discard with full information and never end down a
					# card (the old discard-then-draw-1 was card-negative on a body
					# nobody picked). Net: replace Mule with a 1/3 + a free filter.
					draw_one()
					draw_one()
					if _hand.size() > 0:
						var picked: Array = await _show_discard_picker(1,
							"Mule — discard a card")
						for c in picked:
							_hand.erase(c)
							_player_discard_pile.append(_pile_entry(c.card_id, c.deck_uid))
							if c.get_parent() != null:
								c.get_parent().remove_child(c)
							c.queue_free()
			"raise_dead":
				# Hand-full guard mirrors _look_top_pick: erasing the entry while
				# _draw_card no-ops would destroy the card for the fight.
				if not is_enemy and _player_discard_pile.size() > 0 \
						and _hand.size() < MAX_HAND_SIZE:
					var creature_indices: Array = []
					for idx in _player_discard_pile:
						var cdata = CardDB.get_card_data(_entry_id(idx))
						if cdata.get("type", "") == "creature":
							creature_indices.append(idx)
					if creature_indices.size() > 0:
						var pick = _combat_ops.pick(creature_indices)
						_player_discard_pile.erase(pick)
						_draw_card(pick)
			"fetch_spell":
				# Fetch Hound: the newest spell in YOUR discard comes back to hand;
				# no spell buried (or hand full) = draw 1 instead. Hand-full guard
				# mirrors raise_dead — erasing the entry while _draw_card no-ops
				# would destroy the card for the fight. Player-only: solo enemies
				# have no piles, and skirmish keeps the card out via
				# SkirmishState.SKIRMISH_DENYLIST (caster-local pile read).
				if not is_enemy:
					var fetched := false
					if _hand.size() < MAX_HAND_SIZE:
						for fi in range(_player_discard_pile.size() - 1, -1, -1):
							var fentry = _player_discard_pile[fi]
							if CardDB.get_card_data(_entry_id(fentry)).get("type", "") == "spell" \
									and not CardDB.is_curse(_entry_id(fentry)):
								_player_discard_pile.remove_at(fi)
								_draw_card(fentry)
								fetched = true
								break
					if not fetched:
						draw_one()
			"gain_gold":
				if not is_enemy:
					RunState.gain_gold(floop_data.value)
			"gain_mana":
				# Battlecry Command grant → goes to the creature's OWNER (the client
				# over the wire in skirmish), not always the local player.
				_battlecry_gain_command(is_enemy, int(floop_data.value))
			"buff_adjacent_atk":
				# Canonical adjacency (row ±1 + column-mate) — Sprite was the rule's
				# first citizen; every "adjacent" verb now shares _adjacent_creatures.
				for adj in _adjacent_creatures(is_enemy, my_row, lane_idx):
					adj.temp_atk_buff += floop_data.value
					adj.update_stat_display()
			"discount_next":
				if not is_enemy:
					_card_cost_discount += int(floop_data.get("value", 1))
			"eat_curse":
				# Sin-Eater: swallow a Curse from hand — exhaust it, grow +2/+2
				# (+3/+3 upgraded), draw 1. No Curse in hand = a plain body; the
				# hand read is player-only (enemy copies enter plain).
				if not is_enemy:
					for hc in _hand:
						if is_instance_valid(hc) and CardDB.is_curse(hc.card_id):
							_hand.erase(hc)
							if hc.get_parent() != null:
								hc.get_parent().remove_child(hc)
							_exhaust_pile.append(_pile_entry(hc.card_id, hc.deck_uid))
							hc.queue_free()
							var se_grow: int = int(floop_data.get("value", 2))
							card.current_atk += se_grow
							card.card_data.hp = int(card.card_data.get("hp", card.current_hp)) + se_grow
							card.current_hp += se_grow
							card.update_stat_display()
							draw_one()
							spawn_floating_number(card.global_position \
								+ Vector2(card.size.x * card.scale.x * 0.5, -10),
								"SIN EATEN +%d/+%d" % [se_grow, se_grow],
								Color(0.72, 0.95, 0.62), false)
							break
			"spawn_token_hand":
				if not is_enemy:
					var token_data = {
						"id": "token_hand", "name": "Cat Token", "type": "creature",
						"cost": 0, "atk": floop_data.get("atk", 1), "hp": floop_data.get("hp", 1),
						"rarity": "starter", "keywords": [], "desc": "Token. When played: deal 1 damage to the opposing creature.",
						"on_play": {"type": "damage_opposing", "value": 1}, "is_token": true
					}
					_draw_card(token_data.id)
			"buff_familiar_pick":
				# Familiar floop: buff the card discovered when this Familiar
				# was played. Track the buff in _familiar_buffs (re-applied on
				# draw) and immediately apply to any live copy in hand or play.
				if not is_enemy and card.state.familiar_pick_uid >= 0:
					var target_uid: int = card.state.familiar_pick_uid
					var atk_buf: int = floop_data.get("atk", 1)
					var hp_buf: int = floop_data.get("hp", 1)
					var current_entry: Dictionary = _familiar_buffs.get(target_uid, {"atk": 0, "hp": 0})
					current_entry.atk += atk_buf
					current_entry.hp += hp_buf
					_familiar_buffs[target_uid] = current_entry
					_apply_familiar_buff_live(target_uid, atk_buf, hp_buf)

			# --- MOVEMENT ---
			"wheel_right":
				await _wheel_side_right(is_enemy,
					bool(card.card_data.get("is_upgraded", false)))
			"drag_adjacent_enemy":
				await _drag_adjacent_enemy(card, is_enemy)
			"relocate":
				# 4x4: relocate within the same row. Player picks the empty lane;
				# enemy picks random (no UI for enemy decisions).
				var empty_lanes: Array[int] = []
				for i in range(LANES_PER_ROW):
					if i != lane_idx and friendly_field[i] == null:
						empty_lanes.append(i)
				if empty_lanes.size() > 0:
					var new_lane: int
					if is_enemy:
						new_lane = int(_combat_ops.pick(empty_lanes))
					else:
						new_lane = await _pick_empty_lane(my_row, lane_idx,
							"Harpy — click an empty lane in your row")
						if new_lane < 0:
							break  # player cancelled; skip remaining pulses too
					_relocate_creature(card, is_enemy, my_row, new_lane)
			"challenge":
				card.state.challenge_any_lane = true
				spawn_keyword_callout_kw(card, "challenging")

			# --- SUMMONING / TRANSFORM ---
			"summon_random":
				# 4x4: prefer empty in our row, fall through to the other row.
				var picked = _pick_empty_for_summon(is_enemy, my_row)
				if not picked.is_empty():
					summon_token(floop_data.atk, floop_data.hp, picked.lane, is_enemy, picked.row)
			"summon_token":
				var picked2 = _pick_empty_for_summon(is_enemy, my_row)
				if not picked2.is_empty():
					summon_token(floop_data.atk, floop_data.hp, picked2.lane, is_enemy, picked2.row)
			"kill_adjacent_summon":
				if is_enemy:
					# Enemy: random pick (no UI for enemy decisions).
					var adj: Array = _adjacent_creatures(is_enemy, my_row, lane_idx)
					if adj.size() > 0:
						var victim = _combat_ops.pick(adj)
						var vlane: int = victim.current_lane
						var vrow: int = victim.current_row
						victim.take_damage(999)
						summon_token(floop_data.atk, floop_data.hp, vlane, is_enemy, vrow)
				else:
					var victim = await _pick_adjacent_friendly(lane_idx, my_row,
						"Necromancer — click an adjacent friendly to kill")
					if victim != null and is_instance_valid(victim):
						var vlane: int = victim.current_lane
						var vrow: int = victim.current_row
						victim.take_damage(999)
						summon_token(floop_data.atk, floop_data.hp, vlane, is_enemy, vrow)
			"steal_atk":
				var opp = get_opposing_card(lane_idx, is_enemy)
				# Gate the drain on effective ATK so a 0-base creature buffed
				# above 0 (War Cry, Hexblade, etc.) still counts as drainable.
				# The actual subtraction still applies to base current_atk
				# because temp_atk_buff is a separate per-turn additive.
				if opp != null and opp.effective_atk() > 0:
					opp.current_atk = maxi(0, opp.current_atk - floop_data.get("value", 1))
					card.current_atk += floop_data.get("value", 1)
					opp.update_stat_display()
					card.update_stat_display()
			"devour_adjacent":
				# Devour bumps BOTH current_hp and card_data.hp (the max-HP cap).
				# Skipping card_data.hp meant the next regen/heal tick clamped
				# current_hp back down to the original cap, silently erasing
				# the devour gains. Mirrors the enemy "devour" ability path
				# (see _resolve_enemy_ability) which already does this right.
				if is_enemy:
					var adj: Array = _adjacent_creatures(is_enemy, my_row, lane_idx)
					if adj.size() > 0:
						var victim = _combat_ops.pick(adj)
						card.current_atk += victim.effective_atk()
						card.current_hp += victim.current_hp
						card.card_data.hp += victim.current_hp
						card.update_stat_display()
						victim.take_damage(999)
				else:
					var victim = await _pick_adjacent_friendly(lane_idx, my_row,
						"Corpse Eater — click an adjacent friendly to devour")
					if victim != null and is_instance_valid(victim) and is_instance_valid(card):
						card.current_atk += victim.effective_atk()
						card.current_hp += victim.current_hp
						card.card_data.hp += victim.current_hp
						card.update_stat_display()
						victim.take_damage(999)
			"blood_sacrifice":
				# Kill self, give adjacent +X ATK for the round. Counts as a real
				# sacrifice — triggers Bone Pile, Butcher's Cleaver, ON_PLAYER_SACRIFICE.
				for adj_c in _adjacent_creatures(is_enemy, my_row, lane_idx):
					adj_c.temp_atk_buff += floop_data.value
					adj_c.update_stat_display()
				if not is_enemy:
					_trigger_player_sacrifice(card)
				# Blood Pyre cantrips: draw 1 so the sacrifice replaces its own body.
				# Routed to the OWNER so a client-owned pyre in skirmish draws too.
				_battlecry_draw(is_enemy, 1)
				_force_destroy_creature(card)


# =====================================================================
#  COMBAT RESOLUTION
# =====================================================================

func _do_combat() -> void:
	_phase_caption = ""   # fresh phase narration each combat (no stale-caption leak)
	_update_hud()
	_refresh_adjacency_buffs()

	# Snapshot which lanes had a front-row blocker at start of combat. Used for
	# face-damage decisions when the blocker dies mid-combat.
	var player_front_empty_at_start: Array[bool] = []
	var enemy_front_empty_at_start: Array[bool] = []
	for i in range(LANES_PER_ROW):
		player_front_empty_at_start.append(_player_field[i] == null)
		enemy_front_empty_at_start.append(_enemy_field[i] == null)

	# Mark stunned/frozen creatures as already-attacked so they skip combat (both rows).
	for c in _all_creatures_both_sides():
		if c.state.stunned or c.state.is_frozen:
			c.has_attacked_this_turn = true

	# PHASE NARRATION: caption a sub-phase only when it will actually do
	# something, so the phase line never names an empty beat. Swift is named
	# only if a Swift creature is poised to strike (granted Swift — War Cry,
	# Battle Drummer — counts too, so the caption matches the real phase).
	for c in _all_creatures_both_sides():
		if _is_swift_attacker(c) and c.can_attack() and not c.has_attacked_this_turn:
			_set_phase_caption("SWIFT STRIKES")
			break

	# SWIFT PHASE — front row first, then back row. Both rows attack regardless
	# of whether their own column's front is occupied (back is queue space, not
	# a separate combat tier). Each strike is awaited so the swing reads as a
	# lane-by-lane cascade (lunge → impact → beat) rather than one instant burst.
	# Deaths are HELD for the whole phase (see Card2D.defer_deaths) so a Swift
	# creature slain by another Swift creature still trades its blow — Swift-vs-
	# Swift resolves simultaneously, while Swift-vs-normal still denies retaliation
	# (the normal creature isn't a Swift attacker, so it never swings this phase).
	# Swift Boots: the fight's first Swift phase with a friendly striker pays a
	# card — the pre-scan mirrors the caption check above.
	if _has_relic("swift_boots") and not _swift_boots_drawn_this_fight:
		for sb_c in _all_player_creatures():
			if _is_swift_attacker(sb_c) and sb_c.can_attack() and not sb_c.has_attacked_this_turn:
				_swift_boots_drawn_this_fight = true
				draw_one()
				_relic_fired("swift_boots")
				_show_info("Swift Boots: draw 1 after your first Swift attack.")
				break
	Card2D.defer_deaths = true
	for lane_idx in range(LANES_PER_ROW):
		await _resolve_swift_attack(lane_idx, ROW_FRONT, false)
		await _resolve_swift_attack(lane_idx, ROW_FRONT, true)
	for lane_idx in range(LANES_PER_ROW):
		await _resolve_swift_attack(lane_idx, ROW_BACK, false)
		await _resolve_swift_attack(lane_idx, ROW_BACK, true)
	Card2D.defer_deaths = false

	await _cleanup_dead_paced()

	# CLASH caption (guarded) — show only if someone is still poised to strike.
	# Snapshot the headcount so we can tell afterward whether anyone fell.
	var _alive_before_clash := _all_creatures_both_sides().size()
	for c in _all_creatures_both_sides():
		if c.can_attack() and not c.has_attacked_this_turn:
			_set_phase_caption("CLASH")
			break

	# SIMULTANEOUS COMBAT — both sides attack per lane and deaths are HELD until
	# the whole clash resolves (Card2D.defer_deaths), so a creature slain by the
	# first striker still lands its own already-scheduled blow. A mutual kill drops
	# BOTH creatures; nobody gets a de-facto Swift for attacking first. Front row
	# first, then back row. _cleanup_dead below flushes the held deaths together.
	# SERIALIZED, AND NOW VISIBLY SO (2026-07-28). This loop always resolved one
	# column at a time — front rank across lanes 0->3, then back rank — but each
	# lane got ~30 ms of exclusive attention, so eight sequential exchanges
	# presented as one burst. `_clash_lane_pass` adds the eye-dwell that makes the
	# existing structure legible, and the two ranks are now named, so the clash has
	# phase boundaries instead of one undifferentiated "CLASH".
	Card2D.defer_deaths = true
	if _rank_will_strike(ROW_FRONT):
		_set_phase_caption("THE FRONT RANK")
	for lane_idx in range(LANES_PER_ROW):
		await _clash_lane_pass(lane_idx, ROW_FRONT, enemy_front_empty_at_start,
			player_front_empty_at_start)
	if _rank_will_strike(ROW_BACK):
		_set_phase_caption("THE BACK RANK")
	for lane_idx in range(LANES_PER_ROW):
		await _clash_lane_pass(lane_idx, ROW_BACK, enemy_front_empty_at_start,
			player_front_empty_at_start)
	Card2D.defer_deaths = false
	# NAME THE BEAT BEFORE IT HAPPENS, not after (2026-07-28). A frame capture caught
	# "THE FALLEN" appearing at t=7983 ms when the flush had begun at t=7284 ms —
	# seven of eight bodies had already vanished before the screen said a word about
	# it. The old caption sat after the LAST flush and derived its count from a
	# headcount diff, so it could not fire any earlier. `_downed_count()` reads the
	# dead-but-still-standing (defer_deaths has been holding them all clash), which
	# is the same information one beat sooner.
	if _downed_count() > 0:
		_set_phase_caption("THE FALLEN")
	# Flush the held mutual kills together (on_death, slot clear, adjacency) BEFORE
	# Ranged, so snipers reach over a settled board and chain on their own real kills.
	# Paced: this is the big one — the whole clash's consequences used to land on a
	# single frame right after thirteen individually-paced strikes.
	await _cleanup_dead_paced()

	# THE DOUBLED HOUR — a side whose hour was doubled strikes a second time
	# before the ranged phase. Stunned/frozen stay benched; deaths held so the
	# second wave still resolves simultaneously.
	await _run_doubled_hour_swing(player_front_empty_at_start, enemy_front_empty_at_start)
	# Twinblade — creatures that attack twice take their second swing here.
	await _run_twinblade_swings(player_front_empty_at_start, enemy_front_empty_at_start)

	# Process Sniper attacks (the aimed quarry — else the lowest-HP enemy — any
	# lane, chaining on each kill).
	await _resolve_ranged_attacks()
	# Repeating Arbalest supplies exactly one second full attack. It resolves
	# after the normal Sniper volley so every bearer has completed attack one.
	await _run_armament_second_strikes(player_front_empty_at_start,
		enemy_front_empty_at_start)
	# Rain of Blows marks one creature for exactly one additional strike. Resolve
	# it after the normal ranged phase so a marked Sniper has completed its first
	# volley too. Doubled Hour / Twinblade already supply a second strike and do
	# not stack into an accidental third.
	await _run_battle_order_strikes(player_front_empty_at_start, enemy_front_empty_at_start)
	# The Doubled Hour also lets that side's snipers loose a second volley.
	await _run_doubled_hour_snipe()

	# Berserker growth — scan both rows on both sides. `grow` = per-attack ATK gain.
	for c in _all_creatures_both_sides():
		if c.card_data.get("passive", "") == "grow_on_attack" and c.has_attacked_this_turn:
			c.current_atk += int(c.card_data.get("grow", 1))
			c.update_stat_display()

	await _cleanup_dead_paced()
	if _clash_lane_focus != null and is_instance_valid(_clash_lane_focus):
		_clash_lane_focus.clear_focus()

	# The caption was already raised before the first flush (see above) — this is the
	# late sweep, for anything the ranged/second-swing phases killed after it. Only
	# re-raise if the caption has since moved on, so a bloodless trade still never
	# gets the word.
	var fallen_n: int = _alive_before_clash - _all_creatures_both_sides().size()
	if fallen_n > 0 and _phase_caption != "THE FALLEN":
		_set_phase_caption("THE FALLEN")
	# A mass grave is a beat, not a blink: 3+ dead in one clash gets a heavier
	# shake and holds the settled carnage a moment longer. Deliberately NOT
	# Engine.time_scale — that is global, would fight the player's anim-speed
	# preference (which already scales _short_pause), and would stretch the MP
	# replay clocks.
	if fallen_n >= 3:
		screen_shake(11.0)
		await _short_pause(HITSTOP_BEAT * 2.0)

	_post_clash_ledger()
	await _short_pause(COMBAT_PAUSE_SHORT)
	_update_hud()
	_check_game_over()
	if phase != Phase.GAME_OVER:
		_post_combat_sequence()


## The Doubled Hour: re-run the column-attack pass for each side whose hour was
## doubled this round. Creatures that already swung get their attack flag back
## (stunned/frozen stay benched); deaths are held so the second wave resolves
## simultaneously, same as the main clash. Shared by solo _do_combat and
## _net_run_clash — the flag arrays are per side (0 = player/host, 1 = enemy/client).
func _run_doubled_hour_swing(player_front_empty: Array[bool],
		enemy_front_empty: Array[bool]) -> void:
	for dh_enemy in [false, true]:
		if not _doubled_hour[1 if dh_enemy else 0]:
			continue
		_set_phase_caption("THE DOUBLED HOUR")
		_net_log_caption("THE DOUBLED HOUR")   # mirror the caption to the client's replay
		for c in _all_friendly(dh_enemy):
			if is_instance_valid(c) and not c.state.stunned and not c.state.is_frozen:
				c.has_attacked_this_turn = false
		Card2D.defer_deaths = true
		for lane_idx in range(LANES_PER_ROW):
			await _resolve_column_attack(lane_idx, ROW_FRONT, dh_enemy,
				player_front_empty if dh_enemy else enemy_front_empty)
		for lane_idx in range(LANES_PER_ROW):
			await _resolve_column_attack(lane_idx, ROW_BACK, dh_enemy,
				player_front_empty if dh_enemy else enemy_front_empty)
		Card2D.defer_deaths = false
		_cleanup_dead()


## Repeating Arbalest: reset only bearers that completed their first attack and
## run the same column/Sniper paths once more. Doubled Hour or a native
## Twinblade already supplies attack two, so those sources cap rather than stack.
func _run_armament_second_strikes(player_front_empty: Array[bool],
		enemy_front_empty: Array[bool], side_filter: int = -1) -> void:
	var repeaters: Array[Control] = []
	var has_repeating_sniper := false
	for ra_enemy in [false, true]:
		var side_idx := 1 if ra_enemy else 0
		if side_filter >= 0 and side_idx != side_filter:
			continue
		if _doubled_hour[side_idx]:
			continue
		for c in _all_friendly(ra_enemy):
			if not is_instance_valid(c) or _equipped_armament_id(c) != "repeating_arbalest":
				continue
			if c.card_data.get("passive", "") == "attacks_twice" \
					or not c.has_attacked_this_turn or c.current_hp <= 0 \
					or c.state.stunned or c.state.is_frozen:
				continue
			c.has_attacked_this_turn = false
			repeaters.append(c)
			if _is_sniper(c, ra_enemy, int(c.current_row)):
				has_repeating_sniper = true
	if repeaters.is_empty():
		return
	_set_phase_caption("REPEATING ARBALEST")
	Card2D.defer_deaths = true
	for c in repeaters:
		if not is_instance_valid(c) or c.current_hp <= 0:
			continue
		var c_is_enemy := bool(c.is_opponent)
		if _is_sniper(c, c_is_enemy, int(c.current_row)):
			continue
		await _resolve_column_attack(int(c.current_lane), int(c.current_row), c_is_enemy,
			player_front_empty if c_is_enemy else enemy_front_empty)
	Card2D.defer_deaths = false
	_cleanup_dead()
	if has_repeating_sniper:
		await _resolve_ranged_attacks(side_filter)
		_cleanup_dead()


## Rain of Blows: the marked creature strikes exactly twice this round. The main
## clash/ranged phase has already armed `has_attacked_this_turn`; unflag only the
## marked body and run the shared strike paths again so Poison, Lifesteal, Slay,
## Piercing, Thorns and net replay all remain authoritative. Existing repeaters
## do not stack with the order: their native second strike already fulfils it.
func _run_battle_order_strikes(player_front_empty: Array[bool],
		enemy_front_empty: Array[bool], side_filter: int = -1) -> void:
	var ordered: Array[Control] = []
	var has_ordered_sniper := false
	for bo_enemy in [false, true]:
		var side_idx := 1 if bo_enemy else 0
		if side_filter >= 0 and side_idx != side_filter:
			continue
		for c in _all_friendly(bo_enemy):
			if not is_instance_valid(c) or not c.state.battle_order_second_strike:
				continue
			c.state.battle_order_second_strike = false
			# Doubled Hour, Twinblade, and Repeating Arbalest already make this a
			# two-strike creature; Rain cannot turn any of them into a third attack.
			if _doubled_hour[side_idx] or c.card_data.get("passive", "") == "attacks_twice" \
					or _equipped_armament_id(c) == "repeating_arbalest":
				continue
			if not c.has_attacked_this_turn or c.current_hp <= 0 \
					or c.state.stunned or c.state.is_frozen:
				continue
			c.has_attacked_this_turn = false
			ordered.append(c)
			if _is_sniper(c, bo_enemy, int(c.current_row)):
				has_ordered_sniper = true
	if ordered.is_empty():
		return
	_set_phase_caption("RAIN OF BLOWS")
	_net_log_caption("RAIN OF BLOWS")
	Card2D.defer_deaths = true
	for c in ordered:
		if not is_instance_valid(c):
			continue
		var c_is_enemy := bool(c.is_opponent)
		if _is_sniper(c, c_is_enemy, int(c.current_row)):
			continue
		await _resolve_column_attack(int(c.current_lane), int(c.current_row), c_is_enemy,
			player_front_empty if c_is_enemy else enemy_front_empty)
	Card2D.defer_deaths = false
	_cleanup_dead()
	if has_ordered_sniper:
		await _resolve_ranged_attacks(side_filter)
		_cleanup_dead()


## The Doubled Hour, sniper edition: after the normal ranged phase, un-flag the
## doubled side's snipers so a second _resolve_ranged_attacks pass fires only them.
func _run_doubled_hour_snipe() -> void:
	if not (_doubled_hour[0] or _doubled_hour[1]):
		return
	var any_sniper := false
	for dh_enemy in [false, true]:
		if not _doubled_hour[1 if dh_enemy else 0]:
			continue
		for c in _all_friendly(dh_enemy):
			if is_instance_valid(c) and _is_sniper(c, dh_enemy, c.current_row) \
					and not c.state.stunned and not c.state.is_frozen:
				c.has_attacked_this_turn = false
				any_sniper = true
	if any_sniper:
		await _resolve_ranged_attacks()


## Twinblade (attacks_twice, reworked 2026-07-13 "Strikes its lane and an
## adjacent lane each round"): after the main clash (and any Doubled Hour), each
## creature with the passive that already swung delivers its FLANK BLOW — one
## direct strike into an adjacent column (front row before back; both adjacent
## columns open = the blow carries to the face, the same grammar as attacking
## down an empty lane). Deaths held so flank blows resolve simultaneously.
## Shared by solo _do_combat and the net clash, same as the Doubled Hour passes.
func _run_twinblade_swings(_player_front_empty: Array[bool],
		_enemy_front_empty: Array[bool]) -> void:
	# Collect the EXACT set of twinblades that just swung — never re-scan the
	# field by has_attacked_this_turn in the delivery loop. In a one-directional
	# net pass only the attacking side's flags are set, so a flag-scan would hand
	# the DEFENDER's Twinblade a free flank blow on the opponent's turn (it sits
	# at has_attacked_this_turn == false the whole pass). Un-flag them so the
	# flank blow's own strike path can re-arm and land.
	var swung: Array = []
	for tb_enemy in [false, true]:
		for c in _all_friendly(tb_enemy):
			if is_instance_valid(c) and c.card_data.get("passive", "") == "attacks_twice" \
					and c.has_attacked_this_turn \
					and not c.state.stunned and not c.state.is_frozen:
				c.has_attacked_this_turn = false
				swung.append(c)
	if swung.is_empty():
		return
	Card2D.defer_deaths = true
	for tb_enemy in [false, true]:
		for row in [ROW_FRONT, ROW_BACK]:
			for lane_idx in range(LANES_PER_ROW):
				var c = _row_array(tb_enemy, row)[lane_idx]
				if c != null and is_instance_valid(c) and c in swung \
						and not c.has_attacked_this_turn:
					await _twinblade_flank_blow(c, lane_idx, tb_enemy)
	Card2D.defer_deaths = false
	_cleanup_dead()


## The flank blow's mark: scan the opposing columns adjacent to the Twinblade's
## own (lane-1 before lane+1), front row before back — the first living body
## found eats the strike. Null = both adjacent columns are open.
func _twinblade_flank_target(lane_idx: int, tb_enemy: bool) -> Control:
	var opp_is_enemy := not tb_enemy
	for row in [ROW_FRONT, ROW_BACK]:
		for adj_lane in [lane_idx - 1, lane_idx + 1]:
			if adj_lane < 0 or adj_lane >= LANES_PER_ROW:
				continue
			var t = _row_array(opp_is_enemy, row)[adj_lane]
			if t != null and is_instance_valid(t) and t.current_hp > 0:
				return t
	return null


func _twinblade_flank_blow(card: Control, lane_idx: int, tb_enemy: bool) -> void:
	if not card.can_attack():
		card.has_attacked_this_turn = true
		return
	var target := _twinblade_flank_target(lane_idx, tb_enemy)
	if target == null:
		# Both adjacent columns open — the blow carries to the face
		# (_creature_hits_face marks the swing spent + runs the riders).
		await _creature_hits_face(card, lane_idx, tb_enemy)
		return
	# Full shared strike (thorns, on-hit passives, riders, net beats). The lane
	# passed is the DEFENDER's column so Piercing overflow punches down the
	# struck lane, not the Twinblade's own.
	var t_pos := _find_creature_position(target)
	var strike_lane: int = int(t_pos.get("lane", lane_idx)) if not t_pos.is_empty() else lane_idx
	await _creature_attacks_creature(card, target, strike_lane, tb_enemy)


## Forked Spear: after its bearer spends a normal attack, make one full strike
## into each occupied adjacent enemy lane (left, then right). Empty lanes never
## become face damage. Each strike uses the ordinary combat resolver, so Thorns,
## Poison, Piercing, Lifesteal, Slay, redirection, and damage reactions stay real.
func _run_forked_spear_strikes(attacker: Control, lane_idx: int,
		is_enemy: bool) -> void:
	if attacker == null or not is_instance_valid(attacker) or attacker.current_hp <= 0:
		return
	if _equipped_armament_id(attacker) != "forked_spear":
		return
	var opp_is_enemy := not is_enemy
	for adj_lane in [lane_idx - 1, lane_idx + 1]:
		if adj_lane < 0 or adj_lane >= LANES_PER_ROW:
			continue
		if not is_instance_valid(attacker) or attacker.current_hp <= 0 \
				or attacker.state.stunned or attacker.state.is_frozen:
			break
		var target: Control = null
		var target_row := ROW_FRONT
		for r in [ROW_FRONT, ROW_BACK]:
			var candidate = _row_array(opp_is_enemy, r)[adj_lane]
			if candidate != null and is_instance_valid(candidate) \
					and candidate.current_hp > 0 and not candidate.has_keyword("structure"):
				target = candidate
				target_row = r
				break
		if target == null:
			continue
		target = _redirect_target(target, opp_is_enemy, adj_lane, target_row, attacker)
		if target == null or not is_instance_valid(target) or target.current_hp <= 0:
			continue
		var target_pos: Dictionary = _find_creature_position(target)
		var strike_lane: int = int(target_pos.get("lane", adj_lane)) \
			if not target_pos.is_empty() else adj_lane
		await _creature_attacks_creature(attacker, target, strike_lane, is_enemy)


func _focus_combat_lane(lane_idx: int, enemy_strike: bool) -> void:
	# SKIRMISH GETS THIS TOO (2026-07-29). It used to bail on `_is_net()` alongside
	# the pacing beats, but the spotlight is not a beat — it adds no time and
	# suspends nothing, so none of the reasoning that keeps `_lane_dwell` and
	# `_round_beat` out of the net turn machine applies to it. CombatNet's clash
	# calls `_resolve_column_attack` directly (CombatNet.gd:1488-1495), so the mark
	# simply works there. This is the one piece of the legibility pass skirmish can
	# have for free; the timing-based half stays solo-only by design.
	if _clash_lane_focus == null or not is_instance_valid(_clash_lane_focus):
		return
	# THIS IS INFORMATIONAL, NOT DECORATIVE (reclassified 2026-07-28).
	#
	# It used to bail here under Reduce Motion, on the reasoning that "the attack
	# and its information do not depend on this spotlight". That was true when the
	# clash was an undifferentiated burst and the spotlight was garnish. It is not
	# true now: the serialized clash resolves ONE COLUMN AT A TIME, and this mark is
	# the only thing that says WHICH column — i.e. where to point your eyes. A
	# player on Reduce Motion needs that more than anyone, not less.
	#
	# Reduce Motion still gets its guarantee — ClashLaneFocus.focus_lane snaps to
	# full strength instead of ramping, so nothing animates. See the house rule in
	# CLAUDE.md: informational animations always play; they hold steady rather than
	# pulse under Reduce Motion.
	var inv: Transform2D = _clash_lane_focus.get_global_transform().affine_inverse()
	var player_rect: Rect2 = _lane_rect(false, lane_idx, inv)
	var enemy_rect: Rect2 = _lane_rect(true, lane_idx, inv)
	var lane_rect := player_rect
	if lane_rect.size.x <= 0.0 or lane_rect.size.y <= 0.0:
		lane_rect = enemy_rect
	elif enemy_rect.size.x > 0.0 and enemy_rect.size.y > 0.0:
		lane_rect = lane_rect.merge(enemy_rect)
	if lane_rect.size.x > 0.0 and lane_rect.size.y > 0.0:
		_clash_lane_focus.focus_lane(lane_rect.grow(12.0), enemy_strike)

## Resolve ONE column's exchange (both sides) and then let the eye rest on it.
## This is the unit of the serialized clash: spotlight lands, both sides in this
## column swing, the result holds long enough to read, then the spotlight moves on.
func _clash_lane_pass(lane_idx: int, row: int, enemy_front_empty: Array[bool],
		player_front_empty: Array[bool]) -> void:
	var acted := _lane_will_strike(lane_idx, row)
	var downed_before := _downed_count()
	var face_before: int = player_hp + enemy_hp
	var board_before := _total_board_hp()
	await _resolve_column_attack(lane_idx, row, false, enemy_front_empty)
	await _resolve_column_attack(lane_idx, row, true, player_front_empty)
	if not acted:
		return
	# SPEND THE ATTENTION BUDGET WHERE THE INFORMATION IS (2026-07-29).
	#
	# Every lane used to get the same dwell whether it decided the fight or chipped
	# two HP off a wall, which is how serializing cost +69% wall clock (9.3 s ->
	# 15.7 s on a full board) and pushed past Nielsen's 10 s. But the two defensible
	# pacing modes from §1 are not exclusive — they can be chosen PER LANE:
	#   * a lane that killed something, broke through to a face, or landed a heavy
	#     blow is a separate event and gets a real >=300 ms dwell to be registered;
	#   * a lane that only chipped HP is not worth its own registration slot, so it
	#     FUSES with its neighbour at a sub-causality-window beat instead.
	# That buys back most of the time on quiet boards while making the beats that
	# matter *relatively* louder, which is the actual goal — the eye should be
	# pulled to the lane that decided something, not metronomed across four equals.
	var killed := _downed_count() > downed_before
	var hit_face: bool = (player_hp + enemy_hp) != face_before
	var swing: int = absi(board_before - _total_board_hp())
	if killed:
		await _lane_dwell(true)
	elif hit_face or swing >= HEAVY_HIT_DAMAGE:
		await _lane_dwell(false)
	else:
		await _lane_dwell_minor()


## Total HP standing on both boards — the cheap "did this lane actually do
## anything worth stopping for" probe. Counts the dead-but-still-standing too;
## their HP is 0 either way so it does not distort the delta.
func _total_board_hp() -> int:
	var n := 0
	for c in _all_creatures_both_sides():
		if is_instance_valid(c):
			n += maxi(int(c.current_hp), 0)
	return n


## True if either side has a body in this column+row that is about to swing.
## Skips the dwell on a column where nothing happens — a pause on an empty lane is
## the same mistake as a phase caption naming an empty beat. Mirrors the guards at
## the top of _resolve_column_attack (spent / can't attack / sniper) so the two
## cannot disagree about whether this column is live.
func _lane_will_strike(lane_idx: int, row: int) -> bool:
	for side_is_enemy in [false, true]:
		var c = _row_array(side_is_enemy, row)[lane_idx]
		if c == null or not is_instance_valid(c):
			continue
		if c.has_attacked_this_turn or not c.can_attack():
			continue
		if _is_sniper(c, side_is_enemy, row):
			continue   # snipers sit out the column clash; they fire in the ranged phase
		return true
	return false


## True if any column in this rank is about to swing — gates the rank caption.
func _rank_will_strike(row: int) -> bool:
	for lane_idx in range(LANES_PER_ROW):
		if _lane_will_strike(lane_idx, row):
			return true
	return false


## Bodies standing at or below 0 HP right now. During the clash `Card2D.defer_deaths`
## holds corpses on the board, so this counts the dead-but-still-standing — exactly
## what "did this lane produce a kill" has to ask, since the flush has not run yet.
func _downed_count() -> int:
	var n := 0
	for c in _all_creatures_both_sides():
		if is_instance_valid(c) and c.current_hp <= 0:
			n += 1
	return n


func _resolve_column_attack(lane_idx: int, row: int, is_enemy: bool,
		opponent_front_empty: Array[bool]) -> void:
	# Attempt to attack from (is_enemy, row, lane_idx). Front and back rows are
	# mechanically identical — both attack each turn, front just goes first.
	var attacker_field = _row_array(is_enemy, row)
	var attacker = attacker_field[lane_idx]
	if attacker == null or not is_instance_valid(attacker):
		return
	if attacker.has_attacked_this_turn:
		return
	if not attacker.can_attack():
		return
	# Snipers don't fight their own column — they resolve later in the dedicated
	# ranged phase (_resolve_ranged_attacks), striking their aimed quarry (else
	# the lowest-HP enemy) and chaining on kills. Skipping here is what makes
	# Sniper actually fire: before
	# this guard, snipers attacked their column first, set has_attacked_this_turn,
	# and were then skipped by the ranged phase — so the snipe never happened.
	if _is_sniper(attacker, is_enemy, row):
		return
	_focus_combat_lane(lane_idx, is_enemy)

	# Pick target: opposing front in this column, else opposing back, else face.
	var opp_is_enemy = not is_enemy
	var opp_front = _row_array(opp_is_enemy, ROW_FRONT)[lane_idx]
	var opp_back = _row_array(opp_is_enemy, ROW_BACK)[lane_idx]

	# Hydra (passive) OR Charge! spell (per-turn meta): strikes every opposing
	# creature at once (Hydra takes each defender's counter back; Charge! takes 1).
	if attacker.card_data.get("passive", "") == "attacks_all_lanes" or attacker.state.charges_this_turn:
		await _resolve_hydra_attack(attacker, lane_idx, is_enemy)
		return
	# Siege Golem: a wall-breaker — only lands (face) damage through an empty
	# opposing column; blocked entirely if any creature stands opposite it.
	if attacker.card_data.get("passive", "") == "siege":
		attacker.has_attacked_this_turn = true
		if opp_front == null and opp_back == null and opponent_front_empty[lane_idx]:
			await _creature_hits_face(attacker, lane_idx, is_enemy)
		return

	# Structures (Pyres, Mausoleums, Altars, etc.) are board objects, not
	# combatants — they fill back-row slots but never absorb hits. If the
	# back-row slot holds a structure, treat the column as empty for attack
	# resolution: the attacker either bypasses through to face (if the front
	# is also empty) or just hits the front normally.
	if opp_front != null and opp_front.current_hp > 0:
		await _creature_attacks_creature(attacker, _redirect_target(opp_front, opp_is_enemy, lane_idx, ROW_FRONT, attacker), lane_idx, is_enemy)
	elif opp_back != null and opp_back.current_hp > 0 and not opp_back.is_inert_structure():
		# Front died or never existed — back row is now exposed.
		await _creature_attacks_creature(attacker, _redirect_target(opp_back, opp_is_enemy, lane_idx, ROW_BACK, attacker), lane_idx, is_enemy)
	else:
		# NOTHING LEFT STANDING IN THIS COLUMN → face damage (also fires if the
		# only thing in the back is a non-attackable structure).
		#
		# This used to read `opponent_front_empty[lane_idx]` — a snapshot taken
		# BEFORE the clash's first blow (see _do_combat). That made a blocker which
		# died earlier in the same clash go on denying the column: a second attacker
		# into the freshly-emptied lane found a corpse it couldn't hit and an arm it
		# couldn't reach, and simply dealt NOTHING. A 1-cost 0/4 Palisade facing a
		# 5/5 + 4/4 column absorbed 5 and BLANKED 4 more — 9 damage denied for one
		# Command, which is most of why cheap chaff walled as well as real bodies.
		# Mutual trades do not depend on this: Card2D.defer_deaths holds the corpse
		# on the board for the whole clash and can_attack() never reads HP, so a
		# creature slain by the first striker still lands its own scheduled blow.
		await _creature_hits_face(attacker, lane_idx, is_enemy)

	# Cleave: after the main hit, deal 1 to each adjacent opposing creature
	# (front preferred, back if front empty). Splash damage; does not trigger
	# poison or piercing — it's a rider, not a real attack.
	if is_instance_valid(attacker) and attacker.card_data.get("passive", "") == "cleave":
		_apply_cleave_splash(attacker, lane_idx, is_enemy)
	if is_instance_valid(attacker) and attacker.has_attacked_this_turn:
		await _run_forked_spear_strikes(attacker, lane_idx, is_enemy)


# ── Extra Attack — a relic-ordered single strike ───────────────────────────
# The shared verb behind the "…makes an Extra Attack" relics (Thrown Gauntlet,
# Murder-Hole Key, Warlord's Standard, Apothecary's Toast, Ember Crown, the
# Cursed Key / Penitent's Collar / Mark of Pain doctrines, Warm Knucklebone,
# Black Wax Seal, …). The creature makes ONE immediate normal attack outside
# the clash: opposing front in its column, else opposing back, else the enemy
# face. The defender counters normally and every rider (Slay/Rampage/Lifesteal/
# Thorns/Piercing) fires — it routes through _creature_attacks_creature, the
# same primitive the clash uses. It does NOT spend the creature's regular clash
# attack (has_attacked_this_turn is left untouched on purpose). A relic-ordered
# Extra Attack can never order another one: _relic_extra_attack_active guards
# re-entry so two order-relics can't ping-pong into a loop.
var _relic_extra_attack_active: bool = false

func _extra_attack(attacker: Control, is_enemy: bool) -> void:
	if attacker == null or not is_instance_valid(attacker) or attacker.current_hp <= 0:
		return
	if _relic_extra_attack_active:
		return
	if not attacker.can_attack():
		return
	var pos: Dictionary = _find_creature_position(attacker)
	if pos.is_empty():
		return
	var lane_idx: int = int(pos.get("lane", 0))
	var opp_is_enemy: bool = not is_enemy
	var opp_front = _row_array(opp_is_enemy, ROW_FRONT)[lane_idx]
	var opp_back = _row_array(opp_is_enemy, ROW_BACK)[lane_idx]
	_relic_extra_attack_active = true
	if opp_front != null and is_instance_valid(opp_front) and opp_front.current_hp > 0:
		await _creature_attacks_creature(attacker, _redirect_target(opp_front, opp_is_enemy, lane_idx, ROW_FRONT, attacker), lane_idx, is_enemy)
	elif opp_back != null and is_instance_valid(opp_back) and opp_back.current_hp > 0 and not opp_back.is_inert_structure():
		await _creature_attacks_creature(attacker, _redirect_target(opp_back, opp_is_enemy, lane_idx, ROW_BACK, attacker), lane_idx, is_enemy)
	else:
		await _creature_hits_face(attacker, lane_idx, is_enemy)
	_relic_extra_attack_active = false


func _resolve_swift_attack(lane_idx: int, row: int, is_enemy: bool) -> void:
	var attacker_field = _row_array(is_enemy, row)
	var card = attacker_field[lane_idx]
	if card == null or card.has_attacked_this_turn or not card.can_attack():
		return
	# Swift can also be granted: War Cry's per-turn rally or a Battle Drummer
	# beating beside this creature (both meta flags — see _is_swift_attacker).
	if not _is_swift_attacker(card):
		return
	# RESOLVE THE TARGET BEFORE COMMITTING TO THE ANIMATION. This block used to sit
	# AFTER the lunge and its LUNGE_APEX await, so a Swift body played into an
	# empty column performed a full attack swing and then had _creature_hits_face
	# refuse it under the Rush rule — a phantom swing that dealt nothing, which is
	# the exact thing that function's own comment says it returns early to prevent.
	var opp_is_enemy = not is_enemy
	var opp_front = _row_array(opp_is_enemy, ROW_FRONT)[lane_idx]
	var opp_back = _row_array(opp_is_enemy, ROW_BACK)[lane_idx]
	var opponent: Control = null
	if opp_front != null:
		opponent = _redirect_target(opp_front, opp_is_enemy, lane_idx, ROW_FRONT, card)
	elif opp_back != null and not opp_back.is_inert_structure():
		# Structures are board objects — Swift attackers slip past them to
		# face damage (handled below) instead of plinking the Pyre.
		opponent = _redirect_target(opp_back, opp_is_enemy, lane_idx, ROW_BACK, card)

	# The flag is still spent either way, so a body that held the line does not
	# then get a second swing in the main clash (Swift ignores the muster delay,
	# so can_attack() would otherwise let it through). Behaviour here is unchanged
	# — only the ANIMATION is now conditional.
	card.has_attacked_this_turn = true
	if opponent == null and not _can_reach_face(card):
		return

	_focus_combat_lane(lane_idx, is_enemy)
	if card.has_method("play_attack_lunge"):
		card.play_attack_lunge(
			_lunge_strength(_effective_attack(card, lane_idx, is_enemy)))
	_net_log_lunge(card)
	await _short_pause(LUNGE_APEX)
	if not is_instance_valid(card):
		return
	# The target was resolved before the await; it may have been freed since.
	if opponent != null and not is_instance_valid(opponent):
		opponent = null

	if opponent != null:
		var atk = _effective_attack(card, lane_idx, is_enemy)
		# Marked/enrage vulnerability bonus damage (mirror the column-attack path)
		if opponent.state.marked:
			atk += 2
		if opponent.state.enrage_vulnerable:
			atk += 1
		_play_attack_tracer(_card_center(card), _card_center(opponent),
			is_enemy, float(atk), atk >= HEAVY_HIT_DAMAGE)
		if opponent.has_method("play_hit_recoil"):
			opponent.play_hit_recoil(is_enemy)
		_apply_thorns(opponent, card, not is_enemy)
		atk = _creature_strike_amount(opponent, atk, is_enemy)
		var swift_hp_before: int = opponent.current_hp
		_log_event("%s strikes %s for [color=#f2e6c8]%d[/color]." \
			% [_log_card_ref(card), _log_card_ref(opponent), atk],
			_log_data(card), _log_side(card))
		var swift_dmg: int = _deal_creature_strike_damage(opponent, atk)
		# Poison: swift attacker with Poison kills defender on any hit.
		# Virulence (Unclean Blessing) makes the whole side's attacks poisonous.
		_apply_creature_strike_poison(card, opponent, is_enemy, swift_dmg)
		_apply_creature_struck_growth(opponent, swift_dmg)
		if is_instance_valid(opponent) and atk > 0:
			_apply_struck_passives(opponent, card, not is_enemy, swift_dmg)
		_net_log_hit(card, opponent, swift_hp_before)
		var was_lethal: bool = opponent.current_hp <= 0
		if is_instance_valid(card) and is_instance_valid(opponent):
			_spawn_impact_burst(_strike_contact_point(card, opponent),
				_card_center(opponent) - _card_center(card), float(atk), was_lethal)
		if was_lethal:
			_apply_piercing_overflow(card, opponent, lane_idx, is_enemy, {},
				_strike_reaches_face(card, is_enemy))
		# Keyword riders: Lifesteal (heal = damage dealt) + Rampage (+ATK on kill).
		_apply_combat_strike_riders(card, swift_dmg, was_lethal, is_enemy, opponent)
		# Same comprehension window as the clash — see _impact_hold. The Swift
		# phase used to punctuate on the old two-valued 130/260 split.
		# (Shake is owned by _deal_creature_strike_damage — see the clash path.)
		await _short_pause(_impact_hold(atk, was_lethal))
	else:
		# Nothing standing in the column — same live read as the clash path, and
		# for the same reason (see _resolve_column_attack's face arm). The Swift
		# phase reaches it far less often: opponent is picked off a non-null slot
		# regardless of HP, and defer_deaths keeps corpses in the array.
		await _creature_hits_face(card, lane_idx, is_enemy)
	if is_instance_valid(card):
		await _run_forked_spear_strikes(card, lane_idx, is_enemy)


func _apply_cleave_splash(attacker: Control, lane_idx: int, is_enemy: bool) -> void:
	# Cleave Hound: after the main hit, deal 1 to each creature adjacent to the
	# struck seat (canonical adjacency: its row ±1 + its column-mate — so the
	# axe now clips the body stacked behind a struck front-liner). The seat is
	# the column's front if occupied, else the back (matching where the main
	# hit landed; a face hit anchors on the empty front seat). Pure splash;
	# doesn't trigger thorns/poison/piercing.
	if not is_instance_valid(attacker):
		return
	var opp_is_enemy = not is_enemy
	var struck_row: int = ROW_FRONT
	if _row_array(opp_is_enemy, ROW_FRONT)[lane_idx] == null \
			and _row_array(opp_is_enemy, ROW_BACK)[lane_idx] != null:
		struck_row = ROW_BACK
	for target in _adjacent_creatures(opp_is_enemy, struck_row, lane_idx):
		if target.current_hp > 0:
			var splash_hp_before: int = int(target.current_hp)
			target.take_damage(1)
			_net_log_hit(attacker, target, splash_hp_before)


## Does this striker's overflow read on past an empty column into the enemy
## themselves? Piercing (printed, encounter-granted, or Inspire-lent) and Bodkin
## Points buy that; a plain OVERKILL spill stops at the body behind. One helper so
## the three strike paths — clash, Swift, sniper — can never drift apart.
## WHERE THE BLOW ACTUALLY LANDS (2026-07-30, STRIKE_DESIGN §2.3).
##
## There was no contact point anywhere in the strike path: _spawn_impact_burst
## was handed _card_center(defender), so the spark erupted from the MIDDLE OF THE
## PAINTING — the one surface ★4's ink spatter was reverted for touching. The
## blow said "it landed somewhere inside this card" when the whole point of a
## contact spark is to say "it landed HERE".
##
## Returns the point where the attacker->defender segment crosses the defender's
## rect boundary, so it is orientation-agnostic by construction: a Guardian
## redirect that pulls the hit a lane sideways, or a back-row body reaching over
## its own front rank, both land on the correct edge without special cases.
func _strike_contact_point(attacker: Control, defender: Control) -> Vector2:
	if defender == null or not is_instance_valid(defender):
		return Vector2.ZERO
	var d: Vector2 = _card_center(defender)
	if attacker == null or not is_instance_valid(attacker):
		return d
	var dir: Vector2 = d - _card_center(attacker)
	if dir.length_squared() < 1.0:
		return d
	var n: Vector2 = dir.normalized()
	var half: Vector2 = defender.size * defender.scale * 0.5
	var tx: float = 1e9 if absf(n.x) < 0.0001 else half.x / absf(n.x)
	var ty: float = 1e9 if absf(n.y) < 0.0001 else half.y / absf(n.y)
	return d - n * minf(tx, ty)


func _strike_reaches_face(attacker: Control, attacker_is_enemy: bool) -> bool:
	if attacker == null or not is_instance_valid(attacker):
		return false
	if attacker.has_keyword("piercing"):
		return true
	if attacker_is_enemy and _has_encounter_passive_keyword(attacker, "piercing"):
		return true
	if attacker.state.inspire_piercing:
		return true
	return not attacker_is_enemy and _has_relic("piercing_crown")


func _apply_piercing_overflow(attacker: Control, victim: Control, lane_idx: int,
		is_enemy: bool, victim_pos: Dictionary = {}, reach_face: bool = true) -> void:
	# Overflow damage from a lethal strike spills to the next creature in the same
	# opposing column (front→back), then to face if nothing is left in the column.
	#
	# TWO RULES RIDE THIS ONE FUNCTION (2026-07-28 blocker-economy pass):
	#   OVERKILL  (reach_face = false) — universal, no keyword. Every killing blow
	#             carries its excess into the body standing behind, then STOPS.
	#             This is what makes HP a real currency: before it, a body absorbed
	#             one WHOLE attack regardless of its size, so a 1-cost 1/2 and a
	#             2-cost 3/4 both denied exactly 3.0 damage per Command and the
	#             stat curve was flat. Chump-blocking is now damage REDUCTION
	#             (equal to the chump's HP), not damage NEGATION.
	#   PIERCING  (reach_face = true) — the keyword, plus Bodkin Points and
	#             inspire_piercing. Same spill, but it carries all the way to the
	#             face. That is the whole remaining premium of the keyword, so
	#             don't let overkill leak facewards or Piercing prints blank.
	var excess = abs(victim.current_hp)
	var total = excess
	if total <= 0:
		return
	# The announce + the mark are fired further down, once the SPILL TARGET is
	# known: the rubric stroke has to end on the body that actually receives the
	# overflow, and drawing it before we know that is what made the old lance a
	# fixed 130 px stub pointing into empty space.
	var opp_is_enemy = not is_enemy
	# Spill into the VICTIM's own column, not the attacker's lane. A Guardian /
	# redirecting Royal Guard pulls the hit one lane over, so the slain blocker can
	# sit in a different column than lane_idx — trusting lane_idx there spilled the
	# overflow to face instead of the creature standing behind the blocker. The
	# victim is still in the board arrays at this point (death cleanup runs later),
	# so _find_creature_position resolves it; fall back to lane_idx if it doesn't.
	var spill_lane: int = lane_idx
	var spill_is_enemy: bool = opp_is_enemy
	var victim_is_front: bool = true
	var vpos := victim_pos if not victim_pos.is_empty() else _find_creature_position(victim)
	if not vpos.is_empty():
		spill_lane = int(vpos["lane"])
		spill_is_enemy = bool(vpos["is_enemy"])
		victim_is_front = int(vpos["row"]) == ROW_FRONT
	# If we killed a front-row creature, spill to the back creature in its column.
	var back_card = _row_array(spill_is_enemy, ROW_BACK)[spill_lane]
	var spills_to_body: bool = victim_is_front and back_card != null and back_card.current_hp > 0
	# THE RUBRIC (2026-07-28) — see scripts/ui/painters/RubricStroke.gd.
	#
	# The mark is drawn ONLY when the overflow actually reaches something, and it
	# ENDS on the receiver. A plain overkill with nobody standing behind carries
	# nowhere, so it gets no mark: the old lance drew its skewer regardless, which
	# taught that something had carried when nothing had.
	#
	# The WORD is kept for PIERCING and dropped for OVERKILL. Piercing is a
	# keyword the player paid for and it should announce itself; overkill is
	# universal, has no keyword, and — now that Card2D caps the victim's floating
	# numeral to life actually lost — its two numerals finally add up to the
	# attacker's ATK, which teaches the rule better than a chip ever did.
	if reach_face and is_instance_valid(attacker):
		var pierce_pos := attacker.global_position + Vector2(attacker.size.x * attacker.scale.x * 0.5, -12)
		spawn_keyword_callout(pierce_pos, "PIERCING %d" % total,
			_CALLOUT_STYLE["piercing"]["col"], GameTheme.get_keyword_icon("piercing"))
		# Visual parity: replay this on the client too, anchored on the attacker eid
		# (it survives a piercing kill, so it's a reliable anchor — see _net_fx_queue).
		if _is_host() and int(attacker.entity_id) >= 0:
			var pc: Color = _CALLOUT_STYLE["piercing"]["col"]
			_net_fx_queue.append({
				"eid": int(attacker.entity_id),
				"label": "PIERCING %d" % total,
				"col": [pc.r, pc.g, pc.b],
			})
	if is_instance_valid(victim):
		var rub_end := Vector2.ZERO
		var rub_recv: Control = null
		if spills_to_body:
			rub_end = _card_center(back_card)
			rub_recv = back_card
		elif reach_face:
			# Piercing's terminus is the enemy's own plate, ~400 px off the board.
			# No other body-blow in the game touches it, which makes an ABSOLUTE
			# tell out of what is otherwise only a comparative one (length).
			var plate: Label = _player_hp_label if is_enemy else _enemy_hp_label
			if plate != null and is_instance_valid(plate):
				rub_end = plate.get_global_rect().get_center()
		if rub_end != Vector2.ZERO:
			_play_rubric_stroke(victim, rub_end, rub_recv, reach_face)
			# Replay the mark on the client — INCLUDING where it ends. A mark that
			# terminates on a body carries its receiver's eid; one that reads on to a
			# hero carries that hero's owner index, matching the face-hit entries'
			# `f`. The client must never re-derive either. (is_enemy is the ATTACKER's
			# side, so the plate struck is the opposite one.)
			var rub_face_owner: int = -1
			if rub_recv == null and reach_face:
				rub_face_owner = 0 if is_enemy else 1
			_net_log_pierce(attacker, victim, rub_recv, rub_face_owner, reach_face)
	if spills_to_body:
		var spill_hp_before: int = int(back_card.current_hp)
		back_card.take_damage(total)
		_net_log_hit(attacker, back_card, spill_hp_before)
		return
	# OVERKILL STOPS HERE. Only Piercing (reach_face) reads on past an empty
	# column into the enemy themselves — see the two-rule note at the top.
	if not reach_face:
		return
	# Otherwise go face. Attack damage, not an effect (piercing spill rides the
	# strike that caused it) — from_effect=false keeps the clash log honest.
	#
	# THE RUSH RULE APPLIES HERE TOO. Spill is still the attacker reaching the
	# face, so a body in its arrival round may not deliver it — Swift breaks
	# BODIES on arrival, never the enemy themselves, and Charge is the one
	# keyword that buys the exception. _creature_hits_face guards this; without
	# the same guard here a Swift+Piercing body leaked face damage on round 1
	# through the overflow path (live in 21 encounters). The column damage above
	# has already been dealt — only the face portion is withheld.
	if not _can_reach_face(attacker):
		return
	if is_enemy:
		damage_player_hero(total, false)
	else:
		damage_enemy_hero(total, false, spill_lane)


# ═══════════════════════════════════════════
#  KEYWORD RIDERS — doom / rampage / lifelink
# ═══════════════════════════════════════════

## A sacrifice or an expired Doom is a death condition, not a damage hit. Clear
## one-hit survival gates before using Card2D's normal death pipeline so Shield
## and Last Stand cannot keep the body while still paying sacrifice/detonation
## rewards. On-Death, relic, reactive, pile and net hooks still fire normally.
func _force_destroy_creature(card: Control) -> void:
	if card == null or not is_instance_valid(card) or card.current_hp <= 0:
		return
	card.state.has_shield = false
	if _deal_siege_removal_damage(card):
		return
	card.last_stand_used = true
	card.take_damage(999)


func _detonate_doom(card: Control) -> void:
	if card == null or not is_instance_valid(card) or card.current_hp <= 0:
		return
	if card not in _doom_detonation_queue:
		_doom_detonation_queue.append(card)
	if _doom_detonation_active:
		return
	_doom_detonation_active = true
	while not _doom_detonation_queue.is_empty():
		var next: Control = _doom_detonation_queue.pop_front()
		if next != null and is_instance_valid(next) and next.current_hp > 0:
			_resolve_queued_doom_detonation(next)
	_doom_detonation_active = false


func _tick_doom_counter(card: Control, delta: int, detonate_at_zero: bool) -> bool:
	if card == null or not is_instance_valid(card) or card.current_hp <= 0 \
			or not card.has_keyword("doom"):
		return false
	if card.has_method("_ensure_doom_init"):
		card._ensure_doom_init()
	card.doom_counter += delta
	card.card_data["doom"] = card.doom_counter
	if card.has_method("update_doom_display"):
		card.update_doom_display()
	if card.has_method("flash_doom_tick"):
		card.flash_doom_tick()
	if detonate_at_zero and card.doom_counter <= 0:
		_detonate_doom(card)
	return true


func _resolve_queued_doom_detonation(card: Control) -> void:
	# Doom hit 0: the creature explodes into the OPPOSING face. Then it dies
	# through the canonical destroy path (take_damage(999) → try_die →
	# _on_card_destroyed) so on_death effects, relics, and reactive passives all
	# fire normally — no hand-rolled death.
	if card == null or not is_instance_valid(card):
		return
	_resolve_doom_blast(card, int(card.current_lane), int(card.current_row),
		bool(card.is_opponent), false)
	# Canonical forced destroy — fires on_death / relics / reactives uniformly,
	# while Shield / Last Stand cannot turn one Doom into repeat detonations.
	if is_instance_valid(card) and card.current_hp > 0:
		_force_destroy_creature(card)


## A FUSE CUT SHORT STILL GOES UP (2026-07-28). The death-path entry to the same
## detonation, for a body killed BEFORE its counter reached 0 — which under this
## game's attrition (bodies die in 1-2 rounds) was the common case, and used to
## forfeit the card's entire payoff. The blast falls on the LANE it was standing
## in instead of the face, so the timer still buys something and where a fuse is
## posted starts to matter.
##
## It cannot double-fire with the timed path: EVERY detonation zeroes the counter
## first (see _resolve_doom_blast), so `doom_counter > 0` IS the "this fuse is
## still live" test. That matters because several callers (Powder Cart's
## detonate_dooms, Mark of Ash, Frenzy, the Doomsday Draught) queue a detonation
## on a body whose counter is still positive, and the destroy that follows
## re-enters the death path right here.
##
## Reads the caller's lane/row/side census rather than the corpse's own fields:
## _on_card_destroyed has already unseated the body before it dispatches.
func _detonate_doom_early(card: Control, lane: int, row: int, was_enemy: bool) -> void:
	if card == null or not is_instance_valid(card) or lane < 0:
		return
	if not card.has_keyword("doom"):
		return
	if card.has_method("_ensure_doom_init"):
		card._ensure_doom_init()
	if int(card.doom_counter) <= 0:
		return   # the timer already spent this fuse
	_resolve_doom_blast(card, lane, row, was_enemy, true)


## The early blast's footprint: the OPPOSING column — both rows of the lane the
## fuse was standing in — and nothing else. Never a face; reaching the face is
## precisely what protecting the fuse buys. An empty column eats the blast, which
## is the positional cost of posting a fuse where nobody is standing.
func _doom_blast_lane(lane: int, is_enemy: bool, dmg: int) -> void:
	if lane < 0 or lane >= LANES_PER_ROW or dmg <= 0:
		return
	for row in [ROW_FRONT, ROW_BACK]:
		var arr: Array = _row_array(not is_enemy, row)
		if lane >= arr.size():
			continue
		var victim = arr[lane]
		if victim != null and is_instance_valid(victim) and victim.current_hp > 0:
			victim.take_damage(dmg)


## THE ONE DETONATION RESOLVER. Two ways a fuse goes up, one body of rules:
##   TIMED (`early = false`) — the counter reached 0 (the round tick, Touchpaper,
##       Mark of Ash, a Powder Cart). The blast reaches the OPPOSING FACE.
##   EARLY (`early = true`)  — the body was killed first. The blast falls on the
##       opposing column of its lane and NEVER reaches a face.
## Damage is the card's doom_damage override, else its current effective ATK.
## Everything around the damage — Chain Censer's chain, Ember Censer's +1, the
## Doom Herald draw, the bloom/shake/sound — is shared, because both really are
## detonations. Only Sexton's Spade is face-only, because it doubles face damage.
##
## The counter is zeroed up front and THAT is the one-shot latch for both
## directions (see _detonate_doom_early).
func _resolve_doom_blast(card: Control, lane: int, row: int, is_enemy: bool,
		early: bool) -> void:
	if card == null or not is_instance_valid(card):
		return
	if card.has_method("_ensure_doom_init"):
		card._ensure_doom_init()
	card.doom_counter = 0
	card.card_data["doom"] = 0
	if card.has_method("update_doom_display"):
		card.update_doom_display()
	var dmg: int = int(card.card_data.get("doom_damage", card.effective_atk()))
	# Chain Censer (Kindler doctrine) — the round's first detonation walks the
	# fuse line. CANONICAL adjacency (2026-07-28 fix): row ±1 PLUS the
	# column-mate, the same reading its own hero's Fuse Tender was corrected to.
	# The relic used to resolve through _adjacent_in_row, so the printed word
	# "adjacent" meant something narrower on the Kindler's doctrine than on every
	# card in the game — and the Cinderward-behind-a-fuse line, the hero's most
	# obvious human play, was exactly what it could not reach.
	#
	# The neighbours are gathered BEFORE anything is spent, then the latch and the
	# chip are burned only if there is a fuse to pull: a censer swung at nothing
	# is not a use of it (the reserve_standard / ledger_seal / portcullis house
	# rule — a trigger that paid nothing must not spend its round, and must not
	# animate a relic chip that did nothing). Latching before the ticks still
	# matters: a neighbour pushed to zero here queues behind this detonation and
	# must not read the relic as unspent.
	if not is_enemy and not _is_net() and _has_relic("chain_censer") \
			and not _chain_censer_used_this_round:
		var fuses: Array = []
		for adjacent in _adjacent_creatures(false, row, lane):
			if adjacent != null and is_instance_valid(adjacent) and adjacent != card \
					and adjacent.current_hp > 0 and adjacent.has_keyword("doom"):
				fuses.append(adjacent)
		if not fuses.is_empty():
			_chain_censer_used_this_round = true
			_relic_fired("chain_censer")
			for fuse in fuses:
				_tick_doom_counter(fuse, -1, true)

	# Ember Censer (Kindler signature) — YOUR Doom creatures detonate for +1.
	# Gated to player-side detonations so the relic reads as "your Doom" and
	# doesn't buff enemy bombs aimed at the player's face.
	if not is_enemy and _has_relic("ember_censer"):
		dmg += int(RelicDB.get_relic("ember_censer").get("value", 1))
		_relic_fired("ember_censer")
	# Doom Herald — YOUR Doom creatures detonating draws a card. Gated to
	# player-side so enemy bombs don't fuel the player's hand. Drawn before the
	# detonation destroy so a full draw pile still feels the payoff.
	if not is_enemy and _has_relic("doom_herald"):
		for _i in int(RelicDB.get_relic("doom_herald").get("value", 1)):
			draw_one()
		_relic_fired("doom_herald")
	# (Ember Warden's old feeds_on_doom hook lived here; retired again 2026-07-15
	# with her shield_on_spell rework — the detonation pays no warden anywhere.)
	# LOUD telegraph payoff: a red bloom + hard shake so the clock hitting zero
	# is unmistakable. An early blast gets the SAME beat on purpose — it has to
	# read as a detonation, not as a body quietly dying — and the chronicle line
	# is what names the difference.
	screen_shake(12.0)
	spawn_ash_burst(_card_center(card), Color(1.0, 0.32, 0.16), 22)
	var chip_pos := card.global_position + Vector2(card.size.x * card.scale.x * 0.5, -14)
	spawn_floating_number(chip_pos, "DOOM!", Color(1.0, 0.30, 0.18), true)
	log_status(card, "DOOM — the blast falls on its lane" if early \
		else "DOOM — the fuse burns out")
	if AudioBank != null:
		AudioBank.play_sfx("hit_hero")
	if dmg > 0:
		if early:
			_doom_blast_lane(lane, is_enemy, dmg)
		elif is_enemy:
			damage_player_hero(dmg)
		else:
			damage_enemy_hero(dmg)
			if _has_relic("sextons_spade") and not _sextons_spade_used_this_fight:
				_sextons_spade_used_this_fight = true
				_relic_fired("sextons_spade")
				damage_enemy_hero(dmg)


## Tallow Doll's curse: the living creature across from the Doll's grave makes
## one immediate bonus attack against the nearest OTHER creature on its own
## side. "Nearest" is Manhattan distance on the 2x4 board; equal distances
## prefer the same row, then the lower lane, so replays are deterministic. If
## it is alone, the compelled creature strikes its own hero instead.
##
## This is deliberately synchronous: on-death dispatch is synchronous, and the
## ordinary awaited column resolver assumes attacker/defender are opposing
## sides. The strike still uses live ATK, Shield/Armored/Last Stand, Thorns,
## Poison and one normal counter. It does not spend either creature's scheduled
## combat attack or award Slay/Lifesteal/veterancy for friendly casualties.
func _resolve_tallow_betrayal(lane_idx: int, doll_was_enemy: bool) -> void:
	var traitor = get_opposing_card(lane_idx, doll_was_enemy)
	if traitor == null or not is_instance_valid(traitor) or traitor.current_hp <= 0 \
			or traitor.has_keyword("structure"):
		return
	var side_is_enemy: bool = bool(traitor.is_opponent)
	var traitor_pos: Dictionary = _find_creature_position(traitor)
	if traitor_pos.is_empty():
		return

	var victim: Control = null
	var best_distance := 999
	var best_same_row := false
	var best_lane := 999
	var best_row := 999
	for ally in _all_friendly(side_is_enemy):
		if ally == traitor or ally == null or not is_instance_valid(ally) \
				or ally.current_hp <= 0 or ally.has_keyword("structure"):
			continue
		var ally_pos: Dictionary = _find_creature_position(ally)
		if ally_pos.is_empty():
			continue
		var dist: int = abs(int(ally_pos.lane) - int(traitor_pos.lane)) \
			+ abs(int(ally_pos.row) - int(traitor_pos.row))
		var same_row: bool = int(ally_pos.row) == int(traitor_pos.row)
		var ally_lane: int = int(ally_pos.lane)
		var ally_row: int = int(ally_pos.row)
		var better := dist < best_distance \
			or (dist == best_distance and same_row and not best_same_row) \
			or (dist == best_distance and same_row == best_same_row \
				and ally_lane < best_lane) \
			or (dist == best_distance and same_row == best_same_row \
				and ally_lane == best_lane and ally_row < best_row)
		if better:
			victim = ally
			best_distance = dist
			best_same_row = same_row
			best_lane = ally_lane
			best_row = ally_row

	var strike_atk: int = _effective_attack(traitor, int(traitor.current_lane), side_is_enemy)
	spawn_trigger_callout(traitor.global_position \
		+ Vector2(traitor.size.x * traitor.scale.x * 0.5, -12),
		"CURSED", false, int(traitor.entity_id))
	if victim == null:
		if strike_atk <= 0:
			return
		if traitor.has_method("play_attack_lunge"):
			traitor.play_attack_lunge(_lunge_strength(strike_atk))
		_net_log_lunge(traitor)
		var own_face := _face_lane_point(side_is_enemy, int(traitor.current_lane))
		_play_attack_tracer(_card_center(traitor), own_face, side_is_enemy,
			float(strike_atk), strike_atk >= HEAVY_HIT_DAMAGE)
		_spawn_impact_burst(own_face, own_face - _card_center(traitor),
			float(strike_atk), false)
		_log_event("%s turns on its own commander for [color=#f2e6c8]%d[/color]." \
			% [_log_card_ref(traitor), strike_atk], _log_data(traitor), _log_side(traitor))
		if side_is_enemy:
			damage_enemy_hero(strike_atk, false)
		else:
			damage_player_hero(strike_atk, false)
		return

	# Snapshot the counter before the forward blow: a lethal attack still receives
	# the same simultaneous answer as an ordinary clash.
	var counter_atk := 0
	if not victim.state.is_frozen and not victim.state.stunned:
		counter_atk = _effective_attack(victim, int(victim.current_lane), side_is_enemy)
	if victim.state.marked:
		strike_atk += 2
	if victim.state.enrage_vulnerable:
		strike_atk += 1
	if traitor.has_method("play_attack_lunge"):
		traitor.play_attack_lunge(_lunge_strength(strike_atk))
	_net_log_lunge(traitor)
	_play_attack_tracer(_card_center(traitor), _card_center(victim), side_is_enemy,
		float(strike_atk), strike_atk >= HEAVY_HIT_DAMAGE)
	if victim.has_method("play_hit_recoil"):
		victim.play_hit_recoil(side_is_enemy)
	_apply_thorns(victim, traitor, side_is_enemy)
	var victim_hp_before: int = int(victim.current_hp)
	_log_event("%s turns on %s for [color=#f2e6c8]%d[/color]." \
		% [_log_card_ref(traitor), _log_card_ref(victim), strike_atk],
		_log_data(traitor), _log_side(traitor))
	if strike_atk > 0:
		victim.take_damage(strike_atk)
	var strike_damage: int = maxi(0, victim_hp_before - maxi(int(victim.current_hp), 0))
	if victim.current_hp > 0 and strike_damage > 0 \
			and (traitor.has_keyword("poison") or _virulence_active[1 if side_is_enemy else 0]):
		victim.current_hp = 0
		victim.update_stat_display()
		spawn_keyword_callout_kw(victim, "poison")
		if not Card2D.defer_deaths:
			victim.try_die()
	_net_log_hit(traitor, victim, victim_hp_before)
	if is_instance_valid(victim):
		_apply_struck_passives(victim, traitor, side_is_enemy, strike_damage)

	if counter_atk <= 0 or not is_instance_valid(traitor) or traitor.current_hp <= 0:
		return
	_play_attack_tracer(_card_center(victim), _card_center(traitor), side_is_enemy,
		float(counter_atk), counter_atk >= HEAVY_HIT_DAMAGE)
	var traitor_hp_before: int = int(traitor.current_hp)
	traitor.take_damage(counter_atk)
	var counter_damage: int = maxi(0,
		traitor_hp_before - maxi(int(traitor.current_hp), 0))
	if traitor.current_hp > 0 and counter_damage > 0 \
			and (victim.has_keyword("poison") or _virulence_active[1 if side_is_enemy else 0]):
		traitor.current_hp = 0
		traitor.update_stat_display()
		spawn_keyword_callout_kw(traitor, "poison")
		if not Card2D.defer_deaths:
			traitor.try_die()
	_net_log_hit(victim, traitor, traitor_hp_before, true)
	if is_instance_valid(traitor):
		_apply_struck_passives(traitor, victim, side_is_enemy, counter_damage)


## Wall-cycle strike reactions. `defender_is_enemy` names the wall's OWNER;
## carrying it explicitly matters for Tallow Doll's friendly-fire strike, where
## attacker and defender are on the same side. `damage_taken` is actual HP lost
## (post Shield/Armored/Last Stand and capped at the body it had), not raw ATK.
##
## Iron Rampart reflects even when the strike kills it. Oathwall, Stockade and
## Bastion Lord still require a survivor. Host-side net combat runs this same
## hook for both owners and snapshots every resulting HP/token change.
func _apply_struck_passives(defender: Control, attacker: Control,
		defender_is_enemy: bool, damage_taken: int) -> void:
	if defender == null or not is_instance_valid(defender):
		return
	var survived: bool = defender.current_hp > 0
	var anchor: Vector2 = defender.global_position \
		+ Vector2(defender.size.x * defender.scale.x * 0.5, -12)
	match String(defender.card_data.get("passive", "")):
		"reflect_strike":
			# Reflection replaces ordinary Thorns on this wall. It is recoil damage,
			# so it bypasses Armored like Thorns; Shield can still catch the blow.
			if damage_taken > 0 and attacker != null and is_instance_valid(attacker) \
					and attacker.current_hp > 0:
				var attacker_hp_before: int = int(attacker.current_hp)
				spawn_trigger_callout(anchor, "REFLECT %d" % damage_taken,
					false, int(defender.entity_id))
				attacker.take_damage_bypass_armor(damage_taken)
				_net_log_hit(defender, attacker, attacker_hp_before, true)
		"anvil_spawn":
			# "When this SURVIVES A HIT" — so a hit has to have landed. `survived`
			# alone is true even when the blow never reached this body at all (an
			# Oathbound Squire's ward moved it, or a Shield ate it whole), which
			# splintered a free 1/1 off a hit the Stockade never took. Same defect
			# and same fix as _apply_creature_struck_growth; `reflect_strike` two
			# arms above always gated on damage_taken and is the precedent.
			if survived and damage_taken > 0:
				var seats: Array = _adjacent_empty_seats(defender_is_enemy,
					defender.current_row, defender.current_lane)
				if seats.size() > 0:
					summon_token(1, 1, seats[0].lane, defender_is_enemy, seats[0].row)
					spawn_trigger_callout(anchor, "SPLINTER",
						false, int(defender.entity_id))
	# THE WORKS (arm_works) — the BASTION signature MOMENT: while the works stand
	# fortified, every one of this side's Bastions reflects the HP it just lost.
	#
	# WHY "HP ACTUALLY LOST" AND NOT A FLAT NUMBER: it is self-balancing for free.
	# A chip hit reflects a chip; a haymaker reflects a haymaker. It can never be
	# free damage for merely existing, which is the failure the old bastion_ramp
	# (+1 ATK per round it stands) had in the other direction — it paid for TIME,
	# which fights the game's own two-round pacing.
	#
	# IT FIRES ON THE WAY DOWN. `survived` is deliberately not consulted: the whole
	# claim of the tribe is that hitting the wall costs you even when the wall
	# falls, and take_damage has already resolved by the time we are called (the
	# reflect_strike precedent above works the same way).
	#
	# reflect_strike bodies are EXCLUDED — Iron Rampart already reflects on its own
	# and would otherwise pay twice for one blow.
	var works_side: int = int(defender_is_enemy)
	if damage_taken > 0 and _works_fortified[works_side] > 0 \
			and String(defender.card_data.get("ctype", "")) == "bastion" \
			and String(defender.card_data.get("passive", "")) != "reflect_strike" \
			and attacker != null and is_instance_valid(attacker) \
			and attacker.current_hp > 0:
		var works_hp_before: int = int(attacker.current_hp)
		spawn_trigger_callout(anchor, "THE WORKS — %d" % damage_taken,
			false, int(defender.entity_id))
		# Bypasses Armored for the same reason Thorns and reflect_strike do: this is
		# recoil off the stonework, not a swing. Shield still catches it.
		attacker.take_damage_bypass_armor(damage_taken)
		_net_log_hit(defender, attacker, works_hp_before, true)
	# Bastion Lord: any friendly struck survivor adds a one-damage volley.
	if survived and _has_passive_on_side("bulwark_lord", defender_is_enemy):
		if defender_is_enemy:
			damage_player_hero(1)
		else:
			damage_enemy_hero(1)


func _apply_combat_strike_riders(attacker: Control, damage_dealt: int,
		defender_was_killed: bool, attacker_is_enemy: bool,
		defender: Control = null) -> void:
	# Shared post-strike rider for every combat-damage path (column / swift /
	# ranged / hydra / face). Keeps Rampage + Lifesteal behaving identically no
	# matter which attack routine landed the hit.
	#   damage_dealt  — HP this strike actually removed (Lifesteal heals for it:
	#                   a Shield absorbing the hit means 0, Armored trims it,
	#                   overkill is capped to what the target really lost).
	#   defender_was_killed — the target died to this strike (Rampage grows).
	if attacker == null or not is_instance_valid(attacker):
		return
	# Head-Money: kill attribution already converges here for column, Swift and
	# ranged strikes. Printed cost is captured from the victim; the per-fight cap
	# keeps multi-shot Strays from becoming the whole economy.
	if defender_was_killed and not attacker_is_enemy and not _is_net() \
			and _has_relic("head_money") \
			and String(attacker.card_data.get("ctype", "")) == "stray" \
			and defender != null and is_instance_valid(defender):
		var bounty: int = mini(int(defender.card_data.get("cost", 0)),
			int(RelicDB.get_relic("head_money").get("value", 10)) - _head_money_gold_this_fight)
		if bounty > 0:
			_head_money_gold_this_fight += bounty
			RunState.gain_gold(bounty)
			spawn_floating_number(_card_center(defender), "+%d GOLD" % bounty,
				Color(1.0, 0.82, 0.30), false)
			_relic_fired("head_money")
	# COUNTERORDERS, the keystone (read_the_orders): while The Interpreter stands,
	# a friendly that kills an enemy CAUGHT UNDER AN ORDER is promoted +1/+1 for
	# good. Hosted here because this is the funnel every combat-damage path already
	# converges on (column / Swift / ranged / doubled), the Rampage and Head-Money
	# precedent two arms up.
	#
	# The order is read from the VICTIM at the moment it dies, which is the same
	# badge the player was looking at when they chose the trade — so the reward
	# lands on the read, not on a re-derivation the player cannot see. Solo only:
	# a human opponent has no intents to catch out of position, and the card is
	# skirmish-denylisted for that reason rather than silently no-opping.
	if defender_was_killed and not attacker_is_enemy and not _is_net() \
			and defender != null and is_instance_valid(defender) \
			and _wears_an_order(defender) \
			and _has_passive_on_side("read_the_orders", false):
		attacker.persistent_atk_buff += 1
		attacker.persistent_atk_buff_rounds = 99
		attacker.card_data["hp"] = int(attacker.card_data.get(
			"hp", attacker.current_hp)) + 1
		attacker.current_hp += 1
		attacker.update_stat_display()
		spawn_trigger_callout(attacker.global_position \
			+ Vector2(attacker.size.x * attacker.scale.x * 0.5, -12),
			"COUNTERMARCH +1/+1", false, int(attacker.entity_id))
	# Lifesteal — heal the PLAYER for the damage the strike actually dealt (the
	# HP the target really lost, NOT the attacker's printed ATK).
	if damage_dealt > 0 and not attacker_is_enemy and attacker.has_keyword("lifelink") and player_hp < player_max_hp:
		var healed: int = mini(player_hp + damage_dealt, player_max_hp) - player_hp
		if healed > 0:
			player_hp += healed
			_show_lifelink_heal(healed)
			_update_hud()
	# Net mirror: the CLIENT's Lifesteal heals the client's hero (the host's enemy hero).
	elif damage_dealt > 0 and attacker_is_enemy and _is_net() and attacker.has_keyword("lifelink"):
		_net_heal_hero(true, damage_dealt)
		_update_hud()
	# Rampage — permanent +ATK on every combat kill, for the rest of the fight.
	if defender_was_killed and attacker.has_keyword("rampage"):
		var amt: int = int(attacker.card_data.get("rampage", 1))
		if bool(attacker.card_data.get("is_upgraded", false)):
			amt += 1
		if amt > 0:
			attacker.persistent_atk_buff += amt
			attacker.persistent_atk_buff_rounds = 99  # effectively permanent this fight
			attacker.update_stat_display()
			var rp_pos := attacker.global_position + Vector2(attacker.size.x * attacker.scale.x * 0.5, -10)
			spawn_floating_number(rp_pos, "RAMPAGE +%d" % amt, Color(1.0, 0.62, 0.20), false)
	# Headhunter (slay_heal): a confirmed kill feeds the warband — the OWNER's
	# hero heals 2 (3 upgraded). Rides every combat path (swift / column /
	# ranged / doubled). Same owner-routing as Lifesteal above: player heals
	# locally, the net client's hero heals via _net_heal_hero; solo enemies
	# don't field it.
	if defender_was_killed and attacker.card_data.get("passive", "") == "slay_heal":
		var hh_n: int = 3 if bool(attacker.card_data.get("is_upgraded", false)) else 2
		if not attacker_is_enemy:
			player_hp = mini(player_hp + hh_n, player_max_hp)
			_update_hud()
		elif _is_net():
			_net_heal_hero(true, hh_n)
			_update_hud()
		spawn_trigger_callout(attacker.global_position \
			+ Vector2(attacker.size.x * attacker.scale.x * 0.5, -12),
			"SLAY — HEAL %d" % hh_n, false, int(attacker.entity_id))
	if defender_was_killed and attacker.card_data.get("passive", "") == "shield_on_slay":
		if not attacker.state.has_shield:
			attacker.state.has_shield = true
			if attacker.has_method("_spawn_keyword_chip"):
				attacker._spawn_keyword_chip("SHIELD", Color(0.65, 0.85, 1.0), "shield")
		attacker.update_stat_display()
	# Defection (Free Company Captain — the Stray keystone): a Stray that kills an
	# enemy creature loots one of that corpse's keywords (a PERSISTENT grant, like
	# shield_on_slay above) — or free-redeploys if there's nothing worth taking, so
	# the moment is never zero. The Captain itself steals-or-redeploys; while a
	# Captain stands, EVERY other friendly Stray free-redeploys on a kill (the
	# tribe turn-on). Fires on ENEMY death only (defender is always the opposing
	# body on this path — never a friendly death / sacrifice), and host-side on
	# every net strike path with NO _is_net guard (larceny is skirmish-safe, unlike
	# Head-Money's gold above). The redeploy uses _relocate_creature, which never
	# touches ready_to_swing — a reposition is not a re-muster.
	if defender_was_killed and defender != null and is_instance_valid(defender) \
			and String(attacker.card_data.get("ctype", "")) == "stray" \
			and _stray_defection_active(attacker, attacker_is_enemy):
		_resolve_defection(attacker, defender, attacker_is_enemy)
	# Campaign memory (docs/CAMPAIGN_MEMORY.md): a combat kill by a real deck
	# creature goes on its service record — tally scratches on the writ, an
	# earned name at 3, the veteran's +1/+1 at 6 (folded at next draw; the
	# live body is promoted on the spot so the moment is felt this fight).
	# Solo campaign only; tokens have no identity (uid -1).
	if defender_was_killed and not attacker_is_enemy and not _is_net() \
			and not attacker.is_token and int(attacker.deck_uid) >= 0:
		var vk: int = RunState.record_kill(int(attacker.deck_uid))
		var vk_pos := attacker.global_position \
			+ Vector2(attacker.size.x * attacker.scale.x * 0.5, -12)
		if vk == RunState.veteran_epithet_kills():
			spawn_trigger_callout(vk_pos, ("BLOODED — %s"
				% RunState.veteran_epithet(int(attacker.deck_uid))).to_upper(), false)
			# Rung 1 now also carries the WAR SCHOOL (2026-07-30 — it used to sit at
			# rung 3, ten kills away, which most cards never reached). The CHOICE
			# fires at the top of the next player phase, never mid-clash; if this was
			# the fight's last kill the round-1 catch-up sweep re-queues it.
			_war_school_queue.append(int(attacker.deck_uid))
			# Letters Patent: the earned name comes with a grant of arms — +1/+1
			# permanently. The live body is promoted on the spot; the matching
			# fold in RunState.get_upgraded_card_data carries it to future draws.
			if _has_relic("letters_patent"):
				attacker.current_atk += 1
				attacker.current_hp += 1
				attacker.card_data.hp = int(attacker.card_data.get("hp", attacker.current_hp)) + 1
				attacker.update_stat_display()
				spawn_trigger_callout(vk_pos + Vector2(0, -30), "KNIGHTED +1/+1", false)
				_relic_fired("letters_patent")
		elif vk == RunState.VETERAN_RANK_KILLS:
			attacker.current_atk += 1
			attacker.current_hp += 1
			attacker.card_data.hp = int(attacker.card_data.get("hp", attacker.current_hp)) + 1
			attacker.update_stat_display()
			spawn_trigger_callout(vk_pos, "VETERAN +1/+1", false)
		elif vk == RunState.veteran_doctrine_kills():
			# Rung 3 — the tribe doctrine. Same deferral as the school.
			_doctrine_queue.append(int(attacker.deck_uid))
			spawn_trigger_callout(vk_pos, "MASTER OF THE FIELD", false)


# Keywords a Defection kill may loot off a corpse — the combat keywords that
# transfer cleanly as a persistent grant. Trigger markers (on_enter/on_death),
# debuffs (wither/doom), and one-shot/enemy-defining tags (shield/structure/
# summon/exhaust/retain) are deliberately excluded: nothing worth taking there.
const DEFECTION_STEALABLE := ["armored", "swift", "charge", "thorns", "piercing",
	"regenerate", "last_stand", "sniper", "poison", "rampage", "lifelink",
	"guardian", "overrun", "formation"]


## True when a Stray on `is_enemy`'s side may Defect on a kill: it either IS the
## Captain (carries the `defection` passive) or a living Captain stands with it
## (the tribe turn-on grants every other friendly Stray the free-redeploy).
func _stray_defection_active(attacker: Control, is_enemy: bool) -> bool:
	if attacker == null or not is_instance_valid(attacker):
		return false
	if String(attacker.card_data.get("passive", "")) == "defection":
		return true
	for c in _all_friendly(is_enemy):
		if c != attacker and is_instance_valid(c) and c.current_hp > 0 \
				and String(c.card_data.get("passive", "")) == "defection":
			return true
	return false


## The first keyword on `defender` that the Captain could loot and doesn't
## already carry, in DEFECTION_STEALABLE priority order. "" if none worth taking.
## The receipt a field grant leaves on a body: keywords the FIGHT'S RULE lent it,
## as opposed to keywords its card prints. Written by
## `EncounterEffects.grant_field_keyword` (the single writer, shared by all three
## field grants) and read here by the Defection guard.
const FIELD_GRANT_KEY: String = "field_granted_keywords"

## True when this body holds `keyword` only because the encounter's rule said so.
func _is_field_granted(card: Control, keyword: String) -> bool:
	if card == null or not is_instance_valid(card):
		return false
	return (card.card_data.get(FIELD_GRANT_KEY, []) as Array).has(keyword)


func _defection_steal_target(attacker: Control, defender: Control) -> String:
	var have: Array = attacker.card_data.get("keywords", [])
	var theirs: Array = defender.card_data.get("keywords", [])
	for kw in DEFECTION_STEALABLE:
		if theirs.has(kw) and not have.has(kw):
			# YOU MAY NOT LOOT THE BATTLEFIELD (2026-07-29). Defection grants the
			# stolen keyword for the rest of the fight, and `DEFECTION_STEALABLE`
			# lists "armored", "thorns" and "piercing" — exactly the keywords an
			# encounter passive lends its own line. Without this the Free Company
			# Captain can kill a body that was only Piercing because the Dragon
			# Lord's field rule said so, and keep it. A fight's rule belongs to the
			# fight, not to a card.
			#
			# TWO SOURCES, BOTH CHECKED — the first version of this guard checked
			# only `_has_encounter_passive_keyword` and was therefore INERT for the
			# three passives its own comment named. That lookup matches on
			# `_encounter_passive` and has arms only for the six conditional grants
			# (`dragon_lord_piercing`, `swamp_thorns`, `merc_piercing`,
			# `nexus_rotation`, `stampede_charge`, `stone_armor`); `sentinel_stone`,
			# `formation_lockstep` and `iron_warden_siege` fall through to `false`.
			# Those three write into `card_data.keywords` directly, so they need the
			# provenance stamp (`_mark_field_granted`) instead. Checking both keeps
			# the guard correct whichever way a passive chooses to grant.
			if defender.is_opponent \
					and (_is_field_granted(defender, kw) \
						or _has_encounter_passive_keyword(defender, kw)):
				continue
			return kw
	return ""


## Resolve Defection for one Stray kill (host-side; the board snapshot carries
## the stolen keyword / relocation to the net client). The Captain loots a
## keyword when one is worth taking, else redeploys; a turn-on Stray only ever
## redeploys. Redeploy uses _relocate_creature, preserving ready_to_swing.
func _resolve_defection(attacker: Control, defender: Control, is_enemy: bool) -> void:
	if attacker == null or not is_instance_valid(attacker):
		return
	var is_captain: bool = String(attacker.card_data.get("passive", "")) == "defection"
	if is_captain:
		var kw := _defection_steal_target(attacker, defender)
		if kw != "":
			if not attacker.card_data.has("keywords"):
				attacker.card_data["keywords"] = []
			attacker.card_data.keywords.append(kw)
			if attacker.has_method("_spawn_keyword_chip"):
				attacker._spawn_keyword_chip(kw.to_upper(),
					CTYPE_COLORS.get("stray", Color(0.56, 0.86, 0.82)), kw)
			attacker.update_stat_display()
			spawn_trigger_callout(attacker.global_position \
				+ Vector2(attacker.size.x * attacker.scale.x * 0.5, -12),
				"DEFECTION — %s" % kw.to_upper(), false, int(attacker.entity_id))
			return
	# Nothing to loot (Captain) or a turn-on Stray: free-redeploy to an empty slot.
	var slot := _pick_empty_for_summon(is_enemy, int(attacker.current_row))
	if slot.is_empty():
		return
	if _relocate_creature(attacker, is_enemy, int(slot.row), int(slot.lane)):
		spawn_trigger_callout(attacker.global_position \
			+ Vector2(attacker.size.x * attacker.scale.x * 0.5, -12),
			"DEFECTION — REDEPLOY", false, int(attacker.entity_id))


## The Apothecary (tonic_vigor): every potion its owner drinks fortifies the
## apothecaries on that side — +2/+2 this fight (+3/+3 forged). Solo drinks are
## always the player's; the net potion path calls this with the drinker's side.
## (The old grows_on_heal hero-heal stoke retired with Cinder Acolyte's 2026-07-15
## spark_on_spell rework.)
func _apply_tonic_vigor(owner_is_enemy: bool) -> void:
	for c in _all_friendly(owner_is_enemy):
		if not is_instance_valid(c) or c.card_data.get("passive", "") != "tonic_vigor":
			continue
		var tv_n: int = 3 if bool(c.card_data.get("is_upgraded", false)) else 2
		c.current_atk += tv_n
		c.card_data.hp = int(c.card_data.get("hp", 1)) + tv_n
		c.current_hp += tv_n
		c.update_stat_display()
		spawn_floating_number(c.global_position \
			+ Vector2(c.size.x * c.scale.x * 0.5, -10),
			"+%d/+%d" % [tv_n, tv_n], Color(1.0, 0.62, 0.20), false)
		_net_fx_text(c, "+%d/+%d" % [tv_n, tv_n], Color(1.0, 0.62, 0.20))


func _show_lifelink_heal(amount: int) -> void:
	# Small green heal number near the player HP medallion.
	if amount <= 0:
		return
	if _player_hp_label != null:
		spawn_floating_number(_player_hp_label.get_global_rect().get_center() + Vector2(0, -6),
			"+%d" % amount, GameTheme.HEALTH_GREEN, false)
		_punch_label(_player_hp_label, 1.12)


func _creature_attacks_creature(attacker: Control, defender: Control, lane_idx: int, attacker_is_enemy: bool) -> void:
	if attacker.has_method("play_attack_lunge"):
		attacker.play_attack_lunge(
			_lunge_strength(_effective_attack(attacker, lane_idx, attacker_is_enemy)))
	# THE BRACE — the defender sets itself INTO the blow while the attacker winds
	# up, so BOTH parties in a trade are identified before contact rather than
	# one. Costs no time: it runs inside the wind-up that already exists, and is
	# home well before LUNGE_APEX so it can't fight the recoil for `position`.
	# (docs/STRIKE_DESIGN_20260730.md §2.1)
	if defender != null and is_instance_valid(defender) \
			and defender.has_method("play_defend_brace"):
		defender.play_defend_brace(not attacker_is_enemy)
	_net_log_lunge(attacker, defender)
	await _short_pause(LUNGE_APEX)
	if not is_instance_valid(attacker) or not is_instance_valid(defender):
		return
	var atk = _effective_attack(attacker, lane_idx, attacker_is_enemy)
	# Marked/enrage vulnerability bonus damage
	if defender.state.marked:
		atk += 2
	if defender.state.enrage_vulnerable:
		atk += 1
	_apply_thorns(defender, attacker, not attacker_is_enemy)
	# Royal Guard "Adj -1 dmg" — if an adjacent friendly (same row, ±1 lane) is
	# a Royal Guard, the defender takes 1 less damage. Min 1 dmg.
	# Archlich passive: enemy creatures can't go below 1 HP from creature attacks
	atk = _creature_strike_amount(defender, atk, attacker_is_enemy)
	var who = "ENEMY" if attacker_is_enemy else "PLAYER"
	var defender_side = "PLAYER" if attacker_is_enemy else "ENEMY"
	_dbgp("[COMBAT] %s %s (%d ATK) hits %s %s (%d/%d HP) in lane %d → %d dmg → %d HP left" % [
		who, attacker.card_data.name, atk,
		defender_side, defender.card_data.name, defender.current_hp, defender.card_data.hp,
		lane_idx, atk, maxi(0, defender.current_hp - atk)])
	# Impact lands: streak from attacker to target.
	_play_attack_tracer(_card_center(attacker), _card_center(defender),
		attacker_is_enemy, float(atk), atk >= HEAVY_HIT_DAMAGE)
	var hp_before: int = defender.current_hp
	# Cross-Blitz mutual trade: if this defender is about to counter (see
	# _apply_mutual_retaliation), make it LUNGE back into the attacker instead of just
	# recoiling — so both creatures visibly clash in the middle and the return blow
	# reads as a real attack, not damage from nowhere. Otherwise (solo / sealed / a
	# defender that can't answer) it recoils as before.
	var will_counter: bool = (_net_mutual_retaliation or _defender_is_mustering(defender)) \
		and hp_before > 0 and _defender_will_counter(defender)
	if will_counter and defender.has_method("play_attack_lunge"):
		defender.play_attack_lunge(
			_lunge_strength(_effective_attack(defender, defender.current_lane, defender.is_opponent)))
	elif defender.has_method("play_hit_recoil"):
		defender.play_hit_recoil(attacker_is_enemy)
	_log_event("%s strikes %s for [color=#f2e6c8]%d[/color]." \
		% [_log_card_ref(attacker), _log_card_ref(defender), atk],
		_log_data(attacker), _log_side(attacker))
	# The one place a strike lands — raise the whitelist flag for effect-immune
	# defenders here and nowhere else (see Card2D.strike_damage_active).
	# HP this strike actually removed (a Shield absorbing the whole hit means 0;
	# overkill is capped — Lifesteal heals for what the defender really lost).
	var strike_damage: int = _deal_creature_strike_damage(defender, atk)
	attacker.has_attacked_this_turn = true
	# Poison: if attacker has Poison and dealt damage, defender dies regardless
	# of remaining HP. Shield absorbing the hit means no damage was dealt.
	# Virulence (Unclean Blessing) makes the whole side's attacks poisonous.
	_apply_creature_strike_poison(
		attacker, defender, attacker_is_enemy, strike_damage)
	_net_log_hit(attacker, defender, hp_before)
	var was_lethal: bool = defender.current_hp <= 0

	# Contact-point spark at the defender's struck edge, same visual beat as the
	# tracer/recoil above (sub-frame ordering, invisible to the player).
	if is_instance_valid(attacker) and is_instance_valid(defender):
		_spawn_impact_burst(_strike_contact_point(attacker, defender),
			_card_center(defender) - _card_center(attacker), float(atk), was_lethal)

	# Audio: the kill cue fires HERE, at the impact beat, not seconds later when
	# the deferred death flushes (defer_deaths). death_cue_played stops _die()
	# from sounding the same kill twice at the flush. Struck SURVIVORS already
	# sound inside take_damage (Card2D._flash_hit plays "hit_creature") — a cue
	# here too would double every ordinary strike. "creature_death" falls back
	# to "death" until bespoke clips land (AudioBank.SFX_FALLBACKS).
	if strike_damage > 0 and was_lethal and not defender._dead:
		defender.death_cue_played = true
		AudioBank.play_sfx("creature_death", 0.05)

	# Royal Guard "+1 ATK when hit" (+2 if upgraded) — if the defender is a
	# Royal Guard and is still alive after the hit, it grows in fury.
	_apply_creature_struck_growth(defender, strike_damage)

	# Berserker "rage on hit" — surviving a hit stokes the fury: +2 ATK (+3 upgraded).

	# Wall-cycle reactions: reflection can fire on a lethal hit; heal/spawn/lord
	# remain survivor-only inside the shared handler.
	if atk > 0:
		_apply_struck_passives(defender, attacker, not attacker_is_enemy, strike_damage)

	# OVERKILL — universal, every killing blow carries its excess into the body
	# behind. Bodkin Points / Piercing / inspire_piercing upgrade that spill so it
	# reads on through an empty column into the enemy themselves.
	if defender.current_hp <= 0:
		_apply_piercing_overflow(attacker, defender, lane_idx, attacker_is_enemy, {},
			_strike_reaches_face(attacker, attacker_is_enemy))

	# (Vampire Lord's old slay-grow lived here — reworked 2026-07-15 into
	# vampire_feed, an ally-death drink resolved in _apply_ally_death_passives.)

	# Keyword riders: Lifesteal (heal = damage dealt) + Rampage (+ATK on kill).
	_apply_combat_strike_riders(attacker, strike_damage, was_lethal, attacker_is_enemy, defender)

	# Cross-Blitz mutual trade: in the MP one-directional clash the just-struck
	# defender fires its ATK straight back at the attacker, so an even fight kills
	# both. Only armed for that pass (_net_mutual_retaliation); solo/sealed already
	# resolve simultaneously. hp_before > 0 confirms the defender was alive when hit
	# (the caller only engages living creatures, so this is belt-and-suspenders).
	# ...and in solo/sealed the same counter is armed for a MUSTERING defender:
	# the muster delay stops a body INITIATING, never defending. Without this a
	# fresh body would be free food, because solo mutuality comes from both sides
	# swinging in their own column pass and a mustering body never takes one.
	# No double-count: a defender that CAN swing gets its own pass instead, and
	# _defender_will_counter spends the counter once per clash.
	if (_net_mutual_retaliation or _defender_is_mustering(defender)) and hp_before > 0:
		_apply_mutual_retaliation(attacker, defender, attacker_is_enemy)

	# Weighted punctuation. The hold is the COMPREHENSION WINDOW, not dead time —
	# it is the only moment the damage number, the new HP and the corpse are all
	# on screen and still. Scaled by the blow's size (see _impact_hold).
	if phase == Phase.GAME_OVER:
		# ★8: the strike's own chain (piercing overflow to face, an on-death
		# face hit) just ended the fight — hold the killer at extension
		# through the world-stop instead of the ordinary kill beat.
		if is_instance_valid(attacker) and attacker.has_method("hold_lunge_apex"):
			attacker.hold_lunge_apex(KILLING_BLOW_HOLD)
		await _short_pause(KILLING_BLOW_HOLD)
	else:
		# The shake for this blow was already admitted, ONCE, by
		# _deal_creature_strike_damage — which knows what actually landed and
		# whether it killed. The explicit kill/heavy impulses that used to sit
		# here were the second half of a double-count; see that function.
		await _short_pause(_impact_hold(atk, was_lethal))


## Can this defender answer a hit with a counter right now? Shared gate so the strike's
## choreography (defender lunges back vs just recoils) and the actual counter agree.
## Frozen/stunned = incapacitated (no counter); a spent defender already answered this
## clash; a 0-ATK body has nothing to hit back with.
## True when this body is sitting out its arrival round. Such a defender will
## never get a swing of its own this round, so the clash has to give it its trade
## on the counter instead — "cannot attack" must not decay into "cannot fight
## back", or arriving would mean offering a free kill.
func _defender_is_mustering(defender: Control) -> bool:
	if defender == null or not is_instance_valid(defender):
		return false
	return not defender.state.ready_to_swing and not defender.ignores_muster_delay()


func _defender_will_counter(defender: Control) -> bool:
	if defender == null or not is_instance_valid(defender):
		return false
	if defender.state.counter_spent_this_clash:
		return false
	if defender.state.is_frozen or defender.state.stunned:
		return false
	return _effective_attack(defender, defender.current_lane, defender.is_opponent) > 0


## Cross-Blitz counterstrike (MP one-directional clash only). The defender that just
## took a hit deals its own ATK back to the attacker in the same beat — the return
## half of a mutual trade. This is NOT a full attack: it does not spend the defender's
## own-turn swing (has_attacked_this_turn), grow Rampage, feed veterancy, or re-apply
## Thorns (the attacker already ate the defender's Thorns on its way in). Each defender
## counters ONCE per clash (counter_spent_this_clash), against the first creature to
## engage it — mirroring solo, where a creature deals its ATK just once per combat and
## only to the front foe across from it. Deaths stay deferred, so an even trade drops
## both. Poison/Virulence on the defender carries through the counter (a real trade).
## The defender's return LUNGE is already playing (started in _creature_attacks_creature
## when will_counter was set), so this only lands the damage + tracer.
func _apply_mutual_retaliation(attacker: Control, defender: Control, attacker_is_enemy: bool) -> void:
	if not _defender_will_counter(defender):
		return
	if not is_instance_valid(attacker) or attacker.current_hp <= 0:
		return
	var defender_is_enemy: bool = not attacker_is_enemy
	# lane arg is unused by _effective_attack (adjacency is baked into effective_atk),
	# so the defender's own stored lane is enough for the buff/relic lookups.
	var raw_retal: int = _effective_attack(
		defender, defender.current_lane, defender_is_enemy)
	if raw_retal <= 0:
		return
	defender.state.counter_spent_this_clash = true
	var retal: int = _creature_strike_amount(
		attacker, raw_retal, defender_is_enemy)
	if retal <= 0:
		return
	# Return blow: a tracer from the defender back to its attacker. Do NOT call
	# play_hit_recoil on the attacker here — it is STILL MID-LUNGE (its lunge tween
	# is running), and a recoil tween fights it for `position`/`scale`, capturing a
	# mid-lunge point as "rest" and leaving the card drifted out of its slot (which
	# compounds every trade). take_damage() below already flashes the struck attacker
	# (_flash_hit / _mark_mortally_struck), so the counter still reads without a
	# second position tween. The defender's own bite-back is shown by its lunge (above).
	_play_attack_tracer(_card_center(defender), _card_center(attacker),
		defender_is_enemy, float(retal), retal >= HEAVY_HIT_DAMAGE)
	var a_hp_before: int = attacker.current_hp
	_log_event("%s strikes back at %s for [color=#f2e6c8]%d[/color]." \
		% [_log_card_ref(defender), _log_card_ref(attacker), retal],
		_log_data(defender), _log_side(defender))
	# The counter is a STRIKE too — in a simultaneous clash the defender biting
	# back is the same act as attacking, so it must reach an effect-immune body.
	var counter_damage: int = _deal_creature_strike_damage(attacker, retal)
	if is_instance_valid(attacker):
		_apply_struck_passives(attacker, defender, attacker_is_enemy, counter_damage)
		_apply_creature_struck_growth(attacker, counter_damage)
	var counter_dealt: bool = counter_damage > 0
	# Poison / Virulence: a countering defender with Poison finishes the attacker.
	_apply_creature_strike_poison(
		defender, attacker, defender_is_enemy, counter_damage)
	# Log the counter as a strike from defender→attacker so the client replays it
	# (tracer + damage chip + kill cue). is_counter=true tells the replay to skip the
	# position recoil on the (still-lunging) attacker — same reason as above.
	_net_log_hit(defender, attacker, a_hp_before, true)
	var counter_lethal: bool = attacker.current_hp <= 0
	if is_instance_valid(defender) and is_instance_valid(attacker):
		_spawn_impact_burst(_card_center(attacker),
			_card_center(attacker) - _card_center(defender), float(retal), counter_lethal)
	# Kill cue at the impact beat (parity with the forward strike); death_cue_played
	# stops the deferred flush from sounding the same kill twice.
	if counter_dealt and counter_lethal and not attacker._dead:
		attacker.death_cue_played = true
		AudioBank.play_sfx("creature_death", 0.05)


## THE RUSH RULE, in one place. A body still in its arrival round may break enemy
## BODIES (that is Swift's exception to the muster delay) but may NOT reach the
## enemy themselves — a keyword that does both is a burst finisher, which is why
## Hearthstone draws Rush the same way. Charge is the exception to the exception:
## the one keyword that ignores the delay AND reaches the face on arrival, which
## is its whole identity and why it carries no pre-phase strike in trade.
##
## THREE sites read this — the strike, the piercing spill, and the lane forecast —
## and each used to spell the condition out by hand. The forecast simply didn't
## have it, so it promised face damage the strike then refused.
func _can_reach_face(card: Control) -> bool:
	if card == null or not is_instance_valid(card):
		return false
	if not card.has_method("has_keyword"):
		return true
	return card.state.ready_to_swing or card.has_keyword("charge")


func _creature_hits_face(card: Control, lane_idx: int, is_enemy: bool,
		bypass_muster_delay: bool = false,
		consume_normal_attack: bool = true) -> void:
	# The Rush rule — see _can_reach_face. Returned before THIS function's lunge so
	# it reads as "held the line" rather than a phantom swing that dealt nothing.
	# NOTE that this guard only protects the lunge below it: _resolve_swift_attack
	# used to play a full lunge of its own before ever calling here, which is
	# exactly the phantom swing this comment forbids. Fixed at that call site.
	if not bypass_muster_delay and not _can_reach_face(card):
		return
	if card.has_method("play_attack_lunge"):
		card.play_attack_lunge(
			_lunge_strength(_effective_attack(card, lane_idx, is_enemy)))
	_net_log_lunge(card)
	await _short_pause(LUNGE_APEX)
	if not is_instance_valid(card):
		return
	var atk = _effective_attack(card, lane_idx, is_enemy)
	var face_dmg: int = 0
	if is_enemy:
		if _encounter_passive == "harpy_swift_face" and card.has_keyword("swift"):
			atk += 1
		var reduction = _get_wall_reduction(lane_idx, false)
		var atk_before_wall: int = atk
		atk = maxi(0, atk - reduction)
		if atk > 0:
			_play_face_strike_vfx(card, lane_idx, is_enemy, atk)
			_net_arm_face_hit_source(card, lane_idx, atk)
			damage_player_hero(atk, false)
			_net_clear_face_hit_source()
			face_dmg = atk
		elif atk_before_wall > 0 and reduction > 0:
			# A BLOW FULLY EATEN BY THE WALL USED TO SHOW ABSOLUTELY NOTHING
			# (2026-07-28). The attacker lunged, the wall swallowed the whole hit,
			# and not one pixel changed — indistinguishable from the game dropping
			# an attack on the floor. The wall doing its job is a GOOD outcome and
			# one of the few times defensive investment visibly pays; it should be
			# the loudest small moment in the lane, not the quietest.
			spawn_keyword_callout(_card_center(card), "WALL HOLDS",
				Color(0.60, 0.78, 0.96), null)
	else:
		# Host/player attacker → defender is the enemy/client. In net the CLIENT's walls
		# blunt the hit (solo enemies have no wall passives, so this is a no-op there).
		if _is_net():
			atk = maxi(0, atk - _get_wall_reduction(lane_idx, true))
		if atk > 0:
			_play_face_strike_vfx(card, lane_idx, is_enemy, atk)
			_net_arm_face_hit_source(card, lane_idx, atk)
			face_dmg = damage_enemy_hero(atk, false, lane_idx)
			_net_clear_face_hit_source()
		# face_dmg is actual HP removed from a gate and/or the boss.

	if consume_normal_attack:
		card.has_attacked_this_turn = true
	# Keyword riders: Lifesteal heals for the face damage landed (no defender
	# to kill, so Rampage never fires here).
	_apply_combat_strike_riders(card, face_dmg, false, is_enemy)
	# ★8: if THIS swing ended the fight, the killer freezes at full extension
	# while the world stops (_check_game_over fired the moment synchronously
	# inside the hero-damage call above) — then the long beat, not the
	# ordinary punctuation.
	if phase == Phase.GAME_OVER and face_dmg > 0 \
			and is_instance_valid(card) and card.has_method("hold_lunge_apex"):
		card.hold_lunge_apex(KILLING_BLOW_HOLD)
		await _short_pause(KILLING_BLOW_HOLD)
		return
	# Hero-damage functions already shake + flash; just pace the cascade.
	await _short_pause(_impact_hold(atk, false))


func _resolve_hydra_attack(attacker: Control, lane_idx: int, is_enemy: bool) -> void:
	# Hydra strikes every opposing creature (both rows) at once, taking each
	# defender's counterattack back as it bites through the line (its Armored
	# softens each). If nothing opposes it, it batters the face like any
	# unblocked creature.
	attacker.has_attacked_this_turn = true
	if attacker.has_method("play_attack_lunge"):
		attacker.play_attack_lunge()
	_net_log_lunge(attacker)
	await _short_pause(LUNGE_APEX)
	if not is_instance_valid(attacker):
		return
	var atk = _effective_attack(attacker, lane_idx, is_enemy)
	var targets = _all_player_creatures() if is_enemy else _all_enemy_creatures()
	var live: Array = []
	for t in targets:
		if t != null and t.current_hp > 0 and not t.has_keyword("structure"):
			live.append(t)
	if live.is_empty():
		_play_face_strike_vfx(attacker, lane_idx, is_enemy, atk)
		_net_arm_face_hit_source(attacker, lane_idx, atk)
		var hydra_face_dmg: int = int(atk)
		if is_enemy:
			damage_player_hero(atk, false)
		else:
			hydra_face_dmg = damage_enemy_hero(atk, false, lane_idx)
		_net_clear_face_hit_source()
		# Lifesteal heals for the unblocked face swing.
		_apply_combat_strike_riders(attacker, hydra_face_dmg, false, is_enemy)
		await _short_pause(_impact_hold(atk, false))
		return
	# Bites through the whole line at once — streak + recoil on every target.
	# Lifesteal heals once for the swing — for the total HP the line lost;
	# Rampage fires PER KILL (a full-line sweep is the Hydra's whole payoff —
	# 3 kills = 3 Rampage triggers).
	var hydra_dmg: int = 0
	var hydra_kills: int = 0
	for t in live:
		var bite_atk: int = atk
		if t.state.marked:
			bite_atk += 2
		if t.state.enrage_vulnerable:
			bite_atk += 1
		bite_atk = _creature_strike_amount(t, bite_atk, is_enemy)
		_play_attack_tracer(_card_center(attacker), _card_center(t),
			is_enemy, float(bite_atk), bite_atk >= HEAVY_HIT_DAMAGE)
		if t.has_method("play_hit_recoil"):
			t.play_hit_recoil(is_enemy)
		var t_hp_before: int = t.current_hp
		_apply_thorns(t, attacker, bool(t.is_opponent))
		_log_event("%s bites %s for [color=#f2e6c8]%d[/color]." \
			% [_log_card_ref(attacker), _log_card_ref(t), bite_atk],
			_log_data(attacker), _log_side(attacker))
		var bite_dmg: int = _deal_creature_strike_damage(t, bite_atk)
		_apply_creature_strike_poison(attacker, t, is_enemy, bite_dmg)
		_apply_creature_struck_growth(t, bite_dmg)
		hydra_dmg += bite_dmg
		if is_instance_valid(t) and bite_atk > 0:
			_apply_struck_passives(t, attacker, bool(t.is_opponent), bite_dmg)
		if t.current_hp <= 0:
			hydra_kills += 1
		if attacker.current_hp > 0:
			# Hydra passive takes each bitten defender's FULL counterattack back
			# (Armored on the Hydra softens each blow); the Charge! spell, which
			# borrows this sweep for one turn, keeps the gentler flat-1 recoil.
			var recoil: int = 1
			var full_counter: bool = String(attacker.card_data.get(
				"passive", "")) == "attacks_all_lanes"
			if full_counter:
				recoil = _effective_attack(t, t.current_lane, t.is_opponent)
				recoil = _creature_strike_amount(
					attacker, recoil, bool(t.is_opponent))
				var recoil_dmg := _deal_creature_strike_damage(attacker, recoil)
				_apply_creature_strike_poison(
					t, attacker, bool(t.is_opponent), recoil_dmg)
				_apply_creature_struck_growth(attacker, recoil_dmg)
				if is_instance_valid(attacker) and recoil > 0:
					_apply_struck_passives(
						attacker, t, is_enemy, recoil_dmg)
			elif recoil > 0:
				# Charge!'s flat recoil is an effect, not a defender's strike.
				attacker.take_damage(recoil)
		_net_log_hit(attacker, t, t_hp_before)
	if is_instance_valid(attacker):
		_apply_combat_strike_riders(attacker, hydra_dmg, hydra_kills > 0, is_enemy)
		# Extra kills beyond the first re-fire the kill-gated riders only
		# (0 damage keeps Lifesteal at once per swing).
		for _hk in range(maxi(0, hydra_kills - 1)):
			if not is_instance_valid(attacker):
				break
			_apply_combat_strike_riders(attacker, 0, true, is_enemy)
	screen_shake(6.0)
	await _short_pause(HITSTOP_BEAT)


func _redirect_target(defender: Control, defender_is_enemy: bool, lane_idx: int, row: int,
		attacker: Control = null) -> Control:
	# Royal Guard's redirect floop: a friendly Royal Guard in the same row that
	# is "redirecting" and sits adjacent to the intended defender intercepts the
	# blow in its place.
	# Guardian keyword: permanently redirects adjacent attacks (no floop needed).
	for g in _adjacent_creatures(defender_is_enemy, row, lane_idx):
		if g.current_hp > 0:
			if g.state.redirecting and g.card_data.get("passive", "") == "royal_guard":
				return g
			if g.has_keyword("guardian"):
				return g
	return defender


## Swift can be intrinsic (keyword), rallied for the turn by War Cry, or held
## from an adjacent Battle Drummer — one check for every Swift-phase site so
## granted Swift and printed Swift never disagree.
func _is_swift_attacker(c: Control) -> bool:
	return c.has_keyword("swift") or bool(c.state.war_cry_swift) \
		or bool(c.state.drummer_swift)


func _resolve_ranged_attacks(side_filter: int = -1) -> void:
	# 4x4: ranged prefers back-row enemies (you can reach over the front line),
	# then front-row enemies, then face damage if the opposing side is empty.
	# side_filter: -1 = both sides (solo simultaneous combat); 0 = player side
	# only, 1 = enemy side only (skirmish one-directional clash).
	var sides: Array = [false, true]
	if side_filter == 0:
		sides = [false]
	elif side_filter == 1:
		sides = [true]
	for is_enemy in sides:
		for row in [ROW_FRONT, ROW_BACK]:
			var attackers = _row_array(is_enemy, row)
			for lane_idx in range(LANES_PER_ROW):
				var card = attackers[lane_idx]
				if card == null:
					continue
				if not _is_sniper(card, is_enemy, row):
					continue
				if card.has_attacked_this_turn or not card.can_attack():
					continue
				card.has_attacked_this_turn = true
				if card.has_method("play_attack_lunge"):
					card.play_attack_lunge()
				_net_log_lunge(card)
				await _short_pause(LUNGE_APEX)
				if not is_instance_valid(card):
					continue
				await _sniper_fire(card, lane_idx, is_enemy)
				if is_instance_valid(card) and card.current_hp > 0:
					await _run_forked_spear_strikes(card, lane_idx, is_enemy)


func _is_sniper(card: Control, is_enemy: bool, row: int) -> bool:
	# Sniper is a real keyword. Catapult Crew still grants it dynamically to the
	# player's back row, and the legacy `sniper` flag is honored for old saves.
	if card == null or not is_instance_valid(card):
		return false
	if card.has_keyword("sniper"):
		return true
	if bool(card.card_data.get("sniper", false)):
		return true
	if not is_enemy and row == ROW_BACK and _has_relic("catapult_crew"):
		return true
	return false


# ── Take Aim (2026-07-21 sniper rework) ─────────────────────────────────────
# A sniper can carry a STANDING ORDER: the enemy creature its opening shot
# fires at instead of culling the weakest (the Inscryption model — the player
# picks the space the marksman strikes). Drag the sniper onto an enemy to take
# aim; right-click the sniper to clear the order. The order persists round to
# round until the quarry falls, then the drill resumes. Keyed by the sniper
# Card2D; entries are validated lazily so a dead/freed quarry simply falls
# back to the drill. In net the HOST's dict is authoritative — the client's
# orders arrive as IN_SNIPER_AIM intents (own aim is drawn locally; a foe's
# aim is never shown, same information rule as the hidden hand).
var _sniper_marks: Dictionary = {}
const AIM_COLOR := Color(0.55, 0.78, 1.0)   # the ranged steel-blue (Pavise kin)


func _sniper_mark_target(card: Control) -> Control:
	# The standing order, validated. A quarry that died, left the field, or
	# ended up on the marksman's own side no longer binds him; stale entries
	# are pruned so the dict never outlives the board it described.
	if card == null or not _sniper_marks.has(card):
		return null
	var t = _sniper_marks[card]
	if t == null or not is_instance_valid(t) or t.current_hp <= 0 \
			or not t.is_on_battlefield \
			or bool(t.is_opponent) == bool(card.is_opponent):
		_sniper_marks.erase(card)
		return null
	return t


func _set_sniper_mark(card: Control, quarry: Control, announce: bool = true) -> void:
	if card == null or quarry == null or _sniper_marks.get(card) == quarry:
		return
	_sniper_marks[card] = quarry
	if not announce:
		return
	spawn_floating_number(_card_center(card) + Vector2(0, -14), "TAKES AIM",
		AIM_COLOR, false)
	AudioBank.play_sfx("sniper_aim", 0.05, -6.0)
	_log_event("%s takes aim at %s." % [_log_card_ref(card), _log_card_ref(quarry)],
		_log_data(card), _log_side(card))
	_refresh_combat_process()


func _clear_sniper_mark(card: Control, announce: bool = true) -> void:
	if not _sniper_marks.has(card):
		return
	_sniper_marks.erase(card)
	if announce and is_instance_valid(card):
		spawn_floating_number(_card_center(card) + Vector2(0, -14), "AIM CLEARED",
			Color(0.72, 0.76, 0.82), false)
		_log_event("%s lowers its aim — it will cull the weakest." \
			% _log_card_ref(card), _log_data(card), _log_side(card))


func _aim_target_at(pos: Vector2) -> Control:
	# Hit-test the enemy board for a drop-to-aim. Structures ARE aimable — the
	# drill skips walls as wasted shots, but ordering the crew to batter one
	# down is exactly the kind of call the player should own.
	for c in _all_enemy_creatures():
		if c != null and is_instance_valid(c) and c.current_hp > 0 \
				and _is_click_on_card(pos, c):
			return c
	return null


# ── Take Aim threads — the visible standing orders ──────────────────────────
# One thin cold thread per OWN aimed sniper, marksman → quarry, with a small
# diamond sat on the quarry. Informational (it is board state, not garnish):
# it holds steady under Reduce Motion and never pulses. Lifecycle is a
# per-frame reconciliation against _sniper_marks, so no clear/death site has
# to remember the visuals — a pruned order frees its thread here.
var _aim_thread_nodes: Dictionary = {}


func _update_aim_threads() -> void:
	var show: bool = phase == Phase.PLAYER_TURN and _hud_layer != null
	for k in _aim_thread_nodes.keys():
		var alive: bool = show and is_instance_valid(k) \
			and not bool(k.is_opponent) and _sniper_mark_target(k) != null
		if not alive:
			var stale: Dictionary = _aim_thread_nodes[k]
			for n in stale.values():
				if is_instance_valid(n):
					n.queue_free()
			_aim_thread_nodes.erase(k)
	if not show:
		return
	for k in _sniper_marks.keys():
		# Erase, don't skip: a dead sniper's key lingered forever, and
		# _combat_process_needed() returns true while _sniper_marks is non-empty,
		# so one standing order pinned _process on for the rest of the fight and
		# left the dict holding dangling Object keys. (.keys() is a copy, so
		# erasing during this loop is safe.)
		if not is_instance_valid(k):
			_sniper_marks.erase(k)
			continue
		if bool(k.is_opponent):
			continue
		var sniper: Control = k
		var quarry: Control = _sniper_mark_target(sniper)
		if quarry == null:
			continue
		if not _aim_thread_nodes.has(sniper):
			var line := Line2D.new()
			line.width = 2.5
			line.antialiased = true
			line.begin_cap_mode = Line2D.LINE_CAP_ROUND
			line.end_cap_mode = Line2D.LINE_CAP_ROUND
			line.z_index = 230   # under the telegraph arrow (235) — a standing
			var grad := Gradient.new()   # order must never shout over a forecast
			grad.set_color(0, Color(AIM_COLOR.r, AIM_COLOR.g, AIM_COLOR.b, 0.16))
			grad.set_color(1, Color(AIM_COLOR.r, AIM_COLOR.g, AIM_COLOR.b, 0.70))
			line.gradient = grad
			_hud_layer.add_child(line)
			var head := Polygon2D.new()
			head.polygon = PackedVector2Array([
				Vector2(0, -7), Vector2(7, 0), Vector2(0, 7), Vector2(-7, 0)])
			head.color = Color(AIM_COLOR.r, AIM_COLOR.g, AIM_COLOR.b, 0.85)
			head.z_index = 231
			_hud_layer.add_child(head)
			_aim_thread_nodes[sniper] = {"line": line, "head": head}
		var nodes: Dictionary = _aim_thread_nodes[sniper]
		var line_n: Line2D = nodes["line"]
		var head_n: Polygon2D = nodes["head"]
		var a: Vector2 = _card_center(sniper)
		var b: Vector2 = _card_center(quarry)
		line_n.points = PackedVector2Array([a, b])
		head_n.position = b


func _sniper_pick_lowest(opp_is_enemy: bool, skip_back: bool) -> Control:
	# Lowest-HP living enemy creature (structures aren't valid targets). Ties:
	# first found (front row before back).
	var best: Control = null
	for r in [ROW_FRONT, ROW_BACK]:
		if skip_back and r == ROW_BACK:
			continue
		for l in range(LANES_PER_ROW):
			var c = _row_array(opp_is_enemy, r)[l]
			if c != null and is_instance_valid(c) and c.current_hp > 0 \
					and not c.has_keyword("structure"):
				if best == null or c.current_hp < best.current_hp:
					best = c
	return best


func _sniper_can_keep_firing(card: Control) -> bool:
	# _resolve_ranged_attacks marks the sniper as spent before entering the shot
	# loop, so Card2D.can_attack() would always reject the actual shot. Re-check
	# the real incapacitating states here without reading has_attacked_this_turn.
	if card == null or not is_instance_valid(card) or card.current_hp <= 0:
		return false
	if card.will_floop or card.has_flooped_this_turn:
		return false
	if card.state.is_frozen or card.state.stunned:
		return false
	if card.has_keyword("structure"):
		return false
	if card.card_data.get("passive", "") == "cannot_attack_wall":
		return false
	return true


func _sniper_fire(card: Control, lane_idx: int, is_enemy: bool) -> void:
	# Sniper: fire at the lowest-HP enemy; if the shot kills, fire again at the
	# next-weakest — a marksman cleaning up a softened line. ATK is recomputed per
	# shot so Rampage (+ATK on kill) compounds down the chain; Lifesteal heals per
	# hit. Each shot kills (shrinking the pool) or stops, so it always terminates.
	var opp_is_enemy := not is_enemy
	for _shot in range(8):
		if not _sniper_can_keep_firing(card):
			return
		# Take Aim: the OPENING shot obeys the standing order if the quarry still
		# stands; every later shot in the chain is the marksman's own judgment
		# (next-weakest), and so is an unaimed opening.
		var target: Control = _sniper_mark_target(card) if _shot == 0 else null
		if target == null:
			target = _sniper_pick_lowest(opp_is_enemy, false)
		var atk := _effective_attack(card, lane_idx, is_enemy)
		if target == null:
			# Nothing to shoot: only the OPENING shot carries to face (a chain that
			# already cleared the board doesn't keep plinking the hero).
			if _shot == 0:
				_play_face_strike_vfx(card, lane_idx, is_enemy, atk)
				_net_arm_face_hit_source(card, lane_idx, atk)
				if is_enemy:
					damage_player_hero(atk, false)
				else:
					damage_enemy_hero(atk, false)
				_net_clear_face_hit_source()
				_apply_combat_strike_riders(card, atk, false, is_enemy)
				await _short_pause(_impact_hold(atk, false))
			return
		_play_attack_tracer(_card_center(card), _card_center(target),
			is_enemy, float(atk), atk >= HEAVY_HIT_DAMAGE, true)
		if target.has_method("play_hit_recoil"):
			target.play_hit_recoil(is_enemy)
		var t_pos := _find_creature_position(target)
		var target_lane: int = int(t_pos.get("lane", lane_idx)) if not t_pos.is_empty() else lane_idx
		atk = _effective_attack(card, lane_idx, is_enemy)
		if target.state.marked:
			atk += 2
		if target.state.enrage_vulnerable:
			atk += 1
		_apply_thorns(target, card, not is_enemy)
		atk = _creature_strike_amount(target, atk, is_enemy)
		var hp_before: int = target.current_hp
		_log_event("%s looses at %s for [color=#f2e6c8]%d[/color]." \
			% [_log_card_ref(card), _log_card_ref(target), atk],
			_log_data(card), _log_side(card))
		var shot_dmg: int = _deal_creature_strike_damage(target, atk)
		_apply_creature_strike_poison(card, target, is_enemy, shot_dmg)
		_net_log_hit(card, target, hp_before)
		var killed: bool = not is_instance_valid(target) or target.current_hp <= 0
		if is_instance_valid(card) and is_instance_valid(target):
			_spawn_impact_burst(_strike_contact_point(card, target),
				_card_center(target) - _card_center(card), float(atk), killed)
		if shot_dmg > 0 and killed and is_instance_valid(target) and not target._dead:
			target.death_cue_played = true
			AudioBank.play_sfx("creature_death", 0.05)
		_apply_creature_struck_growth(target, shot_dmg)
		if is_instance_valid(target) and atk > 0:
			_apply_struck_passives(target, card, not is_enemy, shot_dmg)
		if killed:
			_apply_piercing_overflow(card, target, target_lane, is_enemy, t_pos,
				_strike_reaches_face(card, is_enemy))
		_apply_combat_strike_riders(card, shot_dmg, killed, is_enemy, target)
		# Pavise: an enemy sniper's shot that lands on the player's BACK row is
		# answered — the shieldwall's return bolt hits the marksman for 3. A
		# dead sniper's chain ends with him. (Position captured pre-shot so a
		# killed target still reads as the back-row hit it was.)
		if is_enemy and _has_relic("hexagonal_shield") and not t_pos.is_empty() \
				and int(t_pos["row"]) == ROW_BACK:
			var pv: int = int(RelicDB.get_relic("hexagonal_shield").get("value", 3))
			spawn_floating_number(_card_center(card) + Vector2(0, -14),
				"SNIPER SHIELD %d" % pv, Color(0.55, 0.78, 1.0), false)
			_relic_fired("hexagonal_shield")
			card.take_damage_bypass_armor(pv)
			if not is_instance_valid(card) or card.current_hp <= 0:
				return
		await _short_pause(_impact_hold(atk, killed))
		if not killed:
			return   # the chain only continues on a kill


func _apply_thorns(defender: Control, attacker: Control, defender_is_enemy: bool) -> void:
	# Thorns can be intrinsic, encounter-passive granted, or temp from Shield Wall.
	# Bridge Watcher / Corner Stone relics grant Thorns 2 by lane position to the
	# player's creatures — checked alongside the existing sources so the relics
	# stack with intrinsic thorns rather than replacing them.
	var defender_is_friendly: bool = not defender_is_enemy
	var has_thorns: bool = defender.has_keyword("thorns") \
		or (defender_is_enemy and _has_encounter_passive_keyword(defender, "thorns")) \
		or defender.state.shield_wall_thorns \
		or defender.state.square_thorns \
		or (defender_is_friendly and _has_relic("corner_stone") \
			and defender.current_lane in [0, LANES_PER_ROW - 1])
	if has_thorns and defender.current_hp > 0:
		var thorns_dmg = 1
		# Corner Stone explicitly grants Thorns 2. (bridge_watcher's center-lane
		# grant removed 2026-07-16 — the id is now Witch-Shot, a spell relic.)
		if defender_is_friendly \
				and _has_relic("corner_stone") and defender.current_lane in [0, LANES_PER_ROW - 1]:
			thorns_dmg = maxi(thorns_dmg, 2)
		# Recoil bite: a red spark + chip on the attacker that ran onto the thorns.
		if is_instance_valid(attacker):
			spawn_ash_burst(_card_center(attacker), Color(0.85, 0.18, 0.20), 10)
			spawn_keyword_callout_kw(attacker, "thorns")
		var trap_pos := _find_creature_position(attacker)
		var pre_thorns_hp: int = attacker.current_hp
		attacker.take_damage_bypass_armor(thorns_dmg)
		# Basilisk (venom_thorns): its thorns are poisonous — a striker that bled
		# on them dies outright. A Shield that soaked the recoil blocks the venom
		# too (same "must deal damage" rule as Poison strikes).
		if bool(defender.card_data.get("venom_thorns", false)) \
				and is_instance_valid(attacker) and attacker.current_hp > 0 \
				and attacker.current_hp < pre_thorns_hp:
			attacker.current_hp = 0
			attacker.update_stat_display()
			spawn_keyword_callout_kw(attacker, "poison")
			if not Card2D.defer_deaths:
				attacker.try_die()
		# Man-Trap: an enemy that DIES on the player's thorns (the sting or the
		# venom rider above) springs the trap — its same-row neighbors take 2.
		# Position was captured before the sting, so a body already swept from
		# the arrays still reads as the lane it fell in.
		if defender_is_friendly and bool(attacker.is_opponent) and _has_relic("briar_amulet") \
				and (not is_instance_valid(attacker) or attacker.current_hp <= 0) \
				and not trap_pos.is_empty() and bool(trap_pos["is_enemy"]):
			var trap_dmg: int = int(RelicDB.get_relic("briar_amulet").get("value", 2))
			for trap_neighbor in _adjacent_creatures(true, int(trap_pos["row"]), int(trap_pos["lane"])):
				if trap_neighbor != null and is_instance_valid(trap_neighbor) and trap_neighbor.current_hp > 0:
					spawn_floating_number(_card_center(trap_neighbor) + Vector2(0, -14),
						"MAN-TRAP %d" % trap_dmg, Color(0.62, 0.80, 0.35), false)
					_relic_fired("briar_amulet")
					trap_neighbor.take_damage(trap_dmg)


func _effective_attack(card: Control, lane_idx: int, is_enemy: bool) -> int:
	# Adjacency buffs are baked into effective_atk() via the stored adj_atk_buff
	# (kept fresh by _refresh_adjacency_buffs), so they apply to BOTH sides and
	# show on the numeral — do NOT re-add them here or it double-counts.
	# THE SEAL USED TO LIE (fixed 2026-07-28). The six relic terms below were added
	# HERE, outside Card2D — so `card.effective_atk()`, which drives the wax ATK
	# seal AND the hover stat-provenance readout, returned a number the creature did
	# not swing for whenever one of these relics was held. A missing cue is bad; a
	# FALSE one that is on screen permanently is worse.
	#
	# They now live on `CreatureInstance.relic_atk_buff`, which `effective_atk()`
	# includes. This function refreshes that component before reading, so the value
	# it returns is computed exactly as it always was — the arithmetic is unchanged
	# and no gameplay moves. What changed is that the number is now also VISIBLE on
	# the card, because the seal reads the same field.
	#
	# Refreshing here (rather than trusting the periodic sweep) is deliberate: two
	# of the six are round-scoped (`champions_belt`'s latch, `steady_banner`'s
	# round-1 debuff) and one is board-shaped (`phalanx_stone`), so a stale read
	# would change real damage, not just a label.
	if not is_enemy and not _is_net():
		card.relic_atk_buff = _relic_atk_for(card)
	return maxi(0, card.effective_atk())


## The six relic ATK terms, as a pure function of the board. Player side only —
## the enemy has no relics, and on a net client the host owns the folded number
## (same contract as `adj_atk_buff`: the client must leave it 0 or it double-counts
## against the replicated effective ATK).
##
## May return NEGATIVE (steady_banner's round-1 −1). The component is deliberately
## unclamped; `effective_atk()` floors the TOTAL at 0.
func _relic_atk_for(card: Control) -> int:
	if card == null or not is_instance_valid(card):
		return 0
	var atk := 0
	# Granted Swift (War Cry rally, Battle Drummer aura) counts: the boots
	# reward striking in the pre-phase, however the speed was come by.
	if _is_swift_attacker(card) and _has_relic("swift_boots"):
		atk += 1
	if _has_relic("glass_cannon"):
		atk += 1
	# (vanguard_banner's flat front-row ATK removed 2026-07-16 — the id is
	# now The Tally-Stick; see the notch in _on_card_played.)
	# Linked Banner: friendlies with 2+ adjacent friendlies get +1 ATK
	# (HP half is applied as a snapshot in _apply_linked_banner_hp).
	if _has_relic("linked_banner") and _count_adjacent_friendlies(card) >= 2:
		atk += 1
	# Champion's Belt: turn-1-only buff. Latch is cleared at round 2 start.
	if _champions_belt_active and _has_relic("champions_belt"):
		atk += int(RelicDB.get_relic("champions_belt").get("value", 1))
	# Phalanx Stone: all 4 front lanes full → every friendly gets +1 ATK.
	if _has_relic("phalanx_stone") and _front_row_full(false):
		atk += int(RelicDB.get_relic("phalanx_stone").get("value", 1))
	# Diagonal Crest: diagonal friendlies count as adjacent (the HP +1
	# half is granted at placement via _apply_linked_banner_hp's broader
	# rescan; ATK part falls through the linked_banner branch since both
	# relics share the "needs 2 adj" condition when held together).
	# (Neither uses the card adj_buff path — that is Battle Drummer's keyword,
	# now baked into effective_atk via adj_atk_buff.)
	# Steady Banner: turn-1 ATK debuff. The +2 persistent buff is granted
	# in _end_round to surviving creatures. NOT floored here — the component may
	# go negative and effective_atk() floors the total.
	if round_number == 1 and _has_relic("steady_banner"):
		atk -= 1
	return atk


func _front_row_full(is_enemy: bool) -> bool:
	for c in _row_array(is_enemy, ROW_FRONT):
		if c == null:
			return false
	return true


func _curse_count_in_deck() -> int:
	var n := 0
	for cid in RunState.deck:
		if CardDB.is_curse(cid):
			n += 1
	return n


func _deck_creature_ratio() -> float:
	if RunState.deck.is_empty():
		return 0.0
	var creatures: int = 0
	for cid in RunState.deck:
		if CardDB.get_card_data(cid).get("type", "") == "creature":
			creatures += 1
	return float(creatures) / float(RunState.deck.size())


func _mime_trigger_floop_from_hand() -> void:
	# Mime: the player picks ONE creature with an on-play battlecry in hand (floop
	# was folded into on_play — see _resolve_on_play_ability); it's played for free
	# with that battlecry triggered. The card stays on the board afterward (it WAS
	# played — the relic just made it free). Cancellable: closing the picker skips
	# Mime for this turn. (Headless/automation note: this awaits a picker click, so
	# test harnesses must not grant Mime — there is no one to dismiss it.)
	var candidates: Array[Control] = []
	for c in _hand:
		if c != null and is_instance_valid(c) and c.is_creature() and c.card_data.has("on_play"):
			candidates.append(c)
	if candidates.is_empty():
		return
	# No room to place — don't even open the picker.
	if _pick_empty_for_summon(false, ROW_FRONT).is_empty():
		return
	var candidate: Control = await _show_mime_picker(candidates)
	if candidate == null or not is_instance_valid(candidate) or not _hand.has(candidate):
		return
	var slot := _pick_empty_for_summon(false, ROW_FRONT)
	if slot.is_empty():
		return
	_hand.erase(candidate)
	if candidate.get_parent() != null:
		candidate.get_parent().remove_child(candidate)
	candidate.is_on_battlefield = true
	candidate.current_row = slot.row
	candidate.current_lane = slot.lane
	candidate.set_compact_mode(true)
	_place_card_in_slot(candidate, slot.lane, slot.row)
	_first_creature_played = true
	_relic_fired("mime")
	# Mime triggers the card's on-play ability for free.
	if candidate.card_data.has("on_play"):
		_resolve_on_play_ability(candidate, slot.lane, false)


func _show_mime_picker(candidates: Array[Control]) -> Control:
	## Mime end-of-turn picker: show the hand creatures-with-floop; the player
	## clicks one (returned) or cancels (null). Modeled on _show_recycle_modal.
	if candidates.is_empty():
		return null
	var overlay := ColorRect.new()
	overlay.color = Color(0.05, 0.03, 0.04, 0.80)
	overlay.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	overlay.mouse_filter = Control.MOUSE_FILTER_STOP
	overlay.z_index = 200
	add_child(overlay)

	var center := CenterContainer.new()
	center.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	overlay.add_child(center)

	var col := VBoxContainer.new()
	col.add_theme_constant_override("separation", 20)
	col.alignment = BoxContainer.ALIGNMENT_CENTER
	center.add_child(col)

	var title := Label.new()
	title.text = "Mime — floop a creature for free"
	title.add_theme_font_override("font", GameTheme.font_display)
	title.add_theme_font_size_override("font_size", 30)
	title.add_theme_color_override("font_color", Color(1.0, 0.85, 0.30))
	title.add_theme_color_override("font_outline_color", Color(0, 0, 0, 0.95))
	title.add_theme_constant_override("outline_size", 6)
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	col.add_child(title)

	var grid := GridContainer.new()
	grid.columns = mini(candidates.size(), 6)
	grid.add_theme_constant_override("h_separation", 16)
	grid.add_theme_constant_override("v_separation", 16)
	col.add_child(grid)

	var result := {"card": null, "cancelled": false}
	for hand_card in candidates:
		var data: Dictionary = hand_card.card_data
		var slot := Control.new()
		slot.custom_minimum_size = Vector2(220, 300)
		grid.add_child(slot)
		var display = CARD_SCENE.instantiate()
		display.card_id = hand_card.card_id
		display.card_data = data.duplicate(true)
		display.is_on_battlefield = true
		slot.add_child(display)
		var btn := Button.new()
		btn.flat = true
		btn.focus_mode = Control.FOCUS_NONE
		btn.set_anchors_preset(Control.PRESET_FULL_RECT)
		var captured: Control = hand_card
		btn.pressed.connect(func():
			result["card"] = captured
			overlay.queue_free()
		)
		slot.add_child(btn)

	var cancel := GameTheme.make_back_button("CANCEL", Vector2(160, 40))
	cancel.size_flags_horizontal = Control.SIZE_SHRINK_CENTER
	cancel.pressed.connect(func():
		result["cancelled"] = true
		overlay.queue_free()
	)
	col.add_child(cancel)

	while result["card"] == null and not result["cancelled"] and is_instance_valid(overlay):
		await get_tree().process_frame
	return result["card"]


func _empty_player_slots_count() -> int:
	var n := 0
	for row in [ROW_FRONT, ROW_BACK]:
		for c in _row_array(false, row):
			if c == null:
				n += 1
	return n


func _apply_pact_of_embers() -> void:
	# Pact of Embers: find the highest-cost card in hand RIGHT NOW (after all
	# draws settled) and zero its cost for this turn via a meta flag. Tied
	# cards: pick the first encountered (left-most in fan).
	if not _has_relic("pact_of_embers"):
		return
	var best: Control = null
	var best_cost: int = -1
	for c in _hand:
		if c == null or not is_instance_valid(c):
			continue
		var cc: int = int(c.card_data.get("cost", 0))
		if cc > best_cost:
			best_cost = cc
			best = c
	if best != null:
		best.state.pact_of_embers_zero = true
		_refresh_hand_affordability()
		if best_cost > 0:
			_relic_fired("pact_of_embers")


func _count_adjacent_friendlies(card: Control) -> int:
	# "Adjacent" per the design doc: ±1 column, both rows count. Same-column
	# other-row does NOT count. Used by linked_banner and any future relics
	# that gate on adjacency density.
	#
	# Sentinel Pact: empty lanes count as friendlies. Lets thin-board players
	# benefit from adjacency-density relics without forcing a wide field.
	if card == null or not is_instance_valid(card):
		return 0
	var lane: int = card.current_lane
	var count := 0
	var sentinel: bool = _has_relic("sentinel_pact")
	for adj_lane in [lane - 1, lane + 1]:
		if adj_lane < 0 or adj_lane >= LANES_PER_ROW:
			continue
		for row in [ROW_FRONT, ROW_BACK]:
			var field = _row_array(false, row)
			if field[adj_lane] != null:
				count += 1
			elif sentinel:
				count += 1
	return count


func _apply_linked_banner_hp() -> void:
	# HP half of Linked Banner: scan every friendly; any that NOW has 2+
	# adjacents and hasn't been buffed yet gets +1 max HP and +1 current HP.
	# Called after each creature placement so newly-adjacent allies catch up.
	# The buff is permanent for the rest of combat — we deliberately don't
	# pull it back when a neighbor dies (mirrors how Veteran's Medal and
	# Stone Skin grant non-revocable +HP).
	#
	# Diagonal Crest: when held alongside Linked Banner (or alone), bumps the
	# HP grant from +1 to +2. Stacks the "extra HP on adjacency" payoff cleanly
	# instead of needing its own scan.
	if not _has_relic("linked_banner") and not _has_relic("diagonal_crest"):
		return
	var bonus: int = 1
	if _has_relic("diagonal_crest"):
		bonus += int(RelicDB.get_relic("diagonal_crest").get("value", 1))
	for c in _all_player_creatures():
		if c.state.linked_banner_buffed:
			continue
		if _count_adjacent_friendlies(c) >= 2:
			c.card_data["hp"] = int(c.card_data.get("hp", c.current_hp)) + bonus
			c.current_hp += bonus
			c.state.linked_banner_buffed = true
			c.update_stat_display()


func _get_adj_buff_atk(lane_idx: int, row: int, is_enemy: bool) -> int:
	# Canonical adjacency (row ±1 + column-mate): an adj_buff source feeds the
	# seats beside it in its own row plus the seat sharing its lane — the
	# adjacency relation is symmetric, so reading the receiver's neighbors
	# finds every source whose aura covers it.
	#
	# (adj_buff.hp used to be dead here — see _get_adj_buff_hp below, which now
	# owns it. Standard Page prints "Adjacent friendlies have +1 HP" and shipped
	# as a vanilla 0/3 for as long as that note said "every card sets hp:0".)
	var receiver = _row_array(is_enemy, row)[lane_idx]
	if _is_fortification(receiver):
		return 0
	var total := 0
	for neighbor in _adjacent_creatures(is_enemy, row, lane_idx):
		if _is_fortification(neighbor):
			continue
		if neighbor.card_data.has("adj_buff"):
			total += int(neighbor.card_data.adj_buff.get("atk", 0))
			# (Banner of Unity's old "+1 to adjacency" bonus lived here —
			# redesigned 2026-07-03 into the flanked-play rally in
			# _play_creature, so adjacency math is clean again.)
	return total


## The HP half of adjacency (Standard Page: "Adjacent friendlies have +1 HP").
## Same neighbour set and the same fortification exclusion as _get_adj_buff_atk —
## the two must agree on who counts, or one card's aura would cover seats the
## other's doesn't.
func _get_adj_buff_hp(lane_idx: int, row: int, is_enemy: bool) -> int:
	var receiver = _row_array(is_enemy, row)[lane_idx]
	if receiver == null or not is_instance_valid(receiver) or _is_fortification(receiver):
		return 0
	var total := 0
	for neighbor in _adjacent_creatures(is_enemy, row, lane_idx):
		if _is_fortification(neighbor):
			continue
		if neighbor.card_data.has("adj_buff"):
			total += int(neighbor.card_data.adj_buff.get("hp", 0))
	return total


## Push a computed HP aura onto one body, adding or REMOVING the difference.
##
## ATK auras can be a single live number (adj_atk_buff, folded by effective_atk),
## but HP has no such fold: current_hp is a raw stored int that damage subtracts
## from, and max HP is card_data.hp, which every heal caps against. So the aura
## has to be materialised into both — and to take it back off again when the
## banner falls, the body has to remember how much it was lent. That ledger is
## card_data.adj_hp_granted (card_data is deep-duplicated per instance, so it is
## genuinely per-body and rides the ordinary board snapshot).
##
## Losing the aura FLOORS at 1 rather than killing: this runs at ~35 board-mutation
## call sites, including the tail of _cleanup_dead itself, so a death started here
## would be a re-entrant one nothing is left to sweep. A banner falling can leave a
## survivor on 1 HP; it can never kill it.
func _apply_adjacency_hp(c: Control, want: int) -> void:
	# A body already at 0 is mid-death (Card2D.defer_deaths holds corpses through
	# the whole clash). Touching it would RESURRECT it: the removal floor below
	# would read 0 and write 1, and a corpse standing back up because its banner
	# fell is not a rule anyone printed. It leaves the board with a stale ledger,
	# which nothing outlives.
	if c == null or not is_instance_valid(c) or c.current_hp <= 0:
		return
	var held: int = int(c.card_data.get("adj_hp_granted", 0))
	if held == want:
		return
	var delta: int = want - held
	c.card_data["adj_hp_granted"] = want
	c.card_data["hp"] = maxi(1, int(c.card_data.get("hp", c.current_hp)) + delta)
	c.current_hp = maxi(1, c.current_hp + delta)
	if c.has_method("update_stat_display"):
		c.update_stat_display()


func _get_type_buff_atk(receiver: Control, is_enemy: bool) -> int:
	# Type-wide ATK auras (Warchief: "your other Soldiers get +1 ATK"): every
	# OTHER living friendly carrying a matching `type_buff` feeds this
	# creature. State-derived like adjacency — recomputed at every board
	# mutation by _refresh_adjacency_buffs, so it rides adj_atk_buff and the
	# net snapshot the same way.
	var total := 0
	if _is_fortification(receiver):
		return 0
	var rc: String = String(receiver.card_data.get("ctype", ""))
	if rc == "":
		return 0
	for src_c in _all_friendly(is_enemy):
		if src_c == receiver or not is_instance_valid(src_c) or src_c.current_hp <= 0 \
				or _is_fortification(src_c):
			continue
		var tb = src_c.card_data.get("type_buff", null)
		if tb is Dictionary and String(tb.get("ctype", "")) == rc:
			total += int(tb.get("atk", 0))
			# (Kingpin's old per_gold payday aura was retired 2026-07-24 when the
			# Stray tribe was rebuilt on mobility + larceny — see Defection in
			# _apply_combat_strike_riders. No pool card carries per_gold now.)
	return total


## Re-tally every creature's adjacency ATK buff from scratch and push it onto the
## card so it (a) shows on the ATK numeral with a "+N ATK" pop, (b) rides the net
## board snapshot (which serialises effective_atk), and (c) applies to BOTH sides
## — an enemy/opponent Battle Drummer buffs ITS neighbours too. Called at every
## board-mutation choke point; cheap (16 slots) and only repaints cards whose
## value actually changed, so redundant calls are harmless.
##
## The net CLIENT never runs this: its creatures' current_atk already carries the
## host's buffed effective_atk straight off the snapshot, so recomputing locally
## would double-count.
func _refresh_adjacency_buffs() -> void:
	if _is_client():
		return
	for is_enemy in [false, true]:
		for row in [ROW_FRONT, ROW_BACK]:
			var arr = _row_array(is_enemy, row)
			for lane in range(LANES_PER_ROW):
				var c = arr[lane]
				if c == null or not is_instance_valid(c):
					continue
				# Relic ATK rides the same sweep as the adjacency aura so the wax
				# seal is correct while the player is PLANNING, not only at the
				# moment of the strike. _effective_attack refreshes it again on
				# read, which is the safety net for the round-scoped terms
				# (champions_belt, steady_banner) that can move between sweeps.
				var relic_atk: int = 0 if is_enemy else _relic_atk_for(c)
				if c.relic_atk_buff != relic_atk:
					c.relic_atk_buff = relic_atk
					if c.has_method("update_stat_display"):
						c.update_stat_display()
				var bonus := _get_adj_buff_atk(lane, row, is_enemy) \
						+ _get_type_buff_atk(c, is_enemy)
				if c.adj_atk_buff != bonus:
					c.adj_atk_buff = bonus
					if c.has_method("update_stat_display"):
						c.update_stat_display()
				# The HP half of the same aura. Not a live-folded number like the
				# ATK one — it is materialised into current/max HP and taken back
				# off when the source leaves. See _apply_adjacency_hp.
				_apply_adjacency_hp(c, _get_adj_buff_hp(lane, row, is_enemy))
	# Battle Drummer (drummer_swift): adjacent friendlies (canonical: row ±1 +
	# column-mate) hold Swift while the drum beats. Meta-flag grant on War
	# Cry's channel, cleared and re-derived at every board mutation so the aura
	# moves with the drummer and dies with it — see _is_swift_attacker.
	for c0 in _all_creatures_both_sides():
		if is_instance_valid(c0):
			c0.state.drummer_swift = false
	for is_enemy in [false, true]:
		for row in [ROW_FRONT, ROW_BACK]:
			var arr = _row_array(is_enemy, row)
			for lane in range(LANES_PER_ROW):
				var dr = arr[lane]
				if dr == null or not is_instance_valid(dr) or dr.current_hp <= 0:
					continue
				if String(dr.card_data.get("passive", "")) != "drummer_swift":
					continue
				for nb in _adjacent_creatures(is_enemy, row, lane):
					nb.state.drummer_swift = true
	# Pike Square (square_thorns): the pikes only bite while the square is
	# CLOSED — a friendly beside it (canonical adjacency: row ±1 + column-mate,
	# same as the drummer above). Same clear-then-derive model, so the Thorns
	# appear and vanish as the line forms and breaks.
	for c1 in _all_creatures_both_sides():
		if is_instance_valid(c1):
			c1.state.square_thorns = false
	for sq_side in [false, true]:
		for sq_row in [ROW_FRONT, ROW_BACK]:
			var sq_arr = _row_array(sq_side, sq_row)
			for sq_lane in range(LANES_PER_ROW):
				var sq = sq_arr[sq_lane]
				if sq == null or not is_instance_valid(sq) or sq.current_hp <= 0:
					continue
				if String(sq.card_data.get("passive", "")) != "square_thorns":
					continue
				if not _adjacent_creatures(sq_side, sq_row, sq_lane).is_empty():
					sq.state.square_thorns = true
					# The closed square FIGHTS, it does not merely endure. First
					# shape was Thorns alone; the shell ladder graded a 10x deck of
					# them at -34 vs -33 for a plain troll — a 1-ATK wall with a
					# 1-point recoil never closes a fight, so the card was a hold
					# button with no threat. The pikes levelled make it a real
					# formation: one condition, one idea, two riders.
					#
					# Rides adj_atk_buff, which the bonus loop above already
					# ASSIGNED this pass — so this adds on top of a freshly written
					# value and stays idempotent across sweeps. The display refresh
					# has to be re-poked here because that loop only fires it when
					# its own computed value changed.
					sq.adj_atk_buff += SQUARE_CLOSED_ATK
					if sq.has_method("update_stat_display"):
						sq.update_stat_display()
	# (Warchief's old count-my-allies ATK aura lived here — reworked 2026-07-10
	# into the Soldier type_buff aura, summed in _get_type_buff_atk.)
	# Column wards (state-derived, same model as the drummer above): Honor
	# Guard's HP floor and the Oathbound Squire's damage redirect both protect
	# the ward's COLUMN-MATE while the ward stands. Cleared and re-derived at
	# every board mutation so the protection moves with placements and dies
	# with the ward. Card2D.take_damage reads both (hp_floor meta / ward_by).
	for cw in _all_creatures_both_sides():
		if is_instance_valid(cw):
			cw.state.hp_floor = false
			cw.ward_by = null
	for ward_side in [false, true]:
		for ward_row in [ROW_FRONT, ROW_BACK]:
			var ward_arr = _row_array(ward_side, ward_row)
			for ward_lane in range(LANES_PER_ROW):
				var wd = ward_arr[ward_lane]
				if wd == null or not is_instance_valid(wd) or wd.current_hp <= 0:
					continue
				var wd_p := String(wd.card_data.get("passive", ""))
				if wd_p != "column_ward" and wd_p != "bodyguard":
					continue
				var wd_mate = _row_array(ward_side,
					ROW_BACK if ward_row == ROW_FRONT else ROW_FRONT)[ward_lane]
				if wd_mate == null or not is_instance_valid(wd_mate) or wd_mate.current_hp <= 0:
					continue
				if wd_p == "column_ward":
					wd_mate.state.hp_floor = true
				else:
					wd_mate.ward_by = wd
	# The encounter's own lent keywords ride the same clear-then-derive sweep, for
	# the same reason the drummer's Swift and the column wards do: merc_piercing is
	# conditional on LIVE ATK, so its grant has to appear and vanish as neighbours
	# (and their auras) come and go. Signal only — see the block comment on
	# _refresh_encounter_keyword_grants; no strike path reads what it writes.
	_refresh_encounter_keyword_grants()


func _has_passive_on_field(passive_name: String) -> bool:
	for c in _all_player_creatures():
		if c.card_data.get("passive", "") == passive_name:
			return true
	return false


## Start-of-round ATK engines for one side: Riteforge (all allies +N per round).
## Solo runs it for the player; the net turn machine also runs it host-side for
## the client (_net_open_placement, active==1). (Warchief's aura moved to the
## state-derived type_buff path 2026-07-10.)
## Bloodmoon Alpha (beast_encore): a friendly Beast's arrival effects fire a second
## time while a friendly Bloodmoon Alpha holds the board. Doubles BOTH channels an
## arrival can use — the on_enter dict and the on_play ability — since the pool
## splits "reach on landing" across both. Uses _run_on_enter (like Blueprint) so it
## replays the effect only, not the summon keyword / reactives. Called right after
## each authoritative on-enter site (solo both sides + net host); no recursion,
## since it calls the resolvers directly, not the placement path.
## The Dire Alpha (stampede) — the BEAST signature MOMENT. Beast is the one tribe
## whose identity is genuinely present-tense (it pays on ARRIVAL, not on survival),
## so it takes a per-round counter instead of a latch or an arming flag.
##
## When the second Beast of the round lands on a side that fields a Dire Alpha, the
## pack charges: the arriving body strikes the enemy CREATURE across from it.
##
## THE FACE IS UNREACHABLE HERE, BY CONSTRUCTION AND ON PURPOSE. An empty opposing
## column FIZZLES — the strike is never redirected at the hero. Beasts hitting the
## face on their arrival round is the "Beat the Retreat" shape the project already
## considered and rejected, and _creature_hits_face guards the clash against it;
## a keystone that smuggled it back in through a passive would be that rejected
## card with extra steps.
##
## Called from the same three authoritative arrival sites as _maybe_beast_encore
## (solo both sides + the net host), which is why it lives right beside it.
func _maybe_stampede(card: Control, is_enemy: bool) -> void:
	if not is_instance_valid(card):
		return
	if String(card.card_data.get("ctype", "")) != "beast":
		return
	var side: int = int(is_enemy)
	_beasts_arrived_this_round[side] += 1
	var alpha: Control = null
	for a in _all_friendly(is_enemy):
		if not is_instance_valid(a):
			continue
		if a.card_data.get("passive", "") == "stampede":
			alpha = a
			break
	if alpha == null:
		return
	# Forged, the whole pack charges — every Beast arrival, not just the second on.
	var need: int = 1 if bool(alpha.card_data.get("is_upgraded", false)) else 2
	if _beasts_arrived_this_round[side] < need:
		return
	var quarry = get_opposing_card(card.current_lane, is_enemy)
	if quarry == null or not is_instance_valid(quarry) or quarry.current_hp <= 0:
		# FIZZLE, loudly. A silent no-op would read as a bug, and the player needs
		# to learn that the charge wants a body in front of it.
		spawn_trigger_callout(_card_center(card) + Vector2(0, -14), "NO QUARRY",
			false, int(card.entity_id))
		return
	var dmg: int = maxi(1, card.effective_atk())
	var hp_before: int = int(quarry.current_hp)
	spawn_trigger_callout(_card_center(card) + Vector2(0, -14), "STAMPEDE",
		false, int(card.entity_id))
	if _hud_layer != null and DisplayServer.get_name() != "headless":
		_trigger_fx_ring(_card_center(alpha), CTYPE_COLORS["beast"], 30.0, 218)
	quarry.take_damage(dmg)
	_net_log_hit(card, quarry, hp_before, false)


func _maybe_beast_encore(card: Control, is_enemy: bool) -> void:
	if not is_instance_valid(card):
		return
	if String(card.card_data.get("ctype", "")) != "beast":
		return
	if not (card.card_data.has("on_enter") or card.card_data.has("on_play")):
		return
	var alpha: Control = null
	for a in _all_friendly(is_enemy):
		if a == card or not is_instance_valid(a):
			continue
		if a.card_data.get("passive", "") == "beast_encore":
			alpha = a
			break
	if alpha == null:
		return
	# The keystone made VISIBLE (beast signature): the Alpha HOWLS — a doubled
	# russet ring — the beast is named ENCORE, and the arrival effect's material
	# beat replays a beat later so the second firing reads as an echo, not a
	# same-frame smear. (Resolution stays instant; only presentation is delayed.
	# The delayed derivation reads the post-resolution board, so an echo over a
	# body the first firing killed lands where it fell — the spell-grammar rule.)
	spawn_trigger_callout(_card_center(card) + Vector2(0, -14), "ENCORE",
		false, int(card.entity_id))
	if _hud_layer != null and DisplayServer.get_name() != "headless":
		var be_col: Color = CTYPE_COLORS["beast"]
		var howl: Vector2 = _card_center(alpha)
		_trigger_fx_ring(howl, be_col, 34.0, 218)
		Motion.ring(_hud_layer, howl, Color(be_col.r, be_col.g, be_col.b, 0.45),
			{"radius": 24.0, "end_scale": 2.1, "duration": 0.44, "z_index": 218,
			"width": 2.0, "delay": 0.12, "scale_time": true})
		# on_enter encores replay their material beat delayed (the echo). on_play
		# encores need nothing here — the _resolve_on_play_ability call below
		# fires its own "play"-channel beat at re-resolution.
		if card.card_data.has("on_enter"):
			var be_card := card
			var be_lane: int = card.current_lane
			var be_enemy := is_enemy
			get_tree().create_timer(UserSettings.anim_time(0.30)).timeout.connect(func():
				if is_inside_tree() and is_instance_valid(be_card):
					_play_trigger_fx(be_card.card_data.get("on_enter", {}), be_card,
						be_lane, be_enemy, "enter"))
	if card.card_data.has("on_enter"):
		KeywordEffects._run_on_enter(card.card_data["on_enter"], card, card.current_lane, is_enemy, self)
	if card.card_data.has("on_play"):
		_resolve_on_play_ability(card, card.current_lane, is_enemy)


func _apply_start_round_passives(owner_is_enemy: bool) -> void:
	var mine: Array = _all_friendly(owner_is_enemy)
	for _rf in mine:
		if _rf.card_data.get("passive", "") == "riteforge_ramp":
			var rf_gain: int = 2 if bool(_rf.card_data.get("is_upgraded", false)) else 1
			for ally in mine:
				ally.temp_atk_buff += rf_gain   # this round only (resets end of turn)
				ally.update_stat_display()
	# Warden-Sergeant (warden_line): the full front line grows teeth. If the owner's
	# front row is full (3-wide forged), every friendly Soldier gains Armored +
	# Thorns for this round — a temp-keyword grant (_post_combat_cleanup strips the
	# keyword + meta at round end). At the per-side start-round chokepoint, so the
	# net client's copy fires host-side and rides the board snapshot.
	for _ws in mine:
		if not is_instance_valid(_ws) or _ws.card_data.get("passive", "") != "warden_line":
			continue
		var ws_need: int = 3 if bool(_ws.card_data.get("is_upgraded", false)) else 4
		var ws_count: int = 0
		for ws_c in _row_array(owner_is_enemy, ROW_FRONT):
			if ws_c != null and is_instance_valid(ws_c):
				ws_count += 1
		if ws_count < ws_need:
			continue
		var ws_fx: Array = []
		for ws_s in mine:
			if not is_instance_valid(ws_s) or String(ws_s.card_data.get("ctype", "")) != "soldier":
				continue
			if "armored" not in ws_s.card_data.keywords:
				ws_s.card_data.keywords.append("armored")
				ws_s.state.temp_armored = true
			if "thorns" not in ws_s.card_data.keywords:
				ws_s.card_data.keywords.append("thorns")
				ws_s.state.temp_thorns = true
			ws_s.update_stat_display()
			ws_fx.append(_card_center(ws_s))
		# The wall grows teeth VISIBLY: a steel glint runs down the line, man by
		# man, left to right — the keystone's payoff wave (soldier signature).
		ws_fx.sort_custom(func(a: Vector2, b: Vector2): return a.x < b.x)
		_trigger_fx_grace_wave(ws_fx, CTYPE_COLORS["soldier"])
		spawn_trigger_callout(_ws.global_position \
			+ Vector2(_ws.size.x * _ws.scale.x * 0.5, -12), "HOLD", false, int(_ws.entity_id))
		break
	# The Pike Captain (volley) — the SOLDIER signature MOMENT. Once per fight, the
	# first time this side's front line stands complete at a round's opening, the
	# whole tribe levels pikes: +1 ATK and Piercing for that clash.
	#
	# WHY THE LATCH IS ON COMBAT and not on the Captain: the tribe's declared fear
	# is the wipe (docs/DRAW_AND_TRIBE_DIRECTION_20260724.md), so a payoff that a
	# wipe could un-fire would be an identity the player cannot commit to. Once the
	# Volley has gone off it stays gone off, Captain alive or dead.
	#
	# WHY IT READS THE BOARD AT ROUND OPEN rather than the instant the last lane
	# fills: this is the per-side chokepoint the net client's copy runs host-side,
	# the warden_line precedent immediately above. A play-time hook would need a
	# second home for skirmish and could fire mid-drag.
	#
	# DISTINCT FROM warden_line ON PURPOSE. Warden-Sergeant is a repeatable
	# defensive grant every round the line holds (Armored + Thorns); the Volley is
	# one offensive discharge for the whole fight. Same trigger shape, opposite verb.
	var vol_side: int = int(owner_is_enemy)
	if not _volley_fired[vol_side]:
		for _vc in mine:
			if not is_instance_valid(_vc) or _vc.card_data.get("passive", "") != "volley":
				continue
			var vc_need: int = 3 if bool(_vc.card_data.get("is_upgraded", false)) else 4
			var vc_count: int = 0
			for vc_c in _row_array(owner_is_enemy, ROW_FRONT):
				if vc_c != null and is_instance_valid(vc_c):
					vc_count += 1
			if vc_count < vc_need:
				continue
			_volley_fired[vol_side] = true
			var vol_fx: Array = []
			for vc_s in mine:
				if not is_instance_valid(vc_s) \
						or String(vc_s.card_data.get("ctype", "")) != "soldier":
					continue
				vc_s.temp_atk_buff += 1
				# temp_piercing guards the erase order: a Soldier that PRINTS
				# Piercing must keep it when the round ends (the Venom Tip bug).
				if "piercing" not in vc_s.card_data.keywords:
					vc_s.card_data.keywords.append("piercing")
					vc_s.state.temp_piercing = true
				vc_s.update_stat_display()
				spawn_keyword_callout_kw(vc_s, "piercing")
				vol_fx.append(_card_center(vc_s))
			# The line fires as one: the wave runs left to right down the rank, the
			# same reading direction warden_line's glint uses.
			vol_fx.sort_custom(func(a: Vector2, b: Vector2): return a.x < b.x)
			_trigger_fx_grace_wave(vol_fx, CTYPE_COLORS["soldier"])
			spawn_trigger_callout(_vc.global_position \
				+ Vector2(_vc.size.x * _vc.scale.x * 0.5, -12), "VOLLEY",
				false, int(_vc.entity_id))
			break
	# War Fortress (bastion_ramp): the walls learn to hit back. Every round it stands,
	# all your Bastions gain +1 ATK (+2 forged) for the fight — a pile of 0-atk walls
	# becomes a slow siege. persistent_atk_buff accumulates round over round; at the
	# per-side start-round chokepoint so the net client's copy fires host-side.
	for _sw in mine:
		if not is_instance_valid(_sw) or _sw.card_data.get("passive", "") != "bastion_ramp":
			continue
		var sw_g: int = 2 if bool(_sw.card_data.get("is_upgraded", false)) else 1
		var sw_fx: Array = []
		for bs_ally in mine:
			if not is_instance_valid(bs_ally) or String(bs_ally.card_data.get("ctype", "")) != "bastion":
				continue
			bs_ally.persistent_atk_buff += sw_g   # rest of fight; accumulates each round
			bs_ally.persistent_atk_buff_rounds = 99
			bs_ally.update_stat_display()
			sw_fx.append(_card_center(bs_ally))
		# The walls learn it VISIBLY: a bronze pulse runs along the works, stone
		# by stone — the keystone's payoff wave (bastion signature).
		sw_fx.sort_custom(func(a: Vector2, b: Vector2): return a.x < b.x)
		_trigger_fx_grace_wave(sw_fx, CTYPE_COLORS["bastion"])
		spawn_trigger_callout(_sw.global_position \
			+ Vector2(_sw.size.x * _sw.scale.x * 0.5, -12), "SIEGE", false, int(_sw.entity_id))
		break
	# Summoner (summon_each_round): musters a 2/2 (3/3 upgraded) in an adjacent
	# empty seat each round — canonical adjacency: own row ±1 first, then the
	# column-mate seat.
	for _sm in mine:
		if _sm.card_data.get("passive", "") != "summon_each_round":
			continue
		if not is_instance_valid(_sm):
			continue
		var sm_n: int = 3 if bool(_sm.card_data.get("is_upgraded", false)) else 2
		var sm_seats: Array = _adjacent_empty_seats(owner_is_enemy, _sm.current_row, _sm.current_lane)
		if sm_seats.size() > 0:
			var sm_seat: Dictionary = sm_seats[0]
			summon_token(sm_n, sm_n, sm_seat.lane, owner_is_enemy, sm_seat.row)
			spawn_trigger_callout(_sm.global_position \
				+ Vector2(_sm.size.x * _sm.scale.x * 0.5, -12),
				"SUMMON", false, int(_sm.entity_id))
	# Trebuchet (trebuchet_volley): pays 3 face (4 forged) each round it HOLDS
	# the back row — the wall deck's clock. Standing in the front silences it.
	for _tb in mine:
		if not is_instance_valid(_tb) or _tb.card_data.get("passive", "") != "trebuchet_volley":
			continue
		if _tb.current_row != ROW_BACK:
			continue
		var tb_dmg: int = 4 if bool(_tb.card_data.get("is_upgraded", false)) else 3
		if owner_is_enemy:
			damage_player_hero(tb_dmg)
		else:
			damage_enemy_hero(tb_dmg)
		spawn_trigger_callout(_tb.global_position + Vector2(_tb.size.x * _tb.scale.x * 0.5, -12), "VOLLEY %d" % tb_dmg, false, int(_tb.entity_id))
	# (Heartwood Elder's endure_grow ramp lived here — reworked 2026-07-15 into
	# an arrive-scaled body: on_enter buff_per_ctype, resolved in KeywordEffects.)
	# Bulwark Engine (board relic, host-authoritative in net): Armored friendlies on
	# this side gain +1 max HP (and heal the point) each round, so a wall thickens.
	# Lives here — the per-side start-round chokepoint — so the client's own copy
	# fires host-side and rides the board snapshot; see _relic_active_for_side.
	if _relic_active_for_side(owner_is_enemy, "bulwark_engine"):
		var be: int = int(RelicDB.get_relic("bulwark_engine").get("value", 1))
		var be_hit := false
		for c in mine:
			if is_instance_valid(c) and c.has_keyword("armored"):
				c.card_data["hp"] = int(c.card_data.get("hp", 0)) + be
				c.current_hp += be
				c.update_stat_display()
				be_hit = true
		if be_hit:
			_relic_fired_for_side(owner_is_enemy, "bulwark_engine")


# ── Enter-with-a-bonus passives, per owner side (Wave: passive parity) ──
# Per-side counter accessors: solo reads the player-side globals; net reads the
# _net_*[side] counters so a Player-2 creature reads PLAYER 2's spell / card / Tallow
# counts, not the host's.
func _pt_cards_played(owner_is_enemy: bool) -> int:
	return int(_net_cards_played[1 if owner_is_enemy else 0]) if _is_net() else _cards_played_this_turn
func _pt_spells_fight(owner_is_enemy: bool) -> int:
	return int(_net_spells_fight[1 if owner_is_enemy else 0]) if _is_net() else _spells_cast_this_fight
func _pt_tallow_count(owner_is_enemy: bool) -> int:
	return int(_net_tallow_played[1 if owner_is_enemy else 0]) if _is_net() else _tallow_dolls_played
## Enter-with-a-bonus passives for a freshly-played creature owned by owner_is_enemy's
## side: Old Campaigner (+1/+1 per kills on its run ledger), Hexblade (+ATK per spell
## this fight), Warchief (ATK = 2 + other allies), Tallow Doll (+1/+1 per prior Tallow).
## Solo calls it with owner=false (reads the player globals); _net_spawn_creature calls
## it per side so Player 2's creatures scale off Player 2's own state.
func _apply_play_time_passives(card: Control, owner_is_enemy: bool) -> void:
	if not is_instance_valid(card):
		return
	# Old Campaigner (atk_hp_per_own_kills): enters wearing its service record —
	# +1/+1 per 3 kills THIS card has made across the run (per 2 upgraded). Solo
	# campaign memory only: skirmish decks have no kill ledger (the card is
	# denylisted there), and tokens/copies (uid -1) enter plain.
	if String(card.card_data.get("on_enter", {}).get("type", "")) == "atk_hp_per_own_kills":
		if not _is_net() and int(card.deck_uid) >= 0:
			var oc_per: int = 2 if bool(card.card_data.get("is_upgraded", false)) else 3
			var oc_vet: int = int(RunState.get_kills(int(card.deck_uid)) / oc_per)
			if oc_vet > 0:
				card.current_atk += oc_vet
				card.card_data.hp = int(card.card_data.get("hp", card.current_hp)) + oc_vet
				card.current_hp += oc_vet
				card.update_stat_display()
				spawn_floating_number(card.global_position \
					+ Vector2(card.size.x * card.scale.x * 0.5, -10),
					"+%d/+%d" % [oc_vet, oc_vet], Color(1.0, 0.84, 0.35), false)
	# Condottiere (atk_hp_per_unspent_mana): paid in coin — enters with +1/+1 this
	# fight per unspent Command. Solo/host reads the local pool (this runs after
	# the card's own cost is paid); a client play carries its pool on the intent.
	if String(card.card_data.get("on_enter", {}).get("type", "")) == "atk_hp_per_unspent_mana":
		var cd_unspent: int = player_mana
		if _is_net() and owner_is_enemy:
			cd_unspent = _net_client_unspent_mana
		if cd_unspent > 0:
			card.current_atk += cd_unspent
			card.card_data.hp = int(card.card_data.get("hp", card.current_hp)) + cd_unspent
			card.current_hp += cd_unspent
			card.update_stat_display()
			spawn_floating_number(card.global_position \
				+ Vector2(card.size.x * card.scale.x * 0.5, -10),
				"+%d/+%d" % [cd_unspent, cd_unspent], Color(1.0, 0.84, 0.35), false)
			_net_fx_text(card, "+%d/+%d" % [cd_unspent, cd_unspent], Color(1.0, 0.84, 0.35))
	# Oathkeeper (atk_hp_per_fallen): sworn on the FRESH graves — enters with
	# +1/+1 this fight per friendly fallen THIS ROUND (the tally resets when the
	# player phase begins, so it counts bodies the player spent this turn:
	# sacrifices, own-side AoE). Each side reads its own ledger, so a
	# copied/stolen Oathkeeper counts its controller's losses.
	if String(card.card_data.get("on_enter", {}).get("type", "")) == "atk_hp_per_fallen":
		var ok_fallen: int = _enemy_deaths_this_round if owner_is_enemy \
			else _friendly_deaths_this_round
		if ok_fallen > 0:
			card.current_atk += ok_fallen
			card.card_data.hp = int(card.card_data.get("hp", card.current_hp)) + ok_fallen
			card.current_hp += ok_fallen
			card.update_stat_display()
			spawn_floating_number(card.global_position \
				+ Vector2(card.size.x * card.scale.x * 0.5, -10),
				"+%d/+%d" % [ok_fallen, ok_fallen], Color(1.0, 0.84, 0.35), false)
			_net_fx_text(card, "+%d/+%d" % [ok_fallen, ok_fallen], Color(1.0, 0.84, 0.35))
	# Hexblade (atk_per_spell) scales THIS ROUND only now (temp_atk_buff, applied
	# per cast in the spell hook) — no fight-long catch-up on a late entrance.
	# Paladin (paladin_rally): wire its Last Stand moment to the rally handler,
	# owner-side bound (Card2D emits last_stand_fired when Last Stand saves it).
	if card.card_data.get("passive", "") == "paladin_rally" and card.has_signal("last_stand_fired"):
		card.last_stand_fired.connect(_on_paladin_last_stand.bind(card, owner_is_enemy))
	# Riteforge (riteforge_ramp): the desc promises an ON-ENTER pulse too — all
	# friendlies (itself included) get the +1 the moment it lands, so a Riteforge
	# played the turn the fight ends never did literally nothing.
	if card.card_data.get("passive", "") == "riteforge_ramp":
		var rf_enter: int = 2 if bool(card.card_data.get("is_upgraded", false)) else 1
		for ally in _all_friendly(owner_is_enemy):
			if is_instance_valid(ally):
				ally.temp_atk_buff += rf_enter   # this round only (resets end of turn)
				ally.update_stat_display()
		spawn_trigger_callout(card.global_position \
			+ Vector2(card.size.x * card.scale.x * 0.5, -12),
			"FORGE +%d ATK" % rf_enter, false, int(card.entity_id))
	if card.card_data.get("passive", "") == "tallow_stacking":
		var prior: int = _pt_tallow_count(owner_is_enemy)
		if prior > 0:
			card.current_atk += prior
			card.card_data.hp += prior
			card.current_hp += prior
			card.update_stat_display()
		if _is_net():
			_net_tallow_played[1 if owner_is_enemy else 0] += 1
		else:
			_tallow_dolls_played += 1
	# (Standard Bearer's old first-1-cost summon lived here; its 2026-07-05
	# rework is token_lord — summoned tokens enter bigger, hooked in
	# summon_token itself so every token path pays out.)
	# Type-buff auras (Warchief's Soldiers) are state-derived in _get_type_buff_atk
	# and therefore SILENT on arrival — announce the aura once, at muster: each
	# tribe-mate it feeds glints in the tribe's colour. Presentation only; the
	# actual +ATK rides the ordinary adjacency refresh and stat pops.
	var tb = card.card_data.get("type_buff", null)
	if tb is Dictionary and _hud_layer != null \
			and DisplayServer.get_name() != "headless":
		var tb_ct := String(tb.get("ctype", ""))
		var tb_pts: Array = []
		for tb_ally in _all_friendly(owner_is_enemy):
			if tb_ally == card or not is_instance_valid(tb_ally) \
					or tb_ally.current_hp <= 0:
				continue
			if String(tb_ally.card_data.get("ctype", "")) != tb_ct:
				continue
			tb_pts.append(_card_center(tb_ally))
		tb_pts.sort_custom(func(a: Vector2, b: Vector2): return a.x < b.x)
		_trigger_fx_grace_wave(tb_pts,
			CTYPE_COLORS.get(tb_ct, Color(1.0, 0.82, 0.34)))


## Paladin (paladin_rally): its Last Stand moment rallies the whole warband —
## every friendly gains +2 ATK this fight (+3 upgraded) and the owner's hero
## heals 3. Fired by Card2D.last_stand_fired at the survival beat itself.
func _on_paladin_last_stand(card: Control, owner_is_enemy: bool) -> void:
	if not is_instance_valid(card) or card.card_data.get("passive", "") != "paladin_rally":
		return
	var rally: int = 3 if bool(card.card_data.get("is_upgraded", false)) else 2
	for c in _all_friendly(owner_is_enemy):
		if is_instance_valid(c):
			c.current_atk += rally
			c.update_stat_display()
	_heal_owner_hero(owner_is_enemy, 3)
	# Trigger-callout (not a bare float) so the moment reads as an ability firing
	# AND replays on the net client via the fx queue.
	spawn_trigger_callout(card.global_position \
		+ Vector2(card.size.x * card.scale.x * 0.5, -12),
		"RALLY +%d ATK" % rally, false, int(card.entity_id))
	_update_hud()


## Side-aware variant for net per-side passive checks (false = player/host side, the
## same set _has_passive_on_field walks; true = the client's side).
func _has_passive_on_side(passive_name: String, is_enemy: bool) -> bool:
	for c in _all_friendly(is_enemy):
		if c.card_data.get("passive", "") == passive_name:
			return true
	return false


func _get_wall_reduction(lane_idx: int, defender_is_enemy: bool) -> int:
	# 4x4: walls in either row contribute. "Cannot attack wall" reduces only this
	# column and its neighbors. Walls belong to the DEFENDING side — solo only ever
	# defends the player; net also defends the client. (reduce_face_damage retired
	# 2026-07-15 with Iron Bastion's rework into Honor Guard's column_ward.)
	var reduction := 0
	for c in _all_friendly(defender_is_enemy):
		if c.card_data.get("passive", "") == "cannot_attack_wall":
			if abs(c.current_lane - lane_idx) <= 1:
				reduction += 1
	return reduction


func _cleanup_dead() -> void:
	# Most deaths flow through Card2D.take_damage → try_die → _die → destroyed
	# signal, which Combat handles in _on_card_destroyed (including on_death
	# dispatch, encounter hooks, reactive triggers, Phantom Veil, Reborn, etc.).
	# This function is a fallback for paths that mutate current_hp directly
	# without calling try_die — e.g. the poison post-hit overrides at
	# Combat.gd:_resolve_swift_attack / _creature_attacks_creature.
	for row in [ROW_FRONT, ROW_BACK]:
		for is_enemy in [false, true]:
			var arr = _row_array(is_enemy, row)
			for lane_idx in range(LANES_PER_ROW):
				var c = arr[lane_idx]
				if c != null and is_instance_valid(c) and c.current_hp <= 0:
					c.try_die()
	# A death removes a buff source / changes neighbours — re-tally adjacency so the
	# survivors' ATK drops in step (and pops a "-N ATK" so it reads on-screen).
	_refresh_adjacency_buffs()


func _cleanup_dead_paced() -> void:
	## The CLASH's death flush, one corpse at a time.
	##
	## Deaths are DEFERRED across the whole Swift phase and the whole clash
	## (Card2D.defer_deaths) so simultaneity stays fair — a lethal first strike
	## must not deny retaliation. The cost was legibility: every corpse's full
	## destruction chain (on_death dispatch, encounter hook, reactive passives,
	## ally-death passives, relic hooks, adjacency re-tally) then landed on ONE
	## frame. The player watched thirteen strikes paced at ~0.19 s each and then
	## the entire consequence of the clash in about 16 ms.
	##
	## `_cleanup_dead` itself must STAY synchronous — it has ~48 call sites across
	## Combat and CombatNet, many in non-async paths. This paced twin is used only
	## by the three flushes inside `_do_combat`, which are the ones anybody
	## actually watches.
	##
	## THE LEAD-IN (2026-07-28). There used to be no beat before the FIRST corpse,
	## on the reasoning that a one-death clash should cost nothing. But a frame
	## capture showed what that actually bought: corpse #1's whole destruction chain
	## shared a frame with the LAST STRIKE's tail — the killing blow's damage number,
	## the retaliation, the overkill spill and the first body's ash burst all landed
	## inside ~16 ms. The strike and the death it caused are two things to register,
	## and two things need separating. One beat before the first corpse is the
	## cheapest possible fix and it is the difference between "it died" and "it died
	## BECAUSE of that".
	if _is_net() or DisplayServer.get_name() == "headless":
		# Net keeps the synchronous flush (its clocks are not ours to stretch), but
		# it can still have the NAMES — that is a label, not a beat, and skirmish
		# has exactly the same "five bodies vanished and nothing said who" problem.
		if _is_net():
			for row in [ROW_FRONT, ROW_BACK]:
				for is_enemy in [false, true]:
					for lane_idx in range(LANES_PER_ROW):
						var dead = _row_array(is_enemy, row)[lane_idx]
						if dead != null and is_instance_valid(dead) and dead.current_hp <= 0:
							_name_the_fallen(dead, is_enemy)
		_cleanup_dead()
		return
	# A MASS GRAVE IS ONE EVENT, NOT SIXTEEN (2026-07-29). Measured on a full board:
	# 16 corpses at ~210 ms each spent 3.4 SECONDS enumerating bodies — and
	# enumeration is exactly what the player cannot do. Subitizing tops out at 3-4
	# items; past that, counting collapses regardless of how slowly you present
	# them, so an individually-paced sixteenth corpse buys no comprehension at all
	# and costs a third of the clash. The information is carried by the NAMES that
	# float off each body and by the post-clash ledger, neither of which needs the
	# corpses spread out to work.
	#
	# So the flush gets a fixed TOTAL budget and divides it: a 2-corpse trade keeps
	# its full, readable 210 ms beats, while a wipe compresses toward a single
	# swept-away event. Bounded either way.
	var corpse_n: int = _downed_count()
	var death_beat: float = DEATH_BEAT
	if corpse_n > 2:
		death_beat = clampf(FLUSH_BUDGET / float(corpse_n),
			DEATH_BEAT_MIN, DEATH_BEAT)
	if corpse_n > 0:
		await _short_pause(death_beat)
	var seen_one := false
	for row in [ROW_FRONT, ROW_BACK]:
		for is_enemy in [false, true]:
			var arr = _row_array(is_enemy, row)
			for lane_idx in range(LANES_PER_ROW):
				var c = arr[lane_idx]
				if c != null and is_instance_valid(c) and c.current_hp <= 0:
					if seen_one:
						await _short_pause(death_beat)
					seen_one = true
					# Name the dead only while the eye can still take them one at a
					# time. Compressing the flush (above) stacks the names, and a
					# measured wipe put FOURTEEN concurrent name chips on screen —
					# past the subitizing limit these stop being casualties you can
					# register and become a wall of text over the board. Beyond the
					# threshold the beat is "the line broke", not "these individuals
					# fell": the ledger states the count and the chronicle keeps
					# every name for anyone who wants them.
					if death_beat >= DEATH_BEAT * NAME_SPREAD_FRACTION:
						_name_the_fallen(c, is_enemy)
					c.try_die()
	# Anything that died AS A RESULT of the pass above (an on_death that killed a
	# neighbour, a reactive that finished someone off) is swept synchronously.
	# Cheap, idempotent, and it preserves the original invariant that no 0-HP body
	# survives this call.
	_cleanup_dead()


## One line summing up the clash that just ended.
##
## Working memory carries roughly four items, so a player cannot reconstruct a
## sixteen-body clash from what they watched — everything past ~4 facts has to be
## READ somewhere rather than remembered. This is that somewhere for the one fact
## that decides whether the round went well: who lost more of their line. It is the
## summary the players of this genre ask for by name.
##
## Deliberately ONE sentence and no panel. A modal ledger every round would be a
## worse tax than the problem; the detail already lives in the battle log for
## anyone who wants it, and the corpses now name themselves as they fall.
## Silent on a bloodless clash — a ledger reporting nothing is noise.
func _post_clash_ledger() -> void:
	var ours: int = _friendly_deaths_this_round
	var theirs: int = _enemy_deaths_this_round
	if ours <= 0 and theirs <= 0:
		return
	if theirs > 0 and ours <= 0:
		_show_info("The line holds - %d of theirs down." % theirs)
	elif ours > 0 and theirs <= 0:
		_show_info("%d of ours down, none of theirs." % ours)
	else:
		_show_info("%d of ours down, %d of theirs." % [ours, theirs])


## Say the dead body's NAME over its slot as it falls.
##
## A frame capture of "THE FALLEN" caught five bodies vanishing in one beat with
## NOTHING on screen naming any of them — "Pikeman falls" existed only in the
## battle-log drawer, which is CLOSED BY DEFAULT. That is the exact shape of the
## commonest complaint in this genre ("I don't know what killed me"): the
## information existed, it was simply somewhere nobody was looking.
##
## Deliberately the NAME and not a cause. Attribution ("killed by X") would need a
## damage-source ledger the clash does not keep, and — per the ~4-facts retention
## limit — a longer string here would buy nothing. Naming the body is what turns an
## anonymous ash puff into a casualty the player can remember and count.
##
## Side-tinted so a glance reads WHOSE line broke, which is the one fact that
## matters at a mass grave: gilt = yours, ember = theirs. Matches the battle log's
## existing rim convention so the two teach the same colour language.
func _name_the_fallen(card: Control, is_enemy: bool) -> void:
	if card == null or not is_instance_valid(card):
		return
	if DisplayServer.get_name() == "headless":
		return
	var nm := String(card.card_data.get("name", "")).strip_edges()
	if nm == "":
		return
	var col: Color = Color(0.86, 0.34, 0.22) if is_enemy else Color(0.94, 0.78, 0.38)
	spawn_keyword_callout(_card_center(card), nm.to_upper(), col, null)


func _on_friendly_death(card: Control, _lane_idx: int) -> void:
	_friendly_deaths_this_fight += 1
	_friendly_deaths_this_round += 1
	if String(card.card_id) == "pay_wagon":
		var plundered: int = int(card.state.pay_wagon_gold)
		if plundered > 0:
			_show_info("The foe plunders %d gold from the Pay-Wagon." % plundered)
	# Campaign memory: a real deck creature falling is written into the Roll of
	# the Fallen — name as worn at death (epithet included), where, and when.
	# Solo campaign only; tokens have no identity to mourn.
	if not _is_net() and not card.is_token and int(card.deck_uid) >= 0:
		RunState.record_fall(int(card.deck_uid), card.card_id,
			String(card.card_data.get("name", card.card_id)),
			_encounter_name if _encounter_name != "" else "the road",
			round_number)
		# A named veteran's fall is a campaign moment, not a stat tick: call the
		# worn name (the epithet is already folded into card_data at draw) over
		# the spot where they fell, in the death-styled honor banner. The forge's
		# " +" suffix is trimmed — "PIKEMAN THE GRIM + HAS FALLEN" reads as a typo.
		if RunState.get_kills(int(card.deck_uid)) >= RunState.veteran_epithet_kills():
			var worn := String(card.card_data.get("name", card.card_id)).trim_suffix(" +")
			var fall_pos := card.global_position \
				+ Vector2(card.size.x * card.scale.x * 0.5, card.size.y * card.scale.y * 0.30)
			spawn_trigger_callout(fall_pos, "%s HAS FALLEN" % worn.to_upper(), true)
	_last_dead_creature_id = card.card_id
	# Track the uid alongside the id so consumers (Grave Robbery, Grave Pact)
	# can push a proper "card_id#uid" pile entry. Tokens / synthetic cards
	# leave -1 here, which _resolve_card_data already handles.
	_last_dead_creature_uid = card.deck_uid
	# Gravedigger's swell_on_ally_death lives in _apply_ally_death_passives so it
	# fires side-aware + net-aware — see the block there. The player-side call
	# below covers solo + net-host.
	# Corpse Eater / Husk / Carrion Priest — grow/drain payoffs for the player side.
	# Extracted into _apply_ally_death_passives so the net death hook can run the same
	# for the CLIENT's side (a Player-2 Corpse Eater grows on Player-2 deaths, etc.).
	_apply_ally_death_passives(false, card)
	# ORDERING (2026-07-28): sample the fallen's column BEFORE any relic in this
	# chain can put something new in it. Soul Lantern raises a Shade into the
	# vacated seat and the Funeral Lantern's second reading can summon too, so
	# without this the Ledger Seal would hand the inheritance to a token that
	# arrived after the death it is supposed to be settling.
	var death_column_heir: Control = _get_creature_in_column(false, card.current_lane)
	if death_column_heir == card:
		death_column_heir = null
	# Soul Lantern — the Acolyte's signature. Death still pays the bill; as of
	# 2026-07-25 it pays in a BODY rather than Command. summon_token already
	# falls through to the other row of the same column when the seat is taken,
	# so this is safe whether or not the corpse's slot has been cleared yet.
	if _has_relic("soul_lantern") and not _soul_lantern_used_this_round:
		_soul_lantern_used_this_round = true
		var shade_v: int = int(RelicDB.get_relic("soul_lantern").get("value", 1))
		summon_token(shade_v, shade_v, card.current_lane, false, card.current_row,
			{}, "Shade")
		_relic_fired("soul_lantern")
	# Funeral Lantern — the Acolyte's ALTERNATE doctrine (reshaped 2026-07-28: it
	# shipped as a byte-for-byte clone of Soul Lantern's text, so the "choice"
	# between the two was no choice at all). Its own verb now, on the deck's real
	# identity: the first bequest read each round is read TWICE. So the signature
	# pair is "double the bequest" (this) vs "transfer the strength" (Ledger Seal).
	#
	# KeywordEffects.dispatch_on_death already ran the first reading in
	# _on_card_destroyed, so this is strictly the second. It calls _run_on_death
	# DIRECTLY — the same choice Read the Will makes — so the doubling ladder
	# (Warden of Graves / Lich's Bargain / Grave Bell) cannot compound off it,
	# and the two identity arms dispatch_on_death short-circuits stay unreachable
	# (READ_THE_WILL_DENY: return_to_hand_once would float the card to hand a
	# second time; undying_grow writes a PERMANENT run-wide +1/+1 through
	# RunState, i.e. a farmable growth engine).
	if _has_relic("funeral_lantern") and not _funeral_lantern_used_this_round \
			and card.card_data.has("on_death"):
		var fl_eff: Dictionary = card.card_data["on_death"]
		if not READ_THE_WILL_DENY.has(String(fl_eff.get("type", ""))):
			_funeral_lantern_used_this_round = true
			_log_event("The Funeral Lantern reads %s's will a second time." \
				% _log_card_ref(card), _log_data(card), _log_side(card))
			KeywordEffects._run_on_death(fl_eff, card.current_lane, false, self,
				card.current_row)
			_relic_fired("funeral_lantern")
	# Ledger Seal — the debt is transferred, not forgiven: whoever still stands in
	# the fallen's column inherits the strength, for the fight. Reads the heir
	# sampled at the top of this chain so a body raised by either Lantern cannot
	# become its own beneficiary. The latch only spends when it actually paid, so
	# a death in an emptied column does not burn the round's use.
	if _has_relic("ledger_seal") and not _ledger_seal_used_this_round:
		var ls_v: int = int(RelicDB.get_relic("ledger_seal").get("value", 1))
		if _buff_column_survivor(false, card.current_lane, card, ls_v, ls_v,
				death_column_heir) != null:
			_ledger_seal_used_this_round = true
			_relic_fired("ledger_seal")
	# A Verse of You: the first friendly death each round writes strength onto
	# the next body played. It survives the clash/refill boundary as real tempo.
	if _has_relic("verse_of_you") and not _verse_of_you_used_this_round:
		_verse_of_you_used_this_round = true
		_verse_of_you_buff_pending = int(RelicDB.get_relic("verse_of_you").get("value", 1))
	# The Eagle of the Fourth (set-piece trophy): the standard you took off the
	# Bearer does for you what it did for him — the FIRST friendly body that
	# falls each fight gets back up. Reuses the Phoenix Brew revive so there is
	# one implementation of "a 1/1 of what it was, wherever there is room";
	# _last_dead_creature_id is already set by the death path above.
	if _has_relic("eagle_of_the_fourth") and not _eagle_risen_this_fight:
		_eagle_risen_this_fight = true
		_relic_fired("eagle_of_the_fourth")
		_revive_last_dead_friendly()
	# Sigil of Hunger: arm a "next creature -1 mana" charge, once per round.
	if _has_relic("sigil_of_hunger") and not _sigil_of_hunger_fired_this_round:
		_sigil_of_hunger_fired_this_round = true
		_sigil_of_hunger_charge += int(RelicDB.get_relic("sigil_of_hunger").get("value", 1))
		_relic_fired("sigil_of_hunger")
	# (Gravewarden's Pact moved to _apply_ally_death_passives so it fires per-side —
	# host-authoritative for the client's copy too in skirmish.)
	# Soul Ledger: every Nth lifetime friendly death summons a 4/4 token in
	# any empty lane (front preferred, back fallback).
	if _has_relic("soul_ledger"):
		_soul_ledger_counter += 1
		var threshold: int = int(RelicDB.get_relic("soul_ledger").get("value", 5))
		if threshold > 0 and _soul_ledger_counter >= threshold:
			_soul_ledger_counter = 0
			var picked := _pick_empty_for_summon(false, ROW_FRONT)
			if not picked.is_empty():
				_relic_fired("soul_ledger")
				summon_token(4, 4, picked.lane, false, picked.row)


## The Black Contract: once armed, the first real friendly casualty each round
## musters a Debtor into any open back-row-preferred seat. Tokens are excluded so
## a Debtor can never replace itself forever; War-Debt joined the deck on cast.
func _trigger_black_contract(dead_card: Control) -> void:
	if not _black_contract_active or _black_contract_last_round == round_number:
		return
	if dead_card == null or not is_instance_valid(dead_card) or dead_card.is_token:
		return
	var slot := _pick_empty_for_summon(false, ROW_BACK)
	if slot.is_empty():
		return
	_black_contract_last_round = round_number
	summon_token(_black_contract_token_size, _black_contract_token_size,
		int(slot.lane), false, int(slot.row), {}, "Debtor")
	_log_event("The Black Contract collects a death — a [color=#d8b060]%d/%d Debtor[/color] reports." \
		% [_black_contract_token_size, _black_contract_token_size])


## Grow / drain payoffs that fire when a creature on owner_is_enemy's side dies:
## Corpse Eater (grow_on_ally_death), Husk (grow_on_any_death), Carrion Priest
## (drain_on_ally_death → reach + heal). Solo calls it for the player side only; the
## net death hook also calls it for the client's side. dead_card is the fallen
## creature and is skipped so it never profits from its own death.
func _second_wave_rise(owner_is_enemy: bool) -> void:
	# The Sexton's Second Wave: three fresh Wights (2/2, ctype dead — they re-feed
	# the grave's readers) claw up into empty BACK-row lanes. If the back row is
	# full the wave isn't wasted — the grave reinforces your Dead instead (floor:
	# +1/+1 to each Dead, or a random friendly if you field none). summon_token
	# rides the board snapshot, so a host wave shows on the net client.
	var placed: int = 0
	for lane in range(LANES_PER_ROW):
		if placed >= 3:
			break
		if _row_array(owner_is_enemy, ROW_BACK)[lane] == null:
			summon_token(2, 2, lane, owner_is_enemy, ROW_BACK, {}, "Wight")
			_grave_wave_fx(owner_is_enemy, lane)
			placed += 1
	if placed > 0:
		return
	# Back row full — the grave gives what it can.
	var reinforced: bool = false
	for c in _all_friendly(owner_is_enemy):
		if is_instance_valid(c) and String(c.card_data.get("ctype", "")) == "dead":
			_grave_reinforce(c)
			reinforced = true
	if not reinforced:
		var pool: Array = _all_friendly(owner_is_enemy)
		if pool.size() > 0:
			_grave_reinforce(_combat_ops.pick(pool))


func _grave_reinforce(c) -> void:
	if not is_instance_valid(c):
		return
	c.current_atk += 1
	c.card_data["hp"] = int(c.card_data.get("hp", 1)) + 1
	c.current_hp += 1
	c.update_stat_display()
	spawn_trigger_callout(_card_center(c) + Vector2(0, -14),
		"SECOND WAVE +1/+1", false, int(c.entity_id))


func _grave_wave_fx(owner_is_enemy: bool, lane: int) -> void:
	# The grave-light climax: a dead-tinted ring wells up under each rising Wight
	# (its own landing-pop plays too). Decorative — gated off headless / no HUD.
	if _hud_layer == null or DisplayServer.get_name() == "headless":
		return
	var slot = _slot_array(owner_is_enemy, ROW_BACK)[lane]
	if slot == null:
		return
	var dc: Color = CTYPE_COLORS["dead"]
	Motion.ring(_hud_layer, slot.get_global_rect().get_center(),
		Color(dc.r, dc.g, dc.b, 0.70),
		{"radius": 14.0, "end_scale": 1.9, "duration": 0.38,
		"z_index": 219, "width": 2.5, "scale_time": true})


func _apply_ally_death_passives(owner_is_enemy: bool, dead_card: Control = null) -> void:
	# The Understudy owns the exact back seat behind a fallen front-liner. It
	# steps forward before broader death payoffs so the vacated post is visibly
	# inherited, then keeps the dead creature's live ATK for the fight.
	if dead_card != null and is_instance_valid(dead_card) \
			and dead_card.current_row == ROW_FRONT:
		var understudy = _row_array(owner_is_enemy, ROW_BACK)[dead_card.current_lane]
		if understudy != null and is_instance_valid(understudy) \
				and understudy.card_data.get("passive", "") == "understudy":
			var inherited: int = maxi(0, dead_card.effective_atk())
			if _relocate_creature(understudy, owner_is_enemy, ROW_FRONT,
					dead_card.current_lane, false):
				understudy.current_atk += inherited
				understudy.update_stat_display()
				spawn_trigger_callout(_card_center(understudy) + Vector2(0, -14),
					"TAKES THE PART +%d" % inherited, false, int(understudy.entity_id))
	# The Sexton — while the grave stands open, every OTHER non-token friendly
	# death banks a soul; every third (forged: second) soul, a Second Wave of
	# three 2/2 Wights claws up into your empty back row. This runs ONCE per
	# death (outside the per-creature loop) off the Combat-scoped flag, so the
	# engine keeps working after the Sexton itself has fallen.
	var grave_side: int = int(owner_is_enemy)
	if _grave_armed[grave_side] > 0 and dead_card != null \
			and is_instance_valid(dead_card) and not dead_card.is_token:
		_grave_souls[grave_side] += 1
		var wave_need: int = 2 if _grave_armed[grave_side] >= 2 else 3
		if _grave_souls[grave_side] >= wave_need:
			_grave_souls[grave_side] = 0
			_second_wave_rise(owner_is_enemy)
	for c in _all_friendly(owner_is_enemy):
		if c == dead_card:
			continue   # the fallen don't profit from their own death
		match c.card_data.get("passive", ""):
			"mangonel_crew":
				if dead_card != null and is_instance_valid(dead_card) \
						and _adjacent_creatures(owner_is_enemy,
							dead_card.current_row, dead_card.current_lane).has(c):
					var corpse_dmg: int = maxi(0,
						int(dead_card.card_data.get("hp", 0)))
					if bool(c.card_data.get("is_upgraded", false)):
						corpse_dmg += 2
					if corpse_dmg > 0:
						var lane_target = _get_creature_in_column(not owner_is_enemy,
							dead_card.current_lane)
						spawn_trigger_callout(_card_center(c) + Vector2(0, -14),
							"CATAPULT %d" % corpse_dmg, false, int(c.entity_id))
						if lane_target != null:
							lane_target.take_damage(corpse_dmg)
						else:
							_hurt_opposing_hero(owner_is_enemy, corpse_dmg)
			"grow_on_ally_death":
				var ge_gain: int = 2 if bool(c.card_data.get("is_upgraded", false)) else 1
				c.current_atk += ge_gain
				c.update_stat_display()
				spawn_floating_number(c.global_position \
					+ Vector2(c.size.x * c.scale.x * 0.5, -10),
					"+%d ATK" % ge_gain, Color(1.0, 0.62, 0.20), false)
				_net_fx_text(c, "+%d ATK" % ge_gain, Color(1.0, 0.62, 0.20))
			"grow_on_any_death":
				c.current_atk += 1
				c.update_stat_display()
				spawn_floating_number(c.global_position \
					+ Vector2(c.size.x * c.scale.x * 0.5, -10),
					"+1 ATK", Color(1.0, 0.62, 0.20), false)
				_net_fx_text(c, "+1 ATK", Color(1.0, 0.62, 0.20))
			"drain_on_ally_death":
				_hurt_opposing_hero(owner_is_enemy, 2 if bool(c.card_data.get("is_upgraded", false)) else 1)
				_heal_owner_hero(owner_is_enemy, 1)
				spawn_trigger_callout(c.global_position \
					+ Vector2(c.size.x * c.scale.x * 0.5, -12),
					"DRAIN", true, int(c.entity_id))
			"vampire_feed":
				# Vampire Lord — another friendly DEAD dying is a meal: the lord
				# drinks its ATK (forged: its HP too). Reads the dying card's LIVE
				# ATK, so a buffed casualty feeds a bigger drink. Wights and other
				# dead-tagged tokens count — the Gravepact loop is intentional.
				if dead_card != null and is_instance_valid(dead_card) \
						and String(dead_card.card_data.get("ctype", "")) == "dead":
					var vf_atk: int = maxi(0, int(dead_card.current_atk))
					var vf_hp: int = 0
					if bool(c.card_data.get("is_upgraded", false)):
						vf_hp = maxi(0, int(dead_card.card_data.get("hp", 0)))
					if vf_atk > 0 or vf_hp > 0:
						c.current_atk += vf_atk
						if vf_hp > 0:
							c.card_data.hp = int(c.card_data.get("hp", 1)) + vf_hp
							c.current_hp += vf_hp
						c.update_stat_display()
						spawn_trigger_callout(c.global_position \
							+ Vector2(c.size.x * c.scale.x * 0.5, -12),
							"DRINKS +%d" % vf_atk, false, int(c.entity_id))
			"starter_debt_guard":
				# Debt Guard — the first debt called in each round is the one it
				# collects. The enclosing loop already skips dead_card, so
				# "another friendly" is free. TOKENS COUNT (2026-07-28 ruling):
				# the card text carries no token clause, unlike Gravepact below.
				# Per-BODY cap (a Dictionary, not a bool) because several Guards
				# can stand and each owes its own first death — contrast Mirror
				# Guard, whose text describes a SPELL event and so latches once
				# for the whole board.
				var dg_key: int = c.get_instance_id()
				if not _debt_guard_used_this_round.has(dg_key):
					_debt_guard_used_this_round[dg_key] = true
					c.temp_atk_buff += 1   # THIS ROUND — not persistent_atk_buff
					c.update_stat_display()
					spawn_trigger_callout(_card_center(c) + Vector2(0, -14),
						"THE DEBT", false, int(c.entity_id))
			"reap_on_ally_death":
				# Gravepact — each OTHER (non-token) friendly death raises a Wight
				# (1/1, 2/2 forged; ctype dead so it re-feeds) in this creature's
				# back-row lane, capped once per round. summon_token rides the board
				# snapshot, so a host reap shows on the net client.
				if dead_card != null and is_instance_valid(dead_card) and not dead_card.is_token:
					if int(c.state.gravepact_round) != round_number:
						c.state.gravepact_round = round_number
						var gp_n: int = 2 if bool(c.card_data.get("is_upgraded", false)) else 1
						var gp_lane: int = c.current_lane if (c.current_lane >= 0 and c.current_lane < LANES_PER_ROW) else 0
						# Watch which seat the summon actually lands in —
						# summon_token falls through to the other row when the
						# requested seat is held, and no-ops when both are.
						var gp_back_prev = _row_array(owner_is_enemy, ROW_BACK)[gp_lane]
						var gp_front_prev = _row_array(owner_is_enemy, ROW_FRONT)[gp_lane]
						summon_token(gp_n, gp_n, gp_lane, owner_is_enemy, ROW_BACK, {}, "Wight")
						var gp_row: int = -1
						if _row_array(owner_is_enemy, ROW_BACK)[gp_lane] != gp_back_prev:
							gp_row = ROW_BACK
						elif _row_array(owner_is_enemy, ROW_FRONT)[gp_lane] != gp_front_prev:
							gp_row = ROW_FRONT
						# The reap made VISIBLE (dead signature): a grave-light
						# wisp leaves the corpse and arrives where the Wight
						# stands (slot-anchored — the fresh token isn't laid out
						# yet this frame).
						if gp_row >= 0 and _hud_layer != null \
								and DisplayServer.get_name() != "headless":
							var gp_col: Color = CTYPE_COLORS["dead"]
							var gp_to: Vector2 = _slot_array(owner_is_enemy,
								gp_row)[gp_lane].get_global_rect().get_center()
							_spawn_vfx_streak(_card_center(dead_card), gp_to,
								Color(gp_col.r, gp_col.g, gp_col.b, 0.85),
								4.0, 226, 0.40, 30.0)
							Motion.ring(_hud_layer, gp_to,
								Color(gp_col.r, gp_col.g, gp_col.b, 0.65),
								{"radius": 16.0, "end_scale": 1.6, "duration": 0.30,
								"z_index": 219, "width": 2.5, "delay": 0.20,
								"scale_time": true})
						spawn_trigger_callout(c.global_position \
							+ Vector2(c.size.x * c.scale.x * 0.5, -12),
							"REAP", false, int(c.entity_id))
	# Gravedigger (swell_on_ally_death) — "When a friendly creature dies on your
	# turn: this gains +1/+1" (+2/+2 forged). Your-turn-only by design: it is
	# the SACRIFICE-deck common (Offering / Fuel the Pyre / blood_sacrifice
	# floops), not a clash-time freebie — the phase gate is the same one the
	# old washed-draw version used. Grows per death, per Gravedigger.
	if phase == Phase.PLAYER_TURN:
		for c in _all_friendly(owner_is_enemy):
			if c == dead_card or not is_instance_valid(c):
				continue
			if c.card_data.get("passive", "") == "swell_on_ally_death":
				var gd_n: int = 2 if bool(c.card_data.get("is_upgraded", false)) else 1
				c.current_atk += gd_n
				c.card_data.hp = int(c.card_data.get("hp", 1)) + gd_n
				c.current_hp += gd_n
				c.update_stat_display()
				spawn_floating_number(c.global_position \
					+ Vector2(c.size.x * c.scale.x * 0.5, -10),
					"+%d/+%d" % [gd_n, gd_n], Color(1.0, 0.62, 0.20), false)
				_net_fx_text(c, "+%d/+%d" % [gd_n, gd_n], Color(1.0, 0.62, 0.20))
	# Gravewarden's Pact (board relic, host-authoritative in net): the first N
	# non-token friendly deaths each fight are reborn as 1/1 Imps where they fell.
	# Per-side cap so each warband's Pact spends its own; the reborn Imp rides the
	# board snapshot to the client. Tokens excluded so rebirths don't chain.
	var gw_side: int = 1 if owner_is_enemy else 0
	if dead_card != null and is_instance_valid(dead_card) and not dead_card.is_token \
			and _relic_active_for_side(owner_is_enemy, "gravewardens_pact"):
		var gw_cap: int = int(RelicDB.get_relic("gravewardens_pact").get("value", 3))
		if _gravewardens_rebirths[gw_side] < gw_cap:
			_gravewardens_rebirths[gw_side] += 1
			var gw_row: int = dead_card.current_row if dead_card.current_row in [ROW_FRONT, ROW_BACK] else ROW_FRONT
			var gw_lane: int = dead_card.current_lane if (dead_card.current_lane >= 0 and dead_card.current_lane < LANES_PER_ROW) else 0
			summon_token(1, 1, gw_lane, owner_is_enemy, gw_row)
			_relic_fired_for_side(owner_is_enemy, "gravewardens_pact")


## Shieldmaiden (interpose): the first live interposer holding `side`'s FRONT
## row — she catches creature strikes aimed at her own hero's face.
func _find_interposer(side_is_enemy: bool) -> Control:
	for c in _row_array(side_is_enemy, ROW_FRONT):
		if c != null and is_instance_valid(c) and c.current_hp > 0 \
				and c.card_data.get("passive", "") == "interpose":
			return c
	return null


func _lane_is_salted(lane: int) -> bool:
	return lane >= 0 and lane < LANES_PER_ROW \
		and int(_salted_lanes.get(lane, -1)) >= round_number


func _refresh_lane_aftermath() -> void:
	# S5 (docs/SPELL_FX_PLAN_20260717.md): repaint the persistent-spell layer
	# from the LIVE state — salt reads off _salted_lanes, the noose off
	# _condemned_lanes, the covered pits off _pit_traps. One cheap _draw, so
	# every state-change site just calls this rather than tracking deltas.
	# Informational by the reduce-motion contract: always renders, holds steady.
	if _lane_aftermath == null or not is_instance_valid(_lane_aftermath):
		return
	var inv: Transform2D = _lane_aftermath.get_global_transform().affine_inverse()
	var salted_spec: Array = []
	for lane_key in _salted_lanes.keys():
		if int(_salted_lanes[lane_key]) < round_number:
			continue
		var sr: Rect2 = _lane_rect(true, int(lane_key), inv)
		if sr.size.x > 0.0:
			salted_spec.append({"rect": sr,
				"rounds_left": int(_salted_lanes[lane_key]) - round_number + 1})
	var condemned_spec: Array = []
	for lane_key in _condemned_lanes.keys():
		# The Writ condemns the whole COLUMN — both sides die when it falls.
		# The tag anchors at the ENEMY column's foot (the strip just above the
		# gold rule — the rule graphic is painted by a later sibling and
		# covers anything drawn at its own height, shot-verified).
		var ce: Rect2 = _lane_rect(true, int(lane_key), inv)
		var cp: Rect2 = _lane_rect(false, int(lane_key), inv)
		if ce.size.x > 0.0 and cp.size.x > 0.0:
			condemned_spec.append({"rect": ce.merge(cp),
				"tag_pos": Vector2(ce.position.x + ce.size.x * 0.5, ce.end.y + 22.0)})
	var pit_spec: Array = []
	if not _is_net() and not _pit_traps.is_empty():
		# Pits wait for ARRIVALS: mark them just past the enemy front line,
		# spread from the board's centre — the caster sees their own traps;
		# the foe's reinforcements find out.
		var seam := Vector2.ZERO
		var seam_n: int = 0
		var front_slots: Array = _slot_array(true, ROW_FRONT)
		for lane in range(mini(LANES_PER_ROW, front_slots.size())):
			var slot: Control = front_slots[lane]
			if slot != null and is_instance_valid(slot):
				var gr: Rect2 = slot.get_global_rect()
				seam += Vector2(gr.get_center().x, gr.end.y)
				seam_n += 1
		if seam_n > 0:
			# +12: tucked between the enemy line's card bottoms and the rule —
			# "dug in front of the arriving line". The marks layer draws over
			# the rule's glow, so the strip is safe (earlier bare-layer
			# placements at rule height vanished under it, shot-verified).
			var seam_local: Vector2 = inv * (seam / float(seam_n) + Vector2(0, 12.0))
			var pn: int = _pit_traps.size()
			for i in range(pn):
				pit_spec.append(seam_local + Vector2(
					(float(i) - (float(pn) - 1.0) * 0.5) * 58.0, 0.0))
	var scar_spec: Array = []
	for scar in _battlefield_scars:
		var scar_lane := int(scar.get("lane", -1))
		var scar_row := int(scar.get("row", ROW_FRONT))
		var scar_enemy := bool(scar.get("is_enemy", true))
		if scar_lane < 0 or scar_lane >= LANES_PER_ROW:
			continue
		var scar_slots: Array = _slot_array(scar_enemy, scar_row)
		if scar_lane >= scar_slots.size():
			continue
		var scar_slot: Control = scar_slots[scar_lane]
		if scar_slot == null or not is_instance_valid(scar_slot):
			continue
		var scar_rect: Rect2 = scar_slot.get_global_rect()
		var painted: Dictionary = scar.duplicate(true)
		painted["rect"] = Rect2(inv * scar_rect.position, scar_rect.size).grow(-3.0)
		scar_spec.append(painted)
	_lane_aftermath.set_state(salted_spec, condemned_spec, pit_spec, scar_spec)
	if _lane_aftermath_marks != null and is_instance_valid(_lane_aftermath_marks):
		_lane_aftermath_marks.set_state(salted_spec, condemned_spec, pit_spec, scar_spec)


func _lane_rect(is_enemy: bool, lane: int, inv: Transform2D) -> Rect2:
	# Union of a column's front+back slot rects in the aftermath layer's local
	# space, grown a touch so the ground reads wider than the station plates.
	if lane < 0 or lane >= LANES_PER_ROW:
		return Rect2()
	var out := Rect2()
	var any := false
	for row in [ROW_FRONT, ROW_BACK]:
		var slots: Array = _slot_array(is_enemy, row)
		if lane >= slots.size():
			continue
		var slot: Control = slots[lane]
		if slot == null or not is_instance_valid(slot):
			continue
		var gr: Rect2 = slot.get_global_rect()
		var lr := Rect2(inv * gr.position, gr.size)
		out = lr if not any else out.merge(lr)
		any = true
	return out.grow(4.0) if any else Rect2()



func _record_battlefield_scar(card: Control, lane: int, row: int,
		was_enemy: bool) -> void:
	if card == null or not is_instance_valid(card) or lane < 0 or row < 0:
		return
	var same_slot := 0
	for old in _battlefield_scars:
		if int(old.get("lane", -1)) == lane and int(old.get("row", -1)) == row \
				and bool(old.get("is_enemy", false)) == was_enemy:
			same_slot += 1
	if same_slot >= 2:
		return
	var kind := "gate" if _is_fortification(card) \
		else ("enemy" if was_enemy else "player")
	_battlefield_scars.append({
		"lane": lane, "row": row, "is_enemy": was_enemy, "kind": kind,
		"seed": hash("%s:%d:%d:%d:%d" % [
			String(card.card_id), round_number, lane, row, _battlefield_scars.size()]),
	})
	while _battlefield_scars.size() > MAX_BATTLEFIELD_SCARS:
		_battlefield_scars.pop_front()
	_refresh_lane_aftermath()

func _resolve_condemned_lanes() -> void:
	var due: Array[int] = []
	for lane_key in _condemned_lanes.keys():
		if int(_condemned_lanes[lane_key]) <= round_number:
			due.append(int(lane_key))
	for lane in due:
		_condemned_lanes.erase(lane)
		var condemned: Array = []
		for owner_is_enemy in [false, true]:
			for row in [ROW_FRONT, ROW_BACK]:
				var c = _row_array(owner_is_enemy, row)[lane]
				if c != null and is_instance_valid(c):
					condemned.append(c)
		if condemned.is_empty():
			continue
		_show_info("Death Sentence resolves in lane %d." % (lane + 1))
		for c in condemned:
			if is_instance_valid(c):
				spawn_trigger_callout(_card_center(c) + Vector2(0, -14),
					"CONDEMNED", true, int(c.entity_id))
				_force_destroy_creature(c)
	_cleanup_dead()
	if not due.is_empty():
		_refresh_lane_aftermath()


func _post_combat_sequence() -> void:
	_post_combat_cleanup()
	_discard_hand()

	# Name the reinforcement beat so a fresh enemy creature appearing reads as
	# "they brought up reserves," not a silent board change. The opening muster
	# never reaches here — _run_opening_muster consumes it at the top of round 1,
	# so by this point every placement really is reserves.
	if not _enemy_deck.is_empty() or not _reinforcement.is_empty():
		_set_phase_caption("ENEMY REINFORCES")
	await _short_pause(COMBAT_PAUSE_MEDIUM)
	# Census the enemy line before reserves arrive. Everything this placement
	# adds owes the muster delay — see the diff below and _start_round.
	var _pre_reinforce := {}
	for _c in _all_enemy_creatures():
		if is_instance_valid(_c):
			_pre_reinforce[_c.get_instance_id()] = true
	await _enemy_place_creatures()

	# Escalation: once a generic hold has worn on past ESCALATION_REINFORCE_ROUND
	# it commits reserves — a second placement this round, telegraphed so it reads
	# as a turning point and not a silent board change. Faction holds are skipped
	# (their authored wave schedule already supplies the escalation); this is the
	# generic-fight answer to the old, never-reached round-8 tier.
	if _encounter_id != "":
		var enc = EncounterDB.get_encounter(_encounter_id)
		if enc.get("type", "") == "combat" and not _wave_schedule_active \
				and round_number >= _esc_round(ESCALATION_REINFORCE_ROUND):
			if not _escalation_banner_shown:
				_escalation_banner_shown = true
				_show_combat_banner("THE TIDE TURNS",
					"The hold commits its reserves", Color(0.85, 0.3, 0.15))
			await _enemy_place_creatures()

	# THE MUSTER DELAY, HONESTLY APPLIED TO RESERVES.
	#
	# This placement happens AFTER the clash that ends this round, and the very
	# next thing _post_combat_sequence does is call _start_round(), whose sweep
	# readies every body on the board. So a reinforcement used to reach its
	# first possible clash — the one ending the NEXT round — already ready,
	# sitting out zero clashes, while a card the player answers it with sits out
	# one. That was a full round of free tempo for the enemy in every fight past
	# round 1, and it was invisible because _probe_muster_delay counts ROUND
	# STARTS rather than clashes skipped.
	#
	# Diffing against the census above is exact and needs nothing from
	# _enemy_place_creatures' internals. It must be a diff and not "every
	# unready enemy": bodies summoned mid-round by a passive are also unready
	# here, but they DID sit out the clash that just ended and are owed their
	# readiness now — deferring them too would delay them twice.
	for _c in _all_enemy_creatures():
		if is_instance_valid(_c) and not _pre_reinforce.has(_c.get_instance_id()):
			_muster_deferred.append(_c)

	# The Writ names "the end of next round": reinforcements get the chance to
	# enter that round, then every body now standing in the condemned column dies.
	_resolve_condemned_lanes()

	# End-of-turn deaths (Assassin etc.) — both rows.
	# take_damage(999) routes through Card2D.try_die → Combat._on_card_destroyed
	# which already nulls the row slot and dispatches on_death / encounter
	# hooks. The previous manual `_row_array(...)[pos.lane] = null` here was
	# a no-op in the happy path but could double-fire ON_CREATURE_DEATH
	# reactive passives in edge cases (Last Stand preventing the actual death,
	# Phantom Veil restoring the card). Trust take_damage to do the work.
	for c in _all_player_creatures():
		if c.card_data.get("passive", "") == "dies_end_of_turn":
			c.take_damage(999)

	_dispatch_passive_end_of_round()

	# Round-end relic bundle: flanking_banner, imp_generator, mana_drunkard
	# streak check, steady_banner survival ATK grant.
	_apply_round_end_relics()

	# SET-PIECE: the twisted rule resolves first (the Eagle's dead stand back
	# up), THEN the objective is read — so the clock is judged against the
	# board the player will actually wake up to, not the one mid-resolution.
	_sp_end_of_round_revive()
	_sp_round_end_check()

	_update_hud()
	_check_game_over()
	if phase != Phase.GAME_OVER:
		await _short_pause(COMBAT_PAUSE_MEDIUM)
		# Awaited: _start_round paces its visible groups apart (see _round_beat).
		# Without the await, control would return to the player mid-open — the
		# intents would still be landing while the hand went live.
		await _start_round()


func _apply_round_end_relics() -> void:
	# Flanking Banner: 3 of 4 player front lanes full → enemies in the column
	# of the EMPTY player front lane take N damage.
	if _has_relic("flanking_banner"):
		var empty_lanes: Array[int] = []
		for i in range(LANES_PER_ROW):
			if _player_field[i] == null:
				empty_lanes.append(i)
		if empty_lanes.size() == 1:
			var dmg: int = int(RelicDB.get_relic("flanking_banner").get("value", 2))
			var lane: int = empty_lanes[0]
			for row in [ROW_FRONT, ROW_BACK]:
				var e = _row_array(true, row)[lane]
				if e != null:
					_relic_fired("flanking_banner")
					e.take_damage(dmg)
	# Imp Generator: summon a 1/1 in a random empty back-row lane.
	if _has_relic("imp_generator"):
		var empties: Array[int] = []
		for i in range(LANES_PER_ROW):
			if _player_back[i] == null:
				empties.append(i)
		if empties.size() > 0:
			_relic_fired("imp_generator")
			summon_token(1, 1, int(_combat_ops.pick(empties)), false, ROW_BACK)
	# (Mana Drunkard's spend-streak tracker retired 2026-07-25 — Forced March now
	# grants Swift to the round's first creature; see the creature_played hook.)
	# Steady Banner: friendlies that survived the round earn +2 ATK persistent.
	if _has_relic("steady_banner") and round_number >= 2:
		var bonus: int = int(RelicDB.get_relic("steady_banner").get("value", 2))
		var sb_promoted := false
		for c in _all_player_creatures():
			if not c.state.steady_banner_locked:
				c.persistent_atk_buff += bonus
				c.persistent_atk_buff_rounds = 99  # effectively permanent this fight
				c.state.steady_banner_locked = true
				c.update_stat_display()
				sb_promoted = true
		# The relic's turn-1 -1 ATK is an AURA (it lives on relic_atk_buff and is
		# read off the seal) — this GRANT is the moment, and it moved several
		# seals at once with nothing naming the cause. Same shape as Warlord's
		# Standard above; reported only when somebody was actually promoted.
		if sb_promoted:
			_relic_fired("steady_banner")


# =====================================================================
#  SUCCESSOR WARS — PER-FACTION REINFORCEMENT WAVE SCHEDULES (§15.2)
# =====================================================================
# Replaces the uniform 1/round drip in NORMAL holds whose encounter carries a
# faction tag — the last structural "fights feel samey" lever. Keyed by the
# encounter's faction tag. A wave lands at the END of a round and fights from
# the next round on; normal holds end by round 2-3, so every schedule shows
# its face by round 2 (R1-end musters: grasswake 2 / last_wall 1 / owed 0 /
# lanternhall 1 / everflame 0). Elites, bosses, and untagged encounters keep
# the live drip exactly, and every schedule yields to the legacy anti-stall
# escalation at ESCALATION_REINFORCE_ROUND.
#
#   waves        — per-round wave sizes; index 0 = the wave at the end of
#                  round 1.
#   after        — wave size once `waves` runs out (default 1).
#   cycle        — true: loop `waves` forever instead of falling to `after`.
#   collect      — true: wave size = enemy deaths banked since the last wave
#                  (capped at `cap`); ignores `waves`/`after`. Uncollected
#                  deaths stay banked.
#   cap          — max bodies per collected wave (collect mode only).
#   tough_hp     — rider: every wave body arrives with +N HP.
#   surge_bonus  — one-time +N wave the first time the hold is half-broken
#                  (face HP at or below half).
const FACTION_WAVE_SCHEDULES: Dictionary = {
	# The Grasswake (Overrun) — floods early, then the wake passes and they
	# run dry: 2, 2, then nothing. Empty lanes are their highway; outlast the
	# crest and you push into open grass.
	"grasswake": {"waves": [2, 2], "after": 0},
	# The Last Wall (Formation) — trickles forever, every body tough: exactly
	# 1 per round, no flood rolls ever, and each relief arrives +1 HP.
	"last_wall": {"waves": [], "after": 1, "tough_hp": 1},
	# The Owed (the Tithe) — they re-raise from their own dead: each enemy
	# death banks a deposit; every round they collect up to 2. Kill nothing
	# and nothing comes back.
	"owed": {"collect": true, "cap": 2},
	# The Lanternhall (Foresight) — barely reinforces (casts instead): one
	# body every other round, nothing between.
	"lanternhall": {"waves": [1, 0], "cycle": true},
	# The Everflame (the Fuse) — nothing pays now, everything pays later,
	# bigger: 0, 1, then 2 a round — plus a one-time surge the first time
	# the hold is half-broken.
	"everflame": {"waves": [0, 1], "after": 2, "surge_bonus": 1},
}

# Wave-chip captions per faction (caps to match the HUD chip voice — the
# INCOMING caption, the intent pills). "wave" = bodies muster, "none" = the
# schedule rests this round, "surge" = the Everflame's fuse moment.
const FACTION_WAVE_CAPTIONS: Dictionary = {
	"grasswake": {"wave": "THE WAKE CRESTS", "none": "THE WAKE HAS PASSED"},
	"last_wall": {"wave": "FRESH RANKS — TOUGHER", "none": "THE WALL HOLDS"},
	"owed": {"wave": "THE OWED COLLECT", "none": "NO DEBTS TO COLLECT"},
	"lanternhall": {"wave": "A MIRROR FLASHES", "none": "THE HALL ONLY WATCHES"},
	"everflame": {"wave": "THE FUSE BURNS DOWN", "none": "THE EVERFLAME HOLDS",
		"surge": "FIRE ON THE WATER"},
}


func _wave_schedule() -> Dictionary:
	return FACTION_WAVE_SCHEDULES.get(_encounter_faction, {})


func _wave_surge_pending() -> bool:
	# The Everflame's one-time surge: pending while the hold is half-broken
	# and the surge hasn't been spent. Read by both the telegraph and the
	# placement, so the warning can never disagree with what actually lands.
	var bonus: int = int(_wave_schedule().get("surge_bonus", 0))
	return bonus > 0 and not _wave_surge_fired and enemy_hp * 2 <= enemy_max_hp


func _next_wave_count() -> int:
	# Bodies the faction schedule will place at the END of the current round
	# (they fight from next round on). -1 = no schedule applies → callers use
	# the legacy uniform drip. The round-start telegraph and the end-of-round
	# placement both call this with the same round_number, so the chip always
	# matches the muster.
	if not _wave_schedule_active or round_number >= WAVE_SCHEDULE_CUTOFF_ROUND:
		return -1
	var sched: Dictionary = _wave_schedule()
	if sched.is_empty():
		return -1
	var n: int = 0
	if bool(sched.get("collect", false)):
		n = clampi(_wave_deaths_banked, 0, int(sched.get("cap", 2)))
	else:
		var waves: Array = sched.get("waves", [])
		var idx: int = round_number - 1
		if idx >= 0 and idx < waves.size():
			n = int(waves[idx])
		elif bool(sched.get("cycle", false)) and waves.size() > 0:
			n = int(waves[idx % waves.size()])
		else:
			n = int(sched.get("after", 1))
	if _wave_surge_pending():
		n += int(sched.get("surge_bonus", 0))
	return n


func _update_wave_telegraph() -> void:
	# Successor Wars legibility hook: the "next wave" chip pinned under the
	# incoming-damage chip telegraphs what the faction schedule will muster at
	# the end of this round — same diegetic-threat language as the INCOMING
	# chip, same color vocabulary as the intent pills (gray RETREAT = nothing
	# comes, purple SUMMON = a body musters, hot amber/red = a flood). Hidden
	# for legacy/elite/boss fights and once the round-8 escalation takes over.
	# Also re-run when the Owed bank a death, so the chip doubles as the
	# visible Tithe corpse-counter.
	if _hud_layer == null:
		return
	var n: int = _next_wave_count()
	if n < 0:
		if _wave_chip != null:
			_wave_chip.visible = false
		return
	if _wave_chip == null:
		_build_wave_chip()
	_wave_chip.visible = true
	_wave_chip_num.text = str(n)
	var caps: Dictionary = FACTION_WAVE_CAPTIONS.get(_encounter_faction, {})
	var caption: String
	if n > 0 and _wave_surge_pending() and caps.has("surge"):
		caption = String(caps.get("surge"))
	elif n > 0:
		caption = String(caps.get("wave", "REINFORCEMENTS"))
	else:
		caption = String(caps.get("none", "THE LINES HOLD"))
	_wave_chip_caption.text = caption
	# Fit long faction phrases ("THE HALL ONLY WATCHES") on the flavor line —
	# at the standard 15pt a few of them overflow the 236px chip width.
	var cap_font: Font = _wave_chip_caption.get_theme_font("font")
	var cap_size := 15
	while cap_size > 11 and cap_font != null and \
			cap_font.get_string_size(caption, HORIZONTAL_ALIGNMENT_LEFT, -1,
				cap_size).x > 204.0:
		cap_size -= 1
	_wave_chip_caption.add_theme_font_size_override("font_size", cap_size)
	# One warm threat ramp shared with the INCOMING chip (quiet bone → ember →
	# crimson): the muster reads on the same scale as the face damage instead of
	# adding a third (purple) color voice to the rail. Only numeral/icon heat up
	# fully — the border stays at half strength so INCOMING (the tactical clock)
	# always owns the hotter frame on this rail.
	var col := Color(0.72, 0.66, 0.54)
	if n == 1:
		col = Color(1.0, 0.62, 0.30)
	elif n == 2:
		col = Color(1.0, 0.47, 0.26)
	elif n >= 3:
		col = Color(1.0, 0.34, 0.28)
	_wave_chip_num.add_theme_color_override("font_color", col)
	if _wave_chip_icon != null:
		_wave_chip_icon.modulate = col
	var st: GameTheme.ChartPanelStyle = _wave_chip.get_theme_stylebox("panel")
	if st != null:
		st.border_color = Color(col.r, col.g, col.b, 0.45) if n > 0 \
			else Color(0.42, 0.33, 0.20, 0.85)


func _update_reserves_chip() -> void:
	## Solo's answer to skirmish's opponent-hand fan. In a Skirmish you can see
	## the foe's hand as card-backs with a live count; in solo the hold's reserves
	## were completely unknowable, so "how much longer does this fight go" had no
	## readable answer. This prints the COUNT only — never the faces — because a
	## hold's arrivals are meant to stay hidden; knowing there are four bodies
	## left is planning information, knowing WHICH four would end the surprise.
	if _hud_layer == null or _is_net():
		return   # skirmish has the real opponent-hand fan; this would double up
	if _reserves_chip == null:
		_build_reserves_chip()
	if _reserves_chip == null:
		return
	var left: int = _enemy_deck.size()
	# An endless backup body means the deck count is a floor, not a total. Say so
	# rather than printing a number that will not go to zero.
	var endless: bool = not _reinforcement.is_empty()
	if left <= 0 and not endless:
		_reserves_chip.visible = false
		return
	_reserves_chip.visible = true
	_reserves_chip_num.text = ("%d+" % left) if endless else str(left)
	# Cools as the hold runs dry — the same warm threat ramp the other two chips
	# on this rail use, read in reverse: a full reserve is the hot number.
	var col := Color(0.72, 0.66, 0.54)
	if left >= 5:
		col = Color(1.0, 0.47, 0.26)
	elif left >= 3:
		col = Color(1.0, 0.62, 0.30)
	_reserves_chip_num.add_theme_color_override("font_color", col)


